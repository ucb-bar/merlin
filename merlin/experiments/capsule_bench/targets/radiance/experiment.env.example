# Per-experiment tooling-PATH env — TEMPLATE (tracked). Copy to `experiment.env` (gitignored) and fill
# in the real machine paths. This file holds ONLY machine-specific tooling PATHS shared by ALL arms of the
# experiment (a constant input, not per-arm assistance): the mlc model-ladder checkout and the cyclotron
# SIMT toolchain the oracle needs. NO per-arm content, NO answers, NO target logic — those stay in the
# target contract / capsule corpus / bundle manifests.
#
# The harness auto-sources `targets/<target>/experiment.env` into the environment before a run
# (merlin/experiments/capsule_bench/harness/_common.py); the process environment always WINS, so an
# exported var is never overridden. KEY=VALUE lines, `#` comments.

# The mlc model-ladder checkout (the RadianceCluster/Muon arc model + the RTL-derived Muon ISA facts under
# runs/circt-arc/muon/). Resolved by merlin.targetgen.rtl.mlc_bridge; radiance's arc_target is 'muon'.
MERLIN_MLC_DIR=/path/to/mvp-lhwir/modeling

# The cyclotron SIMT perf-model binary — radiance's bespoke RTL oracle (sim_via: cyclotron). Grades the
# emitted kernel ELF; MuonUnavailable (fail-closed) when unset. Resolved by runtime.backends.muon.available.
MERLIN_MUON_CYCLOTRON=/path/to/chipyard/.../cyclotron/target/release/cyclotron

# The cyclotron config (geometry: lanes/warp, warps, cores) the perf model + the fork-free harness read.
MERLIN_MUON_CONFIG=/path/to/cyclotron/config.toml

# The radiance-kernels toolchain root: the Muon clang++/runtime (libmuonrt.a, tohost.S, mu_link.ld,
# include/) the fork-free build links against on stock LLVM. Resolved by runtime.backends.muon.
MERLIN_RADIANCE_KERNELS=/path/to/radiance-kernels
