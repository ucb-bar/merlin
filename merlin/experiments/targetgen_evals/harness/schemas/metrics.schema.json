{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "metrics.schema.json",
  "title": "SummaryMetrics",
  "description": "Per-run summary metrics row for the ablation table.",
  "type": "object",
  "required": ["run_id", "method", "seed"],
  "properties": {
    "run_id":                   {"type": "string"},
    "method":                   {"type": "string"},
    "seed":                     {"type": "integer"},
    "is_smoke_test":            {"type": "boolean"},
    "budget":                   {"type": "string"},
    "schema_valid":             {"type": ["boolean", "null"]},
    "xdsl_files":               {"type": ["integer", "null"]},
    "xdsl_op_estimate":         {"type": ["integer", "null"]},
    "pass_tests_pass":          {"type": ["integer", "null"]},
    "pass_tests_total":         {"type": ["integer", "null"]},
    "evidence_coverage":        {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "unsupported_claim_rate":   {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "arch_rules_passed":        {"type": ["integer", "null"]},
    "arch_rules_failed":        {"type": ["integer", "null"]},
    "human_interventions":      {"type": ["integer", "null"]},
    "cost_usd":                 {"type": ["number", "null"]},
    "time_to_first_pass_s":     {"type": ["number", "null"]},
    "heldout_shape_success":    {"type": ["number", "null"]},
    "heldout_layout_success":       {"type": ["number", "null"]},
    "heldout_dtype_success":        {"type": ["number", "null"]},
    "heldout_surface_success":      {"type": ["number", "null"]},
    "heldout_composition_success":  {"type": ["number", "null"]},
    "heldout_fusion_success":       {"type": ["number", "null"]},
    "heldout_model_success":        {"type": ["number", "null"]},
    "heldout_kernel_success":       {"type": ["number", "null"]},
    "merlin_core_files_modified": {"type": ["integer", "null"]},
    "tracking_mode":              {"type": ["string", "null"]},
    "mlflow_run_id":              {"type": ["string", "null"]},
    "otel_trace_id":              {"type": ["string", "null"]},
    "observed_cost_usd":          {"type": ["number", "null"]},
    "estimated_cost_usd":         {"type": ["number", "null"]},
    "cost_source":                {"type": ["string", "null"]},
    "tokens_input":               {"type": ["integer", "null"]},
    "tokens_output":              {"type": ["integer", "null"]},
    "token_source":               {"type": ["string", "null"]},
    "wall_clock_seconds":         {"type": ["number", "null"]},
    "time_to_first_validation_s": {"type": ["number", "null"]},
    "agent_turns":                {"type": ["integer", "null"]},
    "tool_calls":                 {"type": ["integer", "null"]}
  },
  "additionalProperties": true
}
