{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "merlin.lean.chain.v1",
  "title": "Merlin Lean end-to-end chain (merlin.lean.chain.v1)",
  "description": "Refinement evidence composed from replayed boundary and support receipts. Refinement permits source UB and poison. The overall verdict stays abstracted until a proved source-definedness checker is implemented (docs/design/merlin_lean_verification.md, section 4.5).",
  "type": "object",
  "required": ["schema", "theorem", "function", "links", "support", "chained", "refinement_verdict", "source_definedness", "verdict", "assumptions"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "merlin.lean.chain.v1"},
    "theorem": {"type": "string", "description": "Lean name of the composition theorem."},
    "function": {"type": "string"},
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["boundary", "receipt_sha256", "before_sha256", "after_sha256", "verdict"],
        "additionalProperties": false,
        "properties": {
          "boundary": {"type": "string"},
          "receipt_sha256": {"$ref": "#/$defs/sha"},
          "before_sha256": {"$ref": "#/$defs/sha"},
          "after_sha256": {"$ref": "#/$defs/sha"},
          "verdict": {"enum": ["verified", "refuted", "abstracted", "unmeasured"]}
        }
      }
    },
    "support": {
      "type": "object",
      "required": ["receipt_sha256", "subject_sha256", "verdict"],
      "additionalProperties": false,
      "properties": {
        "receipt_sha256": {"$ref": "#/$defs/sha"},
        "subject_sha256": {"$ref": "#/$defs/sha"},
        "verdict": {"enum": ["verified", "refuted", "abstracted", "unmeasured"]},
        "domain": {"type": "string"}
      }
    },
    "chained": {"type": "boolean", "description": "Every boundary's before is the previous boundary's after, the support subject is the first before, and (with a handoff) the last after is the handoff."},
    "handoff_sha256": {"$ref": "#/$defs/sha", "description": "SHA-256 of the file handed to the upstream lowering, when the chain was checked against it."},
    "refinement_verdict": {"enum": ["verified", "abstracted", "unmeasured"]},
    "source_definedness": {
      "type": "object",
      "required": ["verdict", "reason"],
      "additionalProperties": false,
      "properties": {
        "verdict": {"const": "unmeasured"},
        "reason": {"type": "string"}
      }
    },
    "verdict": {"enum": ["abstracted", "unmeasured"]},
    "reason": {"type": "string"},
    "assumptions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
