{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "merlin/bench_contract/capsule.schema.json",
  "title": "Workload capsule (capsule_bench_v0)",
  "description": "A compiler-input workload capsule: describes what to compile, the numeric golden policy, the expected Gemmini instruction coverage, the required oracle tiers, and the public/dev/hidden label. A capsule is an INPUT to the backend-under-test, never a kernel.",
  "type": "object",
  "required": ["name", "kind", "source_role", "label", "operation", "numeric_policy", "expected", "required_oracle_tiers"],
  "properties": {
    "name": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
    "kind": {"type": "string", "enum": ["isa", "layer", "model_slice", "model"]},
    "source_role": {
      "type": "string",
      "enum": ["behavioral_specimen", "pytorch_model_slice", "handauthored_compiler_test", "uplifted_from_bareMetalC", "spec_derived"]
    },
    "source_reference": {"type": "string", "description": "bareMetalC path / torch module slice / ISA section / local spec id"},
    "label": {"type": "string", "enum": ["public", "dev", "hidden"]},
    "interface_mlir": {"type": "string", "description": "relative path to capsule.interface.mlir"},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role", "shape", "dtype"],
        "properties": {
          "name": {"type": "string"},
          "role": {"type": "string", "enum": ["input", "weight", "bias", "output"]},
          "shape": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 1},
          "dtype": {"type": "string", "enum": ["i8", "i16", "i32", "i64", "fp16", "f32", "bf16", "fp8_e4m3", "fp8_e5m2", "mxfp8", "mxfp6", "mxfp4", "fp6_e3m2", "fp4_e2m1", "e8m0"]},
          "layout": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "operation": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {"type": "string", "enum": ["matmul", "linear", "conv2d", "depthwise_conv2d", "maxpool2d", "avgpool2d", "global_average", "movement", "attention_qk", "attention_pv", "resident_reuse", "rmsnorm", "attention_full", "softmax", "layernorm", "geglu", "rope", "gelu", "silu", "add", "reduce_sum", "bias_add", "fused_matmul_bias", "k_chain", "logit_softcap", "embed_scale", "gemma_4norm", "gemv_batched", "patch_embed", "requant", "attention", "attention_sublayer", "elementwise", "gated_mlp", "mlp", "reduce", "rmsnorm_linear", "model"]},
        "attributes": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "numeric_policy": {
      "type": "object",
      "required": ["compare", "dtype"],
      "properties": {
        "compare": {"type": "string", "enum": ["exact_int", "tolerance_float"]},
        "dtype": {"type": "string", "enum": ["i8", "i16", "i32", "fp16", "f32", "bf16", "fp8_e4m3", "fp8_e5m2", "mxfp8", "mxfp6", "mxfp4", "fp6_e3m2", "fp4_e2m1", "e8m0"]},
        "acc_scale": {"type": "number"},
        "requant_shift": {"type": "integer"},
        "rtol": {"type": "number"},
        "atol": {"type": "number"}
      },
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "required": ["instruction_classes"],
      "properties": {
        "instruction_classes": {
          "type": "array",
          "description": "Required instruction classes, DERIVED per-target from the target's own ISA (e.g. gemmini RoCC classes, or a self-hosted ISA's semantic op patterns like MXUMatMul/TensorBaseOffset). Not a fixed enum: the class vocabulary is the target's, so validity is enforced by the per-target derivation (isa_taxonomy) + its coverage checker, not a hardcoded list here.",
          "items": {"type": "string"}
        },
        "forbidden_classes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "modes": {
          "type": "object",
          "properties": {
            "i8": {"type": "boolean"},
            "relu": {"type": "boolean"},
            "acc_scale": {"type": "boolean"},
            "k_accumulate": {"type": "boolean"},
            "resident_reuse": {"type": "boolean"},
            "conv2d": {"type": "boolean"},
            "movement": {"type": "boolean"},
            "padded_edge": {"type": "boolean"},
            "rmsnorm": {"type": "boolean"},
            "f32": {"type": "boolean"},
            "i32": {"type": "boolean"},
            "bias": {"type": "boolean"},
            "requant": {"type": "boolean"},
            "transposed": {"type": "boolean"},
            "reduction": {"type": "boolean"},
            "elementwise": {"type": "boolean"},
            "softmax": {"type": "boolean"},
            "gelu": {"type": "boolean"},
            "divergent": {"type": "boolean"},
            "nested_control_flow": {"type": "boolean"},
            "cross_thread": {"type": "boolean"},
            "shared_mem": {"type": "boolean"},
            "barrier": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "required_oracle_tiers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "enum": ["L0", "L1", "L2", "L3", "L4", "L5"]}
    },
    "vcs": {"type": "string", "enum": ["required", "optional", "unavailable"]},
    "firesim": {"type": "string", "enum": ["required", "optional", "unavailable"]},
    "gate": {
      "type": "object",
      "description": "Scheduling gate: a whole-model capsule is only run once the op-level suite has proven itself. `after_op_pass_fraction` is the minimum fraction of graded op capsules that must PASS before this capsule is scheduled.",
      "properties": {"after_op_pass_fraction": {"type": "number", "minimum": 0, "maximum": 1}},
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
