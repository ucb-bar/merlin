{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Merlin ExperimentSpec version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "target", "phases"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "target": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "description": {"type": "string"},
    "kind": {"enum": ["experiment", "template"]},
    "inputs": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Experiment-wide declared policy, carried into every phase contract.",
      "properties": {
        "prohibited_instruction_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z_]*$"},
          "description": "Closed-vocabulary instruction roles (merlin.kernels.roles) no candidate program may emit anywhere in its linked ELF, in Phase 1 and in the Phase 2 candidate arm; Phase 0 resolves them to the target's own instructions."
        }
      }
    },
    "phases": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "0": {"$ref": "#/$defs/phase"},
        "1": {"$ref": "#/$defs/phase"},
        "2": {"$ref": "#/$defs/phase"}
      }
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "config"],
      "properties": {
        "adapter": {"type": "string"},
        "mode": {"enum": ["measured_claims", "model_portfolio", "whole_model_measured"]},
        "config": {"type": "object"}
      }
    }
  }
}
