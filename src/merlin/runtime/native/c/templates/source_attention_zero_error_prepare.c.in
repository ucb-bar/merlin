 /* Error admissions cover every immutable RHS row. A zero L1 norm proves
  * elementwise equality to reconstruction, not merely a small sampled error. */
 int rhs_zero_representation=1;
 for(int j=0;j<n;j++)if(enp[j].l1!=0)rhs_zero_representation=0;
 const double zero_representation_error=upadd(0,0);
