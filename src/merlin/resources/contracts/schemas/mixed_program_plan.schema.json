{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "merlin/bench_contract/mixed_program_plan.schema.json",
  "title": "Source-bound mixed whole-program emission plan v1",
  "description": "A compiler declaration, not proof of execution, semantic equivalence or accelerator placement.",
  "type": "object",
  "required": ["schema", "source_sha256", "source_op_count", "tasks", "schedule_instruction_count", "prologue_instruction_range", "epilogue_instruction_range", "entry_bindings", "source_values", "output_bindings"],
  "properties": {
    "schema": {"const": "mixed_program_plan_v1"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_op_count": {"type": "integer", "minimum": 1},
    "tasks": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["task_index", "kind", "source_op_indices", "instruction_start", "instruction_end", "reads", "writes"],
        "properties": {
          "task_index": {"type": "integer", "minimum": 0},
          "kind": {"type": "string", "minLength": 1},
          "source_op_indices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
          "source_region_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "instruction_start": {"type": "integer", "minimum": 0},
          "instruction_end": {"type": "integer", "minimum": 1},
          "reads": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "writes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }, "additionalProperties": true}
    },
    "schedule_instruction_count": {"type": "integer", "minimum": 1},
    "prologue_instruction_range": {"$ref": "#/$defs/range"},
    "epilogue_instruction_range": {"$ref": "#/$defs/range"},
    "entry_bindings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_values": {"type": "array", "items": {"type": "object", "required": ["op_index", "result_index", "tensor"], "properties": {"op_index": {"type": "integer", "minimum": 0}, "result_index": {"type": "integer", "minimum": 0}, "tensor": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "output_bindings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "compiler_temporaries": {"type": "array", "items": {"type": "object", "required": ["tensor", "source_op_index", "source_result_index", "purpose"], "properties": {"tensor": {"type": "string", "minLength": 1}, "source_op_index": {"type": "integer", "minimum": 0}, "source_result_index": {"type": "integer", "minimum": 0}, "purpose": {"type": "string", "minLength": 1}}, "additionalProperties": true}},
    "physical_transitions": {"type": "array"}
  },
  "$defs": {"range": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}], "minItems": 2, "maxItems": 2}},
  "additionalProperties": true
}
