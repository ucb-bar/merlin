{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile-bound structural artifact bundle v1; execution unsupported",
  "type": "object",
  "required": [
    "schema",
    "profile",
    "artifacts",
    "buffers",
    "steps"
  ],
  "properties": {
    "schema": {
      "const": "merlin.artifact_bundle.v1"
    },
    "profile": {
      "type": "object",
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "path",
          "sha256",
          "unit",
          "issuer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "issuer": {
            "type": "string",
            "minLength": 1
          },
          "entry": {
            "type": "string"
          },
          "abi": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "buffers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "memory_space",
          "initialized"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "memory_space": {
            "type": "string",
            "minLength": 1
          },
          "initialized": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "artifact",
          "after",
          "reads",
          "writes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "artifact": {
            "type": "string",
            "minLength": 1
          },
          "after": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reads": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "writes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
