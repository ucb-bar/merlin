{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".venv/bin/python .claude/hooks/guard_artifact_writes.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".venv/bin/python build_tools/scripts/check_artifact_layout.py --stop-hook"
          }
        ]
      }
    ]
  }
}
