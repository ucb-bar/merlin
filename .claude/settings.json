{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".venv/bin/python .claude/hooks/guard_artifact_writes.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".venv/bin/python build_tools/scripts/check_artifact_layout.py --stop-hook"
          },
          {
            "type": "command",
            "command": ".venv/bin/python build_tools/scripts/check_docs.py --stop-hook"
          },
          {
            "type": "command",
            "command": ".venv/bin/python build_tools/scripts/check_no_regex.py --stop-hook"
          },
          {
            "type": "command",
            "command": ".venv/bin/python build_tools/scripts/check_no_target_name.py --stop-hook"
          },
          {
            "type": "command",
            "command": ".venv/bin/python build_tools/scripts/check_no_assumed_constants.py --stop-hook"
          },
          {
            "type": "command",
            "command": ".venv/bin/python build_tools/scripts/check_no_answer_keys.py --stop-hook"
          },
          {
            "type": "command",
            "command": ".venv/bin/python build_tools/scripts/check_provenance.py --stop-hook"
          }
        ]
      }
    ]
  }
}
