{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Merlin ExperimentSpec version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "target", "phases"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "target": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "description": {"type": "string"},
    "kind": {"enum": ["experiment", "template"]},
    "inputs": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "phases": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "0": {"$ref": "#/$defs/phase"},
        "1": {"$ref": "#/$defs/phase"},
        "2": {"$ref": "#/$defs/phase"}
      }
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "config"],
      "properties": {
        "adapter": {"type": "string"},
        "mode": {"enum": ["measured_claims", "model_portfolio"]},
        "config": {"type": "object"}
      }
    }
  }
}
