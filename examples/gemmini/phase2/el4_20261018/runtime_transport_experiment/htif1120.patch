+#if MERLIN_HTIF_BUFFER_BYTES < 1 || MERLIN_HTIF_BUFFER_BYTES > 4096
+#error "MERLIN_HTIF_BUFFER_BYTES must be an integer from 1 through 4096"
+#endif
+static char htif_buf[MERLIN_HTIF_BUFFER_BYTES];
