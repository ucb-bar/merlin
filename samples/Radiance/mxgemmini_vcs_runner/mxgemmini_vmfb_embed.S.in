// Assembly wrapper to embed the mxGemmini VCS bench VMFB in a dedicated
// section. The .vmfb_data output section is provided by htif.ld and is
// placed AFTER heap+stack so medany ±2GB constraints on .text are honored.
//
// Cloned from samples/SaturnOPU/simple_embedding_ukernel/gemmini_spike_vmfb_embed.S.in.

	.section .vmfb_data, "a", @progbits
	.global _binary_mxgemmini_vcs_vmfb_start
	.global _binary_mxgemmini_vcs_vmfb_end
	.balign 16
_binary_mxgemmini_vcs_vmfb_start:
	.incbin "@MXGEMMINI_VCS_VMFB_PATH@"
_binary_mxgemmini_vcs_vmfb_end:
