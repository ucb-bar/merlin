# Auto-detect text files and normalize to LF (Linux style)
* text=auto eol=lf

# Force specific files to ALWAYS be LF (crucial for bash/docker/make)
*.sh text eol=lf
*.bash text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Keep Windows-specific files as CRLF (if any are ever added)
*.bat text eol=crlf
*.ps1 text eol=crlf

# Denote binary files so Git doesn't try to diff them
*.png binary
*.o binary
*.a binary

# Archived evidence is content-addressed. Preserve original bytes (including CSV CRLF)
# across relocation and checkout rather than silently changing recorded hashes.
experiments/reference-data/** -text -eol
# Independent graph-pass review: manifests and audits hash these files, including CSV CRLF.
out/artifacts/verification/graham-graph-review/** -text -eol
# Raw a26 evidence retains CRLF CSV and unified-diff context lines byte-for-byte.
# Keep normal whitespace checks for Python/Lean sources and Markdown updates.
out/artifacts/verification/graham-graph-review/execution-a26-20261026-v1/**/*.csv -whitespace
out/artifacts/verification/graham-graph-review/execution-a26-20261026-v1/**/*.patch -whitespace
out/artifacts/verification/graham-graph-review/execution-a26-20261026-v1/**/*.stdout -whitespace
out/artifacts/verification/graham-graph-review/execution-a26-20261026-v1/**/*.stderr -whitespace
out/artifacts/verification/graham-graph-review/execution-a26-20261026-v1/**/*.headers -whitespace
out/artifacts/verification/graham-graph-review/execution-a26-20261026-v1/**/*.txt -whitespace
