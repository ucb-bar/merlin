# Auto-detect text files and normalize to LF (Linux style)
* text=auto eol=lf

# Force specific files to ALWAYS be LF (crucial for bash/docker/make)
*.sh text eol=lf
*.bash text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Keep Windows-specific files as CRLF (if any are ever added)
*.bat text eol=crlf
*.ps1 text eol=crlf

# Denote binary files so Git doesn't try to diff them
*.png binary
*.o binary
*.a binary

# Archived evidence is content-addressed. Preserve original bytes (including CSV CRLF)
# across relocation and checkout rather than silently changing recorded hashes.
experiments/reference-data/** -text -eol

# Preserve the frozen handoff parts, ELF and source-bound receipts byte for byte.
out/artifacts/handoff/gemmini-firesim-dse-publication/** -text -eol
out/artifacts/handoff/gemmini-tinyllama-synthetic/** -text -eol

# Frozen protocol/ELF handoff: hashes cover original bytes, including CSV CRLF.
out/artifacts/handoff/gemmini-firesim-elf-plan/** -text -eol
# Diff context and captured warning logs intentionally retain their source spaces.
out/artifacts/handoff/gemmini-firesim-elf-plan/**/*.patch -whitespace
out/artifacts/handoff/gemmini-firesim-elf-plan/**/*.log -whitespace
out/artifacts/handoff/gemmini-firesim-elf-plan/**/*.csv whitespace=cr-at-eol
