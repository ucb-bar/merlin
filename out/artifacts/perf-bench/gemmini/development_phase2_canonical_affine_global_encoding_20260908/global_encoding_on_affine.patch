+            # structural byte count, not measured DRAM traffic.
+            materialized_bytes=2 * rows * kdim * DTYPE_BYTES[ifm_dtype],
+            capability="generic_contraction",
+        )
+        operations.append(EncodingOperation(index, node.name, "conv2d", (native, fallback)))
+
+    return solve_global_encodings(EncodingProblem(
+        tuple(tensor_facts[name] for name in sorted(tensor_facts)), tuple(operations), encodings,
+    ))
