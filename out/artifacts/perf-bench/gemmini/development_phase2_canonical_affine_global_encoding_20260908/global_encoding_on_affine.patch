+        e = _epilogue_from(node.attrs)
+        candidate = Convolution(
+            ifm_name, weight_name, node.name, bn, ci, hi, wi, co, kh, kw, ho, wo,
+            stride[0], stride[1], dilation[0], dilation[1], *padding,
+            input_layout="NHWC", weight_layout="HWIO", output_layout="NHWC",
+            output_dtype=e.output_dtype,
+        )
+        activation = Buffer(ifm_name, list(ifm_shape), ifm_dtype, "input")
+        weight = Buffer(weight_name, list(weight_decl.shape), weight_decl.dtype, "weight")
+        destination = Buffer(node.name, list(node.out_shape), node.out_dtype, "output")
