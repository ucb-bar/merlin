+def _plan_iface_encodings(wl: Workload) -> dict[str, Any]:
+    """Adapt public convolution nodes to the target-neutral encoding solver.
+
+    The public convolution contract already names NHWC semantics.  This adapter's important job
+    is therefore not to guess a layout: it proves that a producer's narrow NHWC buffer can remain
+    the next convolution's physical input, instead of forcing each operation through an isolated
+    flattened/im2col boundary.
+    """
+    resident: dict[str, str] = {}
+    produced_by: dict[str, int] = {}
+    consumers: dict[str, list[int]] = {}
+    conv_nodes: list[tuple[int, Any, str]] = []
+    for index, node in enumerate(wl.nodes):
+        if node.kind == "resident_pack":
+            resident[node.name] = node.ins[0]
+        if node.name:
+            produced_by[node.name] = index
+        for operand in node.ins:
+            consumers.setdefault(resident.get(operand, operand), []).append(index)
+        if node.kind == "conv2d":
+            conv_nodes.append((index, node, resident.get(node.ins[1], node.ins[1])))
+
+    if not conv_nodes:
+        return {
+            "schema": "target_neutral_global_encoding_v1",
+            "status": "not_applicable",
+            "reason": "no_convolution_encoding_region",
+            "cycle_prediction_claimed": False,
+        }
+
+    encodings = {
+        "NHWC": Encoding("NHWC", ("N", "H", "W", "C"), _F.DIM),
+        "NCHW": Encoding("NCHW", ("N", "C", "H", "W"), _F.DIM),
+        "HWIO": Encoding("HWIO", ("H", "W", "I", "O"), _F.DIM),
+        "OIHW": Encoding("OIHW", ("O", "I", "H", "W"), _F.DIM),
+    }
+    tensor_facts: dict[str, TensorBoundary] = {}
+    operations: list[EncodingOperation] = []
+    conv_indices = {index for index, _, _ in conv_nodes}
+    for index, node, weight_name in conv_nodes:
+        ifm_name = node.ins[0]
+        ifm_decl = wl.tensors.get(ifm_name)
+        if ifm_decl is not None:
+            ifm_shape, ifm_dtype, external_input = ifm_decl.shape, ifm_decl.dtype, True
+        else:
+            producer = next((prior for prior in wl.nodes if prior.name == ifm_name), None)
+            if producer is None:
+                raise LoweringDeclined(f"global encoding cannot find {ifm_name!r}", op="conv2d")
+            ifm_shape, ifm_dtype = producer.out_shape, producer.out_dtype
+            # A value produced outside this encoding region is an explicit region input.  It has
+            # no producer in this solver problem; claiming otherwise would make an unrelated
+            # movement/elementwise op look like an unknown encoding alternative.
+            external_input = produced_by.get(ifm_name) not in conv_indices
+        kernel = [int(value) for value in node.attrs["kernel"]]
+        kh, kw, ci, co = kernel
+        stride = [int(value) for value in node.attrs.get("stride", [1, 1])]
+        padding = [int(value) for value in node.attrs.get("padding", [0, 0, 0, 0])]
+        dilation = [int(value) for value in node.attrs.get("dilation", [1, 1])]
+        if len(ifm_shape) != 4:
+            # The ordinary lowering owns the diagnostic.  This receipt simply refuses to invent
+            # an encoding for a non-NHWC rank.
+            return {
+                "schema": "target_neutral_global_encoding_v1", "status": "refused",
+                "reason": "activation_rank_is_not_four", "operation": node.name,
+                "cycle_prediction_claimed": False,
+            }
+        bn, hi, wi, actual_ci = [int(value) for value in ifm_shape]
+        ho, wo = conv_out_dims(hi, wi, kh, kw, stride, padding, dilation)
+        output_extents = {"N": bn, "H": ho, "W": wo, "C": co}
+        ifm_extents = {"N": bn, "H": hi, "W": wi, "C": actual_ci}
+        weight_extents = {"H": kh, "W": kw, "I": ci, "O": co}
+
+        tensor_facts[ifm_name] = TensorBoundary(
+            ifm_name, ifm_extents, ifm_dtype, "NHWC",
+            (produced_by.get(ifm_name)
+             if produced_by.get(ifm_name) in conv_indices else None),
+            tuple(sorted(set(c for c in consumers.get(ifm_name, []) if c in conv_indices))),
+            external_input=external_input,
+            external_output=any(c not in conv_indices for c in consumers.get(ifm_name, ())),
+        )
+        weight_decl = wl.tensors[weight_name]
+        tensor_facts[weight_name] = TensorBoundary(
+            weight_name, weight_extents, weight_decl.dtype, "HWIO", None, (index,),
+            external_input=True,
+        )
+        tensor_facts[node.name] = TensorBoundary(
+            node.name, output_extents, node.out_dtype, "NHWC", index,
+            tuple(sorted(set(c for c in consumers.get(node.name, []) if c in conv_indices))),
+            external_output=(not consumers.get(node.name)
+                             or any(c not in conv_indices for c in consumers.get(node.name, ()))),
+        )
