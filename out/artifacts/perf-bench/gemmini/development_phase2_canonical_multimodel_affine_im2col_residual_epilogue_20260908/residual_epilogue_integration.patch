@@ -0,0 +1,181 @@
+"""Structural and numeric qualification for exact second-tensor residual fusion."""
+from __future__ import annotations
+
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+from mlir_oot.frontend.parse import parse_module
+from mlir_oot.frontend.residual_epilogue import ResidualEpilogue, recognize
+from mlir_oot.gemmini_opt import Pipeline, _print
+
+
+ROOT = Path(__file__).resolve().parents[1]
+TEMPLATE = (ROOT / "tests/fixtures/residual_two_branch_template.mlir").read_text()
+
+
+def _source(m: int, k: int, n: int) -> str:
+    return TEMPLATE.replace("@M@", str(m)).replace("@K@", str(k)).replace("@N@", str(n))
+
+
+def _ops(source: str):
+    module = parse_module(source)
+    function = next(op for op in module.walk() if op.name == "func.func")
+    return [op for op in function.regions[0].blocks[0].ops if op.name != "func.return"]
+
+
+def _residual(source: str):
+    return next(op for op in _ops(source)
+                if getattr(op.attributes.get("prov.region_id"), "data", None) == "residual")
+
+
+@pytest.mark.parametrize("m,k,n", [
+    (1, 3, 1),
+    (2, 5, 7),
+    (17, 31, 19),
+    (2, 5, 33),
+])
+def test_two_branch_residual_is_one_exact_host_traversal(m: int, k: int, n: int) -> None:
+    pipe = Pipeline(_source(m, k, n), enable_source_conv=True).run()
+    assert pipe.declined is None
+    assert pipe.mixed_declined is None
+    cb = pipe.plan.command_buffer
+    tasks = cb["params"]["global_program_plan"]["tasks"]
+    assert [task["kind"] for task in tasks] == ["contraction", "contraction", "host"]
+    receipt = cb["params"]["target_neutral_residual_epilogues"]
+    assert receipt["formed_site_count"] == 1
+    assert receipt["selected_site_count"] == 1
+    assert receipt["deferred_branch_count"] == 1
+    assert receipt["formed"][0]["numeric_contract"] == {
+        "source_f32_operation_order_preserved": True,
+        "broadcast_indexing_maps_preserved": True,
+        "rounding": "round_to_nearest_even",
+        "clamp": [-128, 127],
+        "reassociation": False,
+    }
+    owned = [index for task in tasks for index in task["source_op_indices"]]
+    assert sorted(owned) == list(range(cb["params"]["global_program_plan"]["source_op_count"]))
+    assert len(owned) == len(set(owned))
+    target = _print(pipe.artifact)
+    assert target.count('"llvm.intr.roundeven"') == 1
+    assert target.count('"llvm.fptosi"') == 1
+    # Every model-sized pointwise result remains lazy. Only the scalar reciprocal owns storage.
+    storage = cb["params"]["host_storage"]
+    assert storage["workspace_global_bytes"] == 0
+    assert all(row["bytes"] <= 4 for row in storage["largest_owners"]
+               if row["operation"] == "linalg.generic")
+
+
+def test_projected_residual_broadcast_is_formed_from_maps() -> None:
+    source = _source(2, 5, 7)
+    source = source.replace(
+        "%qscale: tensor<f32>)",
