diff --git a/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCF.lean b/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCF.lean
new file mode 100644
--- /dev/null
+++ b/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCF.lean
@@ -0,0 +1,106 @@
+/- ONE operation-level initializer interpretation with scoped SSA values.
+Pure operators may be partial; their only inputs are explicit scalar/index
+operands. Stores emit ordered writes; heap/public framing is proved separately.
+This does not add a route to the frozen MerlinVerify evaluator. -/
+import Merlin.GraphLoopsReuseCountermodels
+import Merlin.GraphLoopsUnrollGrouping
+
+set_option autoImplicit false
+
+namespace Merlin.GraphLoopsMemorySCF
+
+inductive Datum (Value : Type) where
+  | index (value : Nat)
+  | scalar (value : Value)
+
+abbrev Env (Value : Type) := Nat → Option (Datum Value)
+abbrev Write (Value : Type) := Nat × Value
+abbrev Log (Value : Type) := List (Write Value)
+
+def put {Value : Type} (env : Env Value) (name : Nat) (value : Datum Value) : Env Value :=
+  fun other => if other = name then some value else env other
+
+def assign {Value : Type} : Env Value → List Nat → List (Datum Value) → Env Value
+  | env, name :: names, value :: values => assign (put env name value) names values
+  | env, _, _ => env
+
+def read {Value : Type} (env : Env Value) : List Nat → Option (List (Datum Value))
+  | [] => some []
+  | name :: names => do
+      let value ← env name
+      let remaining ← read env names
+      pure (value :: remaining)
+
+structure PureOp where
+  key : String
+  operands : List Nat
+  results : List Nat
+  deriving DecidableEq, Repr
+
+abbrev PureMeaning (Value : Type) := String → List (Datum Value) → List (Datum Value) → Prop
+
+inductive EvalPure {Value : Type} (meaning : PureMeaning Value) : List PureOp → Env Value → Env Value → Prop where
+  | done (env : Env Value) : EvalPure meaning [] env env
+  | more {op : PureOp} {rest : List PureOp} {before after : Env Value} {arguments values : List (Datum Value)}
+      (inputs : read before op.operands = some arguments) (compute : meaning op.key arguments values)
+      (arity : values.length = op.results.length)
+      (remaining : EvalPure meaning rest (assign before op.results values) after) : EvalPure meaning (op :: rest) before after
+
+def definitions (ops : List PureOp) : List Nat := ops.flatMap PureOp.results
+
+theorem assign_frame {Value : Type} (env : Env Value) (names : List Nat) (values : List (Datum Value)) (name : Nat)
+    (outside : name ∉ names) : assign env names values name = env name := by
+  induction names generalizing env values with
+  | nil => rfl
+  | cons first rest induction =>
+    cases values with
+    | nil => rfl
+    | cons value values =>
+      have different : name ≠ first := fun same => outside (same ▸ List.mem_cons_self)
+      have restOutside : name ∉ rest := fun member => outside (List.mem_cons_of_mem first member)
+      change assign (put env first value) rest values name = env name
+      rw [induction _ _ restOutside]
+      exact ite_eq_right different
+
+theorem EvalPure.frame {Value : Type} {meaning : PureMeaning Value} {ops : List PureOp} {before after : Env Value}
+    (run : EvalPure meaning ops before after) {name : Nat} (outside : name ∉ definitions ops) : after name = before name := by
+  induction run with
+  | done => rfl
+  | @more op rest before after arguments values inputs compute arity remaining induction =>
+    have outsideFirst : name ∉ op.results := fun member => outside (List.mem_append_left _ member)
+    have outsideRest : name ∉ definitions rest := fun member => outside (List.mem_append_right _ member)
+    exact (induction outsideRest).trans (assign_frame before op.results values name outsideFirst)
+
+structure Leaf where
+  ops : List PureOp
+  value : Nat
+  indices : List Nat
+  deriving DecidableEq, Repr
+
+def LeafResult {Value : Type} (meaning : PureMeaning Value) (leaf : Leaf) (env : Env Value)
+    (coordinates : List Nat) (value : Value) : Prop :=
+  ∃ after, EvalPure meaning leaf.ops env after ∧ after leaf.value = some (.scalar value) ∧
+    read after leaf.indices = some (coordinates.map Datum.index)
+
+structure Initializer where
+  shape : List Nat
+  ivs : List Nat
+  outerPrefix : List PureOp
+  leaf : Leaf
+  deriving DecidableEq, Repr
+
+/-- Closed locals restore the exact incoming environment after each body.
+The log is the only state changed inside initialization. -/
+structure ScopedLog (Value : Type) where
+  env : Env Value
+  writes : Log Value
+
+/-- The store reads every actual coordinate from its SSA operands. Its address
+is row-major; source/target buffer binding is supplied by the checked epoch map. -/
+def Emit {Value : Type} (meaning : PureMeaning Value) (leaf : Leaf) (shape : List Nat)
+    (before : ScopedLog Value) (after : ScopedLog Value) : Prop :=
+  ∃ coordinates value, LeafResult meaning leaf before.env coordinates value ∧
+    GraphLoopsReuse.Geometry.Coordinate shape coordinates ∧
+    after = ⟨before.env, before.writes ++ [(GraphLoopsReuse.Geometry.flatten shape coordinates, value)]⟩
+
+end Merlin.GraphLoopsMemorySCF
diff --git a/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCFBounds.lean b/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCFBounds.lean
new file mode 100644
--- /dev/null
+++ b/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCFBounds.lean
@@ -0,0 +1,45 @@
+/- Signed control and allocation-relative byte safety from the ACTUAL checked
+boundary. These facts do not establish physical base/capacity or scalar fidelity. -/
+import Merlin.GraphLoopsMemorySCFWitness
+
+set_option autoImplicit false
+
+namespace Merlin.GraphLoopsMemorySCF.Model
+
+theorem checked_outer_control {p : Projection} (accepted : check p = true) {boundary : Boundary}
+    (member : boundary ∈ p.boundaries) {outer : Nat} (inside : outer < boundary.segment.bounds.upper) :
+    GraphLoopsSegment.FitsSigned p.reuse.bits outer ∧
+    GraphLoopsSegment.FitsSigned p.reuse.bits (outer + boundary.segment.bounds.step * boundary.segment.bounds.tile) ∧
+    GraphLoopsSegment.FitsSigned p.reuse.bits (min (outer + boundary.segment.bounds.step * boundary.segment.bounds.tile) boundary.segment.bounds.upper) := by
+  have valid := (check_sound accepted).1.2.2.2.1 boundary member
+  have bounds := valid.2.2.2.1.1
+  have bits := valid.2.2.2.2.2.1
+  rw [← bits]
+  exact GraphLoopsSegment.Bounds.outer_control bounds inside
+
+theorem checked_inner_control {p : Projection} (accepted : check p = true) {boundary : Boundary}
+    (member : boundary ∈ p.boundaries) {outer inner : Nat}
+    (inside : inner < min (outer + boundary.segment.bounds.step * boundary.segment.bounds.tile) boundary.segment.bounds.upper) :
+    GraphLoopsSegment.FitsSigned p.reuse.bits inner ∧
+    GraphLoopsSegment.FitsSigned p.reuse.bits (inner + boundary.segment.bounds.step) := by
+  have valid := (check_sound accepted).1.2.2.2.1 boundary member
+  rw [← valid.2.2.2.2.2.1]
+  exact GraphLoopsSegment.Bounds.inner_control valid.2.2.2.1.1 inside
+
+/-- Every admitted initializer store coordinate has a fitting relative byte
+offset. No actual allocator base address or host ABI fact is invented. -/
+theorem checked_initializer_byte_offset {p : Projection} (accepted : check p = true) {boundary : Boundary}
+    (member : boundary ∈ p.boundaries) {coordinates : List Nat}
+    (inside : GraphLoopsReuse.Geometry.Coordinate boundary.config.program.shape coordinates) :
+    GraphLoopsReuse.Geometry.flatten boundary.config.program.shape coordinates *
+      ((GraphLoopsReuse.objectAt p.reuse.objects boundary.config.object).elementBits / 8) < 2 ^ (p.reuse.bits - 1) := by
+  have configValid := ((check_sound accepted).1.2.2.2.1 boundary member).1
+  have objectMember : GraphLoopsReuse.objectAt p.reuse.objects boundary.config.object ∈ p.reuse.objects := by
+    unfold GraphLoopsReuse.objectAt
+    rw [List.getElem?_eq_getElem configValid.1]
+    exact List.mem_of_getElem rfl
+  have objectValid := (check_sound accepted).2.1.2.1 _ objectMember
+  rw [configValid.2.2.1] at inside ⊢
+  exact GraphLoopsReuse.Model.ValidObject.byte_offset objectValid inside
+
+end Merlin.GraphLoopsMemorySCF.Model
diff --git a/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCFComposition.lean b/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCFComposition.lean
new file mode 100644
--- /dev/null
+++ b/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCFComposition.lean
@@ -0,0 +1,193 @@
+/- Whole-program preservation for explicit initializer SCF plus private reuse.
+Unchanged instructions use the sealed old memory semantics. Initializers execute
+actual scoped operations and stores. No whole-program agreement is assumed. -/
+import Merlin.GraphLoopsMemorySCFSimulation
+
+set_option autoImplicit false
+
+namespace Merlin.GraphLoopsMemorySCF
+
+structure Configuration where
+  object : Nat
+  key : String
+  program : Initializer
+  tile : Nat
+  deriving DecidableEq, Repr
+
+def Configuration.Valid (objects : GraphLoopsReuse.Objects) (config : Configuration) : Prop :=
+  config.object < objects.length ∧ config.program.WellFormed ∧
+  config.program.shape = (GraphLoopsReuse.objectAt objects config.object).shape ∧ 0 < config.tile
+
+instance (objects : GraphLoopsReuse.Objects) (config : Configuration) : Decidable (config.Valid objects) :=
+  inferInstanceAs (Decidable (_ ∧ _ ∧ _ ∧ _))
+
+structure Interpretation (Value Public : Type) where
+  pure : PureMeaning Value
+  captures : Public → Env Value
+  retained : GraphLoopsReuse.Primitives Value Public
+
+/-- The old atomic primitive is INDUCED from actual scalar/loop/store execution.
+No initializer key receives an independently postulated whole-result meaning. -/
+def AtomicInitialization {Value Public : Type} (meaning : Interpretation Value Public) (configs : List Configuration)
+    (key : String) (observed : Public) (values : Nat → Value) : Prop :=
+  ∃ config ∈ configs, config.key = key ∧ ∃ writes,
+    Run meaning.pure config.program config.tile false (meaning.captures observed) writes ∧
+    ∀ cells index, index < GraphLoopsReuse.Geometry.volume config.program.shape →
+      applyWrites writes cells index = some (values index)
+
+def inducedPrimitives {Value Public : Type} (meaning : Interpretation Value Public) (configs : List Configuration) :
+    GraphLoopsReuse.Primitives Value Public :=
+  { meaning.retained with initialization := AtomicInitialization meaning configs }
+
+theorem initialization_induced {Value Public : Type} (meaning : Interpretation Value Public) (configs : List Configuration)
+    {config : Configuration} (member : config ∈ configs) (valid : config.program.WellFormed)
+    {observed : Public} {writes : Log Value}
+    (run : Run meaning.pure config.program config.tile false (meaning.captures observed) writes) :
+    ∃ values, (inducedPrimitives meaning configs).initialization config.key observed values := by
+  obtain ⟨values, initialized⟩ := run.materializes valid
+  exact ⟨values, config, member, rfl, writes, run, initialized⟩
+
+def NonInitializer : GraphLoopsReuse.Instruction → Prop
+  | .initialize _ _ => False
+  | _ => True
+
+/-- Allocation, public effects, private accesses and release retain precisely the
+old semantics. No allocator-failure or pointer-identity observation is added. -/
+inductive Step {Value Public : Type} (objects : GraphLoopsReuse.Objects) (configs : List Configuration)
+    (meaning : Interpretation Value Public) (candidate segmented : Bool) :
+    GraphLoopsReuse.Instruction → GraphLoopsReuse.Memory Value Public → GraphLoopsReuse.Memory Value Public → Prop where
+  | ordinary {instruction : GraphLoopsReuse.Instruction} {before after : GraphLoopsReuse.Memory Value Public}
+      (ordinary : NonInitializer instruction)
+      (run : GraphLoopsReuse.Step objects (inducedPrimitives meaning configs) candidate instruction before after) :
+      Step objects configs meaning candidate segmented instruction before after
+  | initialized {config : Configuration} (member : config ∈ configs) (before : GraphLoopsReuse.Memory Value Public)
+      {after : Heap Value}
+      (run : HeapRun meaning.pure config.program config.tile (GraphLoopsReuse.addressOf objects candidate config.object)
+        segmented (meaning.captures before.observed) before.heap after) :
+      Step objects configs meaning candidate segmented (.initialize config.object config.key) before ⟨before.observed, after⟩
+
+theorem step_forward {Value Public : Type} {objects : GraphLoopsReuse.Objects} {configs : List Configuration}
+    {meaning : Interpretation Value Public} {sourceMode targetMode : Bool} {status : GraphLoopsReuse.Status}
+    {instruction : GraphLoopsReuse.Instruction} {source target after : GraphLoopsReuse.Memory Value Public}
+    (valid : ∀ config ∈ configs, config.Valid objects)
+    (admitted : GraphLoopsReuse.Admitted objects status instruction)
+    (related : GraphLoopsReuse.Related (GraphLoopsReuse.slotOf objects) (GraphLoopsReuse.extentOf objects) status.ready source target)
+    (run : Step objects configs meaning false sourceMode instruction source after) :
+    ∃ next, Step objects configs meaning true targetMode instruction target next ∧
+      GraphLoopsReuse.Related (GraphLoopsReuse.slotOf objects) (GraphLoopsReuse.extentOf objects)
+        (GraphLoopsReuse.next objects status instruction).ready after next := by
+  cases run with
+  | ordinary ordinary run =>
+    obtain ⟨next, translated, relatedNext⟩ := GraphLoopsReuse.step_forward admitted related run
+    exact ⟨next, .ordinary ordinary translated, relatedNext⟩
+  | @initialized config member before after run =>
+    have configValid := valid config member
+    obtain ⟨writes, logRun, rfl⟩ := (heap_run_iff_log_mode _ _ _ _ _ _ _ _ configValid.2.1 configValid.2.2.2).mp run
+    have targetLog : Run meaning.pure config.program config.tile false (meaning.captures target.observed) writes :=
+      related.1 ▸ logRun
+    have targetRun := (heap_run_iff_log_mode meaning.pure config.program config.tile (GraphLoopsReuse.slotOf objects config.object)
+      targetMode (meaning.captures target.observed) target.heap _ configValid.2.1 configValid.2.2.2).mpr ⟨writes, targetLog, rfl⟩
+    refine ⟨⟨target.observed, _⟩, .initialized member target targetRun, ?_⟩
+    exact related_initialize_logs related admitted.initialize_separate configValid.2.1 configValid.2.2.1 logRun
+
+theorem step_backward {Value Public : Type} {objects : GraphLoopsReuse.Objects} {configs : List Configuration}
+    {meaning : Interpretation Value Public} {sourceMode targetMode : Bool} {status : GraphLoopsReuse.Status}
+    {instruction : GraphLoopsReuse.Instruction} {source target after : GraphLoopsReuse.Memory Value Public}
+    (valid : ∀ config ∈ configs, config.Valid objects)
+    (admitted : GraphLoopsReuse.Admitted objects status instruction)
+    (related : GraphLoopsReuse.Related (GraphLoopsReuse.slotOf objects) (GraphLoopsReuse.extentOf objects) status.ready source target)
+    (run : Step objects configs meaning true targetMode instruction target after) :
+    ∃ next, Step objects configs meaning false sourceMode instruction source next ∧
+      GraphLoopsReuse.Related (GraphLoopsReuse.slotOf objects) (GraphLoopsReuse.extentOf objects)
+        (GraphLoopsReuse.next objects status instruction).ready next after := by
+  cases run with
+  | ordinary ordinary run =>
+    obtain ⟨next, translated, relatedNext⟩ := GraphLoopsReuse.step_backward admitted related run
+    exact ⟨next, .ordinary ordinary translated, relatedNext⟩
+  | @initialized config member before after run =>
+    have configValid := valid config member
+    obtain ⟨writes, logRun, rfl⟩ := (heap_run_iff_log_mode _ _ _ _ _ _ _ _ configValid.2.1 configValid.2.2.2).mp run
+    have sourceLog : Run meaning.pure config.program config.tile false (meaning.captures source.observed) writes :=
+      related.1.symm ▸ logRun
+    have sourceRun := (heap_run_iff_log_mode meaning.pure config.program config.tile config.object
+      sourceMode (meaning.captures source.observed) source.heap _ configValid.2.1 configValid.2.2.2).mpr ⟨writes, sourceLog, rfl⟩
+    refine ⟨⟨source.observed, _⟩, .initialized member source sourceRun, ?_⟩
+    exact related_initialize_logs related admitted.initialize_separate configValid.2.1 configValid.2.2.1 sourceLog
+
+inductive Execution {Value Public : Type} (objects : GraphLoopsReuse.Objects) (configs : List Configuration)
+    (meaning : Interpretation Value Public) (candidate segmented : Bool) :
+    List GraphLoopsReuse.Instruction → GraphLoopsReuse.Memory Value Public → GraphLoopsReuse.Memory Value Public → Prop where
+  | done (before : GraphLoopsReuse.Memory Value Public) : Execution objects configs meaning candidate segmented [] before before
+  | more {instruction : GraphLoopsReuse.Instruction} {rest : List GraphLoopsReuse.Instruction}
+      {before middle after : GraphLoopsReuse.Memory Value Public}
+      (first : Step objects configs meaning candidate segmented instruction before middle)
+      (remaining : Execution objects configs meaning candidate segmented rest middle after) :
+      Execution objects configs meaning candidate segmented (instruction :: rest) before after
+
+theorem execution_forward {Value Public : Type} {objects : GraphLoopsReuse.Objects} {configs : List Configuration}
+    {meaning : Interpretation Value Public} {sourceMode targetMode : Bool} {status : GraphLoopsReuse.Status}
+    {instructions : List GraphLoopsReuse.Instruction} (valid : ∀ config ∈ configs, config.Valid objects)
+    (safe : GraphLoopsReuse.Safe objects status instructions) :
+    ∀ source target after, GraphLoopsReuse.Related (GraphLoopsReuse.slotOf objects) (GraphLoopsReuse.extentOf objects) status.ready source target →
+      Execution objects configs meaning false sourceMode instructions source after →
+      ∃ next, Execution objects configs meaning true targetMode instructions target next ∧ after.observed = next.observed := by
+  induction safe with
+  | done =>
+    intro source target after related run
+    cases run
+    exact ⟨target, .done target, related.1⟩
+  | step admitted remaining induction =>
+    intro source target after related run
+    cases run with
+    | more first suffix =>
+      obtain ⟨middle, translated, same⟩ := step_forward valid admitted related first
+      obtain ⟨next, translatedRest, observed⟩ := induction _ middle _ same suffix
+      exact ⟨next, .more translated translatedRest, observed⟩
+
+theorem execution_backward {Value Public : Type} {objects : GraphLoopsReuse.Objects} {configs : List Configuration}
+    {meaning : Interpretation Value Public} {sourceMode targetMode : Bool} {status : GraphLoopsReuse.Status}
+    {instructions : List GraphLoopsReuse.Instruction} (valid : ∀ config ∈ configs, config.Valid objects)
+    (safe : GraphLoopsReuse.Safe objects status instructions) :
+    ∀ source target after, GraphLoopsReuse.Related (GraphLoopsReuse.slotOf objects) (GraphLoopsReuse.extentOf objects) status.ready source target →
+      Execution objects configs meaning true targetMode instructions target after →
+      ∃ next, Execution objects configs meaning false sourceMode instructions source next ∧ next.observed = after.observed := by
+  induction safe with
+  | done =>
+    intro source target after related run
+    cases run
+    exact ⟨source, .done source, related.1⟩
+  | step admitted remaining induction =>
+    intro source target after related run
+    cases run with
+    | more first suffix =>
+      obtain ⟨middle, translated, same⟩ := step_backward valid admitted related first
+      obtain ⟨next, translatedRest, observed⟩ := induction middle _ _ same suffix
+      exact ⟨next, .more translated translatedRest, observed⟩
+
+def outcomes {Value Public : Type} (objects : GraphLoopsReuse.Objects) (configs : List Configuration)
+    (meaning : Interpretation Value Public) (candidate segmented : Bool) (instructions : List GraphLoopsReuse.Instruction)
+    (before : GraphLoopsReuse.Memory Value Public) (outcome : Public) : Prop :=
+  ∃ after, Execution objects configs meaning candidate segmented instructions before after ∧ after.observed = outcome
+
+/-- ALL possible COMPLETE public outcomes for the entire logical sequence,
+including arbitrarily many changed initializers and retained observers. Does not
+identify categorized failures/divergence or infer primitive/allocator totality. -/
+theorem checked_complete_observations {Value Public : Type} (objects : GraphLoopsReuse.Objects) (configs : List Configuration)
+    (instructions : List GraphLoopsReuse.Instruction) (valid : ∀ config ∈ configs, config.Valid objects)
+    (accepted : GraphLoopsReuse.checkProgram objects GraphLoopsReuse.emptyStatus instructions = true)
+    (meaning : Interpretation Value Public) (sourceMode targetMode : Bool)
+    (source target : GraphLoopsReuse.Memory Value Public) (same : source.observed = target.observed) (outcome : Public) :
+    outcomes objects configs meaning false sourceMode instructions source outcome ↔
+      outcomes objects configs meaning true targetMode instructions target outcome := by
+  have safe := GraphLoopsReuse.checkProgram_sound objects instructions _ accepted
+  have related : GraphLoopsReuse.Related (GraphLoopsReuse.slotOf objects) (GraphLoopsReuse.extentOf objects)
+      GraphLoopsReuse.emptyStatus.ready source target := ⟨same, by simp [GraphLoopsReuse.emptyStatus]⟩
+  constructor
+  · rintro ⟨after, run, observed⟩
+    obtain ⟨next, translated, equal⟩ := execution_forward valid safe source target after related run
+    exact ⟨next, translated, equal.symm.trans observed⟩
+  · rintro ⟨after, run, observed⟩
+    obtain ⟨next, translated, equal⟩ := execution_backward valid safe source target after related run
+    exact ⟨next, translated, equal.trans observed⟩
+
+end Merlin.GraphLoopsMemorySCF
diff --git a/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCFCoverage.lean b/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCFCoverage.lean
new file mode 100644
--- /dev/null
+++ b/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCFCoverage.lean
@@ -0,0 +1,92 @@
+/- Complete cell coverage DERIVED from ordered partial loop/store executions.
+No successful execution is assumed to exist; no tensor-sized proof is generated. -/
+import Merlin.GraphLoopsMemorySCFLoops
+
+set_option autoImplicit false
+
+namespace Merlin.GraphLoopsMemorySCF
+
+namespace Repeat
+
+theorem monotone {Value : Type} {body : Nat → Log Value → Log Value → Prop}
+    (preserve : ∀ index before after, body index before after → ∀ event ∈ before, event ∈ after)
+    {count lower : Nat} {before after : Log Value} {trace : List Nat}
+    (run : GraphLoopsUnroll.Repeat body 1 count lower before trace after) : ∀ event ∈ before, event ∈ after := by
+  induction run with
+  | nil => exact fun _ member => member
+  | cons event remaining induction => exact fun write member => induction write (preserve _ _ _ event write member)
+
+theorem covers {Value : Type} {body : Nat → Log Value → Log Value → Prop} (address : Nat → Nat)
+    (preserve : ∀ index before after, body index before after → ∀ event ∈ before, event ∈ after)
+    (emits : ∀ index before after, body index before after → ∃ value, (address index, value) ∈ after)
+    {count lower : Nat} {before after : Log Value} {trace : List Nat}
+    (run : GraphLoopsUnroll.Repeat body 1 count lower before trace after) :
+    ∀ index, lower ≤ index → index < lower + count → ∃ value, (address index, value) ∈ after := by
+  induction run with
+  | nil => intro index start finish; omega
+  | @cons count lower before middle after rest event remaining induction =>
+    intro index start finish
+    by_cases first : index = lower
+    · subst index
+      obtain ⟨value, member⟩ := emits lower before middle event
+      exact ⟨value, monotone preserve remaining _ member⟩
+    · exact induction index (by omega) (by omega)
+
+end Repeat
+
+theorem SCF_covers {Value : Type} {body : Nat → Log Value → Log Value → Prop} (address : Nat → Nat)
+    (preserve : ∀ index before after, body index before after → ∀ event ∈ before, event ∈ after)
+    (emits : ∀ index before after, body index before after → ∃ value, (address index, value) ∈ after)
+    {extent : Nat} {before after : Log Value} {trace : List Nat}
+    (run : GraphLoopsSegment.Execution body extent 1 0 before trace after) :
+    ∀ index, index < extent → ∃ value, (address index, value) ∈ after := by
+  have correct : GraphLoopsUnroll.CountCorrect 0 extent 1 extent := by
+    simpa only [Nat.one_mul, Nat.zero_add] using GraphLoopsUnroll.CountCorrect.aligned 0 1 extent (by decide)
+  have repeated := (GraphLoopsUnroll.repeat_iff_execution body extent 1 extent 0 before after trace correct).mpr run
+  exact fun index inside => Repeat.covers address preserve emits repeated index (Nat.zero_le _) (by omega)
+
+theorem LeafBody.emits_one {Value : Type} {meaning : PureMeaning Value} {leaf : Leaf} {extent iv index : Nat}
+    {captures : Env Value} {before after : Log Value} (run : LeafBody meaning leaf [extent] iv captures index before after)
+    (indices : leaf.indices = [iv]) (noShadow : ∀ name ∈ leaf.indices, name ∉ definitions leaf.ops) :
+    ∃ value, (index, value) ∈ after := by
+  obtain ⟨emitted, stored, rfl⟩ := run
+  have binding : read (put captures iv (.index index)) leaf.indices = some ([index].map Datum.index) := by
+    simp [indices, read, put]
+  obtain ⟨value, _scope, equal⟩ := stored.address noShadow binding
+  refine ⟨value, ?_⟩
+  rw [equal]
+  have member := List.mem_append_right before
+    (List.mem_cons_self (a := (index, value)) (l := []))
+  simpa only [GraphLoopsReuse.Geometry.flatten, GraphLoopsReuse.Geometry.volume, Nat.mul_one, Nat.add_zero] using member
+
+theorem LeafBody.emits_two {Value : Type} {meaning : PureMeaning Value} {leaf : Leaf}
+    {rows columns outerIV innerIV row column : Nat} {captures : Env Value} {before after : Log Value}
+    (run : LeafBody meaning leaf [rows, columns] innerIV captures column before after)
+    (indices : leaf.indices = [outerIV, innerIV]) (different : outerIV ≠ innerIV)
+    (outerBinding : captures outerIV = some (.index row))
+    (noShadow : ∀ name ∈ leaf.indices, name ∉ definitions leaf.ops) :
+    ∃ value, (row * columns + column, value) ∈ after := by
+  obtain ⟨emitted, stored, rfl⟩ := run
+  have binding : read (put captures innerIV (.index column)) leaf.indices = some ([row, column].map Datum.index) := by
+    simp [indices, read, put, different, outerBinding]
+  obtain ⟨value, _scope, equal⟩ := stored.address noShadow binding
+  refine ⟨value, ?_⟩
+  rw [equal]
+  exact List.mem_append_right _ (by
+    simpa only [GraphLoopsReuse.Geometry.flatten, GraphLoopsReuse.Geometry.volume, Nat.mul_one, Nat.add_zero] using
+      List.mem_cons_self (a := (row * columns + column, value)) (l := []))
+
+theorem NestedBody.emits_row {Value : Type} {meaning : PureMeaning Value} {ops : List PureOp} {leaf : Leaf}
+    {rows columns outerIV innerIV row : Nat} {captures : Env Value} {before after : Log Value}
+    (run : NestedBody meaning ops leaf rows columns outerIV innerIV captures row before after)
+    (indices : leaf.indices = [outerIV, innerIV]) (different : outerIV ≠ innerIV)
+    (outerFresh : outerIV ∉ definitions ops) (leafFresh : ∀ name ∈ leaf.indices, name ∉ definitions leaf.ops) :
+    ∀ column, column < columns → ∃ value, (row * columns + column, value) ∈ after := by
+  obtain ⟨rowEnv, trace, evaluated, innerRun⟩ := run
+  have rowBinding : rowEnv outerIV = some (.index row) :=
+    (evaluated.frame outerFresh).trans (put_at captures outerIV (.index row))
+  exact SCF_covers (fun column => row * columns + column)
+    (fun _ _ _ leafRun => LeafBody.monotone leafRun)
+    (fun _ _ _ leafRun => LeafBody.emits_two leafRun indices different rowBinding leafFresh) innerRun
+
+end Merlin.GraphLoopsMemorySCF
diff --git a/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCFEffects.lean b/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCFEffects.lean
new file mode 100644
--- /dev/null
+++ b/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCFEffects.lean
@@ -0,0 +1,113 @@
+/- Compositional meaning of private store logs. Ordered writes are applied one
+at a time; public state and other objects are framed. Values are derived from
+successful complete loop executions, not an admitted initializer summary. -/
+import Merlin.GraphLoopsMemorySCFRect
+
+set_option autoImplicit false
+
+namespace Merlin.GraphLoopsMemorySCF
+
+abbrev Cells (Value : Type) := GraphLoopsReuse.Cells Value
+abbrev Heap (Value : Type) := GraphLoopsReuse.Heap Value
+
+def writeCell {Value : Type} (cells : Cells Value) (event : Write Value) : Cells Value :=
+  fun index => if index = event.1 then some event.2 else cells index
+
+def applyWrites {Value : Type} (writes : Log Value) (cells : Cells Value) : Cells Value :=
+  writes.foldl writeCell cells
+
+def applyHeapWrites {Value : Type} (object : Nat) (writes : Log Value) (heap : Heap Value) : Heap Value :=
+  writes.foldl (fun before event => GraphLoopsReuse.replaceCell before object event.1 event.2) heap
+
+theorem applyWrites_append {Value : Type} (first second : Log Value) (cells : Cells Value) :
+    applyWrites (first ++ second) cells = applyWrites second (applyWrites first cells) := by
+  exact List.foldl_append
+
+theorem applyHeapWrites_append {Value : Type} (object : Nat) (first second : Log Value) (heap : Heap Value) :
+    applyHeapWrites object (first ++ second) heap = applyHeapWrites object second (applyHeapWrites object first heap) := by
+  exact List.foldl_append
+
+theorem applyWrites_agree {Value : Type} (writes : Log Value) (first second : Cells Value) (index : Nat)
+    (agree : first index = second index) : applyWrites writes first index = applyWrites writes second index := by
+  induction writes generalizing first second with
+  | nil => exact agree
+  | cons event rest induction =>
+    apply induction
+    unfold writeCell
+    split
+    · rfl
+    · exact agree
+
+theorem applyWrites_some {Value : Type} (writes : Log Value) (cells : Cells Value) (index : Nat)
+    (initialized : ∃ value, cells index = some value) : ∃ value, applyWrites writes cells index = some value := by
+  induction writes generalizing cells with
+  | nil => exact initialized
+  | cons event rest induction =>
+    apply induction
+    by_cases equal : index = event.1
+    · exact ⟨event.2, ite_eq_left equal⟩
+    · obtain ⟨value, cell⟩ := initialized
+      exact ⟨value, (ite_eq_right equal).trans cell⟩
+
+theorem applyWrites_written {Value : Type} (writes : Log Value) (cells : Cells Value) {index : Nat}
+    (written : ∃ value, (index, value) ∈ writes) : ∃ value, applyWrites writes cells index = some value := by
+  induction writes generalizing cells with
+  | nil => obtain ⟨_value, member⟩ := written; cases member
+  | cons event rest induction =>
+    obtain ⟨value, member⟩ := written
+    rcases List.mem_cons.mp member with equal | later
+    · subst event
+      exact applyWrites_some rest (writeCell cells (index, value)) index ⟨value, by simp only [writeCell, ↓reduceIte]⟩
+    · exact induction _ ⟨value, later⟩
+
+theorem applyWrites_independent {Value : Type} (writes : Log Value) (first second : Cells Value) {index : Nat}
+    (written : ∃ value, (index, value) ∈ writes) : applyWrites writes first index = applyWrites writes second index := by
+  induction writes generalizing first second with
+  | nil => obtain ⟨_value, member⟩ := written; cases member
+  | cons event rest induction =>
+    obtain ⟨value, member⟩ := written
+    rcases List.mem_cons.mp member with equal | later
+    · subst event
+      exact applyWrites_agree rest _ _ index (by simp only [writeCell, ↓reduceIte])
+    · exact induction _ _ ⟨value, later⟩
+
+theorem applyHeapWrites_at {Value : Type} (object : Nat) (writes : Log Value) (heap : Heap Value) (index : Nat) :
+    applyHeapWrites object writes heap object index = applyWrites writes (heap object) index := by
+  induction writes generalizing heap with
+  | nil => rfl
+  | cons event rest induction =>
+    change applyHeapWrites object rest (GraphLoopsReuse.replaceCell heap object event.1 event.2) object index =
+      applyWrites rest (writeCell (heap object) event) index
+    rw [induction]
+    have objectCell : GraphLoopsReuse.replaceCell heap object event.1 event.2 object = writeCell (heap object) event := by
+      funext other
+      simp only [GraphLoopsReuse.replaceCell, GraphLoopsReuse.replaceObject, writeCell, ↓reduceIte]
+    rw [objectCell]
+
+theorem applyHeapWrites_other {Value : Type} (object other : Nat) (writes : Log Value) (heap : Heap Value)
+    (different : other ≠ object) : applyHeapWrites object writes heap other = heap other := by
+  induction writes generalizing heap with
+  | nil => rfl
+  | cons event rest induction =>
+    exact (induction _).trans (ite_eq_right different)
+
+/-- Every successful complete run induces scalar values for ALL valid cells,
+independently of arbitrary prior/stale contents. Choice is derived from writes. -/
+theorem Run.materializes {Value : Type} {meaning : PureMeaning Value} {program : Initializer} {tile : Nat}
+    (valid : program.WellFormed) {captures : Env Value} {writes : Log Value}
+    (run : Run meaning program tile false captures writes) :
+    ∃ values : Nat → Value, ∀ cells index, index < GraphLoopsReuse.Geometry.volume program.shape →
+      applyWrites writes cells index = some (values index) := by
+  have coverage := run.covers valid
+  have initialized : ∀ index, index < GraphLoopsReuse.Geometry.volume program.shape →
+      ∃ value, applyWrites writes (fun _ => none) index = some value :=
+    fun index inside => applyWrites_written writes (fun _ => none) (coverage index inside)
+  obtain ⟨first, _firstInitialized⟩ := initialized 0 (Initializer.positive_volume valid)
+  let values : Nat → Value := fun index => if inside : index < GraphLoopsReuse.Geometry.volume program.shape then
+    Classical.choose (initialized index inside) else first
+  refine ⟨values, ?_⟩
+  intro cells index inside
+  rw [applyWrites_independent writes cells (fun _ => none) (coverage index inside)]
+  exact (by simpa only [values, dite_eq_left inside] using Classical.choose_spec (initialized index inside))
+
+end Merlin.GraphLoopsMemorySCF
diff --git a/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCFLoops.lean b/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCFLoops.lean
new file mode 100644
--- /dev/null
+++ b/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCFLoops.lean
@@ -0,0 +1,68 @@
+/- Actual nested initializer semantics in the old partial SCF relation.
+No iter_args are admitted here: SSA captures are lexical inputs and temporary
+pure results never escape a body. The carried state is the complete ordered
+store log; its compositional heap interpretation is proved separately. -/
+import Merlin.GraphLoopsMemorySCFScope
+
+set_option autoImplicit false
+
+namespace Merlin.GraphLoopsMemorySCF
+
+def LeafBody {Value : Type} (meaning : PureMeaning Value) (leaf : Leaf) (shape : List Nat) (iv : Nat)
+    (captures : Env Value) (index : Nat) (before after : Log Value) : Prop :=
+  ∃ emitted, Emit meaning leaf shape ⟨put captures iv (.index index), before⟩ emitted ∧ after = emitted.writes
+
+def NestedBody {Value : Type} (meaning : PureMeaning Value) (ops : List PureOp) (leaf : Leaf)
+    (rows columns outerIV innerIV : Nat) (captures : Env Value) (row : Nat) (before after : Log Value) : Prop :=
+  ∃ rowEnv trace, EvalPure meaning ops (put captures outerIV (.index row)) rowEnv ∧
+    GraphLoopsSegment.Execution (LeafBody meaning leaf [rows, columns] innerIV rowEnv) columns 1 0 before trace after
+
+def Body {Value : Type} (meaning : PureMeaning Value) (program : Initializer) (captures : Env Value) :
+    Nat → Log Value → Log Value → Prop :=
+  match program.shape, program.ivs with
+  | [extent], [iv] => LeafBody meaning program.leaf [extent] iv captures
+  | [rows, columns], [outerIV, innerIV] => NestedBody meaning program.outerPrefix program.leaf rows columns outerIV innerIV captures
+  | _, _ => fun _ _ _ => False
+
+/-- Mode false is source SCF; true is exactly the generated outer/chunk loops.
+Every rank2 original body is itself a partial inner SCF execution. -/
+def Run {Value : Type} (meaning : PureMeaning Value) (program : Initializer) (tile : Nat) (segmented : Bool)
+    (captures : Env Value) (writes : Log Value) : Prop :=
+  ∃ trace, if segmented then GraphLoopsSegment.Segmented (Body meaning program captures) (program.shape.headD 0) 1 tile 0
+    [] trace writes else GraphLoopsSegment.Execution (Body meaning program captures) (program.shape.headD 0) 1 0 [] trace writes
+
+theorem LeafBody.monotone {Value : Type} {meaning : PureMeaning Value} {leaf : Leaf} {shape : List Nat} {iv index : Nat}
+    {captures : Env Value} {before after : Log Value} (run : LeafBody meaning leaf shape iv captures index before after) :
+    ∀ event ∈ before, event ∈ after := by
+  obtain ⟨emitted, stored, rfl⟩ := run
+  exact stored.monotone
+
+theorem SCF_monotone {Value : Type} {body : Nat → Log Value → Log Value → Prop} {upper step lower : Nat}
+    (monotone : ∀ index before after, body index before after → ∀ event ∈ before, event ∈ after)
+    {before after : Log Value} {trace : List Nat}
+    (run : GraphLoopsSegment.Execution body upper step lower before trace after) :
+    ∀ event ∈ before, event ∈ after := by
+  induction run with
+  | done => exact fun _ member => member
+  | more _ event _ induction => exact fun write member => induction write (monotone _ _ _ event write member)
+
+theorem NestedBody.monotone {Value : Type} {meaning : PureMeaning Value} {ops : List PureOp} {leaf : Leaf}
+    {rows columns outerIV innerIV row : Nat} {captures : Env Value} {before after : Log Value}
+    (run : NestedBody meaning ops leaf rows columns outerIV innerIV captures row before after) :
+    ∀ event ∈ before, event ∈ after := by
+  obtain ⟨_env, _trace, _prefixEval, innerRun⟩ := run
+  exact SCF_monotone (fun _ _ _ leafRun => LeafBody.monotone leafRun) innerRun
+
+/-- Exact possible complete logs, including nested pure choices and EVERY store.
+The same lexical captures/partial operation meaning is used on both sides. -/
+theorem segmentation_exact_logs {Value : Type} (meaning : PureMeaning Value) (program : Initializer)
+    (tile : Nat) (positive : 0 < tile) (captures : Env Value) (writes : Log Value) :
+    Run meaning program tile false captures writes ↔ Run meaning program tile true captures writes := by
+  unfold Run
+  simp only [Bool.false_eq_true, ↓reduceIte]
+  apply exists_congr
+  intro trace
+  exact GraphLoopsSegment.complete_trace_iff (Body meaning program captures)
+    (program.shape.headD 0) 1 tile 0 (by decide) positive [] writes trace
+
+end Merlin.GraphLoopsMemorySCF
diff --git a/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCFModel.lean b/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCFModel.lean
new file mode 100644
--- /dev/null
+++ b/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCFModel.lean
@@ -0,0 +1,105 @@
+/- Recomputed finite facts for complete actual reuse→nested segmentation.
+Python supplies full parsed trees and scoped correspondence. Acceptance checks
+all registry/control links; operational correctness is the existing new root. -/
+import Merlin.GraphLoopsMemorySCFModes
+import Merlin.GraphLoopsSegmentModel
+
+set_option autoImplicit false
+
+namespace Merlin.GraphLoopsMemorySCF.Model
+
+structure Boundary where
+  config : Configuration
+  segment : GraphLoopsSegment.Model.Projection
+  sourceInitializer : String
+  middleInitializer : String
+  segmentationSourceInitializer : String
+  deriving DecidableEq, Repr
+
+structure Projection where
+  reuse : GraphLoopsReuse.Model.Projection
+  boundaries : List Boundary
+  reuseMiddle : String
+  segmentationMiddle : String
+  deriving DecidableEq, Repr
+
+def configs (p : Projection) : List Configuration := p.boundaries.map Boundary.config
+
+def Boundary.Valid (reuse : GraphLoopsReuse.Model.Projection) (boundary : Boundary) : Prop :=
+  boundary.config.Valid reuse.objects ∧
+  boundary.sourceInitializer = boundary.config.key ∧
+  boundary.middleInitializer = boundary.segmentationSourceInitializer ∧
+  GraphLoopsSegment.Model.Numeric boundary.segment ∧ GraphLoopsSegment.Model.Structural boundary.segment ∧
+  boundary.segment.bounds.bits = reuse.bits ∧ boundary.segment.bounds.lower = 0 ∧ boundary.segment.bounds.step = 1 ∧
+  boundary.segment.bounds.upper = boundary.config.program.rows ∧ boundary.segment.bounds.tile = boundary.config.tile ∧
+  ∃ init ∈ reuse.initializers, init.object = boundary.config.object ∧ init.sourceBody = boundary.config.key ∧
+    init.ivs = boundary.config.program.ivs ∧ init.indices = boundary.config.program.leaf.indices
+
+instance (reuse : GraphLoopsReuse.Model.Projection) (boundary : Boundary) : Decidable (boundary.Valid reuse) :=
+  inferInstanceAs (Decidable (_ ∧ _ ∧ _ ∧ _ ∧ _ ∧ _ ∧ _ ∧ _ ∧ _ ∧ _ ∧ _))
+
+def Bound (p : Projection) : GraphLoopsReuse.Instruction → Prop
+  | .initialize object key => ∃ config ∈ configs p, config.object = object ∧ config.key = key
+  | _ => True
+
+instance (p : Projection) (instruction : GraphLoopsReuse.Instruction) : Decidable (Bound p instruction) := by
+  cases instruction <;> unfold Bound <;> infer_instance
+
+def Valid (p : Projection) : Prop :=
+  p.boundaries ≠ [] ∧ p.reuseMiddle = p.segmentationMiddle ∧
+  p.boundaries.length = p.reuse.initializers.length ∧
+  (∀ boundary ∈ p.boundaries, boundary.Valid p.reuse) ∧
+  (∀ instruction ∈ p.reuse.instructions, Bound p instruction) ∧
+  ∀ first ∈ configs p, ∀ second ∈ configs p, first.key = second.key → first = second
+
+instance (p : Projection) : Decidable (Valid p) :=
+  inferInstanceAs (Decidable (_ ∧ _ ∧ _ ∧ _ ∧ _ ∧ _))
+
+def check (p : Projection) : Bool := decide (Valid p) && GraphLoopsReuse.Model.check p.reuse
+
+theorem check_sound {p : Projection} (accepted : check p = true) :
+    Valid p ∧ GraphLoopsReuse.Model.Valid p.reuse ∧ GraphLoopsReuse.Safe p.reuse.objects GraphLoopsReuse.emptyStatus p.reuse.instructions := by
+  obtain ⟨valid, checked⟩ := Bool.and_eq_true_iff.mp accepted
+  exact ⟨of_decide_eq_true valid, GraphLoopsReuse.Model.check_sound checked⟩
+
+theorem checked_configs {p : Projection} (accepted : check p = true) :
+    ∀ config ∈ configs p, config.Valid p.reuse.objects := by
+  intro config member
+  obtain ⟨boundary, boundaryMember, rfl⟩ := List.mem_map.mp member
+  exact ((check_sound accepted).1.2.2.2.1 boundary boundaryMember).1
+
+/-- Source, exact middle and final all use the SAME operational interpretation.
+Multiple changed boundaries compose by instruction-list congruence. -/
+theorem checked_chain {p : Projection} (accepted : check p = true) {Value Public : Type}
+    (meaning : Interpretation Value Public) (source middle : GraphLoopsReuse.Memory Value Public)
+    (same : source.observed = middle.observed) (outcome : Public) :
+    (outcomes p.reuse.objects (configs p) meaning false false p.reuse.instructions source outcome ↔
+      outcomes p.reuse.objects (configs p) meaning true false p.reuse.instructions middle outcome) ∧
+    (outcomes p.reuse.objects (configs p) meaning true false p.reuse.instructions middle outcome ↔
+      outcomes p.reuse.objects (configs p) meaning true true p.reuse.instructions middle outcome) ∧
+    (outcomes p.reuse.objects (configs p) meaning false false p.reuse.instructions source outcome ↔
+      outcomes p.reuse.objects (configs p) meaning true true p.reuse.instructions middle outcome) := by
+  have safe := (Bool.and_eq_true_iff.mp (Bool.and_eq_true_iff.mp accepted).2).2
+  exact checked_reuse_then_segment p.reuse.objects (configs p) p.reuse.instructions (checked_configs accepted) safe meaning source middle same outcome
+
+theorem checked_complete {p : Projection} (accepted : check p = true) {Value Public : Type}
+    (meaning : Interpretation Value Public) (source middle : GraphLoopsReuse.Memory Value Public)
+    (same : source.observed = middle.observed) (outcome : Public) :
+    outcomes p.reuse.objects (configs p) meaning false false p.reuse.instructions source outcome ↔
+      outcomes p.reuse.objects (configs p) meaning true true p.reuse.instructions middle outcome :=
+  (checked_chain accepted meaning source middle same outcome).2.2
+
+/-- Arbitrary common callers may observe the complete public outcome set.
+The mapping from actual unchanged functions/callers is trusted full-tree Python. -/
+theorem checked_context {p : Projection} (accepted : check p = true) {Value Public Outcome : Type}
+    (meaning : Interpretation Value Public) (source middle : GraphLoopsReuse.Memory Value Public)
+    (same : source.observed = middle.observed) (context : (Public → Prop) → Outcome) :
+    context (outcomes p.reuse.objects (configs p) meaning false false p.reuse.instructions source) =
+      context (outcomes p.reuse.objects (configs p) meaning true true p.reuse.instructions middle) := by
+  have equal : outcomes p.reuse.objects (configs p) meaning false false p.reuse.instructions source =
+      outcomes p.reuse.objects (configs p) meaning true true p.reuse.instructions middle := by
+    funext outcome
+    exact propext (checked_complete accepted meaning source middle same outcome)
+  rw [equal]
+
+end Merlin.GraphLoopsMemorySCF.Model
diff --git a/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCFModes.lean b/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCFModes.lean
new file mode 100644
--- /dev/null
+++ b/src/merlin/verify/lean/Merlin/GraphLoopsMemorySCFModes.lean
@@ -0,0 +1,73 @@
+/- Exact-middle composition inside ONE operational memory/SSA interpretation.
+Segmentation preserves the complete terminal memory, not just public outcomes.
+The reuse edge separately relates allocation-changing worlds. -/
+import Merlin.GraphLoopsMemorySCFComposition
+
+set_option autoImplicit false
+
+namespace Merlin.GraphLoopsMemorySCF
+
+theorem step_modes {Value Public : Type} {objects : GraphLoopsReuse.Objects} {configs : List Configuration}
+    {meaning : Interpretation Value Public} {candidate sourceMode targetMode : Bool}
+    {instruction : GraphLoopsReuse.Instruction} {before after : GraphLoopsReuse.Memory Value Public}
+    (valid : ∀ config ∈ configs, config.Valid objects)
+    (run : Step objects configs meaning candidate sourceMode instruction before after) :
+    Step objects configs meaning candidate targetMode instruction before after := by
+  cases run with
+  | ordinary ordinary run => exact .ordinary ordinary run
+  | @initialized config member before after run =>
+    have configValid := valid config member
+    have log := (heap_run_iff_log_mode _ _ _ _ _ _ _ _ configValid.2.1 configValid.2.2.2).mp run
+    exact .initialized member before ((heap_run_iff_log_mode _ _ _ _ _ _ _ _ configValid.2.1 configValid.2.2.2).mpr log)
+
+/-- Whole-list congruence applies to ANY number of changed initializers, with
+identical surrounding observers, effects, allocations and releases. -/
+theorem execution_modes {Value Public : Type} {objects : GraphLoopsReuse.Objects} {configs : List Configuration}
+    {meaning : Interpretation Value Public} {candidate sourceMode targetMode : Bool}
+    {instructions : List GraphLoopsReuse.Instruction} {before after : GraphLoopsReuse.Memory Value Public}
+    (valid : ∀ config ∈ configs, config.Valid objects)
+    (run : Execution objects configs meaning candidate sourceMode instructions before after) :
+    Execution objects configs meaning candidate targetMode instructions before after := by
+  induction run with
+  | done before => exact .done before
+  | more first remaining induction => exact .more (step_modes valid first) induction
+
+theorem outcomes_modes {Value Public : Type} (objects : GraphLoopsReuse.Objects) (configs : List Configuration)
+    (valid : ∀ config ∈ configs, config.Valid objects) (meaning : Interpretation Value Public)
+    (candidate sourceMode targetMode : Bool) (instructions : List GraphLoopsReuse.Instruction)
+    (before : GraphLoopsReuse.Memory Value Public) (outcome : Public) :
+    outcomes objects configs meaning candidate sourceMode instructions before outcome ↔
+      outcomes objects configs meaning candidate targetMode instructions before outcome := by
+  constructor <;> rintro ⟨after, run, observed⟩ <;> exact ⟨after, execution_modes valid run, observed⟩
+
+/-- Explicit adjacent composition: source→EXACT reused middle→segmented final.
+The middle is the SAME instruction sequence, interpretation and initial memory.
+There is no evaluator bridge, whole-program equality hypothesis or numeric law. -/
+theorem checked_reuse_then_segment {Value Public : Type} (objects : GraphLoopsReuse.Objects) (configs : List Configuration)
+    (instructions : List GraphLoopsReuse.Instruction) (valid : ∀ config ∈ configs, config.Valid objects)
+    (accepted : GraphLoopsReuse.checkProgram objects GraphLoopsReuse.emptyStatus instructions = true)
+    (meaning : Interpretation Value Public) (source middle : GraphLoopsReuse.Memory Value Public)
+    (same : source.observed = middle.observed) (outcome : Public) :
+    (outcomes objects configs meaning false false instructions source outcome ↔
+      outcomes objects configs meaning true false instructions middle outcome) ∧
+    (outcomes objects configs meaning true false instructions middle outcome ↔
+      outcomes objects configs meaning true true instructions middle outcome) ∧
+    (outcomes objects configs meaning false false instructions source outcome ↔
+      outcomes objects configs meaning true true instructions middle outcome) := by
+  have reuse := checked_complete_observations objects configs instructions valid accepted meaning false false source middle same outcome
+  have segment := outcomes_modes objects configs valid meaning true false true instructions middle outcome
+  exact ⟨reuse, segment, reuse.trans segment⟩
+
+/-- Existing atomic-reuse root instantiated with the same INDUCED initializer
+meaning. The operational theorem above is stronger about stores, not an assumed
+identity of atomic heaps (which differ outside the valid allocation domain). -/
+theorem checked_induced_atomic {Value Public : Type} (objects : GraphLoopsReuse.Objects) (configs : List Configuration)
+    (instructions : List GraphLoopsReuse.Instruction)
+    (accepted : GraphLoopsReuse.checkProgram objects GraphLoopsReuse.emptyStatus instructions = true)
+    (meaning : Interpretation Value Public) (source target : GraphLoopsReuse.Memory Value Public)
+    (same : source.observed = target.observed) (outcome : Public) :
+    (∃ after, GraphLoopsReuse.Execution objects (inducedPrimitives meaning configs) false instructions source after ∧ after.observed = outcome) ↔
+    (∃ after, GraphLoopsReuse.Execution objects (inducedPrimitives meaning configs) true instructions target after ∧ after.observed = outcome) :=
+  GraphLoopsReuse.checked_observations objects instructions accepted (inducedPrimitives meaning configs) source target same outcome
+
+end Merlin.GraphLoopsMemorySCF
