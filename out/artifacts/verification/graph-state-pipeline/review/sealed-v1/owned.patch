+"""Exact receipt bindings and coherent fresh-rehash attacks on owned artifacts.
+
+No protected source/toolchain is mutated. Each attack owns a fresh unqualified
+candidate and preserves an exact before snapshot. Rehashing is attacker input,
+never an adopted proof/tool identity.
+"""
+
+import copy
+import json
+import shutil
+from pathlib import Path
+
+import pytest
+from test_lean_graph_state_pipeline import CASES, REFERENCE, capture, checked
+
+from merlin.verify import lean_graph_state as stable
+from merlin.verify.lean_graph_state_pipeline_receipt import (
+    CLAIMS,
+    issue,
+    reference_row,
+    replay,
+    valid_claims,
+    validate,
+)
+
+
+def load(path):
+    return json.loads(Path(path).read_text())
+
+
+def save(path, value):
+    Path(path).write_text(json.dumps(value, indent=2) + "\n")
+
+
+def fresh_candidate(root):
+    buffers, _ = capture(root, CASES["i32"])
+    result = checked(root, buffers, CASES["i32"])
+    assert result["status"] == "conditional_graph_checked", result
+    issue(root / "checked/report.json", root / "receipt.json")
+    receipt = load(root / "receipt.json")
+    validate(receipt)
+    return receipt
+
+
+def preserve(root, receipt):
+    archive = root / "before-attack"
+    shutil.copytree(root / "checked", archive)
+    shutil.copyfile(root / "receipt.json", root / "receipt-before.json")
+    rows = []
+    for original in sorted((root / "checked").rglob("*")):
+        if not original.is_file():
+            continue
+        copied = archive / original.relative_to(root / "checked")
+        assert stable.file_ref(original)["sha256"] == stable.file_ref(copied)["sha256"]
+        rows.append({"original": stable.file_ref(original), "snapshot": stable.file_ref(copied)})
+    save(
+        root / "BEFORE_ATTACK.json",
+        {
+            "status": "unqualified test candidate, before deliberate attack",
+            "files": rows,
+            "receipt": stable.file_ref(root / "receipt-before.json"),
+            "old_capsules_edited": False,
+        },
+    )
+
+
+def refresh_refs(value):
+    if type(value) is dict:
+        if set(value) == {"path", "sha256", "bytes"}:
+            return stable.file_ref(Path(value["path"]))
+        return {key: refresh_refs(child) for key, child in value.items()}
+    if type(value) is list:
+        return [refresh_refs(child) for child in value]
+    return value
+
+
+def coherent_rehash(root, receipt):
+    # The DAG is buffers/query/object/raw audit → kernel/projection → report → receipt.
+    for rel in ("projection/CAPTURE.json", "kernel/report.json", "report.json"):
+        path = root / "checked" / rel
+        save(path, refresh_refs(load(path)))
+    receipt = refresh_refs(receipt)
+    receipt["files"] = [stable.file_ref(p) for p in sorted((root / "checked").rglob("*")) if p.is_file()]
+    save(root / "forged-receipt.json", receipt)
+    return receipt
+
+
+def test_live_receipt_and_one_development_fresh_replay(tmp_path):
+    receipt = fresh_candidate(tmp_path)
+    result = replay(tmp_path / "receipt.json", tmp_path / "replay", reference=REFERENCE)
+    assert result["status"] == "conditional_graph_checked"
+    assert result["retained_object_reproduced"] and result["exact_original_query_path_reproduced"]
+    assert result["qualified"] is False
+    assert receipt["claims"]["review_approved"] is False
+
+
+ATTACKS = ("query", "object", "header", "projection", "audit", "import", "statements", "profile", "original")
+
+
+@pytest.mark.parametrize("kind", ATTACKS)
+def test_coherently_rehashed_forgeries_are_refused(kind, tmp_path):
+    receipt = fresh_candidate(tmp_path)
+    preserve(tmp_path, receipt)
+    report_path = tmp_path / "checked/report.json"
+    report = load(report_path)
+    kernel_path = Path(report["kernel"]["path"])
+    kernel = load(kernel_path)
+    capture_path = Path(report["projection"]["path"])
+    projection = load(capture_path)
+    if kind == "query":
+        path = Path(receipt["query"]["path"])
+        path.write_text(path.read_text() + "\n-- unauthorized query bytes\n")
+    elif kind == "object":
+        path = Path(receipt["object"]["path"])
+        data = bytearray(path.read_bytes())
+        data[-1] ^= 1
+        path.write_bytes(data)
+    elif kind == "header":
+        for stage in projection["stages"]:
+            next(f for f in stage["functions"] if f["name"] == "main")["header"]["attributes"] = [
+                "dictionary",
+                [["forged", ["bool", True]]],
+            ]
+        save(capture_path, projection)
+    elif kind == "projection":
+        projection["stages"][0]["registry"][0]["outputs"] = [{"bits": 64}]
+        save(capture_path, projection)
+    elif kind in ("audit", "import", "statements"):
+        if kind == "audit":
+            kernel["audit"]["raw"]["theorems_audited"] += 1
+        elif kind == "import":
+            kernel["audit"]["raw"]["imports"][0]["module"] += ".__forged"
+        else:
+            kernel["audit"]["statements"][receipt["roots"][0]] += " → False"
+        buffers = {Path(r["path"]).name: Path(r["path"]) for r in kernel["audit"]["buffers"]}
+        save(buffers["audit.stdout"], kernel["audit"]["raw"])
+        save(buffers["statements.stdout"], {"statements": kernel["audit"]["statements"]})
+        save(kernel_path, kernel)
+    elif kind == "profile":
+        fake = tmp_path / "forged-profile.json"
+        profile = load(receipt["profile"]["path"])
+        profile["selection"]["arguments"] = ["-j2"]
+        save(fake, profile)
+        fake_ref = stable.file_ref(fake)
+        previous = receipt["profile"]
+        receipt["profile"] = fake_ref
+        report["profile"] = fake_ref
+        kernel["profile"] = fake_ref
+        receipt["dependencies"] = [fake_ref if r == previous else r for r in receipt["dependencies"]]
+        save(report_path, report)
+        save(kernel_path, kernel)
+    elif kind == "original":
+        # Change an actual original AND its submitted snapshot, preserving all
+        # hashes coherently while leaving the old semantic/query proof behind.
+        import os
+        import sys
+
+        from merlin.common.owned_process import run_owned
+        from merlin.common.paths import repo_root
+
+        script = repo_root() / "src/merlin/verify/lean_graph_state_pipeline_mutate.py"
+        original = Path(receipt["originals"][4]["path"])
+        altered = tmp_path / "changed-original.mlir"
+        result = run_owned(
+            [sys.executable, str(script), str(original), str(altered), "drop-observer"],
+            cwd=REFERENCE,
+            env={**os.environ, "PYTHONPATH": str(REFERENCE / "src"), "PYTHONDONTWRITEBYTECODE": "1"},
+            capture_output=True,
+            text=True,
+            timeout=60,
+            check=False,
+        )
+        assert result.returncode == 0, result.stderr
+        original.write_bytes(altered.read_bytes())
+        Path(receipt["snapshots"][4]["path"]).write_bytes(altered.read_bytes())
+    forged = coherent_rehash(tmp_path, receipt)
+    # Some attacks correctly pass all hashes/retained authoring and are refused
+    # only by re-projection, exact object reproduction or a fresh transitive audit.
+    with pytest.raises((ValueError, RuntimeError)):
+        replay(tmp_path / "forged-receipt.json", tmp_path / "forgery-replay", reference=REFERENCE)
+    save(
+        tmp_path / "FORGERY_REFUSED.json",
+        {
+            "kind": kind,
+            "fresh_rehash_consistent": True,
+            "protected_source_or_toolchain_edited": False,
+            "public_approval": False,
+        },
+    )
+    assert forged["claims"]["review_approved"] is False
+
+
+@pytest.fixture(scope="module")
+def schema_receipt(tmp_path_factory):
+    return fresh_candidate(tmp_path_factory.mktemp("schema-candidate"))
+
+
+@pytest.mark.parametrize(
+    "kind", ["legacy", "extra", "missing-original", "wrong-mode", "approval", "bool-version", "bool-byte-count"]
+)
+def test_closed_versioned_receipt_refusals(kind, schema_receipt):
+    candidate = copy.deepcopy(schema_receipt)
+    if kind == "legacy":
+        candidate["version"] = 0
+    elif kind == "extra":
+        candidate["foreign"] = True
+    elif kind == "missing-original":
+        candidate["originals"] = candidate["originals"][:-1]
+    elif kind == "wrong-mode":
+        candidate["config"]["mode"] = "unapproved"
+    elif kind == "approval":
+        candidate["claims"]["review_approved"] = True
+    elif kind == "bool-version":
+        candidate["version"] = True
+    elif kind == "bool-byte-count":
+        candidate["originals"][0]["bytes"] = True
+    with pytest.raises(ValueError):
+        validate(candidate)
+
+
+def test_claims_are_immutable_and_types_are_exact():
+    with pytest.raises(ValueError):
+        reference_row({"path": "/tmp/x", "sha256": "0" * 64, "bytes": False})
+    altered = copy.deepcopy(dict(CLAIMS))
+    altered["review_approved"] = 0
+    assert not valid_claims(altered)
+    with pytest.raises(TypeError):
+        CLAIMS["review_approved"] = True
diff --git a/src/merlin/verify/lean/Merlin/GraphStatePipelineControl.lean b/src/merlin/verify/lean/Merlin/GraphStatePipelineControl.lean
new file mode 100644
--- /dev/null
+++ b/src/merlin/verify/lean/Merlin/GraphStatePipelineControl.lean
@@ -0,0 +1,111 @@
+/- Explicit finite nonnegative SCF control and its connection to the sealed W
+relation. The evaluator determines IVs from bounds/stride; no iteration callback
+agreement or successful-body hypothesis is used in these bridges. -/
+import Merlin.GraphStatePipelineFailure
+import Merlin.GraphLoopsUnrollGrouping
+
+namespace Merlin.GraphState.Pipeline
+set_option autoImplicit false
+open Scalar GraphLoopsSegment GraphLoopsUnroll
+
+/-- Static nonnegative SCF iteration, including zero-trip and stride overshoot.
+Invalid/nonpositive controls are outside the admitted checked domain. -/
+def scfRange (lower upper step : Nat) : List Nat :=
+  if lower < upper ∧ 0 < step then
+    lower :: scfRange (lower+step) upper step
+  else []
+termination_by upper-lower
+decreasing_by omega
+
+/-- Exact counted progression. It is mathematical data, not a trip-sized
+certificate: the preservation proofs recurse on the symbolic count. -/
+def progression (lower step : Nat) : Nat → List Nat
+  | 0 => []
+  | count+1 => lower :: progression (lower+step) step count
+
+theorem range_count {lower upper step count : Nat} (positive : 0 < step)
+    (correct : CountCorrect lower upper step count) :
+    scfRange lower upper step = progression lower step count := by
+  induction count generalizing lower with
+  | zero =>
+    have stopped : upper ≤ lower := correct
+    rw [scfRange]
+    simp only [show ¬ (lower < upper ∧ 0 < step) by omega, ↓reduceIte, progression]
+  | succ count ih =>
+    rw [scfRange]
+    simp only [show lower < upper ∧ 0 < step from ⟨correct.live,positive⟩, ↓reduceIte, progression]
+    exact congrArg (List.cons lower) (ih correct.next)
+
+/-- Concrete value-level iteration selection for the supported index domain.
+Negative controls/nonpositive stride are refused by the checker, not licensed
+as alternate semantics. This total fallback does not establish their behavior. -/
+def indexIterations (lower upper step : Int) : List Int :=
+  if 0 ≤ lower ∧ 0 ≤ upper ∧ 0 < step then
+    (scfRange lower.toNat upper.toNat step.toNat).map Int.ofNat
+  else []
+
+theorem indexIterations_count {lower upper step count : Nat}
+    (positive : 0 < step) (correct : CountCorrect lower upper step count) :
+    indexIterations lower upper step = (progression lower step count).map Int.ofNat := by
+  have pos : (0 : Int) < (step : Int) := by omega
+  simp only [indexIterations, Int.natCast_nonneg, pos, and_self, ↓reduceIte, Int.toNat_natCast]
+  rw [range_count positive correct]
+
+/-- Deterministic total transition used only after the failure representation
+has been proved. It does not turn a raw partial body into successful execution. -/
+def Step {State : Type} (transition : Nat → State → State) (index : Nat) (before after : State) : Prop :=
+  after = transition index before
+
+/-- W's repeated relation has exactly the evaluator's trace and folded state. -/
+theorem repeat_fold {State : Type} (transition : Nat → State → State) (step count lower : Nat)
+    (initial final : State) (trace : List Nat) :
+    Repeat (Step transition) step count lower initial trace final ↔
+      trace = progression lower step count ∧ final = trace.foldl (fun state index => transition index state) initial := by
+  induction count generalizing lower initial trace with
+  | zero =>
+    constructor
+    · intro run; cases run; exact ⟨rfl,rfl⟩
+    · rintro ⟨rfl,rfl⟩; exact .nil _ _
+  | succ count ih =>
+    constructor
+    · intro run
+      cases run with
+      | cons event remaining =>
+        obtain ⟨same,folded⟩ := (ih _ _ _).mp remaining
+        constructor
+        · exact congrArg (List.cons lower) same
+        · dsimp only [Step] at event
+          rw [event] at folded
+          simpa only [List.foldl_cons] using folded
+    · rintro ⟨rfl,folded⟩
+      refine .cons rfl ((ih _ _ _).mpr ⟨rfl,?_⟩)
+      exact folded
+
+/-- Complete operational bridge to W's SCF relation for arbitrary state,
+including the absorbing error/world state. The trace and final state are derived. -/
+theorem execution_fold {State : Type} (transition : Nat → State → State)
+    {upper step count lower : Nat} (positive : 0 < step)
+    (correct : CountCorrect lower upper step count) (initial final : State) (trace : List Nat) :
+    Execution (Step transition) upper step lower initial trace final ↔
+      trace = scfRange lower upper step ∧ final = trace.foldl (fun state index => transition index state) initial := by
+  rw [← repeat_iff_execution _ upper step count lower initial final trace correct,
+    repeat_fold, range_count positive correct]
+
+/-- The sealed early-failure scalar loop is exactly the final projection of
+W's deterministic outcome-state relation. It preserves errors/terminal worlds
+without assuming any raw body success or total external computation. -/
+theorem scalar_execution {Value World Error : Type} (arity : Nat)
+    (body : Int → List Value → World → Outcome Value World Error)
+    {lower upper step count : Nat} (positive : 0 < step)
+    (correct : CountCorrect lower upper step count) (values : List Value) (world : World) :
+    ∃ final, Execution
+      (Step (fun index state => advance arity body state (Int.ofNat index))) upper step lower
+      (.ok (values,world)) (scfRange lower upper step) final ∧
+      Scalar.loopEval arity body (indexIterations lower upper step) values world = finish arity final := by
+  let final := (scfRange lower upper step).foldl
+    (fun state index => advance arity body state (Int.ofNat index)) (.ok (values,world))
+  refine ⟨final, (execution_fold _ positive correct _ _ _).mpr ⟨rfl,rfl⟩, ?_⟩
+  rw [indexIterations_count positive correct, loop_fold]
+  simp only [final, List.foldl_map, range_count positive correct]
+
+end Merlin.GraphState.Pipeline
diff --git a/src/merlin/verify/lean/Merlin/GraphStatePipelineFailure.lean b/src/merlin/verify/lean/Merlin/GraphStatePipelineFailure.lean
new file mode 100644
--- /dev/null
+++ b/src/merlin/verify/lean/Merlin/GraphStatePipelineFailure.lean
@@ -0,0 +1,89 @@
+/- Failure-sensitive bridge for the unchanged sealed scalar evaluator.
+A logical trace may visit later indices after failure, but its absorbing state
+neither invokes the body nor changes the terminal error/world. This representation
+is proved equivalent to early failure; no source-success premise is introduced. -/
+import Merlin.GraphStateScalarContract
+-- One shared library contains byte-identical sealed dependency objects.
+
+namespace Merlin.GraphState.Pipeline
+open Scalar
+set_option autoImplicit false
+
+/-- The final arity check is observable, including for a zero-trip loop. -/
+def finish {Value World Error : Type} (arity : Nat) : Outcome Value World Error → Outcome Value World Error
+  | .error failure => .error failure
+  | .ok (values,world) =>
+    if values.length = arity then .ok (values,world) else .error (.arity,world)
+
+/-- An absorbing step checks current carries and executes at most one body.
+It leaves malformed result arity for the next step/final check, exactly as loopEval. -/
+def advance {Value World Error : Type} (arity : Nat)
+    (body : Int → List Value → World → Outcome Value World Error)
+    (before : Outcome Value World Error) (index : Int) : Outcome Value World Error :=
+  match before with
+  | .error failure => .error failure
+  | .ok (values,world) =>
+    if values.length = arity then body index values world else .error (.arity,world)
+
+/-- Absorption preserves the complete terminal failure and does not invoke body. -/
+theorem advance_failed {Value World Error : Type} (arity : Nat)
+    (body : Int → List Value → World → Outcome Value World Error)
+    (failure : Fault Error × World) (index : Int) :
+    advance arity body (.error failure) index = .error failure := rfl
+
+theorem fold_failed {Value World Error : Type} (arity : Nat)
+    (body : Int → List Value → World → Outcome Value World Error)
+    (failure : Fault Error × World) (indices : List Int) :
+    indices.foldl (advance arity body) (.error failure) = .error failure := by
+  induction indices with
+  | nil => rfl
+  | cons index later ih => exact ih
+
+/-- Exact representation theorem, for arbitrary inputs/body/arity/errors/world.
+This proves the failure-prefix semantics needed to use total relational W roots. -/
+theorem fold_early_failure {Value World Error : Type} (arity : Nat)
+    (body : Int → List Value → World → Outcome Value World Error)
+    (indices : List Int) (initial : Outcome Value World Error) :
+    finish arity (indices.foldl (advance arity body) initial) =
+      initial.bind (fun state => Scalar.loopEval arity body indices state.1 state.2) := by
+  induction indices generalizing initial with
+  | nil =>
+    cases initial with
+    | error failure => rfl
+    | ok state => cases state; rfl
+  | cons index later ih =>
+    cases initial with
+    | error failure => simp only [fold_failed, finish, Except.bind]
+    | ok state =>
+      rcases state with ⟨values,world⟩
+      simp only [List.foldl_cons, ih]
+      by_cases h : values.length = arity
+      · simp only [advance, h, ↓reduceIte, Except.bind, Scalar.loopEval]
+      · simp only [advance, h, ↓reduceIte, Except.bind, Scalar.loopEval]
+
+theorem loop_fold {Value World Error : Type} (arity : Nat)
+    (body : Int → List Value → World → Outcome Value World Error)
+    (indices : List Int) (values : List Value) (world : World) :
+    Scalar.loopEval arity body indices values world =
+      finish arity (indices.foldl (advance arity body) (.ok (values,world))) :=
+  (fold_early_failure arity body indices (.ok (values,world))).symm
+
+/-- Regrouping an absorbing fold preserves failure at any prefix. In particular
+there is no assumption that a complete original body trace succeeds. -/
+theorem fold_append {Value World Error : Type} (arity : Nat)
+    (body : Int → List Value → World → Outcome Value World Error)
+    (first second : List Int) (initial : Outcome Value World Error) :
+    (first ++ second).foldl (advance arity body) initial =
+      second.foldl (advance arity body) (first.foldl (advance arity body) initial) :=
+  List.foldl_append
+
+/-- The remainder of a failed prefix cannot mutate its error or terminal world. -/
+theorem failure_prefix {Value World Error : Type} (arity : Nat)
+    (body : Int → List Value → World → Outcome Value World Error)
+    (first second : List Int) (initial : Outcome Value World Error) (failure : Fault Error × World)
+    (failed : first.foldl (advance arity body) initial = .error failure) :
+    finish arity ((first ++ second).foldl (advance arity body) initial) = .error failure := by
+  rw [fold_append, failed, fold_failed]
+  rfl
+
+end Merlin.GraphState.Pipeline
diff --git a/src/merlin/verify/lean/Merlin/GraphStatePipelineFold.lean b/src/merlin/verify/lean/Merlin/GraphStatePipelineFold.lean
new file mode 100644
--- /dev/null
+++ b/src/merlin/verify/lean/Merlin/GraphStatePipelineFold.lean
@@ -0,0 +1,140 @@
+/- Operational folds connected to W's ordered grouping proofs. All states may
+contain failure and terminal world; only the proved absorbing representation
+allows a total transition relation to be used. -/
+import Merlin.GraphStatePipelineControl
+
+namespace Merlin.GraphState.Pipeline
+set_option autoImplicit false
+open Scalar GraphLoopsSegment GraphLoopsUnroll
+
+theorem finish_idempotent {Value World Error : Type} (arity : Nat) (state : Outcome Value World Error) :
+    finish arity (finish arity state) = finish arity state := by
+  cases state with
+  | error failure => rfl
+  | ok state =>
+    rcases state with ⟨values,world⟩
+    by_cases size : values.length = arity <;> simp only [finish,size,↓reduceIte]
+
+theorem finish_advance_finish {Value World Error : Type} (arity : Nat)
+    (body : Int → List Value → World → Outcome Value World Error)
+    (state : Outcome Value World Error) (index : Int) :
+    finish arity (advance arity body (finish arity state) index) =
+      finish arity (advance arity body state index) := by
+  cases state with
+  | error failure => rfl
+  | ok state =>
+    rcases state with ⟨values,world⟩
+    by_cases size : values.length = arity <;> simp only [finish,advance,size,↓reduceIte]
+
+def closedAdvance {Value World Error : Type} (arity : Nat)
+    (body : Int → List Value → World → Outcome Value World Error)
+    (state : Outcome Value World Error) (index : Int) : Outcome Value World Error :=
+  finish arity (advance arity body state index)
+
+/-- Immediate arity validation and absorbing errors are a representation of
+loopEval, not a replacement evaluator whose correspondence is assumed. -/
+theorem fold_closed {Value World Error : Type} (arity : Nat)
+    (body : Int → List Value → World → Outcome Value World Error)
+    (indices : List Int) (state : Outcome Value World Error) :
+    indices.foldl (closedAdvance arity body) (finish arity state) =
+      finish arity (indices.foldl (advance arity body) state) := by
+  induction indices generalizing state with
+  | nil => rfl
+  | cons index later ih =>
+    simp only [List.foldl_cons,closedAdvance,finish_advance_finish]
+    exact ih (advance arity body state index)
+
+theorem loop_closed {Value World Error : Type} (arity : Nat)
+    (body : Int → List Value → World → Outcome Value World Error)
+    (indices : List Int) (values : List Value) (world : World) :
+    Scalar.loopEval arity body indices values world =
+      indices.foldl (closedAdvance arity body) (finish arity (.ok (values,world))) := by
+  rw [loop_fold, fold_closed]
+
+def groupStep {State : Type} (transition : Nat → State → State) (step factor index : Nat)
+    (before : State × List Nat) : State × List Nat :=
+  let indices := progression index step factor
+  (indices.foldl (fun state iv => transition iv state) before.1, before.2 ++ indices)
+
+/-- Actual grouped state/log meaning is derived from the counted relation. -/
+theorem groupBody_step {State : Type} (transition : Nat → State → State) (step factor index : Nat)
+    (before after : State × List Nat) :
+    GroupBody (Step transition) step factor index before after ↔
+      Step (groupStep transition step factor) index before after := by
+  constructor
+  · rintro ⟨trace,run,log⟩
+    obtain ⟨indices,folded⟩ := (repeat_fold transition step factor index before.1 after.1 trace).mp run
+    rcases before with ⟨initial,startLog⟩
+    rcases after with ⟨final,endLog⟩
+    dsimp only at indices folded log
+    subst trace
+    dsimp only [Step,groupStep]
+    exact Prod.ext folded log
+  · intro same
+    change after = groupStep transition step factor index before at same
+    subst after
+    refine ⟨progression index step factor, ?_, rfl⟩
+    exact (repeat_fold transition step factor index _ _ _).mpr ⟨rfl,rfl⟩
+
+theorem repeat_congr {State : Type} {first second : Nat → State → State → Prop}
+    (same : ∀ index before after, first index before after ↔ second index before after)
+    {step count lower : Nat} {initial final : State} {trace : List Nat}
+    (run : Repeat first step count lower initial trace final) :
+    Repeat second step count lower initial trace final := by
+  induction run with
+  | nil lower state => exact .nil lower state
+  | cons event _ ih => exact .cons ((same _ _ _).mp event) ih
+
+/-- W's grouping theorem entails equality of complete deterministic folds.
+This is independent of trip count magnitude and does not expand body execution. -/
+theorem groups_fold {State : Type} (transition : Nat → State → State)
+    (lower step factor groups : Nat) (initial : State) :
+    ((progression lower (step*factor) groups).foldl
+      (fun state index => groupStep transition step factor index state) (initial,[])).1 =
+      (progression lower step (groups*factor)).foldl (fun state index => transition index state) initial := by
+  let bases := progression lower (step*factor) groups
+  let final := bases.foldl (fun state index => groupStep transition step factor index state) (initial,[])
+  have run : Repeat (Step (groupStep transition step factor)) (step*factor) groups lower (initial,[]) bases final :=
+    (repeat_fold _ _ _ _ _ _ _).mpr ⟨rfl,rfl⟩
+  have grouped := repeat_congr (fun index before after => (groupBody_step transition step factor index before after).symm) run
+  obtain ⟨trace,original,_⟩ :=
+    (grouped_repeat_iff (Step transition) step factor groups lower initial final.1 [] final.2).mp ⟨bases,grouped⟩
+  obtain ⟨same,folded⟩ := (repeat_fold transition step (groups*factor) lower initial final.1 trace).mp original
+  rw [same] at folded
+  exact folded
+
+/-- A total relation execution exists for any deterministic transition. This
+includes absorbing failures, with zero additional external calls after failure. -/
+theorem range_execution {State : Type} (transition : Nat → State → State)
+    (upper step : Nat) (positive : 0 < step) (lower : Nat) (initial : State) :
+    Execution (Step transition) upper step lower initial (scfRange lower upper step)
+      ((scfRange lower upper step).foldl (fun state index => transition index state) initial) := by
+  by_cases inside : lower < upper
+  · rw [scfRange]
+    simp only [inside,positive,and_self,↓reduceIte,List.foldl_cons]
+    exact .more inside rfl (range_execution transition upper step positive (lower+step) (transition lower initial))
+  · have stopped : upper ≤ lower := by omega
+    rw [scfRange]
+    simp only [inside,false_and,↓reduceIte,List.foldl_nil]
+    exact .done initial stopped
+termination_by upper-lower
+decreasing_by omega
+
+theorem execution_determined {State : Type} {transition : Nat → State → State}
+    {upper step lower : Nat} (positive : 0 < step) {initial final : State} {trace : List Nat}
+    (run : Execution (Step transition) upper step lower initial trace final) :
+    trace = scfRange lower upper step ∧ final = trace.foldl (fun state index => transition index state) initial := by
+  induction run with
+  | @done lower state stopped =>
+    constructor
+    · rw [scfRange]; simp only [show ¬ (lower < upper ∧ 0 < step) by omega,↓reduceIte]
+    · rfl
+  | @more lower initial middle final later inside event remaining ih =>
+    constructor
+    · rw [scfRange]
+      simp only [inside,positive,and_self,↓reduceIte,ih.1]
+    · change middle = transition lower initial at event
+      rw [List.foldl_cons, ← event]
+      exact ih.2
+
+end Merlin.GraphState.Pipeline
diff --git a/src/merlin/verify/lean/Merlin/GraphStatePipelineIndex.lean b/src/merlin/verify/lean/Merlin/GraphStatePipelineIndex.lean
new file mode 100644
--- /dev/null
+++ b/src/merlin/verify/lean/Merlin/GraphStatePipelineIndex.lean
@@ -0,0 +1,147 @@
+/- Fixed concrete INDEX meanings for the scalar/SCF graph domain.
+Index values are mathematical signed representatives. Accepted W bounds prove
+that generated operations have no fixed-width overflow and minui compares
+nonnegative representatives. This is not a backend/runtime fidelity theorem. -/
+import Merlin.GraphStatePipelineControl
+import Merlin.GraphLoopsUnrollBounds
+
+namespace Merlin.GraphState.Pipeline
+set_option autoImplicit false
+open Scalar GraphLoopsSegment
+
+inductive IndexOp where
+  | constant (value : Int)
+  | add
+  | minui
+  deriving DecidableEq, BEq, ReflBEq, LawfulBEq, Repr
+
+def IndexOp.inputs : IndexOp → List Ty
+  | .constant _ => []
+  | .add | .minui => [.index,.index]
+
+def IndexOp.eval : IndexOp → List Int → Int
+  | .constant value,_ => value
+  | .add,values => values[0]?.getD 0 + values[1]?.getD 0
+  | .minui,values => min (values[0]?.getD 0) (values[1]?.getD 0)
+
+/-- A single common registry. Control classification must match the exact
+supported operation/type descriptor projection; other calls remain partial. -/
+abbrev Controls := List (Option IndexOp)
+
+def controlAt (controls : Controls) (identity : Nat) : Option IndexOp :=
+  (controls[identity]?).getD none
+
+def ControlValid (registry : List Signature) (controls : Controls) : Prop :=
+  controls.length = registry.length ∧ ∀ identity op, controlAt controls identity = some op →
+    identity < registry.length ∧ (signature registry identity).inputs = op.inputs ∧
+      (signature registry identity).outputs = [.index]
+
+/-- Executable finite signature check; its soundness is kernel proved below. -/
+def checkControl (registry : List Signature) (controls : Controls) : Bool :=
+  decide (controls.length = registry.length) && (List.range controls.length).all (fun identity =>
+    match controlAt controls identity with
+    | none => true
+    | some op => decide ((signature registry identity).inputs = op.inputs ∧
+        (signature registry identity).outputs = [.index]))
+
+theorem checkControl_sound {registry : List Signature} {controls : Controls}
+    (accepted : checkControl registry controls = true) : ControlValid registry controls := by
+  simp only [checkControl, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at accepted
+  refine ⟨accepted.1, ?_⟩
+  intro identity op found
+  have inside : identity < controls.length := by
+    by_cases inside : identity < controls.length
+    · exact inside
+    · have absent : controls[identity]? = none := List.getElem?_eq_none (by omega)
+      simp only [controlAt, absent, Option.getD_none] at found
+      cases found
+  have checked := accepted.2 identity (List.mem_range.mpr inside)
+  rw [found] at checked
+  exact ⟨by omega, of_decide_eq_true checked⟩
+
+/-- The only external premise is successful result arity for the retained
+noncontrol call meaning. It does not assert success, purity, totality or no poison. -/
+structure External (World Error : Type) (registry : List Signature) where
+  run : Nat → List Int → World → Except (Error × World) (List Int × World)
+  arity : ∀ identity arguments world values final,
+    run identity arguments world = .ok (values,final) →
+      values.length = (signature registry identity).outputs.length
+
+def indexEffect {World Error : Type} {registry : List Signature} (controls : Controls)
+    (external : External World Error registry) (identity : Nat) (arguments : List Int) (world : World) :
+    Except (Error × World) (List Int × World) :=
+  match controlAt controls identity with
+  | some op => .ok ([op.eval arguments],world)
+  | none => external.run identity arguments world
+
+/-- The unchanged Scalar evaluator specialized to ONE concrete index/control
+interpretation and an explicitly total pure common word-primitive function. -/
+def indexModel {World Error : Type} {registry : List Signature} {controls : Controls}
+    (valid : ControlValid registry controls) (primitive : Prim → List Int → Int)
+    (external : External World Error registry) : Model Int World Error registry where
+  default := 0
+  primitive := primitive
+  index := id
+  iterations := indexIterations
+  effect := indexEffect controls external
+  arity := by
+    intro identity arguments world values final success
+    cases found : controlAt controls identity with
+    | none => exact external.arity _ _ _ _ _ (by simpa only [indexEffect,found] using success)
+    | some op =>
+      have same : ([op.eval arguments],world) = (values,final) := by
+        simpa only [indexEffect,found,Except.ok.injEq] using success
+      cases same
+      rw [(valid.2 identity op found).2.2]
+      rfl
+
+theorem control_effect {World Error : Type} {registry : List Signature} {controls : Controls}
+    (valid : ControlValid registry controls) (primitive : Prim → List Int → Int)
+    (external : External World Error registry) {identity : Nat} {op : IndexOp}
+    (found : controlAt controls identity = some op) (arguments : List Int) (world : World) :
+    opaqueStep (indexModel valid primitive external) identity arguments world = .ok ([op.eval arguments],world) := by
+  simp only [opaqueStep,indexModel,indexEffect,found]
+
+/-- Fixed-width representative relation used by the control bridge. -/
+def signedRepresentative (bits : Nat) (value : Int) : Prop :=
+  -((2^(bits-1) : Nat) : Int) ≤ value ∧ value < ((2^(bits-1) : Nat) : Int)
+
+theorem signed_from_W {bits value : Nat} (fits : FitsSigned bits value) :
+    signedRepresentative bits (Int.ofNat value) := fits
+
+/-- The actual unsigned minimum agrees with the nonnegative natural minimum
+on the proved control domain; negative inputs are not admitted by this bridge. -/
+theorem minui_natural (left right : Nat) :
+    IndexOp.eval .minui [Int.ofNat left,Int.ofNat right] = Int.ofNat (min left right) := by
+  simp only [IndexOp.eval, List.getElem?_cons_zero, List.getElem?_cons_succ, Option.getD_some]
+  by_cases ordered : left ≤ right
+  · rw [Nat.min_eq_left ordered]
+    exact Int.min_eq_left (Int.ofNat_le.mpr ordered)
+  · rw [Nat.min_eq_right (by omega)]
+    exact Int.min_eq_right (Int.ofNat_le.mpr (by omega))
+
+theorem unroll_lane_meaning {b : GraphLoopsUnroll.Bounds} (valid : b.Valid)
+    {group lane : Nat} (groupInside : group < b.groups) (laneInside : lane < b.factor) :
+    IndexOp.eval .add [Int.ofNat (b.lower+(b.step*b.factor)*group),Int.ofNat (b.step*lane)] =
+      Int.ofNat (b.lower+b.step*(group*b.factor+lane)) ∧
+    signedRepresentative b.bits (Int.ofNat (b.step*lane)) ∧
+    signedRepresentative b.bits (Int.ofNat (b.lower+b.step*(group*b.factor+lane))) := by
+  have derived := GraphLoopsUnroll.Bounds.lane_control valid groupInside laneInside
+  refine ⟨?_, derived.2.1, ?_⟩
+  · simp only [IndexOp.eval, List.getElem?_cons_zero, List.getElem?_cons_succ, Option.getD_some]
+    exact congrArg Int.ofNat derived.1
+  · rw [← derived.1]
+    exact derived.2.2
+
+theorem segment_control_meaning {b : GraphLoopsSegment.Bounds} (valid : b.Valid)
+    {outer : Nat} (inside : outer < b.upper) :
+    IndexOp.eval .add [Int.ofNat outer,Int.ofNat (b.step*b.tile)] = Int.ofNat (outer+b.step*b.tile) ∧
+    IndexOp.eval .minui [Int.ofNat (outer+b.step*b.tile),Int.ofNat b.upper] =
+      Int.ofNat (min (outer+b.step*b.tile) b.upper) ∧
+    signedRepresentative b.bits (Int.ofNat (outer+b.step*b.tile)) ∧
+    signedRepresentative b.bits (Int.ofNat (min (outer+b.step*b.tile) b.upper)) := by
+  exact ⟨by simp [IndexOp.eval], minui_natural _ _,
+    (GraphLoopsSegment.Bounds.outer_control valid inside).2.1,
+    (GraphLoopsSegment.Bounds.outer_control valid inside).2.2⟩
+
+end Merlin.GraphState.Pipeline
diff --git a/src/merlin/verify/lean/Merlin/GraphStatePipelineLiterals.lean b/src/merlin/verify/lean/Merlin/GraphStatePipelineLiterals.lean
new file mode 100644
--- /dev/null
+++ b/src/merlin/verify/lean/Merlin/GraphStatePipelineLiterals.lean
@@ -0,0 +1,32 @@
+/- Complete fixed-profile index literal domain, independently checked.
+This checks all control-classified constants, including captured/ghost values;
+W's separate bounds discharge generated add/min/IV increment obligations. -/
+import Merlin.GraphStatePipelineIndex
+
+namespace Merlin.GraphState.Pipeline
+set_option autoImplicit false
+
+instance (bits : Nat) (value : Int) : Decidable (signedRepresentative bits value) := by
+  unfold signedRepresentative
+  infer_instance
+
+def checkLiterals (bits : Nat) (controls : Controls) : Bool :=
+  controls.all (fun entry => match entry with
+    | some (.constant value) => decide (signedRepresentative bits value)
+    | _ => true)
+
+theorem checkLiterals_sound {bits : Nat} {controls : Controls}
+    (accepted : checkLiterals bits controls = true) {identity : Nat} {value : Int}
+    (found : controlAt controls identity = some (.constant value)) : signedRepresentative bits value := by
+  have member : some (IndexOp.constant value) ∈ controls := by
+    unfold controlAt at found
+    cases item : controls[identity]? with
+    | none => simp only [item,Option.getD_none] at found; cases found
+    | some entry =>
+      simp only [item,Option.getD_some] at found
+      subst entry
+      exact List.mem_of_getElem? item
+  have checked := List.all_eq_true.mp accepted (some (.constant value)) member
+  exact of_decide_eq_true checked
+
+end Merlin.GraphState.Pipeline
diff --git a/src/merlin/verify/lean/Merlin/GraphStatePipelineLoops.lean b/src/merlin/verify/lean/Merlin/GraphStatePipelineLoops.lean
new file mode 100644
--- /dev/null
+++ b/src/merlin/verify/lean/Merlin/GraphStatePipelineLoops.lean
@@ -0,0 +1,144 @@
+/- Failure-sensitive operational loop composition. The local body equations
+below are proof obligations discharged against actual checked SSA syntax, not
+external operation assumptions or assumed whole-program equalities. -/
+import Merlin.GraphStatePipelineSegments
+import Merlin.GraphStateScalarSound
+
+namespace Merlin.GraphState.Pipeline
+set_option autoImplicit false
+open Scalar GraphLoopsSegment GraphLoopsUnroll
+
+abbrev Packed (Value World Error : Type) (arity : Nat) :=
+  {state : Outcome Value World Error // finish arity state = state}
+
+def packedInitial {Value World Error : Type} (arity : Nat) (values : List Value) (world : World) :
+    Packed Value World Error arity := ⟨finish arity (.ok (values,world)),finish_idempotent _ _⟩
+
+def packedStep {Value World Error : Type} (arity : Nat)
+    (body : Int → List Value → World → Outcome Value World Error)
+    (index : Nat) (before : Packed Value World Error arity) : Packed Value World Error arity :=
+  ⟨closedAdvance arity body before.1 (Int.ofNat index),finish_idempotent _ _⟩
+
+/-- Every successful packed carry has the checked length. An error remains
+an error, with no assumption of successful source/body execution. -/
+theorem packed_arity {Value World Error : Type} {arity : Nat}
+    (state : Packed Value World Error arity) {values : List Value} {world : World}
+    (success : state.1 = .ok (values,world)) : values.length = arity := by
+  have fixed := state.2
+  rw [success] at fixed
+  by_cases size : values.length = arity
+  · exact size
+  · simp only [finish,size,↓reduceIte] at fixed
+    cases fixed
+
+/-- Projection of the subtype fold is the exact absorbing fold. -/
+theorem packed_fold {Value World Error : Type} (arity : Nat)
+    (body : Int → List Value → World → Outcome Value World Error) (indices : List Nat)
+    (state : Packed Value World Error arity) :
+    (indices.foldl (fun s i => packedStep arity body i s) state).1 =
+      (indices.map Int.ofNat).foldl (closedAdvance arity body) state.1 := by
+  induction indices generalizing state with
+  | nil => rfl
+  | cons index later ih => exact ih (packedStep arity body index state)
+
+/-- The packed fold is proved equivalent to the unchanged early-failure loop. -/
+theorem packed_run {Value World Error : Type} (arity : Nat)
+    (body : Int → List Value → World → Outcome Value World Error) (indices : List Nat)
+    (state : Packed Value World Error arity) :
+    (indices.foldl (fun s i => packedStep arity body i s) state).1 =
+      state.1.bind (fun result => Scalar.loopEval arity body (indices.map Int.ofNat) result.1 result.2) := by
+  rw [packed_fold]
+  have fixed := congrArg (fun value => (indices.map Int.ofNat).foldl (closedAdvance arity body) value) state.2
+  exact fixed.symm.trans ((fold_closed arity body _ state.1).trans (fold_early_failure arity body _ state.1))
+
+/-- A proved actual SSA block representing an original-body interval induces
+exactly the corresponding packed transition, including first failure/world. -/
+theorem packed_block {Value World Error : Type} (arity : Nat)
+    (original block : Int → List Value → World → Outcome Value World Error)
+    (indices : Nat → List Nat)
+    (bodyChecked : ∀ index values world, values.length = arity →
+      block (Int.ofNat index) values world =
+        Scalar.loopEval arity original ((indices index).map Int.ofNat) values world)
+    (index : Nat) (state : Packed Value World Error arity) :
+    packedStep arity block index state =
+      (indices index).foldl (fun s i => packedStep arity original i s) state := by
+  apply Subtype.ext
+  rw [packed_run]
+  cases value : state.1 with
+  | error failure => simp only [packedStep,closedAdvance,advance,value,finish,Except.bind]
+  | ok result =>
+    rcases result with ⟨values,world⟩
+    have size := packed_arity state value
+    simp only [packedStep,closedAdvance,advance,value,size,↓reduceIte,Except.bind]
+    rw [bodyChecked index values world size]
+    cases executed : Scalar.loopEval arity original ((indices index).map Int.ofNat) values world with
+    | error failure => rfl
+    | ok result =>
+      have resultSize := loopEval_arity arity original _ _ _ executed
+      simp only [finish,resultSize,↓reduceIte]
+
+theorem fold_pointwise {State : Type} (first second : Nat → State → State)
+    (same : ∀ index state, first index state = second index state) (indices : List Nat) (initial : State) :
+    indices.foldl (fun state index => first index state) initial =
+      indices.foldl (fun state index => second index state) initial := by
+  induction indices generalizing initial with
+  | nil => rfl
+  | cons index later ih => simp only [List.foldl_cons,same,ih]
+
+/-- Operational unroll preservation from the exact local cloned-body proof
+and existing W grouping root. Bound arithmetic is checked separately by W. -/
+theorem unroll_loop {Value World Error : Type} (arity : Nat)
+    (original bulk : Int → List Value → World → Outcome Value World Error)
+    (lower upper step factor groups : Nat) (positive : 0 < step) (positiveFactor : 0 < factor)
+    (counted : CountCorrect lower upper step (groups*factor))
+    (bodyChecked : ∀ index values world, values.length = arity →
+      bulk (Int.ofNat index) values world =
+        Scalar.loopEval arity original ((progression index step factor).map Int.ofNat) values world)
+    (values : List Value) (world : World) :
+    Scalar.loopEval arity original (indexIterations lower upper step) values world =
+      Scalar.loopEval arity bulk
+        (indexIterations (lower : Int) ((lower+(step*factor)*groups : Nat) : Int) ((step*factor : Nat) : Int)) values world := by
+  have originalRange := indexIterations_count positive counted
+  have bulkRange := indexIterations_count (Nat.mul_pos positive positiveFactor)
+    (CountCorrect.aligned lower (step*factor) groups (Nat.mul_pos positive positiveFactor))
+  let initial : Packed Value World Error arity := packedInitial arity values world
+  have originalProjection : Scalar.loopEval arity original (indexIterations lower upper step) values world =
+      ((progression lower step (groups*factor)).foldl (fun s i => packedStep arity original i s) initial).1 := by
+    rw [originalRange,packed_fold]
+    exact loop_closed arity original _ values world
+  have bulkProjection : Scalar.loopEval arity bulk
+      (indexIterations (lower : Int) ((lower+(step*factor)*groups : Nat) : Int) ((step*factor : Nat) : Int)) values world =
+      ((progression lower (step*factor) groups).foldl (fun s i => packedStep arity bulk i s) initial).1 := by
+    rw [bulkRange,packed_fold]
+    exact loop_closed arity bulk _ values world
+  rw [originalProjection,bulkProjection]
+  have replace := fold_pointwise (packedStep arity bulk)
+    (fun index state => (progression index step factor).foldl (fun s i => packedStep arity original i s) state)
+    (packed_block arity original bulk (fun index => progression index step factor) bodyChecked)
+    (progression lower (step*factor) groups) initial
+  rw [replace, groups_plain]
+
+/-- Operational segmentation preservation, with explicit actual outer-body
+correspondence to the inner finite SCF interval. Failure/world is part of state. -/
+theorem segment_loop {Value World Error : Type} (arity : Nat)
+    (original outer : Int → List Value → World → Outcome Value World Error)
+    (lower upper step tile : Nat) (positive : 0 < step) (positiveTile : 0 < tile)
+    (bodyChecked : ∀ index values world, values.length = arity →
+      outer (Int.ofNat index) values world = Scalar.loopEval arity original
+        ((scfRange index (min (index+step*tile) upper) step).map Int.ofNat) values world)
+    (values : List Value) (world : World) :
+    Scalar.loopEval arity original ((scfRange lower upper step).map Int.ofNat) values world =
+      Scalar.loopEval arity outer ((scfRange lower upper (step*tile)).map Int.ofNat) values world := by
+  let initial : Packed Value World Error arity := packedInitial arity values world
+  rw [loop_closed,loop_closed]
+  change ((scfRange lower upper step).map Int.ofNat).foldl (closedAdvance arity original) initial.1 =
+    ((scfRange lower upper (step*tile)).map Int.ofNat).foldl (closedAdvance arity outer) initial.1
+  rw [← packed_fold arity original _ initial,← packed_fold arity outer _ initial]
+  have replace := fold_pointwise (packedStep arity outer)
+    (fun index state => (scfRange index (min (index+step*tile) upper) step).foldl
+      (fun s i => packedStep arity original i s) state)
+    (packed_block arity original outer (fun index => scfRange index (min (index+step*tile) upper) step) bodyChecked)
+    (scfRange lower upper (step*tile)) initial
+  rw [replace,segments_plain _ upper step tile lower positive positiveTile]
+
+end Merlin.GraphState.Pipeline
diff --git a/src/merlin/verify/lean/Merlin/GraphStatePipelineProgram.lean b/src/merlin/verify/lean/Merlin/GraphStatePipelineProgram.lean
new file mode 100644
--- /dev/null
+++ b/src/merlin/verify/lean/Merlin/GraphStatePipelineProgram.lean
@@ -0,0 +1,66 @@
+/- Whole defined-entry roster correspondence, including absent entries and
+invalid input arity. Declarations/names/metadata are bound by the complete host
+projection. Supported calls are retained external descriptors; this is not an
+assumed semantics bridge for internal calls or backend/runtime delivery. -/
+import Merlin.GraphStatePipelineIndex
+import Merlin.GraphStateScalarTyping
+
+namespace Merlin.GraphState.Pipeline
+set_option autoImplicit false
+open Scalar
+
+structure Entry where
+  inputs : List Ty
+  outputs : List Ty
+  body : Program
+  deriving DecidableEq, BEq, ReflBEq, LawfulBEq, Repr
+
+def evalEntry {Value World Error : Type} {registry : List Signature}
+    (model : Model Value World Error registry) (entries : List Entry)
+    (identity : Nat) (arguments : List Value) (world : World) : Option (Outcome Value World Error) :=
+  match entries[identity]? with
+  | none => none
+  | some entry => some (if arguments.length = entry.inputs.length then
+      evalProgram model entry.body arguments world else .error (.arity,world))
+
+def PreservesEntries {Value World Error : Type} {registry : List Signature}
+    (model : Model Value World Error registry) (before after : List Entry) : Prop :=
+  ∀ identity arguments world, evalEntry model before identity arguments world =
+    evalEntry model after identity arguments world
+
+theorem entries_nil {Value World Error : Type} {registry : List Signature}
+    (model : Model Value World Error registry) : PreservesEntries model [] [] := by
+  intro identity arguments world
+  rfl
+
+/-- Every defined entry uses its own checked signature/arity; arbitrary external
+observers are in the complete outcome. No private environment equality is used. -/
+theorem entries_cons {Value World Error : Type} {registry : List Signature}
+    (model : Model Value World Error registry) {first second : Entry} {before after : List Entry}
+    (inputs : first.inputs = second.inputs) (outputs : first.outputs = second.outputs)
+    (body : ∀ arguments world, arguments.length = first.inputs.length →
+      evalProgram model first.body arguments world = evalProgram model second.body arguments world)
+    (rest : PreservesEntries model before after) :
+    PreservesEntries model (first::before) (second::after) := by
+  intro identity arguments world
+  cases identity with
+  | zero =>
+    simp only [evalEntry,List.getElem?_cons_zero]
+    rw [← inputs]
+    by_cases arity : arguments.length = first.inputs.length
+    · simp only [arity,↓reduceIte,body arguments world arity]
+    · simp only [arity,↓reduceIte]
+  | succ identity =>
+    simpa only [evalEntry,List.getElem?_cons_succ] using rest identity arguments world
+
+def checkEntries (registry : List Signature) (entries : List Entry) : Bool :=
+  entries.all (fun entry => checkTypes registry entry.inputs entry.outputs entry.body)
+
+theorem checkEntries_sound {registry : List Signature} {entries : List Entry}
+    (accepted : checkEntries registry entries = true) :
+    ∀ entry ∈ entries, Typed registry entry.inputs entry.outputs entry.body := by
+  intro entry member
+  have checked := List.all_eq_true.mp accepted entry member
+  exact checkTypes_sound _ _ _ checked
+
+end Merlin.GraphState.Pipeline
diff --git a/src/merlin/verify/lean/Merlin/GraphStatePipelineScope.lean b/src/merlin/verify/lean/Merlin/GraphStatePipelineScope.lean
new file mode 100644
--- /dev/null
+++ b/src/merlin/verify/lean/Merlin/GraphStatePipelineScope.lean
@@ -0,0 +1,43 @@
+/- Checked lexical scope/capture correspondence using the existing scalar
+normalization root. Ghost private cells may differ; only explicit logical
+bindings and the complete returned/error/world observation are compared. -/
+import Merlin.GraphStateScalarSound
+
+namespace Merlin.GraphState.Pipeline.Scope
+set_option autoImplicit false
+open Scalar
+
+def check (registry : List Signature) (leftSymbols rightSymbols : List Expr)
+    (left right : Program) : Bool :=
+  match normalize registry leftSymbols left, normalize registry rightSymbols right with
+  | some first,some second => first == second
+  | _,_ => false
+
+/-- Acceptance checks every ordered use against its own lexical environment;
+it never identifies independently numbered SSA cells. The symbol maps are part
+of the certificate. Their connection to actual outer frames is checked at use. -/
+theorem check_sound {registry : List Signature} {leftSymbols rightSymbols : List Expr}
+    {left right : Program} (accepted : check registry leftSymbols rightSymbols left right = true)
+    {Value World Error : Type} (model : Model Value World Error registry) (logical : List Value) (world : World) :
+    evalProgram model left (leftSymbols.map (evalExpr model.default model.primitive logical)) world =
+      evalProgram model right (rightSymbols.map (evalExpr model.default model.primitive logical)) world := by
+  cases first : normalize registry leftSymbols left with
+  | none => simp [check,first] at accepted
+  | some code =>
+    cases second : normalize registry rightSymbols right with
+    | none => simp [check,first,second] at accepted
+    | some other =>
+      have same : code = other := by simpa only [check,first,second,beq_iff_eq] using accepted
+      subst other
+      exact (normalize_sound model left leftSymbols code first logical world).trans
+        (normalize_sound model right rightSymbols code second logical world).symm
+
+/-- A successful body result can be rebound to a differently sized private
+frame using the checked arity law; internal private slots are not observations. -/
+theorem rebind {Value World Error : Type} {registry : List Signature}
+    (model : Model Value World Error registry) (earlier logical : List Value) (symbols : List Expr) :
+    (lift earlier.length symbols).map (evalExpr model.default model.primitive (earlier++logical)) =
+      earlier ++ symbols.map (evalExpr model.default model.primitive logical) :=
+  eval_lift model.default model.primitive earlier logical symbols
+
+end Merlin.GraphState.Pipeline.Scope
diff --git a/src/merlin/verify/lean/Merlin/GraphStatePipelineSegments.lean b/src/merlin/verify/lean/Merlin/GraphStatePipelineSegments.lean
new file mode 100644
--- /dev/null
+++ b/src/merlin/verify/lean/Merlin/GraphStatePipelineSegments.lean
@@ -0,0 +1,75 @@
+/- Derived scalar/SCF operational grouping and segmentation folds, through
+unchanged W relational roots. No success premise: State can include a fault
+and the complete terminal world with a proved absorbing transition. -/
+import Merlin.GraphStatePipelineFold
+
+namespace Merlin.GraphState.Pipeline
+set_option autoImplicit false
+open GraphLoopsSegment GraphLoopsUnroll
+
+theorem logged_first {State : Type} (transition : Nat → State → State)
+    (occurrences : Nat → List Nat) (indices : List Nat) (initial : State) (history : List Nat) :
+    (indices.foldl (fun state index => (transition index state.1,state.2++occurrences index)) (initial,history)).1 =
+      indices.foldl (fun state index => transition index state) initial := by
+  induction indices generalizing initial history with
+  | nil => rfl
+  | cons index later ih => exact ih (transition index initial) (history++occurrences index)
+
+theorem groups_plain {State : Type} (transition : Nat → State → State)
+    (lower step factor groups : Nat) (initial : State) :
+    (progression lower (step*factor) groups).foldl
+      (fun state index => (progression index step factor).foldl (fun s iv => transition iv s) state) initial =
+      (progression lower step (groups*factor)).foldl (fun state index => transition index state) initial := by
+  have grouped := groups_fold transition lower step factor groups initial
+  rw [← grouped]
+  exact (logged_first _ _ _ _ _).symm
+
+def segmentStep {State : Type} (transition : Nat → State → State) (upper step tile index : Nat)
+    (before : State × List Nat) : State × List Nat :=
+  let indices := scfRange index (min (index+step*tile) upper) step
+  (indices.foldl (fun state iv => transition iv state) before.1, before.2++indices)
+
+/-- The complete actual outer iteration corresponds to an inner SCF execution
+and the same state. Its complete ordered trace is derived, not hypothesized. -/
+theorem outer_segmented {State : Type} (transition : Nat → State → State)
+    (upper step tile : Nat) (positive : 0 < step) {lower : Nat}
+    {initial final : State × List Nat} {bases : List Nat}
+    (run : Execution (Step (segmentStep transition upper step tile)) upper (step*tile) lower initial bases final) :
+    ∃ trace, Segmented (Step transition) upper step tile lower initial.1 trace final.1 ∧
+      final.2 = initial.2++trace := by
+  induction run with
+  | @done lower state stopped => exact ⟨[],.done _ stopped,by simp⟩
+  | @more lower initial middle final later inside event remaining ih =>
+    change middle = segmentStep transition upper step tile lower initial at event
+    subst middle
+    obtain ⟨trace,rest,log⟩ := ih
+    refine ⟨scfRange lower (min (lower+step*tile) upper) step ++ trace,
+      .more inside (range_execution transition _ step positive lower initial.1) rest, ?_⟩
+    simpa only [segmentStep,List.append_assoc] using log
+
+/-- Exact nested finite-fold correspondence established through W's full-state
+segmentation theorem, without equating raw SSA stacks or assuming source success. -/
+theorem segments_plain {State : Type} (transition : Nat → State → State)
+    (upper step tile lower : Nat) (positive : 0 < step) (positiveTile : 0 < tile) (initial : State) :
+    (scfRange lower upper (step*tile)).foldl
+      (fun state index => (scfRange index (min (index+step*tile) upper) step).foldl
+        (fun s iv => transition iv s) state) initial =
+      (scfRange lower upper step).foldl (fun state index => transition index state) initial := by
+  let bases := scfRange lower upper (step*tile)
+  let final := bases.foldl (fun state index => segmentStep transition upper step tile index state) (initial,[])
+  have outer := range_execution (segmentStep transition upper step tile) upper (step*tile)
+    (Nat.mul_pos positive positiveTile) lower (initial,[])
+  obtain ⟨trace,nested,_⟩ := outer_segmented transition upper step tile positive outer
+  have original := segmented_refines positive nested
+  obtain ⟨same,folded⟩ := execution_determined positive original
+  rw [same] at folded
+  have projection : final.1 = bases.foldl
+      (fun state index => (scfRange index (min (index+step*tile) upper) step).foldl
+        (fun s iv => transition iv s) state) initial := by
+    exact logged_first
+      (fun index state => (scfRange index (min (index+step*tile) upper) step).foldl
+        (fun s iv => transition iv s) state)
+      (fun index => scfRange index (min (index+step*tile) upper) step) bases initial []
+  exact projection.symm.trans folded
+
+end Merlin.GraphState.Pipeline
