+    changed[2] = alternate[2]
+    result = checked(tmp_path, changed, case)
+    assert result["status"] in ("unsupported", "refused"), result
+    assert result["originals"][2]["sha256"] != __import__("hashlib").sha256(buffers[2].read_bytes()).hexdigest()
