+            text+=f'    loopEval {count} {body} (indexIterations {lower} {upper} {step}) {lean_list(initial)} world = .ok ({lean_list(initial)},world) :=\n'
+            text+=f'  Inline.empty_no_body {count} _ {lower} {upper} {step} (by decide) (by decide) _ world rfl\n'
