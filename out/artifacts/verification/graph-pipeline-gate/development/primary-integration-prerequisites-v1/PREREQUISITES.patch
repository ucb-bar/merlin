+    candidates = [(library_modules(version), public_modules(version))]
+    incoming = [
+        (
+            tuple(name for name in _INCOMING_V6_MODULES if name not in omitted),
+            tuple(name for name in _INCOMING_V6_PUBLIC if name not in omitted),
+        )
