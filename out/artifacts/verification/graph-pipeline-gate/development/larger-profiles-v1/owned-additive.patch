+                self.assertTrue(p.query.startswith(frozen))
+                self.assertEqual(len(p.buffers), len(profile.kinds)+1)
+                self.assertTrue(all(p.buffers[i] != p.buffers[i+1] for i in range(len(profile.kinds))))
