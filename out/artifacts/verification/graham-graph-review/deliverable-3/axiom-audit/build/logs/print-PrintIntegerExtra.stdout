Merlin.GraphState.Integer.loop_constant : ∀ (value : Int) (increment : Nat)
  (body : Int → List Int → Nat → Merlin.GraphState.Scalar.Outcome Int Nat Int),
  (∀ (index : Int) (carry : List Int) (world : Nat),
      carry.length = 1 → body index carry world = Except.ok ([value], world + increment)) →
    ∀ (first : Int) (later carry : List Int) (world : Nat),
      carry.length = 1 →
        Merlin.GraphState.Scalar.loopEval 1 body (first :: later) carry world =
          Except.ok ([value], world + increment * (later.length + 1))
