  Merlin.GraphState.Integer.LocalTyping model rep →
    Merlin.GraphState.Integer.TotalOnTyped model rep →
      ∀ {types results : List Merlin.GraphState.Scalar.Ty} {program : Merlin.GraphState.Scalar.Program},
        Merlin.GraphState.Scalar.Typed registry types results program →
