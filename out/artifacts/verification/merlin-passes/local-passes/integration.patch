+        (tmp_path / f"torchao-{short}.stderr").write_text(result.stderr)
+        oracle = json.loads(result.stdout)
+        assert all(z == 0 for z in oracle["zero_point"])
+        assert native["results"] == [[str(v) for v in oracle["scale_bits"] + oracle["q_bits"]]]
+
