diff --git a/merlin/lean/LocalPassesCandidate.lean b/merlin/lean/LocalPassesCandidate.lean
new file mode 100644
index 000000000..80f635906
--- /dev/null
+++ b/merlin/lean/LocalPassesCandidate.lean
@@ -0,0 +1,70 @@
+/- Separate provisional pass-local driver. Shared Main/CLI and frozen configuration are untouched. -/
+import MerlinVerify.Core.Json
+import MerlinVerify.Core.Print
+import MerlinVerify.Rules.LocalPassesChain
+open MerlinVerify Lean
+namespace LocalPassesDriver
+mutual
+  def allOps : List Op → List Op
+    | [] => []
+    | o@(.mk _ _ _ _ _ rs _) :: rest => o :: (regionOps rs ++ allOps rest)
+  def regionOps : List Region → List Op
+    | [] => []
+    | .mk bs :: rest => blockOps bs ++ regionOps rest
+  def blockOps : List Block → List Op
+    | [] => []
+    | .mk _ os :: rest => allOps os ++ blockOps rest
+end
+
+def readModule (path : String) : IO MerlinVerify.Module := do
+  match Decode.module (← IO.FS.readFile path) with
+  | .ok m => return m
+  | .error why => throw (IO.userError why)
+
+def inventory (m : MerlinVerify.Module) : Json :=
+  let types := ((Rules.FrontendBoolProgram.defsOps 64 m.ops).getD []).map fun v => (v.id, v.ty)
+  let casts := (allOps m.ops).filter fun o => o.name == "arith.sitofp" &&
+    o.operands.any (fun x => types.lookup x == some (.int 1))
+  Json.mkObj [("sites", toJson casts.length), ("formats", toJson
+    (casts.map fun o => o.results.map fun r => MerlinVerify.Print.ty r.ty)),
+    ("supported", toJson "scalar i1 to f32, including scalar bodies of tensor operations"),
+    ("unsupported", toJson ["f16", "bf16", "f64", "direct tensor cast", "source numeric attributes"])]
+
+def run (mode before after : String) (suffix : List String) : IO Json := do
+  let src ← readModule before
+  let tgt ← readModule after
+  let tail ← suffix.mapM readModule
+  if mode == "torchao-materialize" then
+    return Json.mkObj [("mlir", toJson ((Rules.TorchAOAffineProgram.materialize? src).map MerlinVerify.Print.module))]
+  if mode == "torchao-affine" then
+    let bodies := (allOps tgt.ops).filterMap fun o =>
+      if o.name == "linalg.generic" && o.attr? "prov.transforms" == some (.str "torchao_quantize_affine") then
+        match o.regions with
+        | [.mk [.mk args ops]] => some (Rules.TorchAOAffineScalar.checkBody args ops)
+        | _ => some false
+      else none
+    return Json.mkObj [("schema", toJson "merlin.local-passes.result.v1"),
+      ("accepted", toJson (Rules.LocalPassesChain.torchaoCheck src tgt tail)),
+      ("suffix_count", toJson tail.length),
+      ("status", toJson "materialized_contract_only"),
+      ("source_call_refinement_proved", toJson false), ("contract_review", toJson "pending"),
+      ("scalar_bodies", toJson bodies),
+      ("theorem", toJson "MerlinVerify.Rules.LocalPassesChain.torchao_sound"),
+      ("remaining", toJson ["capture version and recipe binding", "opaque-call/tensor execution bridge",
+        "AbsReductionCorrect", "ZeroPointElisionCorrect", "independent specification review"])]
+  unless mode == "bool-to-float" do throw (IO.userError "unsupported local pass")
+  return Json.mkObj [("schema", toJson "merlin.local-passes.result.v1"),
+    ("accepted", toJson (Rules.LocalPassesChain.boolCheck src tgt tail)),
+    ("suffix_count", toJson tail.length),
+    ("status", toJson "provisional_contract"), ("policy", toJson "frontend-bool-to-float"),
+    ("ordinary_source_equivalence", toJson false), ("whole_function_defined", toJson false),
+    ("theorem", toJson "MerlinVerify.Rules.LocalPassesChain.bool_sound"),
+    ("inventory", inventory src)]
+end LocalPassesDriver
+
+def main (args : List String) : IO UInt32 := do
+  let mode :: before :: after :: suffix := args | return 2
+  try
+    IO.println (← LocalPassesDriver.run mode before after suffix).compress
+    return 0
+  catch error => IO.eprintln error.toString; return 2
diff --git a/merlin/lean/MerlinVerify/Rules/BoolToFloat.lean b/merlin/lean/MerlinVerify/Rules/BoolToFloat.lean
new file mode 100644
index 000000000..6589f5ab5
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/BoolToFloat.lean
@@ -0,0 +1,137 @@
+/- Additive f32 frontend-intent proposal. The primitive is A2's boolToF32; its approval
+   is separate from the previously approved float-to-bool repair. No frozen file is changed. -/
+import MerlinVerify.Rules.FrontendBoolSimulation
+import Init.Data.Float.Model.Float32
+import Lean.Elab.Tactic.Omega
+
+namespace MerlinVerify.Rules.BoolToFloat
+open MerlinVerify MerlinVerify.Check
+open FrontendBoolProgram
+
+abbrev Types := List (ValueId × Ty)
+
+def unsignedKey : FloatOpKey :=
+  Sem.Ops.Arith.floatKey (.mk "arith.uitofp" [] [] [] [] [] [])
+
+/-- Precisely the two unsigned i1 conversions. Poison is handled outside FloatModel. -/
+def UnsignedBoolCorrect (M : FloatModel) : Prop :=
+  ∀ x : BitVec 1, M.ofInt unsignedKey 1 .f32 x =
+    if x.toNat = 0 then 0 else 0x3f800000
+
+/-- Use Lean's pre-existing IEEE ofNat, rather than a host cast or a postulated conversion law.
+    Only this key, width and format are overridden; other conversions remain parametric. -/
+def model (base : FloatModel) : FloatModel :=
+  { base with ofInt := fun key w k x =>
+      if key = unsignedKey ∧ w = 1 then
+        match k with
+        | .f32 => (Float32.Model.ofNat x.toNat).toBits.toBitVec
+        | k => base.ofInt key w k x
+      else base.ofInt key w k x }
+
+theorem ofNat_zero : (Float32.Model.ofNat 0).toBits.toBitVec = (0 : BitVec 32) := by decide
+theorem ofNat_one : (Float32.Model.ofNat 1).toBits.toBitVec = (0x3f800000 : BitVec 32) := by decide
+
+theorem model_correct (base : FloatModel) : UnsignedBoolCorrect (model base) := by
+  intro x
+  have hx := x.isLt
+  have hc : x.toNat = 0 ∨ x.toNat = 1 := by omega
+  rcases hc with h | h
+  · simp only [model, and_self, ↓reduceIte]
+    change (Float32.Model.ofNat x.toNat).toBits.toBitVec = _
+    rw [h, ofNat_zero]; rfl
+  · simp only [model, and_self, ↓reduceIte]
+    change (Float32.Model.ofNat x.toNat).toBits.toBitVec = _
+    rw [h, ofNat_one]; rfl
+
+/-- The independently stated primitive on well-typed inputs; an explicit off-domain extension
+    uses the unchanged parametric unsigned conversion on integers of other widths. This extension
+    permits exact stuck/UB correspondence without claiming totality of unchanged computations. -/
+def scalar (M : FloatModel) : Val → Outcome Val
+  | .poison => .ok (Spec.FrontendIntent.boolToF32 none)
+  | .some (.bits 1 x) =>
+      .ok (Spec.FrontendIntent.boolToF32 (some (x.toNat != 0)))
+  | .some (.bits w x) => .ok (.some (.flt .f32 (M.ofInt unsignedKey w .f32 x)))
+  | .some (.flt ..) => .stuck "*itofp of float"
+
+theorem scalar_correct (M : FloatModel) (h : UnsignedBoolCorrect M) (v : Val) :
+    (.ok (match v with
+      | .poison => .poison
+      | .some (.bits w x) => .some (.flt .f32 (M.ofInt unsignedKey w .f32 x))
+      | .some (.flt ..) => .poison) : Outcome Val) =
+    (match v with | .some (.flt ..) => .ok .poison | _ => scalar M v) := by
+  cases v with
+  | poison => rfl
+  | some a =>
+    cases a with
+    | flt k x => rfl
+    | bits w x =>
+      cases w with
+      | zero => rfl
+      | succ w =>
+        cases w with
+        | zero => simp [scalar, Spec.FrontendIntent.boolToF32, h x]
+        | succ w => rfl
+
+def cast (M : FloatModel) (args : List RVal) : Outcome (List RVal) :=
+  match args with
+  | [a] => do
+    let v ← liftEager (.float .f32) (fun | [x] => scalar M x | _ => .stuck "arity") [a]
+    pure [v]
+  | _ => .stuck "arith.uitofp: expected 1 operand"
+
+/-- Static source eligibility is recomputed from the actual source inventory. Scalar i1-to-f32
+    is supported; tensor casts and f16/bf16/f64 are refused by the complete-boundary inventory. -/
+def legalSource (types : Types) (o : Op) : Option (ValueId × Value) := do
+  if o.name != "arith.sitofp" then none else
+  let [src] := o.operands | none
+  let [result] := o.results | none
+  if result.ty != .float .f32 || types.lookup src != some (.int 1) then none else
+  if !o.regions.isEmpty || !o.successors.isEmpty || !o.props.isEmpty then none else
+  if !o.attrs.all (fun (k, _) => k.startsWith "prov.") then none else
+  pure (src, result)
+
+def sem (types : Types) : OpSem := fun ctx call op args regions =>
+  match legalSource types op with
+  | none => Sem.Ops.opSem ctx call op args regions
+  | some _ => cast ctx.M args
+
+def CastFacts (op : Op) : Prop :=
+  Sem.Ops.unmodelledAttr? op.blind = none ∧
+  Sem.Ops.dialectOf op.name = "arith" ∧ op.name = "arith.uitofp" ∧
+  Sem.Ops.Arith.resultElt op.blind = some (.float .f32) ∧
+  Sem.Ops.Arith.floatKey op.blind = unsignedKey ∧ hasUnit op.blind "nonNeg" = false
+instance (op : Op) : Decidable (CastFacts op) := inferInstanceAs (Decidable (_ ∧ _))
+
+theorem cast_exec (ctx : Ctx) (call : CallSem) (op : Op) (hf : CastFacts op)
+    (h : UnsignedBoolCorrect ctx.M) (args : List RVal) (regions : List (Ctx → RegionSem)) :
+    Sem.Ops.opSem ctx call op args regions = cast ctx.M args := by
+  obtain ⟨hm, hd, hn, hr, hk, hneg⟩ := hf
+  rw [Check.opSem_modelled hm]
+  simp only [Sem.Ops.dispatch, Check.Op.blind_name, hd]
+  simp only [Sem.Ops.Arith.sem, Check.Op.blind_name, hn, hr, hk, hneg,
+    Bool.and_false, Bool.false_and, Bool.false_eq_true, ↓reduceIte]
+  have heq : (fun v : Val => match v with
+      | .some (.bits w x) => (.ok (.some (.flt .f32 (ctx.M.ofInt unsignedKey w .f32 x))) : Outcome Val)
+      | .poison => .ok .poison
+      | _ => .stuck "*itofp of float") = scalar ctx.M := by
+    funext v
+    cases v with
+    | poison => rfl
+    | some a =>
+      cases a with
+      | flt k x => rfl
+      | bits w x => exact scalar_correct ctx.M h (.some (.bits w x))
+  trans Sem.Ops.Arith.unOp op.blind args (scalar ctx.M)
+  · exact congrArg (Sem.Ops.Arith.unOp op.blind args) heq
+  · cases args with
+    | nil => simp [Sem.Ops.Arith.unOp, cast, Check.Op.blind_name, hn]; rfl
+    | cons a rest => cases rest with
+      | nil => simp only [Sem.Ops.Arith.unOp, Sem.Ops.Arith.pureN, hr, cast, Outcome.bind_ok]; rfl
+      | cons b rest => simp [Sem.Ops.Arith.unOp, cast, Check.Op.blind_name, hn]; rfl
+theorem poison (M : FloatModel) : scalar M .poison = .ok (Spec.FrontendIntent.boolToF32 none) := rfl
+theorem false_positive_zero (M : FloatModel) :
+    scalar M (.some (.bits 1 0)) = .ok (.some (.flt .f32 0)) := rfl
+theorem true_positive_one (M : FloatModel) :
+    scalar M (.some (.bits 1 1)) = .ok (.some (.flt .f32 0x3f800000)) := rfl
+
+end MerlinVerify.Rules.BoolToFloat
diff --git a/merlin/lean/MerlinVerify/Rules/BoolToFloatProgram.lean b/merlin/lean/MerlinVerify/Rules/BoolToFloatProgram.lean
new file mode 100644
index 000000000..7916cc3bf
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/BoolToFloatProgram.lean
@@ -0,0 +1,390 @@
+/- Complete-program correspondence for fix_bool_sitofp's f32 frontend intent.
+Every changed site is recomputed from the source AST; all remaining syntax, SSA, nested regions,
+function lookup and calls are checked. This proves a local repair policy, not original signed-i1
+cast equivalence or defined execution of every unchanged model operation. Contract admission is pending. -/
+import MerlinVerify.Rules.BoolToFloat
+
+namespace MerlinVerify.Rules.BoolToFloatProgram
+open MerlinVerify MerlinVerify.Check
+open FrontendBoolProgram (defsOps sourceTypes)
+open BoolToFloat
+open FrontendBoolSimulation (EnvRel envRel_bind bind_corr)
+
+/-- Single-site acceptance checks the unsigned key, nonNeg, types, operands and SSA freshness. -/
+def site (ρ : Rho) (source : Nat) (result : Value) (target : Op) : Option Rho :=
+  match target.results, target.operands with
+  | [r], [lhs] =>
+    if ρ.find source = some lhs ∧ target.regions = [] ∧ CastFacts target ∧
+        r.ty = .float .f32 ∧ freshIds ρ [r.id] = true
+    then some ((result.id, r.id) :: ρ) else none
+  | _, _ => none
+
+mutual
+  def ops (types : Types) (ρ : Rho) : List Op → List Op → Bool
+    | [], [] => true
+    | s :: ss, ts =>
+      match legalSource types s with
+      | some (source, result) =>
+        match ts with
+        | t :: rest =>
+          match site ρ source result t with
+          | some next => ops types next ss rest
+          | none => false
+        | _ => false
+      | none =>
+        match ts with
+        | t :: rest => match operation types ρ s t with
+          | some next => ops types next ss rest
+          | none => false
+        | [] => false
+    | _, _ => false
+
+  def operation (types : Types) (ρ : Rho) : Op → Op → Option Rho
+    | s@(.mk _ resS opsS _ _ regsS _), t@(.mk _ resT opsT _ _ regsT _) =>
+      if opHeadEq s t && opsS.mapM ρ.find == some opsT && regions types ρ regsS regsT &&
+          freshIds ρ (resT.map (·.id))
+      then some ((resS.map (·.id)).zip (resT.map (·.id)) ++ ρ) else none
+
+  def regions (types : Types) (ρ : Rho) : List Region → List Region → Bool
+    | [], [] => true
+    | r :: rs, t :: ts => region types ρ r t && regions types ρ rs ts
+    | _, _ => false
+
+  def region (types : Types) (ρ : Rho) : Region → Region → Bool
+    | .mk [.mk argsS ss], .mk [.mk argsT ts] =>
+      argsS.map (·.ty) == argsT.map (·.ty) && freshIds ρ (argsT.map (·.id)) &&
+        ops types ((argsS.map (·.id)).zip (argsT.map (·.id)) ++ ρ) ss ts
+    | .mk [], .mk [] => true
+    | _, _ => false
+end
+
+theorem legal_facts {types : Types} {op : Op} {source : Nat} {result : Value}
+    (h : legalSource types op = some (source, result)) :
+    op.operands = [source] ∧ op.results = [result] ∧ result.ty = .float .f32 ∧
+    op.isTerminator = false := by
+  unfold legalSource at h
+  repeat' first | (split at h <;> simp_all [Op.isTerminator, terminatorNames])
+  all_goals rcases h with ⟨⟨hty, _⟩, _, _, hs, hr⟩; subst_vars; assumption
+
+theorem site_spec {ρ next : Rho} {source : Nat} {result : Value} {target : Op}
+    (h : site ρ source result target = some next) :
+    ∃ r lhs, target.results = [r] ∧ target.operands = [lhs] ∧
+      ρ.find source = some lhs ∧ target.regions = [] ∧ CastFacts target ∧
+      r.ty = .float .f32 ∧ freshIds ρ [r.id] = true ∧ next = (result.id, r.id) :: ρ := by
+  unfold site at h
+  split at h
+  · next r lhs hr hop =>
+    split at h
+    · next hf => exact ⟨r, lhs, hr, hop, hf.1, hf.2.1, hf.2.2.1, hf.2.2.2.1,
+        hf.2.2.2.2, (Option.some.inj h).symm⟩
+    · simp at h
+  · simp at h
+
+theorem site_nonterm {ρ next : Rho} {source : Nat} {result : Value} {target : Op}
+    (h : site ρ source result target = some next) : target.isTerminator = false := by
+  obtain ⟨_, _, _, _, _, _, hf, _, _, _⟩ := site_spec h
+  simp [Op.isTerminator, hf.2.2.1, terminatorNames]
+
+theorem site_step {types : Types} {ρ next : Rho} {source : Nat} {result : Value}
+    {s t : Op} (hl : legalSource types s = some (source, result))
+    (hs : site ρ source result t = some next)
+    (ctx : Ctx) (hu : UnsignedBoolCorrect ctx.M) (callS callT : CallSem)
+    {es et : Env} (hc : Corr ρ es et) :
+    EnvRel next (stepOp (BoolToFloat.sem types) ctx callS es s)
+      (stepOp Sem.Ops.opSem ctx callT et t) := by
+  obtain ⟨hsoperands, hsresults, _, _⟩ := legal_facts hl
+  obtain ⟨r, lhs, htresults, htoperands, hmap, hregs, hf, _, hfresh, rfl⟩ := site_spec hs
+  have hread : es.getAll [source] = et.getAll [lhs] :=
+    Corr.getAll hc _ _ (by simp [hmap])
+  simp only [stepOp, hsoperands, htoperands, hsresults, htresults]
+  simp only [BoolToFloat.sem, hl]
+  rw [hread]
+  cases he : et.getAll [lhs] with
+  | ub => trivial
+  | stuck reason => rfl
+  | ok args =>
+    simp only [Outcome.bind_ok]
+    rw [cast_exec ctx callT t hf hu args]
+    cases hv : cast ctx.M args with
+    | ub => trivial
+    | stuck reason => rfl
+    | ok rs => simpa using bind_corr hc [result] [r] rs rfl hfresh
+
+theorem operation_spec {types : Types} {ρ next : Rho} {s t : Op}
+    (h : operation types ρ s t = some next) :
+    opHeadEq s t = true ∧ s.operands.mapM ρ.find = some t.operands ∧
+    regions types ρ s.regions t.regions = true ∧ freshIds ρ (t.results.map (·.id)) = true ∧
+    next = (s.results.map (·.id)).zip (t.results.map (·.id)) ++ ρ := by
+  cases s with
+  | mk ns ss os as ps rs us =>
+    cases t with
+    | mk nt st ot attrsT pt rt ut =>
+      simp only [operation] at h
+      split at h
+      · next hc =>
+        simp only [Option.some.injEq] at h
+        simp only [Bool.and_eq_true, beq_iff_eq] at hc
+        exact ⟨hc.1.1.1, hc.1.1.2, hc.1.2, hc.2, h.symm⟩
+      · simp at h
+
+theorem ops_isEmpty {types : Types} {ρ : Rho} {ss ts : List Op}
+    (h : ops types ρ ss ts = true) : ss.isEmpty = ts.isEmpty := by
+  cases ss with
+  | nil => cases ts <;> simp_all [ops]
+  | cons s ss =>
+    cases ts with
+    | cons t ts => rfl
+    | nil => cases hl : legalSource types s <;> simp_all [ops]
+
+mutual
+  /-- Exact execution simulation of the complete block, with no supplied site-occurrence,
+source-value, freshness or initializedness premises. All SSA facts come from the checker. -/
+  theorem ops_sound (types : Types) (call : CallSem) :
+      ∀ (ρ : Rho) (ss ts : List Op) (ctx : Ctx) (es et : Env),
+        ops types ρ ss ts = true → UnsignedBoolCorrect ctx.M → Corr ρ es et →
+        evalOps (BoolToFloat.sem types) ctx call es ss =
+          evalOps Sem.Ops.opSem ctx call et ts
+    | _, [], [], _, _, _, _, _, _ => rfl
+    | ρ, (.mk ns ss os ats ps rs us) :: rest, ts, ctx, es, et, h, hu, hc => by
+      unfold ops at h
+      split at h
+      · next source result hl =>
+        cases ts with
+        | nil => simp at h
+        | cons t targetRest =>
+          simp only at h
+          split at h
+          · next next hs =>
+            obtain ⟨_, _, _, hterm⟩ := legal_facts hl
+            have htterm := site_nonterm hs
+            rw [evalOps_cons_step _ _ _ _ _ _ hterm,
+              evalOps_cons_step _ _ _ _ _ _ htterm]
+            exact envRel_bind (site_step hl hs ctx hu call call hc) _ _
+              (fun es' et' hc' => ops_sound types call next rest targetRest ctx es' et' h hu hc')
+          · simp at h
+      · next hl =>
+        cases ts with
+        | nil => simp at h
+        | cons t targetRest =>
+          simp only at h
+          split at h
+          · next next ho =>
+            obtain ⟨hhead, hmap, hregions, hfresh, rfl⟩ := operation_spec ho
+            have hterm := isTerminator_of_opHeadEq hhead
+            have hblind := blind_of_opHeadEq hhead
+            have hlen := results_length_of_opHeadEq hhead
+            have hread := Corr.getAll hc _ _ hmap
+            cases t with
+            | mk nt st ot att pt rt ut =>
+              dsimp only [Op.operands] at hread
+              rw [evalOps.eq_2, evalOps.eq_2]
+              by_cases ht : (Op.mk nt st ot att pt rt ut).isTerminator = true
+              · rw [ite_eq_left (hterm.trans ht), ite_eq_left ht, ops_isEmpty h, hread]
+              · rw [ite_eq_right (by rwa [hterm]), ite_eq_right ht, hread]
+                cases et.getAll ot with
+                | ub => rfl
+                | stuck reason => rfl
+                | ok args =>
+                  simp only [Outcome.bind_ok, BoolToFloat.sem, hl]
+                  have hr := regions_sound types call ρ rs rt ctx es et hregions hu hc
+                  rw [FrontendBoolContext.opSem_regions ctx call _ args _ _ hr,
+                    Sem.Ops.opSem_blind hblind]
+                  cases Sem.Ops.opSem ctx call (.mk nt st ot att pt rt ut) args
+                      (evalRegions Sem.Ops.opSem call et rt) with
+                  | ub => rfl
+                  | stuck reason => rfl
+                  | ok results =>
+                    simp only [Outcome.bind_ok]
+                    exact envRel_bind (bind_corr hc _ _ results hlen hfresh) _ _
+                      (fun es' et' hc' => ops_sound types call _ rest targetRest ctx es' et' h hu hc')
+          · simp at h
+    | _, [], _ :: _, _, _, _, h, _, _ => by simp [ops] at h
+
+  theorem regions_sound (types : Types) (call : CallSem) :
+      ∀ (ρ : Rho) (rs ts : List Region) (ctx : Ctx) (es et : Env),
+        regions types ρ rs ts = true → UnsignedBoolCorrect ctx.M → Corr ρ es et →
+        (evalRegions (BoolToFloat.sem types) call es rs).map (FrontendBoolContext.pin ctx) =
+          (evalRegions Sem.Ops.opSem call et ts).map (FrontendBoolContext.pin ctx)
+    | _, [], [], _, _, _, _, _, _ => rfl
+    | ρ, r :: rs, t :: ts, ctx, es, et, h, hu, hc => by
+      simp only [regions, Bool.and_eq_true] at h
+      simp only [evalRegions, List.map_cons, List.cons.injEq]
+      refine ⟨?_, regions_sound types call ρ rs ts ctx es et h.2 hu hc⟩
+      funext inner args
+      exact congrFun (region_sound types call ρ r t
+        { ctx with loopIndex := inner.loopIndex } es et h.1 hu hc) args
+    | _, [], _ :: _, _, _, _, h, _, _ => by simp [regions] at h
+    | _, _ :: _, [], _, _, _, h, _, _ => by simp [regions] at h
+
+  theorem region_sound (types : Types) (call : CallSem) :
+      ∀ (ρ : Rho) (s t : Region) (ctx : Ctx) (es et : Env),
+        region types ρ s t = true → UnsignedBoolCorrect ctx.M → Corr ρ es et →
+        evalRegion (BoolToFloat.sem types) ctx call es s =
+          evalRegion Sem.Ops.opSem ctx call et t
+    | ρ, .mk [.mk argsS ss], .mk [.mk argsT ts], ctx, es, et, h, hu, hc => by
+      simp only [region, Bool.and_eq_true, beq_iff_eq] at h
+      obtain ⟨⟨hty, hfresh⟩, hops⟩ := h
+      have hl : argsS.length = argsT.length := by simpa using congrArg List.length hty
+      simp only [evalRegion, evalBlocks, evalBlock]
+      funext vals
+      exact envRel_bind (bind_corr hc argsS argsT vals hl hfresh) _ _
+        (fun es' et' hc' => ops_sound types call _ ss ts ctx es' et' hops hu hc')
+    | _, .mk [], .mk [], _, _, _, _, _, _ => rfl
+    | _, .mk [], .mk (_ :: _ :: _), _, _, _, h, _, _ => by simp [region] at h
+    | _, .mk (_ :: _ :: _), .mk [], _, _, _, h, _, _ => by simp [region] at h
+    | _, .mk (_ :: _ :: _), .mk (_ :: _ :: _), _, _, _, h, _, _ => by simp [region] at h
+    | _, .mk [], .mk [_], _, _, _, h, _, _ => by simp [region] at h
+    | _, .mk [_], .mk [], _, _, _, h, _, _ => by simp [region] at h
+    | _, .mk [_], .mk (_ :: _ :: _), _, _, _, h, _, _ => by simp [region] at h
+    | _, .mk (_ :: _ :: _), .mk [_], _, _, _, h, _, _ => by simp [region] at h
+end
+
+def function (types : Types) (s t : Func) : Bool :=
+  s.name == t.name && s.isDecl == t.isDecl && region types [] s.body t.body
+
+def functions (types : Types) : List Func → List Func → Bool
+  | [], [] => true
+  | s :: ss, t :: ts => function types s t && functions types ss ts
+  | _, _ => false
+
+theorem function_spec {types : Types} {s t : Func} (h : function types s t = true) :
+    s.name = t.name ∧ s.isDecl = t.isDecl ∧ region types [] s.body t.body = true := by
+  simpa only [function, Bool.and_eq_true, beq_iff_eq, and_assoc] using h
+
+def Found (types : Types) : Option Func → Option Func → Prop
+  | none, none => True
+  | some s, some t => function types s t = true
+  | _, _ => False
+
+theorem functions_find {types : Types} : ∀ (ss ts : List Func),
+    functions types ss ts = true → ∀ name,
+      Found types (ss.find? (·.name == name)) (ts.find? (·.name == name))
+  | [], [], _, _ => trivial
+  | s :: ss, t :: ts, h, name => by
+    simp only [functions, Bool.and_eq_true] at h
+    have hn := (function_spec h.1).1
+    simp only [List.find?_cons, hn]
+    split
+    · exact h.1
+    · exact functions_find ss ts h.2 name
+  | [], _ :: _, h, _ => by simp [functions] at h
+  | _ :: _, [], h, _ => by simp [functions] at h
+
+theorem functions_length {types : Types} : ∀ (ss ts : List Func),
+    functions types ss ts = true → ss.length = ts.length
+  | [], [], _ => rfl
+  | _ :: ss, _ :: ts, h => by
+    simp only [functions, Bool.and_eq_true] at h
+    simpa using functions_length ss ts h.2
+  | [], _ :: _, h => by simp [functions] at h
+  | _ :: _, [], h => by simp [functions] at h
+
+/-- Fuel, symbol lookup, external declarations and calls are preserved. Region execution is
+proved using the actual evaluator and the checked SSA correspondence, including tensor bodies. -/
+theorem evalFunc_sound {types : Types} {src tgt : Module}
+    (h : functions types src.funcs tgt.funcs = true) (ctx : Ctx) (hu : UnsignedBoolCorrect ctx.M) :
+    ∀ fuel, evalFunc (BoolToFloat.sem types) ctx src fuel =
+      evalFunc Sem.Ops.opSem ctx tgt fuel := by
+  intro fuel
+  induction fuel with
+  | zero => rfl
+  | succ fuel ih =>
+    funext name args
+    have hf := functions_find src.funcs tgt.funcs h name
+    change Found types (src.func? name) (tgt.func? name) at hf
+    cases hs : src.func? name with
+    | none =>
+      cases ht : tgt.func? name with
+      | none => simp [evalFunc, hs, ht]
+      | some t => simp [hs, ht, Found] at hf
+    | some s =>
+      cases ht : tgt.func? name with
+      | none => simp [hs, ht, Found] at hf
+      | some t =>
+        simp only [hs, ht, Found] at hf
+        obtain ⟨_, hd, hr⟩ := function_spec hf
+        simp only [evalFunc, hs, ht, hd]
+        split
+        · rfl
+        · rw [ih]
+          exact congrFun (region_sound types (evalFunc Sem.Ops.opSem ctx tgt fuel)
+            [] s.body t.body ctx [] [] hr hu (by intro x y hxy; simp [Rho.find] at hxy)) args
+
+/-- Source-driven exact materialization used solely for complete syntax accounting.
+The source execution policy above invokes A2 directly and never consults this materialization. -/
+def replacement (o : Op) : Op :=
+  let kept : List (String × Attr) := o.attrs.filter fun (k, _) => k.startsWith "prov."
+  let previous := match kept.lookup "prov.transforms" with
+    | some (Attr.str s) => s.splitOn "," | _ => []
+  let chain := previous.filter (· != "") ++ ["bool_sitofp_uitofp"]
+  let attrs := (kept.filter (fun (k, _) => k != "prov.transforms") ++
+    [("prov.transforms", Attr.str (String.intercalate "," chain))]).mergeSort (fun a b => a.1 ≤ b.1)
+  .mk "arith.uitofp" o.results o.operands attrs [] [] []
+
+def rewriteOps (types : Types) : Nat → List Op → StateT Nat Option (List Op)
+  | 0, _ => failure
+  | fuel + 1, os => os.mapM fun o => do
+    if o.name == "arith.sitofp" && o.operands.any (fun x => types.lookup x == some (.int 1)) then
+      let some _ := legalSource types o | failure
+      modify (· + 1)
+      return replacement o
+    let rs ← o.regions.mapM fun r => do
+      let bs ← r.blocks.mapM fun b => do
+        let children ← rewriteOps types fuel b.ops
+        pure (.mk b.args children : Block)
+      pure (.mk bs : Region)
+    match o with
+    | .mk n res args attrs props _ successors => pure (.mk n res args attrs props rs successors)
+
+def intent? (src : Module) : Option Module := do
+  let defs ← defsOps 64 src.ops
+  if !decide (defs.map (·.id)).Nodup then none else
+  let (ops, count) ← (rewriteOps (sourceTypes defs) 64 src.ops).run 0
+  if count == 0 then none else pure {src with ops}
+
+def structural (src tgt : Module) : Bool :=
+  match intent? src with
+  | none => false
+  | some intended => decide (intended.attrs = tgt.attrs ∧ intended.props = tgt.props) &&
+      alphaOps [] intended.ops tgt.ops &&
+      (outsideChanges intended tgt).unverified.isEmpty
+
+def check (src tgt : Module) : Bool :=
+  structural src tgt &&
+    match defsOps 64 src.ops with
+    | none => false
+    | some defs => functions (sourceTypes defs) src.funcs tgt.funcs
+
+/-- No construction or reference to target syntax occurs in the source policy denotation. -/
+def policyDenote (src : Module) (ctx : Ctx) (name : String) (args : List RVal) :
+    Outcome (List RVal) :=
+  match defsOps 64 src.ops with
+  | none => .stuck "bool-to-float source inventory exceeds supported nesting"
+  | some defs => denote (BoolToFloat.sem (sourceTypes defs)) ctx src name args
+
+/-- Complete-program execution of the declared repair policy, with the conversion assumption
+explicit. The result covers internal calls, poison, tensor-region lifting, UB and stuck outcomes;
+it makes no initialized-return or original signed-cast equivalence claim. -/
+theorem check_sound {src tgt : Module} (h : check src tgt = true)
+    (ctx : Ctx) (hu : UnsignedBoolCorrect ctx.M) (name : String) (args : List RVal) :
+    policyDenote src ctx name args = denote Sem.Ops.opSem ctx tgt name args := by
+  simp only [check, Bool.and_eq_true] at h
+  cases hd : defsOps 64 src.ops with
+  | none => simp [hd] at h
+  | some defs =>
+    simp only [hd] at h
+    have heq := evalFunc_sound h.2 ctx hu
+    have hlen := functions_length src.funcs tgt.funcs h.2
+    simp only [policyDenote, hd, denote]
+    rw [heq, hlen]
+
+/-- The only float premise is discharged by the pre-existing IEEE ofNat interpretation.
+The f32 bool-to-float contract remains provisional pending its independent approval. -/
+theorem check_sound_ieee {src tgt : Module} (h : check src tgt = true)
+    (base : FloatModel) (ctx : Ctx) (name : String) (args : List RVal) :
+    policyDenote src {ctx with M := model base} name args =
+      denote Sem.Ops.opSem {ctx with M := model base} tgt name args :=
+  check_sound h _ (model_correct base) name args
+
+#print axioms check_sound_ieee
+end MerlinVerify.Rules.BoolToFloatProgram
diff --git a/merlin/lean/MerlinVerify/Rules/LocalPassesChain.lean b/merlin/lean/MerlinVerify/Rules/LocalPassesChain.lean
new file mode 100644
index 000000000..56e7d70ff
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/LocalPassesChain.lean
@@ -0,0 +1,63 @@
+/- Ordered pass-local pipeline composition. Repair matching is kept distinct from original
+source equivalence, and the provisional TorchAO materialization claim is never promoted into
+captured-call refinement. Every supplied suffix boundary is checked by Lean. -/
+import MerlinVerify.Rules.BoolToFloatProgram
+import MerlinVerify.Rules.TorchAOAffineProgram
+
+namespace MerlinVerify.Rules.LocalPassesChain
+open MerlinVerify
+
+def suffix (first : Module) : List Module → Bool
+  | [] => true
+  | next :: rest => LocalProgramCorrespondence.check first next && suffix next rest
+
+def final (first : Module) : List Module → Module
+  | [] => first
+  | next :: rest => final next rest
+
+theorem suffix_sound (first : Module) : ∀ tail, suffix first tail = true →
+    ∀ (ctx : Ctx) (name : String) (args : List RVal),
+      denote Sem.Ops.opSem ctx first name args =
+        denote Sem.Ops.opSem ctx (final first tail) name args
+  | [], _, _, _, _ => rfl
+  | next :: rest, h, ctx, name, args => by
+    simp only [suffix, Bool.and_eq_true] at h
+    exact (LocalProgramCorrespondence.check_sound h.1 ctx name args).trans
+      (suffix_sound next rest h.2 ctx name args)
+
+def boolCheck (src repaired : Module) (tail : List Module) : Bool :=
+  BoolToFloatProgram.check src repaired && suffix repaired tail
+
+/-- Composition preserves the declared f32 repair policy, including poison and failed outcomes.
+It does not weaken the policy claim to ordinary equivalence with a signed-i1 conversion. -/
+theorem bool_sound {src repaired : Module} {tail : List Module}
+    (h : boolCheck src repaired tail = true) (base : FloatModel)
+    (ctx : Ctx) (name : String) (args : List RVal) :
+    BoolToFloatProgram.policyDenote src {ctx with M := BoolToFloat.model base} name args =
+      denote Sem.Ops.opSem {ctx with M := BoolToFloat.model base} (final repaired tail) name args := by
+  simp only [boolCheck, Bool.and_eq_true] at h
+  exact (BoolToFloatProgram.check_sound_ieee h.1 base ctx name args).trans
+    (suffix_sound repaired tail h.2 _ name args)
+
+def torchaoCheck (src lowered : Module) (tail : List Module) : Bool :=
+  TorchAOAffineProgram.check src lowered && suffix lowered tail
+
+/-- A complete materialized-contract execution claim with an explicit source-derived witness.
+The missing captured-call/tensor reference connection remains outside this statement. -/
+theorem torchao_sound {src lowered : Module} {tail : List Module}
+    (h : torchaoCheck src lowered tail = true) :
+    ∃ intended, TorchAOAffineProgram.materialize? src = some intended ∧
+      ∀ (ctx : Ctx) (name : String) (args : List RVal),
+        denote Sem.Ops.opSem ctx intended name args =
+          denote Sem.Ops.opSem ctx (final lowered tail) name args := by
+  simp only [torchaoCheck, Bool.and_eq_true] at h
+  cases hi : TorchAOAffineProgram.materialize? src with
+  | none => simp [TorchAOAffineProgram.check, hi] at h
+  | some intended =>
+    refine ⟨intended, rfl, fun ctx name args => ?_⟩
+    exact ((TorchAOAffineProgram.check_sound hi h.1).2 ctx name args).trans
+      (suffix_sound lowered tail h.2 ctx name args)
+
+#print axioms bool_sound
+#print axioms torchao_sound
+end MerlinVerify.Rules.LocalPassesChain
diff --git a/merlin/lean/MerlinVerify/Rules/LocalProgramCorrespondence.lean b/merlin/lean/MerlinVerify/Rules/LocalProgramCorrespondence.lean
new file mode 100644
index 000000000..74ec40473
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/LocalProgramCorrespondence.lean
@@ -0,0 +1,100 @@
+/- Exact whole-program alpha correspondence, including internal calls, for local contracts.
+No definedness obligation is imposed on unchanged computations. Unsupported operations retain
+their exact stuck outcomes; this theorem does not claim they have been verified individually. -/
+import MerlinVerify.Check.Module
+
+namespace MerlinVerify.Rules.LocalProgramCorrespondence
+open MerlinVerify MerlinVerify.Check
+
+def function (s t : Func) : Bool :=
+  s.name == t.name && s.isDecl == t.isDecl && alphaRegion [] s.body t.body
+
+def functions : List Func → List Func → Bool
+  | [], [] => true
+  | s :: ss, t :: ts => function s t && functions ss ts
+  | _, _ => false
+
+theorem function_spec {s t : Func} (h : function s t = true) :
+    s.name = t.name ∧ s.isDecl = t.isDecl ∧ alphaRegion [] s.body t.body = true := by
+  simpa only [function, Bool.and_eq_true, beq_iff_eq, and_assoc] using h
+
+def Found : Option Func → Option Func → Prop
+  | none, none => True
+  | some s, some t => function s t = true
+  | _, _ => False
+
+theorem functions_find : ∀ (ss ts : List Func),
+    functions ss ts = true → ∀ name,
+      Found (ss.find? (·.name == name)) (ts.find? (·.name == name))
+  | [], [], _, _ => trivial
+  | s :: ss, t :: ts, h, name => by
+    simp only [functions, Bool.and_eq_true] at h
+    have hn := (function_spec h.1).1
+    simp only [List.find?_cons, hn]
+    split
+    · exact h.1
+    · exact functions_find ss ts h.2 name
+  | [], _ :: _, h, _ => by simp [functions] at h
+  | _ :: _, [], h, _ => by simp [functions] at h
+
+theorem functions_length : ∀ (ss ts : List Func),
+    functions ss ts = true → ss.length = ts.length
+  | [], [], _ => rfl
+  | _ :: ss, _ :: ts, h => by
+    simp only [functions, Bool.and_eq_true] at h
+    simpa using functions_length ss ts h.2
+  | [], _ :: _, h => by simp [functions] at h
+  | _ :: _, [], h => by simp [functions] at h
+
+/-- Fuel, symbol lookup, external declarations and calls are preserved. Region execution is
+proved using the actual evaluator and the checked SSA correspondence, including tensor bodies. -/
+theorem evalFunc_sound {src tgt : Module}
+    (h : functions src.funcs tgt.funcs = true) (ctx : Ctx) :
+    ∀ fuel, evalFunc Sem.Ops.opSem ctx src fuel =
+      evalFunc Sem.Ops.opSem ctx tgt fuel := by
+  intro fuel
+  induction fuel with
+  | zero => rfl
+  | succ fuel ih =>
+    funext name args
+    have hf := functions_find src.funcs tgt.funcs h name
+    change Found (src.func? name) (tgt.func? name) at hf
+    cases hs : src.func? name with
+    | none =>
+      cases ht : tgt.func? name with
+      | none => simp [evalFunc, hs, ht]
+      | some t => simp [hs, ht, Found] at hf
+    | some s =>
+      cases ht : tgt.func? name with
+      | none => simp [hs, ht, Found] at hf
+      | some t =>
+        simp only [hs, ht, Found] at hf
+        obtain ⟨_, hd, hr⟩ := function_spec hf
+        simp only [evalFunc, hs, ht, hd]
+        split
+        · rfl
+        · rw [ih]
+          exact congrFun (alphaRegion_sound
+            (evalFunc Sem.Ops.opSem ctx tgt fuel) (evalFunc Sem.Ops.opSem ctx tgt fuel)
+            [] s.body t.body ctx [] [] hr
+            (by intro x y hxy; simp [Rho.find] at hxy) (fun _ _ => rfl)) args
+
+/-- Full AST, metadata and function correspondence. No greedy rewrite synthesis is needed
+for unchanged computations; repeated constants and internal calls remain ordinary alpha cases. -/
+def check (src tgt : Module) : Bool :=
+  (alphaOps [] src.ops tgt.ops && (outsideChanges src tgt).unverified.isEmpty &&
+    decide (src.attrs = tgt.attrs ∧ src.props = tgt.props)) && functions src.funcs tgt.funcs
+
+/-- The complete programs agree for every context, external interpretation, function and input.
+The induction covers every call fuel rather than assuming an execution bound or acyclic calls. -/
+theorem check_sound {src tgt : Module} (h : check src tgt = true)
+    (ctx : Ctx) (name : String) (args : List RVal) :
+    denote Sem.Ops.opSem ctx src name args = denote Sem.Ops.opSem ctx tgt name args := by
+  simp only [check, Bool.and_eq_true] at h
+  have he := evalFunc_sound h.2 ctx
+  have hl := functions_length src.funcs tgt.funcs h.2
+  simp only [denote]
+  rw [he, hl]
+
+#print axioms check_sound
+end MerlinVerify.Rules.LocalProgramCorrespondence
diff --git a/merlin/lean/MerlinVerify/Rules/TorchAOAffineContract.lean b/merlin/lean/MerlinVerify/Rules/TorchAOAffineContract.lean
new file mode 100644
index 000000000..c1e427388
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/TorchAOAffineContract.lean
@@ -0,0 +1,85 @@
+/- PROVISIONAL reference contract, not an admitted Spec declaration.
+Reference: TorchAO 0.15.0/0.16.0 quant_api._int8_symm_per_token_reduced_range_quant,
+quant_primitives._choose_qparams_affine and _quantize_affine_no_dtype_cast.
+This proposal is implementation-aware and requires an independent specification review.
+It is applicable only when the actual capture receipt binds this dynamic per-token recipe;
+the selected Gemmini static recipes do not establish that premise. -/
+import MerlinVerify.Rules.DequantScalar
+
+namespace MerlinVerify.Rules.TorchAOAffineContract
+open MerlinVerify
+
+def key (name : String) : FloatOpKey :=
+  {op := name, modifiers := "fm1:0;rm4:none;pred4:none"}
+
+def f (M : FloatModel) (name : String) (xs : List (FBits .f32)) : FBits .f32 :=
+  M.op (key name) .f32 xs
+
+/-- MLIR conversion extension. Agreement with Torch's integer cast requires a finite,
+in-range result domain; Torch's observed NaN-to-int behavior is not an MLIR poison law. -/
+def asInt (M : FloatModel) (x : FBits .f32) : Val :=
+  match M.toInt (key "arith.fptosi") .f32 8 x with
+  | none => .poison
+  | some n => .some (.bits 8 n)
+
+def clamp (M : FloatModel) (x : FBits .f32) : FBits .f32 :=
+  f M "arith.minimumf" [f M "arith.maximumf" [x, 0xc2fe0000], 0x42fe0000]
+
+/-- The reference includes the integer-domain zero point added AFTER half-even rounding.
+No reassociation, division substitution or zero-addition law is assumed here. -/
+def quantize (M : FloatModel) (x scale : FBits .f32) : Val :=
+  let reciprocal := f M "arith.divf" [0x3f800000, scale]
+  let product := f M "arith.mulf" [x, reciprocal]
+  let rounded := f M "math.roundeven" [product]
+  let shifted := f M "arith.addf" [rounded, 0]
+  asInt M (clamp M shifted)
+
+/-- The exact expression implemented without an explicit zero-point addition. Its equality
+to the versioned reference requires the separately named elision obligation below. -/
+def quantizeWithoutZero (M : FloatModel) (x scale : FBits .f32) : Val :=
+  let reciprocal := f M "arith.divf" [0x3f800000, scale]
+  let product := f M "arith.mulf" [x, reciprocal]
+  let rounded := f M "math.roundeven" [product]
+  asInt M (clamp M rounded)
+
+/-- Exact remaining IEEE-model obligation. It concerns the final integer/poison result,
+allowing the reference's zero addition to change a negative zero's sign. -/
+def ZeroPointElisionCorrect (M : FloatModel) : Prop :=
+  ∀ x scale, quantize M x scale = quantizeWithoutZero M x scale
+
+def floorScale (M : FloatModel) (maxAbs : FBits .f32) : FBits .f32 :=
+  f M "arith.maximumf" [f M "arith.divf" [maxAbs, 0x42fe0000], 0x3727c5ac]
+
+/-- The source reference explicitly reduces min/max, includes zero, negates the lower bound,
+and divides by 127 before applying the f32 1e-5 floor. Empty reduction admission is separate. -/
+def choose (M : FloatModel) (xs : List (FBits .f32)) : FBits .f32 :=
+  let lo := xs.foldl (fun a x => f M "arith.minimumf" [a, x]) 0x7f800000
+  let hi := xs.foldl (fun a x => f M "arith.maximumf" [a, x]) 0xff800000
+  let lo := f M "arith.minimumf" [lo, 0]
+  let hi := f M "arith.maximumf" [hi, 0]
+  floorScale M (f M "arith.maximumf" [f M "arith.negf" [lo], hi])
+
+def chooseAbsFold (M : FloatModel) (xs : List (FBits .f32)) : FBits .f32 :=
+  floorScale M (xs.foldl (fun a x => f M "arith.maximumf" [a, f M "math.absf" [x]]) 0)
+
+/-- Exact remaining reduction obligation, including NaN, infinity and signed-zero behavior.
+The reference's two reductions cannot be equated to abs/max by uninterpreted-float algebra. -/
+def AbsReductionCorrect (M : FloatModel) : Prop :=
+  ∀ xs, xs ≠ [] → choose M xs = chooseAbsFold M xs
+
+/-- A countermodel documents why no theorem for every frozen FloatModel can drop the +zero.
+This is a mathematical witness, not a proposed IEEE interpretation. -/
+def countermodel : FloatModel where
+  op := fun k _ xs => if k.op = "arith.addf" then 0 else xs.headD 0
+  cmp := fun _ _ _ _ => false
+  convert := fun _ _ _ x => BitVec.ofNat _ x.toNat
+  toInt := fun _ _ w x => some (BitVec.ofNat w x.toNat)
+  ofInt := fun _ _ _ x => BitVec.ofNat _ x.toNat
+
+theorem elision_not_parametric : ¬ (∀ M, ZeroPointElisionCorrect M) := by
+  intro h
+  have he := h countermodel (1 : FBits .f32) (1 : FBits .f32)
+  have hn : quantize countermodel 1 1 ≠ quantizeWithoutZero countermodel 1 1 := by decide
+  exact hn he
+
+end MerlinVerify.Rules.TorchAOAffineContract
diff --git a/merlin/lean/MerlinVerify/Rules/TorchAOAffineProgram.lean b/merlin/lean/MerlinVerify/Rules/TorchAOAffineProgram.lean
new file mode 100644
index 000000000..2a792e2ec
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/TorchAOAffineProgram.lean
@@ -0,0 +1,169 @@
+/- Provisional source-driven structural checker for lower_torchao_affine_quant.
+Its whole-program theorem compares the target to the explicitly materialized local contract.
+It does NOT yet relate captured opaque-call execution to TorchAO's reference. In particular,
+reduction lifting, zero-point elision and actual capture/version admission remain obligations.
+No production verifier may treat this result as approved source-to-target verification. -/
+import MerlinVerify.Rules.TorchAOAffineScalar
+import MerlinVerify.Rules.FrontendBoolProgram
+import MerlinVerify.Rules.LocalProgramCorrespondence
+
+namespace MerlinVerify.Rules.TorchAOAffineProgram
+open MerlinVerify MerlinVerify.Check
+open FrontendBoolProgram (defsOps sourceTypes freshStart)
+open DequantScalar (op floatOp yield)
+open TorchAOAffineScalar (constant)
+
+abbrev Types := List (ValueId × Ty)
+def chooseName := "torchao_choose_qparams_affine_default"
+def quantizeName := "torchao_quantize_affine_default"
+
+def named (o : Op) (name : String) : Bool := o.name == "func.call" &&
+  o.attr? "callee" == some (.symbolRef name [])
+
+def provenance (o : Op) (tag : String) : List (String × Attr) :=
+  let kept := o.attrs.filter fun (k, _) => k.startsWith "prov."
+  let previous := match kept.lookup "prov.transforms" with
+    | some (Attr.str s) => s.splitOn "," | _ => []
+  (kept.filter (fun (k, _) => k != "prov.transforms") ++
+    [("prov.transforms", Attr.str (String.intercalate "," (previous.filter (· != "") ++ [tag])))]).mergeSort
+      (fun a b => a.1 ≤ b.1)
+
+def tensorTy (shape : List Nat) (elt : Ty) : Ty := .tensor (shape.map some) elt none
+
+def empty (id : Nat) (ty : Ty) : Op := .mk "tensor.empty" [{id, ty}] [] [] [] [] []
+
+def identity (rank : Nat) : AffineMap :=
+  {numDims := rank, numSyms := 0, results := (List.range rank).map AffineExpr.dim}
+
+def projection (rank kept : Nat) : AffineMap :=
+  {numDims := rank, numSyms := 0, results := (List.range kept).map AffineExpr.dim}
+
+def generic (id : Nat) (ty : Ty) (ins : List Nat) (out : Nat)
+    (maps : List AffineMap) (iters : List String) (args : List Value) (body : List Op)
+    (attrs : List (String × Attr)) : Op :=
+  .mk "linalg.generic" [{id, ty}] (ins ++ [out])
+    ([("indexing_maps", .array (maps.map Attr.affineMap)),
+      ("iterator_types", .array (iters.map fun s => .enum "linalg" "iterator_type" s)),
+      ("operandSegmentSizes", .denseArray (.int 32) [Int.ofNat ins.length, 1])] ++ attrs)
+    [] [.mk [.mk args body]] []
+
+def chooseExpansion (source : Nat) (result : Value) (shape : List Nat) (s : Nat) (o : Op) : List Op :=
+  let scaleTy := result.ty
+  let kept := shape.length - 1
+  let fillArgs : List Value := [{id := s+3, ty := .float .f32}, {id := s+4, ty := .float .f32}]
+  let fill := Op.mk "linalg.fill" [{id := s+2, ty := scaleTy}] [s+1, s]
+    [("operandSegmentSizes", .denseArray (.int 32) [1, 1])]
+    [] [.mk [.mk fillArgs [yield (s+3)]]] []
+  let reduction := generic (s+9) scaleTy [source] (s+2)
+    [identity shape.length, projection shape.length kept]
+    (List.replicate kept "parallel" ++ ["reduction"])
+    [{id := s+5, ty := .float .f32}, {id := s+6, ty := .float .f32}]
+    [floatOp "math.absf" (s+7) [s+5], floatOp "arith.maximumf" (s+8) [s+6, s+7], yield (s+8)]
+    (provenance o "torchao_choose_qparams_affine")
+  let scale := generic result.id scaleTy [s+9] (s+10) [identity kept, identity kept]
+    (List.replicate kept "parallel")
+    [{id := s+11, ty := .float .f32}, {id := s+12, ty := .float .f32}]
+    [constant (s+13) 0x42fe0000, constant (s+14) 0x3727c5ac,
+     floatOp "arith.divf" (s+15) [s+11, s+13],
+     floatOp "arith.maximumf" (s+16) [s+15, s+14], yield (s+16)]
+    (provenance o "torchao_choose_qparams_affine")
+  [empty s scaleTy, constant (s+1) 0, fill, reduction, empty (s+10) scaleTy, scale]
+
+def shifted (offset : Nat) : Op → Op
+  | .mk n rs args attrs props regions successors =>
+    .mk n (rs.map fun v => {v with id := v.id + offset}) (args.map (· + offset)) attrs props regions successors
+
+def quantizeExpansion (source scale : Nat) (result : Value) (shape : List Nat) (s : Nat) (o : Op) : List Op :=
+  [empty s result.ty,
+   generic result.id result.ty [source, scale] s
+    [identity shape.length, projection shape.length (shape.length-1), identity shape.length]
+    (List.replicate shape.length "parallel")
+    [{id := s+1, ty := .float .f32}, {id := s+2, ty := .float .f32}, {id := s+3, ty := .int 8}]
+    (TorchAOAffineScalar.body.map (shifted (s+1)))
+    (provenance o "torchao_quantize_affine")]
+
+/-- Static, unencoded f32 per-token layout. Other ranks/layouts/numeric symbol suffixes are
+explicitly unsupported by this initial checker, even when production handles them. -/
+def shape? (types : Types) (id : Nat) : Option (List Nat) := do
+  let some ty := types.lookup id | none
+  let some (shape, elt) := ty.staticTensor? | none
+  if ty != tensorTy shape (.float .f32) || elt != .float .f32 || shape.isEmpty || shape.any (· == 0) then none
+  else some shape
+
+def metadataOK (o : Op) : Bool :=
+  o.regions.isEmpty && o.successors.isEmpty && o.props.isEmpty &&
+    o.attrs.all (fun (k, _) => k == "callee" || k.startsWith "prov.")
+
+def expansion (types : Types) (o : Op) : StateT Nat Option (List Op) := do
+  if !(metadataOK o) then failure
+  let [result] := o.results | failure
+  if named o chooseName then
+    let [source] := o.operands | failure
+    let some shape := shape? types source | failure
+    if result.ty != tensorTy (shape.take (shape.length-1)) (.float .f32) then failure
+    let start ← get
+    modify (· + 17)
+    pure (chooseExpansion source result shape start o)
+  else if named o quantizeName then
+    let [source, scale] := o.operands | failure
+    let some shape := shape? types source | failure
+    if types.lookup scale != some (tensorTy (shape.take (shape.length-1)) (.float .f32)) ||
+      result.ty != tensorTy shape (.int 8) then failure
+    let start ← get
+    modify (· + 13)
+    pure (quantizeExpansion source scale result shape start o)
+  else failure
+
+def removableDecl (o : Op) : Bool :=
+  o.name == "func.func" && (o.attr? "sym_name" == some (.str chooseName) ||
+    o.attr? "sym_name" == some (.str quantizeName)) &&
+    o.regions.all (fun r => r.blocks.isEmpty)
+
+def rewrite (types : Types) : Nat → List Op → StateT Nat Option (List Op)
+  | 0, _ => failure
+  | fuel+1, os => do
+    let groups ← os.mapM fun o => do
+      if removableDecl o then return []
+      if named o chooseName || named o quantizeName then return (← expansion types o)
+      -- Refuse an unsupported numeric overload instead of silently ignoring an eligible call.
+      if o.name == "func.call" then
+        match o.attr? "callee" with
+        | some (.symbolRef n _) =>
+          if n.startsWith chooseName || n.startsWith quantizeName then failure
+        | _ => pure ()
+      let rs ← o.regions.mapM fun r => do
+        let bs ← r.blocks.mapM fun b => do
+          let children ← rewrite types fuel b.ops
+          pure (.mk b.args children : Block)
+        pure (.mk bs : Region)
+      match o with
+      | .mk n res args attrs props _ successors => return [.mk n res args attrs props rs successors]
+    pure groups.flatten
+
+def materialize? (src : Module) : Option Module := do
+  if src.attrs.lookup "prov.quantization" != some (.str "int8_dyn_act_int8_weight") then none else
+  let defs ← defsOps 64 src.ops
+  if !decide (defs.map (·.id)).Nodup then none else
+  let start := freshStart defs
+  let (ops, finish) ← (rewrite (sourceTypes defs) 64 src.ops).run start
+  if finish == start then none else pure {src with ops}
+
+/-- Strict whole-AST accounting plus the existing complete-program refinement checker.
+This is materialized-contract correspondence, not a source opaque-call execution proof. -/
+def check (src tgt : Module) : Bool :=
+  match materialize? src with
+  | none => false
+  | some intended => LocalProgramCorrespondence.check intended tgt
+
+theorem check_sound {src tgt intended : Module} (hi : materialize? src = some intended)
+    (h : check src tgt = true) :
+    alphaOps [] intended.ops tgt.ops = true ∧
+      ∀ (ctx : Ctx) (name : String) (args : List RVal),
+        denote Sem.Ops.opSem ctx intended name args = denote Sem.Ops.opSem ctx tgt name args := by
+  simp only [check, hi] at h
+  have hc := h
+  simp only [LocalProgramCorrespondence.check, Bool.and_eq_true] at hc
+  exact ⟨hc.1.1.1, LocalProgramCorrespondence.check_sound h⟩
+
+#print axioms check_sound
+end MerlinVerify.Rules.TorchAOAffineProgram
diff --git a/merlin/lean/MerlinVerify/Rules/TorchAOAffineScalar.lean b/merlin/lean/MerlinVerify/Rules/TorchAOAffineScalar.lean
new file mode 100644
index 000000000..03c268a2d
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/TorchAOAffineScalar.lean
@@ -0,0 +1,90 @@
+/- Actual scalar-region checking for the provisional TorchAO affine contract.
+No acceptance result in this module verifies the enclosing tensor reduction or captured calls. -/
+import MerlinVerify.Rules.TorchAOAffineContract
+import MerlinVerify.Check.ProgramLemmas
+import MerlinVerify.Sem.OutcomeLaws
+
+namespace MerlinVerify.Rules.TorchAOAffineScalar
+open MerlinVerify MerlinVerify.Check TorchAOAffineContract
+open DequantScalar (op floatOp yield)
+
+def constant (id : Nat) (bits : FBits .f32) : Op :=
+  .mk "arith.constant" [{id, ty := .float .f32}] []
+    [("value", .float bits.toNat (.float .f32))] [] [] []
+
+def body : List Op :=
+  [constant 3 0x3f800000, constant 4 0xc2fe0000, constant 5 0x42fe0000,
+   floatOp "arith.divf" 6 [3, 1], floatOp "arith.mulf" 7 [0, 6],
+   floatOp "math.roundeven" 8 [7],
+   floatOp "arith.maximumf" 9 [8, 4], floatOp "arith.minimumf" 10 [9, 5],
+   op "arith.fptosi" 11 (.int 8) [10], yield 11]
+
+def inputs (x scale : FBits .f32) (init : Val) : Env :=
+  [(0, .scalar (.some (.flt .f32 x))), (1, .scalar (.some (.flt .f32 scale))), (2, .scalar init)]
+
+private theorem key_default (name : String) (id : Nat) (ty : Ty) (args : List Nat) :
+    Sem.Ops.Arith.floatKey (.mk name [{id, ty}] args [] [] [] []) = key name := by
+  apply congrArg (fun modifiers => ({op := name, modifiers} : FloatOpKey))
+  simp only [Sem.Ops.Arith.fastmathKey, Sem.Ops.Arith.attrKey, Op.attr?, Op.props, Op.attrs, List.lookup]
+  cbv
+
+private theorem key_none (name : String) (id : Nat) (args : List Nat) :
+    Sem.Ops.Arith.floatKey (.mk name [{id, ty := .float .f32}] args
+      [("fastmath", .enum "arith" "fastmath" "none")] [] [] []) = key name := by
+  apply congrArg (fun modifiers => ({op := name, modifiers} : FloatOpKey))
+  simp only [floatOp, Sem.Ops.Arith.fastmathKey, Sem.Ops.Arith.attrKey, Op.attr?, Op.props, Op.attrs, List.lookup]
+  cbv
+
+private theorem dialect_arith_constant : Sem.Ops.dialectOf "arith.constant" = "arith" := by cbv
+private theorem dialect_arith_divf : Sem.Ops.dialectOf "arith.divf" = "arith" := by cbv
+private theorem dialect_arith_mulf : Sem.Ops.dialectOf "arith.mulf" = "arith" := by cbv
+private theorem dialect_math_roundeven : Sem.Ops.dialectOf "math.roundeven" = "math" := by cbv
+private theorem dialect_arith_maximumf : Sem.Ops.dialectOf "arith.maximumf" = "arith" := by cbv
+private theorem dialect_arith_minimumf : Sem.Ops.dialectOf "arith.minimumf" = "arith" := by cbv
+private theorem dialect_arith_fptosi : Sem.Ops.dialectOf "arith.fptosi" = "arith" := by cbv
+
+private theorem roundeven_prefix : "math.roundeven".startsWith "math." = true := by cbv
+
+set_option maxRecDepth 8192 in
+set_option maxHeartbeats 2000000 in
+/-- No float law: the actual scalar evaluator computes exactly this ordered expression,
+including a poison result when the conversion interpretation rejects the clamped float. -/
+theorem body_sound (ctx : Ctx) (call : CallSem) (x scale : FBits .f32) (init : Val) :
+    evalOps Sem.Ops.opSem ctx call (inputs x scale init) body =
+      .ok [.scalar (quantizeWithoutZero ctx.M x scale)] := by
+  simp (maxSteps := 1000000) [evalOps, body, constant, inputs, op, floatOp, yield,
+    Env.getAll, Env.get?, Env.bindAll, List.lookup, Outcome.mapM, Outcome.ofOption,
+    Sem.Ops.opSem, Sem.Ops.unmodelledAttr?, Sem.Ops.interpretedAttrs, Sem.Ops.dispatch,
+    Op.blind, Op.attr?, Op.name, Op.results, Op.attrs, Op.props, Op.successors, roundeven_prefix, dialect_arith_constant, dialect_arith_divf, dialect_arith_mulf, dialect_math_roundeven, dialect_arith_maximumf, dialect_arith_minimumf, dialect_arith_fptosi, Sem.Ops.Arith.sem,
+    Sem.Ops.Arith.unOp, Sem.Ops.Arith.binOp, Sem.Ops.Arith.pureN, Sem.Ops.Arith.resultElt,
+    Sem.Ops.Arith.fltBin, Sem.Ops.Arith.fltN, Sem.Ops.Arith.widthOf, Ty.bitWidth?,
+    scalarOfAttr, liftEager, key_default, key_none, quantizeWithoutZero, clamp, asInt, f,
+    Sem.Ops.Arith.bv, Op.isTerminator, terminatorNames, FKind.width, hasUnit, RVal.canonize,
+    List.range_succ, Function.comp_def, List.mapM_cons, List.mapM_nil]
+  all_goals split <;> simp_all
+
+def checkBody (args : List Value) (ops : List Op) : Bool :=
+  decide (args.map (·.ty) = [.float .f32, .float .f32, .int 8]) &&
+    freshIds [] (args.map (·.id)) && alphaOps ([0, 1, 2].zip (args.map (·.id))) body ops
+
+/-- The body certificate supplies no arithmetic facts. The actual IR is alpha checked against
+the proved scalar program, including attributes, SSA freshness, constants and returned use. -/
+theorem checkBody_sound {args : List Value} {ops : List Op} (h : checkBody args ops = true)
+    (ctx : Ctx) (call : CallSem) (x scale : FBits .f32) (init : Val)
+    (env : Env) (hc : Corr ([0, 1, 2].zip (args.map (·.id))) (inputs x scale init) env) :
+    evalOps Sem.Ops.opSem ctx call env ops = .ok [.scalar (quantizeWithoutZero ctx.M x scale)] := by
+  simp only [checkBody, Bool.and_eq_true] at h
+  rw [← alphaOps_sound call call _ _ _ ctx _ _ h.2 hc (fun _ _ => rfl)]
+  exact body_sound ctx call x scale init
+
+/-- Conditional connection to the versioned reference: the omitted zero-point addition
+is visible in the theorem's remaining hypothesis, never admitted as an axiom. -/
+theorem checkBody_reference {args : List Value} {ops : List Op} (h : checkBody args ops = true)
+    (ctx : Ctx) (hz : ZeroPointElisionCorrect ctx.M) (call : CallSem)
+    (x scale : FBits .f32) (init : Val) (env : Env)
+    (hc : Corr ([0, 1, 2].zip (args.map (·.id))) (inputs x scale init) env) :
+    evalOps Sem.Ops.opSem ctx call env ops = .ok [.scalar (quantize ctx.M x scale)] := by
+  rw [checkBody_sound h ctx call x scale init env hc, hz]
+
+#print axioms checkBody_reference
+end MerlinVerify.Rules.TorchAOAffineScalar
diff --git a/merlin/tests/ir/test_lean_bool_to_float.py b/merlin/tests/ir/test_lean_bool_to_float.py
new file mode 100644
index 000000000..3cc0f88ea
--- /dev/null
+++ b/merlin/tests/ir/test_lean_bool_to_float.py
@@ -0,0 +1,325 @@
+"""Actual pass boundaries, compiler-valid mutations, native bits and provisional replay."""
+
+from __future__ import annotations
+
+import copy
+import json
+import os
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from merlin.common.paths import merlin_dir, repo_root
+from merlin.frontends.linalg_mlir import parse_mlir_text
+from merlin.llvmlower.passes_xdsl import fix_bool_sitofp
+from merlin.verify.lean import differential as diff
+from merlin.verify.lean import local_passes
+from merlin.verify.lean.export import ExportError, export_file
+from merlin.xdsl_dialects._common import text as to_text
+
+SCALAR = """module {
+  func.func @subject(%b: i1, %other: i1) -> f32 {
+    %r = arith.sitofp %b : i1 to f32
+    return %r : f32
+  }
+}"""
+
+NESTED = """module {
+  func.func private @cast(%b: i1) -> f32 {
+    %r = arith.sitofp %b : i1 to f32
+    return %r : f32
+  }
+  func.func @subject(%mask: tensor<4xi1>) -> tensor<4xf32> {
+    %e = tensor.empty() : tensor<4xf32>
+    %r = linalg.generic {indexing_maps = [affine_map<(d0)->(d0)>, affine_map<(d0)->(d0)>],
+      iterator_types = ["parallel"]} ins(%mask: tensor<4xi1>) outs(%e: tensor<4xf32>) {
+      ^bb0(%b: i1, %old: f32):
+      %f = func.call @cast(%b) : (i1) -> f32
+      linalg.yield %f : f32
+    } -> tensor<4xf32>
+    return %r : tensor<4xf32>
+  }
+}"""
+
+
+def actual(source: str) -> tuple[str, str, int]:
+    module = parse_mlir_text(source)
+    before = to_text(module, generic=True)
+    count = fix_bool_sitofp(module)
+    module.verify()
+    return before, to_text(module, generic=True), count
+
+
+def exported(source: str, work: Path, tools) -> Path:
+    work.mkdir(parents=True, exist_ok=True)
+    mlir, path = work / "subject.mlir", work / "subject.json"
+    mlir.write_text(source)
+    export_file(mlir, path, backend="mlir", m2m_python=tools.compiler_python)
+    return path
+
+
+def checked(before: str, after: str, work: Path, tools) -> dict:
+    paths = [exported(s, work / side, tools) for s, side in ((before, "before"), (after, "after"))]
+    executable = repo_root() / "out/build/lean/build/bin/merlin-lean-local-passes"
+    assert executable.is_file(), "build LocalPasses.lakefile.toml first"
+    result = subprocess.run(
+        [str(executable), "bool-to-float", *(str(p) for p in paths)],
+        check=True,
+        capture_output=True,
+        text=True,
+        timeout=360,
+    )
+    answer = json.loads(result.stdout)
+    (work / "checker.json").write_text(json.dumps(answer, indent=2) + "\n")
+    assert answer["status"] == "provisional_contract"
+    return answer
+
+
+@pytest.mark.parametrize("source", [SCALAR, NESTED, NESTED.replace("tensor<4x", "tensor<0x")])
+def test_actual_pass_complete_program(tmp_path, fidelity_tools, source):
+    before, after, count = actual(source)
+    assert count == 1
+    assert checked(before, after, tmp_path, fidelity_tools)["accepted"]
+
+
+def test_scf_nested_sites_and_both_calls(tmp_path, fidelity_tools):
+    source = """module {func.func @subject(%b: i1) -> f32 {
+      %r = scf.if %b -> (f32) {
+        %t = arith.sitofp %b : i1 to f32
+        scf.yield %t : f32
+      } else {
+        %f = arith.sitofp %b : i1 to f32
+        scf.yield %f : f32
+      }
+      return %r : f32 }}"""
+    before, after, count = actual(source)
+    assert count == 2
+    assert checked(before, after, tmp_path, fidelity_tools)["accepted"]
+    path = exported(after, tmp_path / "native-export", fidelity_tools)
+    inputs, outputs = diff.signature(json.loads(path.read_text()), "subject")
+    mlir = tmp_path / "after.mlir"
+    mlir.write_text(after)
+    native = diff.execute_mlir(
+        mlir, [[[0]], [[1]]], tmp_path / "native", fidelity_tools, inputs=inputs, outputs=outputs
+    )
+    assert native["results"] == [["0"], ["1065353216"]]
+
+
+@pytest.mark.parametrize("format", ["f16", "bf16", "f64"])
+def test_unsupported_formats_are_refused(tmp_path, fidelity_tools, format):
+    before, after, count = actual(SCALAR.replace("f32", format))
+    assert count == 1  # Production coverage is wider than this proved f32 contract.
+    answer = checked(before, after, tmp_path, fidelity_tools)
+    assert not answer["accepted"] and answer["inventory"]["sites"] == 1
+
+
+def test_valid_mutations_reach_actual_lean(tmp_path, fidelity_tools):
+    before, after, _ = actual(SCALAR)
+    assert checked(before, after, tmp_path / "baseline", fidelity_tools)["accepted"]
+    cast = next(line for line in after.splitlines() if '"arith.uitofp"' in line)
+    mutations = {
+        "retained_signed_cast": before,
+        "wrong_source": after.replace('"arith.uitofp"(%b)', '"arith.uitofp"(%other)'),
+        "nonneg": after.replace("{prov.transforms", "{nonNeg, prov.transforms"),
+        "fastmath": after.replace("{prov.transforms", "{fastmath = #arith.fastmath<nnan>, prov.transforms"),
+        "rounding": after.replace("{prov.transforms", '{roundingmode = "towardzero", prov.transforms'),
+        "wrong_use": after.replace(
+            cast, cast + '\n    %wrong = "arith.constant"() <{value = -0.0 : f32}> : () -> f32'
+        ).replace('"func.return"(%r)', '"func.return"(%wrong)'),
+        "bypassed_cast": after.replace(cast, cast + '\n    %wrong = "arith.sitofp"(%b) : (i1) -> f32').replace(
+            '"func.return"(%r)', '"func.return"(%wrong)'
+        ),
+        "wrong_format": after.replace("f32", "f64"),
+        "missing_provenance": after.replace(' {prov.transforms = "bool_sitofp_uitofp"}', ""),
+        "extra_dead_operation": after.replace(
+            cast, cast + '\n    %dead = "arith.constant"() <{value = 1.0 : f32}> : () -> f32'
+        ),
+    }
+    for name, mutant in mutations.items():
+        assert mutant != after, name
+        # Export runs the authoritative compiler verifier. Only then is rejection a Lean test.
+        assert not checked(before, mutant, tmp_path / name, fidelity_tools)["accepted"], name
+
+
+def test_complete_boundary_rejects_partial_repair_and_wrong_nested_use(tmp_path, fidelity_tools):
+    source = NESTED.replace(
+        "%f = func.call @cast(%b) : (i1) -> f32",
+        "%f = arith.sitofp %b : i1 to f32",
+    )
+    before, after, count = actual(source)
+    assert count == 2 and checked(before, after, tmp_path / "baseline", fidelity_tools)["accepted"]
+    line = next(line for line in after.splitlines() if '"arith.uitofp"(%b)' in line)
+    partial = after.replace(line, line.replace('"arith.uitofp"', '"arith.sitofp"'), 1)
+    wrong = after.replace('"linalg.yield"(%f)', '"linalg.yield"(%old)')
+    assert not checked(before, partial, tmp_path / "partial", fidelity_tools)["accepted"]
+    assert not checked(before, wrong, tmp_path / "use", fidelity_tools)["accepted"]
+
+
+def test_changed_internal_callee_is_refused(tmp_path, fidelity_tools):
+    alternate = """func.func private @alternate(%b: i1) -> f32 {
+      %z = arith.constant 0.0 : f32
+      return %z : f32
+    }"""
+    before, after, _ = actual(NESTED.replace("module {", "module {" + alternate, 1))
+    assert checked(before, after, tmp_path / "baseline", fidelity_tools)["accepted"]
+    wrong = after.replace("callee = @cast", "callee = @alternate")
+    assert wrong != after
+    assert not checked(before, wrong, tmp_path / "callee", fidelity_tools)["accepted"]
+
+
+def test_ssa_errors_are_compiler_refusals(tmp_path, fidelity_tools):
+    _, after, _ = actual(SCALAR)
+    invalid = after.replace('"func.return"(%r)', '"func.return"(%undefined)')
+    with pytest.raises(ExportError):
+        exported(invalid, tmp_path, fidelity_tools)
+
+
+@pytest.mark.parametrize("source,values", [(SCALAR, [[[0], [1]], [[1], [0]]]), (NESTED, [[[0, 1, 1, 0]]])])
+def test_native_and_pinned_torch_oracle(tmp_path, fidelity_tools, source, values):
+    before, after, _ = actual(source)
+    checked(before, after, tmp_path / "check", fidelity_tools)
+    mlir = tmp_path / "after.mlir"
+    mlir.write_text(after)
+    path = exported(after, tmp_path / "export", fidelity_tools)
+    inputs, outputs = diff.signature(json.loads(path.read_text()), "subject")
+    native = diff.execute_mlir(mlir, values, tmp_path / "native", fidelity_tools, inputs=inputs, outputs=outputs)
+    python = Path(os.environ["MERLIN_TORCH_PYTHON"])
+    request = tmp_path / "torch-request.json"
+    request.write_text(json.dumps(values))
+    code = """import json,sys,torch
+assert torch.__version__ == '2.10.0+cpu', torch.__version__
+samples=json.load(open(sys.argv[1]));result=[]
+for sample in samples:
+ x=torch.tensor(sample[0],dtype=torch.bool).to(torch.float32)
+ result.append([str(int(b)&0xffffffff) for b in x.view(torch.int32).tolist()])
+print(json.dumps({'torch':torch.__version__,'results':result}))
+"""
+    reference = subprocess.run(
+        [str(python), "-B", "-c", code, str(request)], check=True, capture_output=True, text=True
+    )
+    answer = json.loads(reference.stdout)
+    (tmp_path / "torch.json").write_text(reference.stdout)
+    assert native["results"] == answer["results"]
+
+
+def test_provisional_receipt_and_replay(tmp_path, fidelity_tools):
+    before, after, _ = actual(SCALAR)
+    paths = [tmp_path / f"{side}.mlir" for side in ("before", "after")]
+    for path, source in zip(paths, (before, after), strict=True):
+        path.write_text(source)
+    receipt = local_passes.verify(
+        "bool-to-float",
+        *paths,
+        tmp_path / "receipts",
+        compiler_python=fidelity_tools.compiler_python,
+        suffix=(paths[1],),
+    )
+    assert receipt["status"] == "proved_policy_provisional", receipt.get("reason")
+    assert receipt["answer"]["suffix_count"] == 1
+    local_passes.replay(receipt, compiler_python=fidelity_tools.compiler_python)
+    for field, value in (
+        ("approved_full_verification", True),
+        ("contract_review", "approved"),
+        ("whole_function_defined", True),
+    ):
+        forged = copy.deepcopy(receipt)
+        forged[field] = value
+        with pytest.raises(ValueError):
