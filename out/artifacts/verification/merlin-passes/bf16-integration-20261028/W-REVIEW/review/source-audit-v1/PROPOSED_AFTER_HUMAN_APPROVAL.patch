+theorem stepOpt_none_left (M : FloatModel) (license : License) {ka kb : FKind}
+    (b : Option (FBits kb)) (acc : Option (FBits .f32)) :
+    stepOpt M license (ka := ka) Option.none b acc = Option.none := by
+  cases b <;> cases acc <;> rfl
+
+theorem stepOpt_none_acc (M : FloatModel) (license : License) {ka kb : FKind}
