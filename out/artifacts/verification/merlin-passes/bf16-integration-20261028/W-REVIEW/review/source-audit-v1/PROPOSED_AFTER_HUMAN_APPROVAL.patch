+theorem extKey_literal : extKey = ⟨"arith.extf", "fm1:0;rm4:none;pred4:none"⟩ := rfl
+theorem truncKey_literal : truncKey = ⟨"arith.truncf", "fm1:0;rm4:none;pred4:none"⟩ := rfl
+
+theorem mulKey_literal (f : Flag) : mulKey f =
+    ⟨"arith.mulf", match f with
+      | .none => "fm1:0;rm4:none;pred4:none" | .contract => "fm2:32;rm4:none;pred4:none"⟩ := by
+  unfold mulKey Sem.Ops.Arith.floatKey
+  rw [fastmath_mask]
+  cases f <;> rfl
+
+theorem addKey_literal (f : Flag) : addKey f =
+    ⟨"arith.addf", match f with
+      | .none => "fm1:0;rm4:none;pred4:none" | .contract => "fm2:32;rm4:none;pred4:none"⟩ := by
+  unfold addKey Sem.Ops.Arith.floatKey
+  rw [fastmath_mask]
+  cases f <;> rfl
+
+/-- A `contract` operation is a different uninterpreted function from its unflagged form. -/
+theorem contract_distinct : mulKey .contract ≠ mulKey .none ∧ addKey .contract ≠ addKey .none := by
+  rw [mulKey_literal, mulKey_literal, addKey_literal, addKey_literal]
+  decide
+
+/-! ### Clauses 3 and 4: the accumulation step and its initial value -/
+
+/-- `+0.0` in binary32. -/
+def zero : FBits .f32 := 0#32
+
+/-- One accumulation step: `acc + ext(a) * ext(b)`, multiply first, accumulator as left addend. -/
+def step (M : FloatModel) (license : License) {ka kb : FKind}
+    (a : FBits ka) (b : FBits kb) (acc : FBits .f32) : FBits .f32 :=
+  M.op (addKey license.add) .f32 [acc, M.op (mulKey license.mul) .f32 [ext M ka a, ext M kb b]]
+
+/-! ### Clause 5: the final conversion -/
+
+def trunc (M : FloatModel) (kc : FKind) (x : FBits .f32) : FBits kc := M.convert truncKey .f32 kc x
+
+/-! ### Element values: `none` is poison, which every clause propagates -/
+
+def value (k : FKind) : Option (FBits k) → Val
+  | Option.none => .poison
+  | some x => .some (.flt k x)
+
+def stepOpt (M : FloatModel) (license : License) {ka kb : FKind} :
+    Option (FBits ka) → Option (FBits kb) → Option (FBits .f32) → Option (FBits .f32)
+  | some a, some b, some acc => some (step M license a b acc)
+  | _, _, _ => Option.none
+
+/-! ### Clause 2 and the whole contraction -/
+
+/-- A contraction's geometry: operand and result shapes, the three indexing maps, and the loop
+extents. Loop extents are not chosen by this contract; checkers derive them from the maps. -/
+structure Geometry where
+  left : List Nat
+  right : List Nat
+  out : List Nat
+  leftMap : AffineMap
+  rightMap : AffineMap
+  outMap : AffineMap
+  ranges : List Nat
+
+def Geometry.coordinate (shape : List Nat) (map : AffineMap) (point : Idx) : Idx :=
+  W8A8TensorOperands.coordinate shape map point
+
+/-- The f32 accumulator of every output cell after the complete, ordered loop nest. -/
+def accumulate (M : FloatModel) (license : License) {ka kb : FKind} (g : Geometry)
+    (A : Idx → Option (FBits ka)) (B : Idx → Option (FBits kb)) : Idx → Option (FBits .f32) :=
+  W8A8TensorTrace.accumulate (Geometry.coordinate g.out g.outMap)
+    (fun point acc => stepOpt M license (A (Geometry.coordinate g.left g.leftMap point))
+      (B (Geometry.coordinate g.right g.rightMap point)) acc)
+    (fun _ => some zero) (allPoints g.ranges)
+
+/-- The contract's result tensor: every in-bounds cell holds its truncated accumulator. -/
+def result (M : FloatModel) (license : License) {ka kb : FKind} (kc : FKind) (g : Geometry)
+    (A : Idx → Option (FBits ka)) (B : Idx → Option (FBits kb)) : Tensor :=
+  Tensor.canon g.out (.float kc) fun cell => value kc ((accumulate M license g A B cell).map (trunc M kc))
+
+/-- Clause 3, made explicit: each cell folds exactly the loop points that write it, in
+lexicographic iteration order, from `+0.0`. -/
+theorem accumulate_cell (M : FloatModel) (license : License) {ka kb : FKind} (g : Geometry)
+    (A : Idx → Option (FBits ka)) (B : Idx → Option (FBits kb)) (cell : Idx) :
+    accumulate M license g A B cell =
+      (allPoints g.ranges).foldl (fun acc point =>
+        if cell = Geometry.coordinate g.out g.outMap point then
+          stepOpt M license (A (Geometry.coordinate g.left g.leftMap point))
+            (B (Geometry.coordinate g.right g.rightMap point)) acc
+        else acc) (some zero) :=
+  W8A8TensorTrace.accumulate_cell _ _ _ _ _
