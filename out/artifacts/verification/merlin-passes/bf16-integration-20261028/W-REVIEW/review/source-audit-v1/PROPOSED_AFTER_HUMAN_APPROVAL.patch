+keyed by the exact operation, so claims hold for every interpretation. A `contract`-flagged
+multiply or add is its own uninterpreted function, distinct from its unflagged counterpart. That
+the trusted lowering may fuse a `contract` multiply-add into one rounding is not modelled here.
+-/
+import MerlinVerify.Sem.Ops
+import MerlinVerify.Rules.W8A8TensorTrace
+import MerlinVerify.Rules.W8A8TensorOperands
+
+namespace MerlinVerify.Rules.Bf16F32AccContract
+
+open MerlinVerify MerlinVerify.Sem.Ops.Linalg
+
+/-! ### Clause 1: formats and the operand conversion -/
+
+/-- Storage formats the contract admits for both operands and the result. -/
+def half : FKind → Bool
+  | .bf16 | .f16 => true
+  | _ => false
+
+def extOp : Op := .mk "arith.extf" [] [] [] [] [] []
+def truncOp : Op := .mk "arith.truncf" [] [] [] [] [] []
+
+/-- The semantics' own key for an attribute-free `arith.extf`. -/
+def extKey : FloatOpKey := Sem.Ops.Arith.floatKey extOp
+
+/-- The semantics' own key for an attribute-free `arith.truncf` (default rounding mode). -/
+def truncKey : FloatOpKey := Sem.Ops.Arith.floatKey truncOp
+
+def ext (M : FloatModel) (k : FKind) (x : FBits k) : FBits .f32 := M.convert extKey k .f32 x
+
+/-! ### Clause 6: the permitted fast-math license -/
+
+inductive Flag where
+  | none
+  | contract
+  deriving DecidableEq, Repr
+
+def Flag.text : Flag → String
+  | .none => "none"
+  | .contract => "contract"
+
+/-- Exactly the two permitted spellings; every other flag set is outside the contract. -/
+def Flag.ofText? : String → Option Flag
+  | "none" => some .none
+  | "contract" => some .contract
+  | _ => Option.none
+
+structure License where
+  mul : Flag
+  add : Flag
+  deriving DecidableEq, Repr
+
+def fastmath (f : Flag) : List (String × Attr) := [("fastmath", .enum "arith" "fastmath" f.text)]
+
+def mulKey (f : Flag) : FloatOpKey := Sem.Ops.Arith.floatKey (.mk "arith.mulf" [] [] (fastmath f) [] [] [])
+def addKey (f : Flag) : FloatOpKey := Sem.Ops.Arith.floatKey (.mk "arith.addf" [] [] (fastmath f) [] [] [])
+
+/-! The keys, as reviewable literals of the frozen `Sem.Ops.Arith.floatKey`. -/
+
+private theorem flagList_contract : flagList "contract" = ["contract"] := by cbv
+private theorem flagList_none : flagList "none" = ["none"] := by cbv
+
+private theorem fastmath_mask (name : String) (f : Flag) :
+    Sem.Ops.Arith.fastmathKey (.mk name [] [] (fastmath f) [] [] []) =
+      match f with | .none => "0" | .contract => "32" := by
+  cases f <;> simp [Sem.Ops.Arith.fastmathKey, Op.attr?, Op.props, Op.attrs, fastmath, Flag.text,
+    flagList_contract, flagList_none, Sem.Ops.Arith.fastmathBit] <;> rfl
