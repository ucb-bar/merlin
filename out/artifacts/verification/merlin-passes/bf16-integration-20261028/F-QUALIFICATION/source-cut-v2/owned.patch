+    monkeypatch.setattr(gate.subprocess, "run", run)
+    result = gate.audit_candidate(tools, tmp_path)
+    assert set(result["axioms"]) == set(gate.ROOTS)
+    assert len(calls) == 2 + len(gate.ROOTS)
