+        assert command[:3] == ["/NEW_REVIEWED_TOOLS/lake", "env", "/NEW_REVIEWED_TOOLS/audit"]
+        assert kwargs["env"]["PATH"].split(":")[0] == "/NEW_REVIEWED_TOOLS"
+        if "--statements" in command:
