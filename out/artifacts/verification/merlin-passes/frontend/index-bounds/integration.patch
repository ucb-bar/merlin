diff --git a/merlin/lean/MerlinVerify/Rules/FrontendRangeArithmetic.lean b/merlin/lean/MerlinVerify/Rules/FrontendRangeArithmetic.lean
new file mode 100644
index 000000000..2318d879e
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/FrontendRangeArithmetic.lean
@@ -0,0 +1,144 @@
+/- Bounds transfers use actual modular integer semantics. A range is retained only
+when its entire signed result range is representable. No floating laws are used. -/
+import MerlinVerify.Rules.FrontendRangeFrame
+import MerlinVerify.Rules.FrontendDefinedIndex
+
+namespace MerlinVerify.Rules.FrontendRangeArithmetic
+open MerlinVerify MerlinVerify.Check Sem.Ops
+open Definedness.IndexRanges (Interval)
+open FrontendTensorRanges
+
+namespace Mul
+
+def evidence (ib : Nat) (left right : Option Interval) : Option Interval :=
+  match left, right with
+  | some a, some b =>
+    if 0 < ib ∧ a.lower < a.upper ∧ b.lower < b.upper ∧
+        (a.upper - 1) * (b.upper - 1) + 1 ≤ 2 ^ (ib - 1) then
+      some ⟨a.lower * b.lower, (a.upper - 1) * (b.upper - 1) + 1⟩
+    else none
+  | _, _ => none
+
+theorem sound {ib : Nat} (left right : Option Interval) (x y : BitVec ib)
+    (hx : Definedness.IndexRanges.model.holds left (.scalar (.some (.bits ib x))))
+    (hy : Definedness.IndexRanges.model.holds right (.scalar (.some (.bits ib y)))) :
+    Definedness.IndexRanges.model.holds (evidence ib left right) (.scalar (.some (.bits ib (x * y)))) := by
+  cases left with
+  | none => trivial
+  | some a =>
+    cases right with
+    | none => trivial
+    | some b =>
+      unfold evidence
+      dsimp only
+      split
+      · next hc =>
+        obtain ⟨_, ha, hb, hlimit⟩ := hc
+        obtain ⟨u, hu, hul, huh⟩ := hx
+        obtain ⟨v, hv, hvl, hvh⟩ := hy
+        have hux : x.toInt = u := by simpa [Definedness.IndexRanges.value?, Tensor.indexVal?] using hu
+        have hvy : y.toInt = v := by simpa [Definedness.IndexRanges.value?, Tensor.indexVal?] using hv
+        have hun : 0 ≤ u := by omega
+        have hvn : 0 ≤ v := by omega
+        have hulo : a.lower ≤ u.toNat := by omega
+        have hvlo : b.lower ≤ v.toNat := by omega
+        have huhi : u.toNat ≤ a.upper - 1 := by omega
+        have hvhi : v.toNat ≤ b.upper - 1 := by omega
+        have hlo := Nat.mul_le_mul hulo hvlo
+        have hhi := Nat.mul_le_mul huhi hvhi
+        have hpos : 0 ≤ u * v := Int.mul_nonneg hun hvn
+        have hmul : u * v < (2 : Int) ^ (ib - 1) := by
+          have h : u.toNat * v.toNat < 2 ^ (ib - 1) := by omega
+          have hc' : ((u.toNat * v.toNat : Nat) : Int) < (2 : Int) ^ (ib - 1) := by exact_mod_cast h
+          simpa [Int.toNat_of_nonneg hun, Int.toNat_of_nonneg hvn] using hc'
+        have hsafe : ¬ BitVec.smulOverflow x y := by
+          have hp : 0 ≤ (2 : Int) ^ (ib - 1) := Int.pow_nonneg (by omega)
+          simp only [BitVec.smulOverflow, Bool.or_eq_true, decide_eq_true_eq, not_or, Int.not_le, Int.not_lt]
+          rw [hux, hvy]
+          constructor <;> omega
+        have heq := BitVec.toInt_mul_of_not_smulOverflow hsafe
+        change ∃ z, Definedness.IndexRanges.value? (.scalar (.some (.bits ib (x * y)))) = some z ∧ _ ∧ _
+        refine ⟨u * v, ?_, ?_, ?_⟩
+        · simpa [Definedness.IndexRanges.value?, Tensor.indexVal?, hux, hvy] using congrArg some heq
+        · have h : ((a.lower * b.lower : Nat) : Int) ≤ u * v := by
+            simpa [Int.toNat_of_nonneg hun, Int.toNat_of_nonneg hvn] using (Int.ofNat_le.mpr hlo)
+          simpa using h
+        · have h : u * v < (((a.upper - 1) * (b.upper - 1) + 1 : Nat) : Int) := by
+            have h := Int.ofNat_le.mpr hhi
+            simp only [Int.natCast_mul, Int.toNat_of_nonneg hun, Int.toNat_of_nonneg hvn] at h
+            omega
+          exact h
+      · trivial
+end Mul
+
+def evidence (ib : Nat) (kind : Definedness.IndexArithmetic.Kind) (left right : Fact) : Option Interval :=
+  if kind = .mul then Mul.evidence ib left.info right.info
+  else Definedness.IndexArithmetic.evidence ib kind left right
+
+theorem evidence_sound {ib : Nat} (kind : Definedness.IndexArithmetic.Kind) (left right : Fact) (x y : BitVec ib)
+    (hx : Definedness.Refined.Fact.Holds model ib (.scalar (.some (.bits ib x))) left)
+    (hy : Definedness.Refined.Fact.Holds model ib (.scalar (.some (.bits ib y))) right) :
+    model.holds (evidence ib kind left right) (.scalar (.some (.bits ib (kind.bits x y)))) := by
+  have hx' : Definedness.Refined.Fact.Holds Definedness.IndexRanges.model ib (.scalar (.some (.bits ib x))) left := by
+    exact ⟨hx.1, by cases hi : left.info <;> simpa [model, Holds, Definedness.IndexRanges.model, hi] using hx.2⟩
+  have hy' : Definedness.Refined.Fact.Holds Definedness.IndexRanges.model ib (.scalar (.some (.bits ib y))) right := by
+    exact ⟨hy.1, by cases hi : right.info <;> simpa [model, Holds, Definedness.IndexRanges.model, hi] using hy.2⟩
+  have h : Definedness.IndexRanges.model.holds (evidence ib kind left right)
+      (.scalar (.some (.bits ib (kind.bits x y)))) := by
+    unfold evidence
+    split
+    · next hk => subst kind; exact Mul.sound _ _ x y hx'.2 hy'.2
+    · exact Definedness.IndexArithmetic.evidence_sound kind left right x y hx' hy'
+  exact (from_scalar (ib := ib) (f := ⟨⟨.scalar (.int ib), true⟩, evidence ib kind left right⟩)
+    ⟨⟨by simp [RVal.HasTy, Val.HasTy, Scalar.conforms], by simp [RVal.Defined]⟩, h⟩).2
+
+/-- Fixed-width initialized integer arithmetic, with the same flag checks as the old index rule. -/
+def rule (ib : Nat) (_ : FEnv) (op : Op) (fs : List Fact) : Option (List Fact) :=
+  match fs, op.results, Definedness.IndexArithmetic.kind? op.name with
+  | [left, right], [r], some kind =>
+    if unmodelledAttr? op.blind = none ∧ dialectOf op.name = "arith" ∧
+        left.base = ⟨.scalar (.int ib), true⟩ ∧ right.base = ⟨.scalar (.int ib), true⟩ ∧
+        r.ty = .int ib ∧ op.regions = [] ∧ overflowFlags op = [] ∧ Arith.fastmathKey op = "0" then
+      some [⟨⟨.scalar (.int ib), true⟩, evidence ib kind left right⟩]
+    else none
+  | _, _, _ => none
+
+def book (ib : Nat) : Definedness.Refined.Book model opSem ib where
+  rule := rule ib
+  sound Γ op fs rs h ctx call env args _ _ ha := by
+    unfold rule at h
+    split at h
+    · next _ _ _ left right r kind hr hk =>
+      split at h
+      · next hc =>
+        obtain ⟨hm, hd, hl, hright, hty, hregs, hflags, _⟩ := hc
+        cases h
+        obtain _ | ⟨hx, hrest⟩ := ha
+        obtain _ | ⟨hy, hnil⟩ := hrest
+        cases hnil
+        have hxl := hx.1
+        have hyr := hy.1
+        rw [hl] at hxl
+        rw [hright] at hyr
+        obtain ⟨x, rfl⟩ := Definedness.initialized_int hxl
+        obtain ⟨y, rfl⟩ := Definedness.initialized_int hyr
+        refine ⟨[.scalar (.some (.bits ib (kind.bits x y)))], ?_,
+          .cons ⟨⟨by simp [RVal.HasTy, Val.HasTy, Scalar.conforms], by simp [RVal.Defined]⟩,
+            evidence_sound kind left right x y hx hy⟩ .nil⟩
+        have hn := Definedness.IndexArithmetic.kind?_name hk
+        have hresult : Arith.resultElt op.blind = some (.int ib) := by
+          simp [Arith.resultElt, Op.blind_results, hr, hty]
+        have hf : overflowFlags op.blind = [] := by simpa [overflowFlags, attrEnum?] using hflags
+        rw [hregs, evalRegions, opSem_modelled hm]
+        simp only [dispatch, Op.blind_name, hd]
+        cases kind <;> simp only [Definedness.IndexArithmetic.Kind.name] at hn
+        all_goals
+          simp only [Arith.sem, Op.blind_name, hn, Arith.binOp, Arith.pureN, hresult]
+          rw [show [.scalar (.some (.bits ib x)), .scalar (.some (.bits ib y))] =
+            ([.some (.bits ib x), .some (.bits ib y)] : List Val).map RVal.scalar from rfl, liftEager_scalars]
+          simp [Arith.intBin, Arith.arithWithFlags, hf, Arith.bv, Definedness.IndexArithmetic.Kind.bits]
+      · cases h
+    · cases h
+
+#print axioms book
+end MerlinVerify.Rules.FrontendRangeArithmetic
diff --git a/merlin/lean/MerlinVerify/Rules/FrontendRangeDefined.lean b/merlin/lean/MerlinVerify/Rules/FrontendRangeDefined.lean
new file mode 100644
index 000000000..eb8be8529
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/FrontendRangeDefined.lean
@@ -0,0 +1,51 @@
+/- Assembled inactive bounds-aware checker. Unknown element bounds are never
+input facts. They must be derived by the current SSA producer. -/
+import MerlinVerify.Rules.FrontendRangeTensor
+import MerlinVerify.Rules.FrontendPrefixDefined
+
+namespace MerlinVerify.Rules.FrontendRangeDefined
+open MerlinVerify MerlinVerify.Check Sem.Ops
+open FrontendTensorRanges FrontendRangeFrame
+
+def base (ib : Nat) (ranges : List Nat) : BookAt ib ranges :=
+  let scalar := ((FrontendRangeScalars.constantBook ib).orElse
+    (FrontendRangeScalars.castBook ib)).orElse (FrontendRangeArithmetic.book ib)
+  let tensor := (FrontendRangeTensor.splatBook ib).orElse (FrontendRangeTensor.reshapeBook ib)
+  let existing := (scalarBook (Definedness.Bounds.leafBook ib)).orElse
+    (Definedness.Refined.Book.lift model (FrontendPrefixDefined.book ib))
+  orElse (FrontendRangeScalars.indexBook ib ranges) (lift (scalar.orElse (tensor.orElse existing)) ranges)
+
+def nested (ib : Nat) : Nat → (ranges : List Nat) → BookAt ib ranges
+  | 0, ranges => base ib ranges
+  | fuel + 1, ranges => orElse (lift ((FrontendRangeGeneric.emptyBook ib).orElse
+      (FrontendRangeGeneric.book ib (nested ib fuel))) ranges) (base ib ranges)
+
+def frameBook (ib : Nat) (ranges : List Nat) : BookAt ib ranges where
+  rule Γ op fs := (nested ib (RegionDepth.op op) ranges).rule Γ op fs
+  sound Γ op fs rs h ctx call env args hib hf hΓ ha :=
+    (nested ib (RegionDepth.op op) ranges).sound Γ op fs rs h ctx call env args hib hf hΓ ha
+
+def book (ib : Nat) : Definedness.Refined.Book model opSem ib := root (frameBook ib [])
+
+def candidateBook (limit ib : Nat) : Definedness.Refined.Book model (FrontendMaskRuntime.sem limit) ib where
+  rule Γ op fs := if FrontendRuntimeBridge.delegates op && FrontendRuntimeBridge.regions op.regions then
+    (book ib).rule Γ op fs else none
+  sound Γ op fs rs h ctx call env args hib hΓ ha := by
+    split at h
+    · next hc =>
+      simp only [Bool.and_eq_true] at hc
+      rw [FrontendRuntimeBridge.regions_sound limit call env op.regions hc.2,
+        FrontendRuntimeBridge.delegates_sound hc.1]
+      exact (book ib).sound Γ op fs rs h ctx call env args hib hΓ ha
+    · cases h
+
+/-- Initialization is required only at declared inputs; every internal interval is derived.
+The interpretation is exactly the same inactive runtime used by bool repair and checkpoint proofs. -/
+theorem check_sound {ib limit : Nat} {m : Module} {fn : String} {args results : List VTy}
+    (h : Definedness.Refined.check (candidateBook limit ib) m fn args results = true) :
+    FuncDefined (FrontendMaskRuntime.sem limit) (fun ctx => ctx.indexBits = ib)
+      (fun vs => HasTys ib vs args ∧ ResultsDefined vs) m fn :=
+  Definedness.Refined.check_sound (candidateBook limit ib) h
+
+#print axioms check_sound
+end MerlinVerify.Rules.FrontendRangeDefined
diff --git a/merlin/lean/MerlinVerify/Rules/FrontendRangeFrame.lean b/merlin/lean/MerlinVerify/Rules/FrontendRangeFrame.lean
new file mode 100644
index 000000000..498fa373d
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/FrontendRangeFrame.lean
@@ -0,0 +1,138 @@
+/- A bounds-aware region walker. Inferred facts are recomputed from real SSA bindings;
+terminators return proved facts, rather than discarding element intervals. -/
+import MerlinVerify.Rules.FrontendTensorRanges
+
+namespace MerlinVerify.Rules.FrontendRangeFrame
+open MerlinVerify MerlinVerify.Check
+open FrontendTensorRanges
+
+/-- Root books need no enclosing loop frame. Nested books get the actual coordinates. -/
+def Frame (ranges : List Nat) (ctx : Ctx) : Prop :=
+  ranges = [] ∨ Idx.InBounds ranges ctx.loopIndex
+
+structure BookAt (ib : Nat) (ranges : List Nat) where
+  rule : FEnv → Op → List Fact → Option (List Fact)
+  sound : ∀ Γ op fs rs, rule Γ op fs = some rs → ∀ ctx call env args,
+    ctx.indexBits = ib → Frame ranges ctx → Definedness.Refined.EnvHolds model ib Γ env →
+    Definedness.Refined.FactsHold model ib args fs →
+    ∃ vs, Sem.Ops.opSem ctx call op args (evalRegions Sem.Ops.opSem call env op.regions) = .ok vs ∧
+      Definedness.Refined.FactsHold model ib vs rs
+
+def lift {ib : Nat} (old : Definedness.Refined.Book model Sem.Ops.opSem ib) (ranges : List Nat) : BookAt ib ranges where
+  rule := old.rule
+  sound Γ op fs rs h ctx call env args hib _ hΓ ha := old.sound Γ op fs rs h ctx call env args hib hΓ ha
+
+def orElse {ib : Nat} {ranges : List Nat} (first next : BookAt ib ranges) : BookAt ib ranges where
+  rule Γ op fs := (first.rule Γ op fs).orElse fun _ => next.rule Γ op fs
+  sound Γ op fs rs h ctx call env args hib hf hΓ ha := by
+    cases hp : first.rule Γ op fs with
+    | none =>
+      simp only [hp, Option.orElse_none] at h
+      exact next.sound Γ op fs rs h ctx call env args hib hf hΓ ha
+    | some ys =>
+      simp only [hp, Option.orElse_some, Option.some.injEq] at h
+      subst rs
+      exact first.sound Γ op fs ys hp ctx call env args hib hf hΓ ha
+
+/-- Inferred result facts describe the actual terminator operands, including all uses. -/
+def inferOps {ib : Nat} {ranges : List Nat} (R : BookAt ib ranges) (Γ : FEnv) :
+    List Op → Option (List Fact)
+  | [] => none
+  | op :: rest =>
+    match op.operands.mapM (fun x => Γ.lookup x) with
+    | none => none
+    | some fs =>
+      if op.isTerminator then
+        if rest.isEmpty && fs.all (·.base.initialized) then some fs else none
+      else if op.successors.isEmpty then
+        match R.rule Γ op fs with
+        | none => none
+        | some rs => if rs.length == op.results.length then
+            inferOps R ((op.results.map (·.id)).zip rs ++ Γ) rest
+          else none
+      else none
+
+theorem inferOps_sound {ib : Nat} {ranges : List Nat} (R : BookAt ib ranges) :
+    ∀ Γ ops rs ctx call env, inferOps R Γ ops = some rs → Definedness.Refined.EnvHolds model ib Γ env →
+      ctx.indexBits = ib → Frame ranges ctx →
+      ∃ vs, evalOps Sem.Ops.opSem ctx call env ops = .ok vs ∧ Definedness.Refined.FactsHold model ib vs rs
+  | _, [], _, _, _, _, h, _, _, _ => by cases h
+  | Γ, (.mk n results operands attrs props regions successors) :: rest, rs, ctx, call, env,
+      h, hΓ, hib, hframe => by
+    simp only [inferOps] at h
+    split at h
+    · cases h
+    · next fs hfs =>
+      obtain ⟨args, hargs, hfacts⟩ := hΓ.getAll operands fs hfs
+      rw [evalOps.eq_2]
+      split
+      · next ht =>
+        rw [ite_eq_left ht] at h
+        split at h
+        · next hc =>
+          simp only [Bool.and_eq_true, List.isEmpty_iff] at hc
+          obtain ⟨rfl, _⟩ := hc
+          cases h
+          simp only [List.isEmpty_nil, ↓reduceIte, hargs]
+          exact ⟨args, rfl, hfacts⟩
+        · cases h
+      · next ht =>
+        rw [ite_eq_right ht] at h
+        split at h
+        · next hempty =>
+          split at h
+          · cases h
+          · next ys hrule =>
+            split at h
+            · next hlen =>
+              obtain ⟨vs, hop, hv⟩ := R.sound Γ _ fs ys hrule ctx call env args hib hframe hΓ hfacts
+              simp only [Op.regions] at hop
+              simp only [hargs, Outcome.bind_ok, hop, Op.results]
+              have hb : results.length = vs.length :=
+                (beq_iff_eq.mp hlen).symm.trans (List.Forall₂.length_eq hv).symm
+              rw [bindAll_ok hb, Outcome.bind_ok]
+              exact inferOps_sound R _ rest rs ctx call _ h (hΓ.extend _ vs ys hv) hib hframe
+            · cases h
+        · cases h
+
+def inferRegion {ib : Nat} {ranges : List Nat} (R : BookAt ib ranges) (Γ : FEnv)
+    (region : Region) (args : List Fact) : Option (List Fact) :=
+  match region with
+  | .mk [.mk bargs ops] =>
+    if bargs.mapM (fun a => vtyOf ib a.ty) = some (args.map (·.base.ty)) then
+      inferOps R ((bargs.map (·.id)).zip args ++ Γ) ops
+    else none
+  | _ => none
+
+theorem inferRegion_sound {ib : Nat} {ranges : List Nat} (R : BookAt ib ranges)
+    {Γ : FEnv} {region : Region} {fs rs : List Fact}
+    (h : inferRegion R Γ region fs = some rs) {ctx : Ctx} {call : CallSem} {env : Env}
+    (hib : ctx.indexBits = ib) (hf : Frame ranges ctx) (hΓ : Definedness.Refined.EnvHolds model ib Γ env)
+    {args : List RVal} (ha : Definedness.Refined.FactsHold model ib args fs) :
+    ∃ vs, evalRegion Sem.Ops.opSem ctx call env region args = .ok vs ∧ Definedness.Refined.FactsHold model ib vs rs := by
+  cases region with
+  | mk blocks =>
+    cases blocks with
+    | nil => cases h
+    | cons b rest =>
+      cases rest with
+      | cons _ _ => cases b; cases h
+      | nil =>
+        cases b with
+        | mk params ops =>
+          simp only [inferRegion] at h
+          split at h
+          · next ht =>
+            have hlen : params.length = args.length := by
+              rw [← optionMapM_length _ _ _ ht]
+              simpa using (List.Forall₂.length_eq ha).symm
+            simp only [evalRegion, evalBlocks, evalBlock, bindAll_ok hlen, Outcome.bind_ok]
+            exact inferOps_sound R _ ops rs ctx call _ h (hΓ.extend _ args fs ha) hib hf
+          · cases h
+
+def root {ib : Nat} (R : BookAt ib []) : Definedness.Refined.Book model Sem.Ops.opSem ib where
+  rule := R.rule
+  sound Γ op fs rs h ctx call env args hib hΓ ha := R.sound Γ op fs rs h ctx call env args hib (.inl rfl) hΓ ha
+
+#print axioms inferRegion_sound
+end MerlinVerify.Rules.FrontendRangeFrame
diff --git a/merlin/lean/MerlinVerify/Rules/FrontendRangeGeneric.lean b/merlin/lean/MerlinVerify/Rules/FrontendRangeGeneric.lean
new file mode 100644
index 000000000..77e8d9a82
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/FrontendRangeGeneric.lean
@@ -0,0 +1,252 @@
+/- Tensor-element intervals through identity-output structured overwrites. The
+body is checked at actual loop coordinates and receives bounds at actual reads. -/
+import MerlinVerify.Rules.FrontendRangeScalars
+
+namespace MerlinVerify.Rules.FrontendRangeGeneric
+open MerlinVerify MerlinVerify.Check Sem.Ops Sem.Ops.Linalg
+open FrontendTensorRanges FrontendRangeFrame
+
+def elementFact (f : Fact) : Fact := ⟨Definedness.elementFact f.base, f.info⟩
+
+def emptyOutput (sh : List Nat) (e : Ty) : Fact := ⟨⟨.tensor sh e, false⟩, none⟩
+
+theorem readAt_total {ib : Nat} {ranges pt : List Nat} (hp : Idx.InBounds ranges pt)
+    {v : RVal} {f : Fact} {m : AffineMap} (hv : Definedness.Refined.Fact.Holds model ib v f)
+    (hm : mapInBounds ranges m f.base.ty.shape = true) :
+    ∃ x, readAt v m pt = .ok x ∧ Definedness.Refined.Fact.Holds model ib (.scalar x) (elementFact f) := by
+  obtain ⟨x, hx, hbase⟩ := Definedness.readAt_total hp hv.1 hm
+  refine ⟨x, hx, hbase, ?_⟩
+  cases hi : f.info with
+  | none => simp [model, elementFact, hi]
+  | some r =>
+    cases v with
+    | scalar v =>
+      have hxv : x = v := by
+        simp only [readAt] at hx
+        split at hx
+        · cases hx; rfl
+        · cases hx
+      subst x
+      simpa [model, Holds, elementFact, hi] using hv.2
+    | tensor t =>
+      cases ht : f.base.ty with
+      | scalar _ => have h := hv.1.1; rw [ht] at h; cases h
+      | tensor sh e =>
+        have hs : t.shape = sh := by have h := hv.1.1; rw [ht] at h; exact h.1
+        have hm' : mapInBounds ranges m sh = true := by simpa [ht, VTy.shape] using hm
+        obtain ⟨i, he, hin⟩ := mapInBounds_sound hm' hp
+        change evalMap m pt >>= toIdx sh = some i at he
+        have heq : x = t.get i := by simpa only [readAt, hs, he, Outcome.ok.injEq] using hx.symm
+        have hr : Holds r (.tensor t) := by simpa [model, hi] using hv.2
+        simpa only [elementFact, hi, model, Holds, heq] using hr i (hs.symm ▸ hin)
+
+theorem mapM_read_total {ib : Nat} {ranges pt : List Nat} (hp : Idx.InBounds ranges pt) :
+    ∀ (vs : List RVal) (ms : List AffineMap) (fs : List Fact),
+      Definedness.Refined.FactsHold model ib vs fs → MapsInBounds ranges ms (fs.map (·.base.ty)) →
+      ∃ xs, (vs.zip ms).mapM (fun (v, m) => readAt v m pt) = .ok xs ∧
+        Definedness.Refined.FactsHold model ib (xs.map RVal.scalar) (fs.map elementFact)
+  | [], [], [], _, _ => ⟨[], rfl, .nil⟩
+  | v :: vs, m :: ms, f :: fs, .cons hv hvs, .cons hm hms => by
+    obtain ⟨x, hx, hxf⟩ := readAt_total hp hv hm
+    obtain ⟨xs, hxs, hxsf⟩ := mapM_read_total hp vs ms fs hvs hms
+    exact ⟨x :: xs, by simp only [List.zip_cons_cons, List.mapM_cons, Outcome.bindOp_eq,
+      hx, hxs, Outcome.bind_ok, Outcome.pure_eq], .cons hxf hxsf⟩
+  | [], _ :: _, _, h, hm => by cases h; cases hm
+  | _ :: _, [], fs, h, hm => by cases fs; cases h; cases hm
+
+theorem split_facts {ib : Nat} {op : Op} {args : List RVal} {fs ins outs : List Fact}
+    (h : splitInsOuts op fs = some (ins, outs)) (ha : Definedness.Refined.FactsHold model ib args fs) :
+    ∃ xs ys, splitInsOuts op args = some (xs, ys) ∧
+      Definedness.Refined.FactsHold model ib xs ins ∧ Definedness.Refined.FactsHold model ib ys outs := by
+  have hlen := List.Forall₂.length_eq ha
+  unfold splitInsOuts at h ⊢
+  split at h
+  · next ni no _ =>
+    split at h
+    · next hc =>
+      simp only [Option.some.injEq, Prod.mk.injEq] at h
+      obtain ⟨rfl, rfl⟩ := h
+      refine ⟨args.take ni.toNat, args.drop ni.toNat, ?_, List.forall₂_take _ ha, List.forall₂_drop _ ha⟩
+      rw [ite_eq_left ⟨hc.1, hc.2.1, by rw [hlen]; exact hc.2.2⟩]
+    · cases h
+  · cases h
+
+/-- The semantic obligation includes successful execution and the inferred output interval.
+Only actual in-bounds body calls are quantified, including zero-extent iteration spaces. -/
+theorem overwrite_total {ib : Nat} {ctx : Ctx} {ins : List RVal} {fs : List Fact}
+    {maps : List AffineMap} {iters : List IterKind} {t : Tensor} {sh : List Nat} {e : Ty}
+    {body : Ctx → RegionSem} {info : Option Definedness.IndexRanges.Interval}
+    (hs : StructuredOk maps iters.length (fs.map (·.base.ty) ++ [.tensor sh e]) sh)
+    (hout : maps.drop fs.length = [identityMap sh.length])
+    (hins : Definedness.Refined.FactsHold model ib ins fs)
+    (ht : RVal.HasTy ib (.tensor t) (.tensor sh e))
+    (hbody : ∀ pt, Idx.InBounds sh pt → ∀ args,
+      Definedness.Refined.FactsHold model ib args
+        ((fs ++ [emptyOutput sh e]).map elementFact) →
+      ∃ ys, body {ctx with loopIndex := pt} args = .ok ys ∧
+        Definedness.Refined.FactsHold model ib ys [⟨⟨.scalar e, true⟩, info⟩]) :
+    ∃ rs, genericSem ctx maps iters ins [.tensor t] body = .ok rs ∧
+      Definedness.Refined.FactsHold model ib rs [⟨⟨.tensor sh e, true⟩, info⟩] := by
+  classical
+  have hall : HasTys ib (ins ++ [.tensor t]) (fs.map (·.base.ty) ++ [.tensor sh e]) :=
+    List.rel_append hins.typed (.cons ht .nil)
+  obtain ⟨hL, hD, hR, hLR⟩ := structured_runtime hs hall
+  have hk : ins.length = fs.length := List.Forall₂.length_eq hins
+  have hinM : MapsInBounds sh (maps.take ins.length) (fs.map (·.base.ty)) := by
+    have h := List.forall₂_take (fs.map (·.base.ty)).length hs.inBounds
+    rw [List.take_left] at h
+    simpa only [List.length_map, ← hk] using h
+  have hpoint : ∀ p, Idx.InBounds sh p → ∃ y,
+      bodyAt ctx ins (maps.take ins.length) [identityMap sh.length] [t] body p = .ok [y] ∧
+      Definedness.Refined.Fact.Holds model ib (.scalar y) ⟨⟨.scalar e, true⟩, info⟩ := by
+    intro p hp
+    obtain ⟨xs, hx, hxf⟩ := mapM_read_total hp ins (maps.take ins.length) fs hins hinM
+    have hp' : Idx.InBounds t.shape p := ht.1.symm ▸ hp
+    have houtRead := readAt_identity hp'
+    rw [ht.1] at houtRead
+    have hfacts : Definedness.Refined.FactsHold model ib ((xs ++ [t.get p]).map RVal.scalar)
+        ((fs ++ [emptyOutput sh e]).map elementFact) := by
+      rw [List.map_append, List.map_append]
+      exact List.rel_append hxf (.cons ⟨⟨ht.2.2 p hp, by simp [elementFact, emptyOutput, Definedness.elementFact]⟩, trivial⟩ .nil)
+    obtain ⟨ys, hy, hyf⟩ := hbody p hp _ hfacts
+    obtain _ | ⟨hyf, hnil⟩ := hyf
+    cases hnil
+    rename_i y
+    cases y with
+    | tensor _ => cases hyf.1.1
+    | scalar y =>
+      refine ⟨y, ?_, hyf⟩
+      simp only [bodyAt, List.zip_cons_cons, List.zip_nil_right, List.mapM_cons, List.mapM_nil,
+        Outcome.bindOp_eq, hx, houtRead, Outcome.bind_ok, Outcome.pure_eq, hy,
+        List.length_cons, List.length_nil, ne_eq, not_true_eq_false, ↓reduceIte]
+  let F : Idx → Val := fun p => if hp : Idx.InBounds sh p then Classical.choose (hpoint p hp) else .poison
+  have hF : ∀ p, Idx.InBounds sh p →
+      bodyAt ctx ins (maps.take ins.length) [identityMap sh.length] [t] body p = .ok [F p] ∧
+      Definedness.Refined.Fact.Holds model ib (.scalar (F p)) ⟨⟨.scalar e, true⟩, info⟩ := by
+    intro p hp
+    simpa only [F, dite_eq_left hp] using Classical.choose_spec (hpoint p hp)
+  refine ⟨[.tensor (Tensor.canon sh t.elt F)], ?_, .cons ⟨⟨⟨rfl, ht.2.1, ?_⟩, ?_⟩, ?_⟩ .nil⟩
+  · exact genericSem_parallel1 ctx maps iters ins t body sh F
+      (by simpa only [List.length_append, List.length_cons, List.length_nil] using hL)
+      hD hR hLR ht.1 (hk ▸ hout) (fun p hp => (hF p hp).1)
+  · intro p hp
+    simpa only [Tensor.canon, hp, ↓reduceIte, RVal.HasTy] using (hF p hp).2.1.1
+  · intro _ p hp
+    change Idx.InBounds sh p at hp
+    simpa only [Tensor.canon, hp, ↓reduceIte, RVal.Defined] using (hF p hp).2.1.2 rfl
+  · cases info with
+    | none => trivial
+    | some r =>
+      intro p hp
+      change Idx.InBounds sh p at hp
+      simpa only [Tensor.canon, hp, ↓reduceIte, model, Holds] using (hF p hp).2.2
+
+def rule (ib : Nat) (bodyBooks : (ranges : List Nat) → BookAt ib ranges)
+    (Γ : FEnv) (op : Op) (fs : List Fact) : Option (List Fact) :=
+  if unmodelledAttr? op.blind = none ∧ dialectOf op.name = "linalg" ∧ op.name = "linalg.generic" then
+    match splitInsOuts op fs, attrAffineMaps? op "indexing_maps", iterKinds? op, op.regions with
+    | some (ins, [⟨⟨.tensor sh e, _⟩, _⟩]), some maps, some iters, [body] =>
+      if op.results.length = 1 ∧ maps.drop ins.length = [identityMap sh.length] ∧
+          structuredRanges? maps iters.length (ins.map (·.base.ty) ++ [.tensor sh e]) = some sh ∧
+          op.results.mapM (fun v => vtyOf ib v.ty) = some [.tensor sh e] then
+        match inferRegion (bodyBooks sh) Γ body ((ins ++ [emptyOutput sh e]).map elementFact) with
+        | some [⟨⟨.scalar ty, true⟩, info⟩] => if ty = e then some [⟨⟨.tensor sh e, true⟩, info⟩] else none
+        | _ => none
+      else none
+    | _, _, _, _ => none
+  else none
+
+def book (ib : Nat) (bodyBooks : (ranges : List Nat) → BookAt ib ranges) : Definedness.Refined.Book model opSem ib where
+  rule := rule ib bodyBooks
+  sound Γ op fs rs h ctx call env args hib hΓ ha := by
+    unfold rule at h
+    split at h
+    · next hc =>
+      obtain ⟨hm, hd, hn⟩ := hc
+      split at h
+      · next ins sh e init oldinfo maps iters body hsplit hmaps hiters hregs =>
+        split at h
+        · next hc =>
+          obtain ⟨hres, hout, hranges, _⟩ := hc
+          split at h
+          · next ty info hbody =>
+            split at h
+            · next hty =>
+              subst ty
+              cases h
+              obtain ⟨xs, ys, hio, hxs, hys⟩ := split_facts hsplit ha
+              obtain _ | ⟨ht, hnil⟩ := hys
+              cases hnil
+              rename_i t
+              cases t with
+              | scalar _ => cases ht.1.1
+              | tensor t =>
+                obtain ⟨rs, hsem, hrf⟩ := overwrite_total (ctx := ctx)
+                  (body := fun inner => evalRegion opSem inner call env body) (info := info)
+                  (structuredRanges?_spec hranges) hout hxs ht.1.1
+                  (fun p hp vals hfacts => inferRegion_sound (ctx := {ctx with loopIndex := p})
+                    (bodyBooks sh) hbody hib (.inr hp) hΓ hfacts)
+                refine ⟨rs, ?_, hrf⟩
+                have hlen : rs.length = op.blind.results.length := by
+                  rw [List.Forall₂.length_eq hrf, Op.blind_results, List.length_map, hres]; rfl
+                rw [linalg_sem_of hm hd (.inl hn)]
+                simp only [hregs, evalRegions, Linalg.sem, Op.blind_name, hn, splitInsOuts_blind, hio,
+                  attrAffineMaps?_blind, hmaps, iterKinds?_blind, hiters, Outcome.bindOp_eq, hsem,
+                  Outcome.bind_ok, hlen, ↓reduceIte, Outcome.pure_eq]
+            · cases h
+          · cases h
+        · cases h
+      · cases h
+    · cases h
+
+/-- No body call is possible in a zero-extent iteration space. The checked
+structured geometry proves this case, so it needs no invented element interval. -/
+def emptyRule (ib : Nat) (_ : FEnv) (op : Op) (fs : List Fact) : Option (List Fact) :=
+  if unmodelledAttr? op.blind = none ∧ dialectOf op.name = "linalg" ∧ op.name = "linalg.generic" then
+    match splitInsOuts op fs, attrAffineMaps? op "indexing_maps", iterKinds? op, op.regions with
+    | some (ins, [⟨⟨.tensor sh e, _⟩, _⟩]), some maps, some iters, [_body] =>
+      if op.results.length = 1 ∧ maps.drop ins.length = [identityMap sh.length] ∧
+          structuredRanges? maps iters.length (ins.map (·.base.ty) ++ [.tensor sh e]) = some sh ∧
+          shapeSize sh = 0 ∧ op.results.mapM (fun v => vtyOf ib v.ty) = some [.tensor sh e] then
+        some [⟨⟨.tensor sh e, true⟩, none⟩]
+      else none
+    | _, _, _, _ => none
+  else none
+
+def emptyBook (ib : Nat) : Definedness.Refined.Book model opSem ib where
+  rule := emptyRule ib
+  sound Γ op fs rs h ctx call env args hib hΓ ha := by
+    unfold emptyRule at h
+    split at h
+    · next hc =>
+      obtain ⟨hm, hd, hn⟩ := hc
+      split at h
+      · next ins sh e init oldinfo maps iters body hsplit hmaps hiters hregs =>
+        split at h
+        · next hc =>
+          obtain ⟨hres, hout, hranges, hempty, _⟩ := hc
+          cases h
+          obtain ⟨xs, ys, hio, hxs, hys⟩ := split_facts hsplit ha
+          obtain _ | ⟨ht, hnil⟩ := hys
+          cases hnil
+          rename_i t
+          cases t with
+          | scalar _ => cases ht.1.1
+          | tensor t =>
+            obtain ⟨rs, hsem, hrf⟩ := overwrite_total (ctx := ctx)
+              (body := fun inner => evalRegion opSem inner call env body) (info := none)
+              (structuredRanges?_spec hranges) hout hxs ht.1.1
+              (fun p hp _ _ => False.elim (by have hi := linearIndex_lt sh p hp; omega))
+            refine ⟨rs, ?_, hrf⟩
+            have hlen : rs.length = op.blind.results.length := by
+              rw [List.Forall₂.length_eq hrf, Op.blind_results, List.length_map, hres]; rfl
+            rw [linalg_sem_of hm hd (.inl hn)]
+            simp only [hregs, evalRegions, Linalg.sem, Op.blind_name, hn, splitInsOuts_blind, hio,
+              attrAffineMaps?_blind, hmaps, iterKinds?_blind, hiters, Outcome.bindOp_eq, hsem,
+              Outcome.bind_ok, hlen, ↓reduceIte, Outcome.pure_eq]
+        · cases h
+      · cases h
+    · cases h
+
+#print axioms book
+end MerlinVerify.Rules.FrontendRangeGeneric
diff --git a/merlin/lean/MerlinVerify/Rules/FrontendRangeProjection.lean b/merlin/lean/MerlinVerify/Rules/FrontendRangeProjection.lean
