+/- Conservativity of the inactive runtime interpretation on unchanged operation fragments.
+The executable gate reads actual operation fields, including nested regions. -/
+import MerlinVerify.Rules.FrontendMaskRuntime
+import MerlinVerify.Check.Defined
+
+namespace MerlinVerify.Rules.FrontendRuntimeBridge
+open MerlinVerify MerlinVerify.Check
+
+/-- The candidate delegates this operation to the frozen interpreter, on every input. -/
+def delegates (op : Op) : Bool :=
+  decide (op.name ≠ "scf.if" ∧ op.name ≠ "scf.for" ∧
+    (op.name ≠ "tensor.empty" ∨ Sem.Ops.Tensor.resultTensorTy op.blind ≠ none))
+
+theorem delegates_sound {op : Op} (h : delegates op = true) (limit : Nat)
+    (ctx : Ctx) (call : CallSem) (args : List RVal) (regions : List (Ctx → RegionSem)) :
+    FrontendMaskRuntime.sem limit ctx call op args regions = Sem.Ops.opSem ctx call op args regions := by
+  simp only [delegates, decide_eq_true_eq] at h
+  unfold FrontendMaskRuntime.sem
+  split
+  · split
+    · split
+      · next hn => exact (h.1 (Op.blind_name op ▸ hn)).elim
+      · next hn => exact (h.2.1 (Op.blind_name op ▸ hn)).elim
+      · rfl
+    · split
+      · next hn =>
+        rcases h.2.2 with he | he
+        · exact (he (Op.blind_name op ▸ hn.1)).elim
+        · exact (he hn.2).elim
+      · rfl
+    · rfl
+  · rfl
+
+mutual
+  def ops : List Op → Bool
+    | [] => true
+    | op@(.mk _ _ _ _ _ rs _) :: tail => delegates op && regions rs && ops tail
+  def regions : List Region → Bool
+    | [] => true
+    | .mk blocks :: tail => blocksCheck blocks && regions tail
+  def blocksCheck : List Block → Bool
+    | [] => true
+    | .mk _ body :: tail => ops body && blocksCheck tail
+end
+
+mutual
+  theorem ops_sound (limit : Nat) (ctx : Ctx) (call : CallSem) (env : Env) :
+      ∀ body, ops body = true →
+      evalOps (FrontendMaskRuntime.sem limit) ctx call env body =
+        evalOps Sem.Ops.opSem ctx call env body
+    | [], _ => rfl
+    | .mk name results operands attrs props rs successors :: tail, h => by
+      simp only [ops, Bool.and_eq_true] at h
+      rw [evalOps.eq_2, evalOps.eq_2]
+      split
+      · rfl
+      · apply congrArg (Outcome.bind (env.getAll operands))
+        funext args
+        have hr := regions_sound limit call env rs h.1.2
+        rw [hr, delegates_sound h.1.1]
+        apply congrArg (Outcome.bind (Sem.Ops.opSem ctx call
+          (.mk name results operands attrs props rs successors) args
+          (evalRegions Sem.Ops.opSem call env rs)))
+        funext values
+        apply congrArg (Outcome.bind (env.bindAll results values))
+        funext next
+        exact ops_sound limit ctx call next tail h.2
+
+  theorem regions_sound (limit : Nat) (call : CallSem) (env : Env) :
+      ∀ rs, regions rs = true →
+      evalRegions (FrontendMaskRuntime.sem limit) call env rs =
+        evalRegions Sem.Ops.opSem call env rs
+    | [], _ => rfl
+    | .mk blocks :: tail, h => by
+      simp only [regions, Bool.and_eq_true] at h
+      simp only [evalRegions]
+      congr 1
+      · funext ctx args
+        exact blocks_sound limit ctx call env blocks args h.1
+      · exact regions_sound limit call env tail h.2
+
+  theorem blocks_sound (limit : Nat) (ctx : Ctx) (call : CallSem) (env : Env) :
+      ∀ blocks args, blocksCheck blocks = true →
+      evalBlocks (FrontendMaskRuntime.sem limit) ctx call env blocks args =
+        evalBlocks Sem.Ops.opSem ctx call env blocks args
+    | [], _, _ => rfl
+    | [.mk params body], args, h => by
+      simp only [blocksCheck, Bool.and_eq_true] at h
+      simp only [evalBlocks, evalBlock]
+      apply congrArg (Outcome.bind (env.bindAll params args))
+      funext next
+      exact ops_sound limit ctx call next body h.1
+    | _ :: _ :: _, _, _ => rfl
+end
+
+/-- Lift an existing definedness book only when the actual operation and all nested regions
+retain the frozen interpretation. Dynamic/SCF cases must supply independent proofs. -/
+def liftBook (limit ib : Nat) (old : Definedness.Book Sem.Ops.opSem ib) :
+    Definedness.Book (FrontendMaskRuntime.sem limit) ib where
+  rule Γ op fs := if delegates op && regions op.regions then old.rule Γ op fs else none
+  sound Γ op fs rs h ctx call env args hib hΓ ha := by
+    split at h
+    · next hc =>
+      simp only [Bool.and_eq_true] at hc
+      rw [regions_sound limit call env op.regions hc.2, delegates_sound hc.1]
+      exact old.sound Γ op fs rs h ctx call env args hib hΓ ha
+    · cases h
+
+#print axioms ops_sound
+#print axioms liftBook
+end MerlinVerify.Rules.FrontendRuntimeBridge
diff --git a/merlin/lean/MerlinVerify/Rules/FrontendRuntimeChain.lean b/merlin/lean/MerlinVerify/Rules/FrontendRuntimeChain.lean
new file mode 100644
index 000000000..2732a40b3
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/FrontendRuntimeChain.lean
@@ -0,0 +1,62 @@
+/- Checked suffix composition under exactly the same candidate interpretation. -/
+import MerlinVerify.Rules.FrontendRuntimeVerification
+
+namespace MerlinVerify.Rules.FrontendRuntimeChain
+open MerlinVerify MerlinVerify.Check
+
+/-- An intentionally narrow suffix checker: complete AST alpha correspondence. It never imports
+frozen-model receipts or treats a numerical policy as ordinary execution equality. -/
+def boundary (src tgt : Module) : Bool :=
+  alphaOps [] src.ops tgt.ops && (outsideChanges src tgt).unverified.isEmpty &&
+    FrontendBoolSimulation.functions [] src.funcs tgt.funcs
+
+theorem boundary_sound {src tgt : Module} (h : boundary src tgt = true)
+    (limit : Nat) (base : FloatModel) (ctx : Ctx) (name : String) (args : List RVal) :
+    denote (FrontendMaskRuntime.sem limit) {ctx with M := FrontendF32Comparison.model base} src name args =
+      denote (FrontendMaskRuntime.sem limit) {ctx with M := FrontendF32Comparison.model base} tgt name args := by
+  simp only [boundary, Bool.and_eq_true] at h
+  have he := FrontendBoolSimulationWith.evalFunc_sound _
+    (FrontendBoolSimulationWith.candidateLaws limit) h.2
+    {ctx with M := FrontendF32Comparison.model base} (FrontendF32Comparison.model_correct base)
+  have hl := FrontendBoolSimulation.functions_length src.funcs tgt.funcs h.2
+  rw [FrontendBoolSimulationWith.policy_nil] at he
+  simp only [denote]
+  rw [he, hl]
+
+/-- The tail is explicit, so neither the order nor an intermediate boundary can be omitted. -/
+def suffix (first : Module) : List Module → Bool
+  | [] => true
+  | next :: rest => boundary first next && suffix next rest
+
+def final (first : Module) : List Module → Module
+  | [] => first
+  | next :: rest => final next rest
+
+theorem suffix_sound (first : Module) : ∀ tail, suffix first tail = true →
+    ∀ (limit : Nat) (base : FloatModel) (ctx : Ctx) (name : String) (args : List RVal),
+    denote (FrontendMaskRuntime.sem limit) {ctx with M := FrontendF32Comparison.model base}
+        (final first tail) name args =
+      denote (FrontendMaskRuntime.sem limit) {ctx with M := FrontendF32Comparison.model base} first name args
+  | [], _, _, _, _, _, _ => rfl
+  | next :: rest, h, limit, base, ctx, name, args => by
+    simp only [suffix, Bool.and_eq_true] at h
+    exact (suffix_sound next rest h.2 limit base ctx name args).trans
+      (boundary_sound h.1 limit base ctx name args).symm
+
+/-- A checked suffix discharges the equality premise in the existing repair-policy composition
+lemma. The final claim still matches A2's source-only repair policy, not raw source semantics. -/
+theorem compose {src repaired : Module} {tail : List Module} {entry : String} {stop limit : Nat}
+    (hrepair : FrontendRuntimeVerification.check src repaired entry stop limit = true)
+    (hsuffix : suffix repaired tail = true) (base : FloatModel) (ctx : Ctx)
+    (name : String) (args : List RVal) :
+    denote (FrontendMaskRuntime.sem limit) {ctx with M := FrontendF32Comparison.model base}
+        (final repaired tail) name args =
+      FrontendBoolSimulationWith.policyDenote (FrontendMaskRuntime.sem limit) src
+        {ctx with M := FrontendF32Comparison.model base} name args :=
+  FrontendBoolCandidateChain.compose (FrontendRuntimeVerification.check_sound hrepair).1 limit base ctx name args
+    (suffix_sound repaired tail hsuffix limit base ctx name args)
+
+#print axioms boundary_sound
+#print axioms suffix_sound
+#print axioms compose
+end MerlinVerify.Rules.FrontendRuntimeChain
diff --git a/merlin/lean/MerlinVerify/Rules/FrontendRuntimeCheckpoint.lean b/merlin/lean/MerlinVerify/Rules/FrontendRuntimeCheckpoint.lean
new file mode 100644
index 000000000..fb2bbe15c
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/FrontendRuntimeCheckpoint.lean
@@ -0,0 +1,135 @@
+/- Actual-prefix plus actual-selection execution, composed through intermediate SSA state. -/
+import MerlinVerify.Rules.FrontendPrefixProjection
+import MerlinVerify.Rules.FrontendMaskTyped
+import MerlinVerify.Rules.FrontendProgramSegments
+
+namespace MerlinVerify.Rules.FrontendRuntimeCheckpoint
+open MerlinVerify MerlinVerify.Check MerlinVerify.Check.Definedness
+open FrontendProgramSegments
+
+structure Scope (m : Module) (name : String) (stop : Nat) where
+  p : FrontendPrefixProjection.Prefix m name stop
+  mask : Value
+  values : Value
+  seed : Value
+  roots : p.cut.args = [mask, values, seed]
+
+def project? (m : Module) (name : String) (stop : Nat) : Option (Scope m name stop) := do
+  let p ← FrontendPrefixProjection.project? m name stop
+  match h : p.cut.args with
+  | [mask, values, seed] => some ⟨p, mask, values, seed, h⟩
+  | _ => none
+
+def bareSource : Region := .mk [.mk [] FrontendMaskTemplate.operations]
+
+def Scope.bare {m : Module} {name : String} {stop : Nat} (s : Scope m name stop) : Region :=
+  .mk [.mk [] (s.p.cut.selected ++ [returned (s.p.cut.outputs.map (·.id))])]
+
+def Scope.body {m : Module} {name : String} {stop : Nat} (s : Scope m name stop) : Region :=
+  .mk [.mk s.p.cut.block.args ((s.p.cut.block.ops.take stop) ++
+    s.p.cut.selected ++ [returned (s.p.cut.outputs.map (·.id))])]
+
+/-- The checked region contains the actual initial operations, in their original order.
+Only the observation return is added; no source operation is replaced by the projection. -/
+theorem Scope.body_actual {m : Module} {name : String} {stop : Nat} (s : Scope m name stop) :
+    s.body = .mk [.mk s.p.cut.block.args ((s.p.cut.block.ops.take (stop + 25)) ++
+      [returned (s.p.cut.outputs.map (·.id))])] := by
+  simp only [Scope.body, s.p.cut.slice, ← List.take_add]
+
+def Scope.program {m : Module} {name : String} {stop : Nat} (s : Scope m name stop) : Module :=
+  {ops := [.mk "func.func" [] []
+    [("function_type", .type (.function (s.p.cut.block.args.map (·.ty)) (s.p.cut.outputs.map (·.ty)))),
+     ("sym_name", .str "subject")] [] [s.body] []]}
+
+def Scope.check {m : Module} {name : String} {stop : Nat} (s : Scope m name stop)
+    (limit : Nat) (a : List VTy) : Bool :=
+  FrontendMaskWhole.check s.p.cut.program &&
+  (s.p.cut.block.ops.take stop).all (fun op => !op.isTerminator) &&
+  Definedness.checkRegion (FrontendPrefixDefined.candidateBook limit 64) [] s.p.body (clean a)
+    FrontendMaskTyped.inputTypes &&
+  FrontendBoolSimulation.region [] [(50,s.mask.id),(51,s.values.id),(52,s.seed.id)] bareSource s.bare
+
+/-- Acceptance connects the full model's declared initialized inputs to actual prefix/selection
+execution. It does not assume the intermediate cut domain or replace the operations by an oracle. -/
+theorem scope_sound {m : Module} {name : String} {stop limit : Nat} {s : Scope m name stop}
+    {a : List VTy} (h : s.check limit a = true) (base : FloatModel) (ctx : Ctx) (call : CallSem)
+    (args : List RVal) (ha : HasTys 64 args a) (hd : ResultsDefined args)
+    (hib : ctx.indexBits = 64) (hl : 1024 ≤ limit) :
+    ∃ results, evalRegion (FrontendMaskRuntime.sem limit) {ctx with M := FrontendF32Comparison.model base}
+      call [] s.body args = .ok results ∧
+      HasTys 64 results FrontendMaskTyped.resultTypes ∧ ResultsDefined results := by
+  simp only [Scope.check, Bool.and_eq_true] at h
+  obtain ⟨⟨⟨_, hnonterm⟩, hpre⟩, hcut⟩ := h
+  let modelCtx := {ctx with M := FrontendF32Comparison.model base}
+  let sem := FrontendMaskRuntime.sem limit
+  obtain ⟨mid, hmid, ht, hi⟩ := Definedness.checkRegion_sound
+    (ctx := modelCtx) (call := call) (env := [])
+    (FrontendPrefixDefined.candidateBook limit 64) hpre hib
+    (by intro _ _ h; cases h) (inputFacts ha hd)
+  change evalRegion sem modelCtx call [] s.p.body args = .ok mid at hmid
+  cases hb : Env.bindAll [] s.p.cut.block.args args with
+  | ub => simp [FrontendPrefixProjection.Prefix.body, evalRegion, evalBlocks, evalBlock, hb] at hmid
+  | stuck why => simp [FrontendPrefixProjection.Prefix.body, evalRegion, evalBlocks, evalBlock, hb] at hmid
+  | ok initial =>
+    simp only [FrontendPrefixProjection.Prefix.body, evalRegion, evalBlocks, evalBlock, hb,
+      Outcome.bind_ok] at hmid
+    obtain ⟨middle, hmiddle, hread⟩ := prefix_state (sem := sem) (ctx := modelCtx) (call := call)
+      (env := initial) (pre := s.p.cut.block.ops.take stop)
+      (fun op hop => by simpa using List.all_eq_true.mp hnonterm op hop) hmid
+    obtain _ | ⟨hm, ht⟩ := ht
+    obtain _ | ⟨hv, ht⟩ := ht
+    obtain _ | ⟨hs, ht⟩ := ht
+    cases ht
+    rename_i mask values seed
+    have htyped : HasTys 64 [mask,values,seed] FrontendMaskTyped.inputTypes := .cons hm (.cons hv (.cons hs .nil))
+    obtain ⟨results, hbody, hr, hd⟩ := FrontendMaskTyped.body_exec limit modelCtx call _ htyped hi hib
+      (FrontendF32Comparison.model_correct base) hl
+    have hc := roots_corr middle s.mask.id s.values.id s.seed.id mask values seed
+      (by simpa only [s.roots, List.map_cons, List.map_nil] using hread)
+    have he := FrontendBoolSimulationWith.region_sound sem (FrontendBoolSimulationWith.candidateLaws limit)
+      [] call _ bareSource s.bare modelCtx [(50,mask),(51,values),(52,seed)] middle hcut
+      (FrontendF32Comparison.model_correct base) hc
+    rw [FrontendBoolSimulationWith.policy_nil] at he
+    have hsource : evalRegion sem modelCtx call [(50,mask),(51,values),(52,seed)] bareSource [] = .ok results := by
+      simpa only [bareSource, FrontendMaskTemplate.body, evalRegion, evalBlocks, evalBlock,
+        Env.bindAll, List.length_cons, List.length_nil, ↓reduceIte, List.map_cons, List.map_nil,
+        List.zip_cons_cons, List.zip_nil_left, List.cons_append, List.nil_append, Outcome.bind_ok] using hbody
+    have htarget := (congrFun he []).symm.trans hsource
+    simp only [Scope.bare, evalRegion, evalBlocks, evalBlock, Env.bindAll, List.length_nil,
+      ↓reduceIte, List.map_nil, List.zip_nil_left, List.nil_append, Outcome.bind_ok] at htarget
+    refine ⟨results, ?_, hr, hd⟩
+    simp only [Scope.body, evalRegion, evalBlocks, evalBlock, hb, Outcome.bind_ok]
+    rw [List.append_assoc, evalOps_append sem modelCtx call initial _ _
+      (fun op hop => by simpa using List.all_eq_true.mp hnonterm op hop), hmiddle, Outcome.bind_ok]
+    exact htarget
+
+def check (m : Module) (name : String) (stop limit : Nat) : Bool :=
+  match project? m name stop with
+  | none => false
+  | some s => match s.p.cut.block.args.mapM (fun v => vtyOf 64 v.ty) with
+    | none => false
+    | some a => s.check limit a
+
+/-- Every accepted checkpoint is a slice of the actual block and executes from its declared
+initialized inputs, including the actual SSA state between the prefix and selection. -/
+theorem check_sound {m : Module} {name : String} {stop limit : Nat}
+    (h : check m name stop limit = true) :
+    ∃ s : Scope m name stop, project? m name stop = some s ∧
+      ∃ a, s.p.cut.block.args.mapM (fun v => vtyOf 64 v.ty) = some a ∧
+        ∀ (base : FloatModel) (ctx : Ctx) (call : CallSem) (args : List RVal), ctx.indexBits = 64 → 1024 ≤ limit →
+          HasTys 64 args a → ResultsDefined args →
+          ∃ results, evalRegion (FrontendMaskRuntime.sem limit) {ctx with M := FrontendF32Comparison.model base}
+            call [] s.body args = .ok results ∧ HasTys 64 results FrontendMaskTyped.resultTypes ∧
+              ResultsDefined results := by
+  unfold check at h
+  split at h
+  · cases h
+  · next s hp =>
+    split at h
+    · cases h
+    · next a ha =>
+      exact ⟨s, hp, a, ha, fun base ctx call args hib hl ht hd => scope_sound h base ctx call args ht hd hib hl⟩
+
+#print axioms scope_sound
+#print axioms check_sound
+end MerlinVerify.Rules.FrontendRuntimeCheckpoint
diff --git a/merlin/lean/MerlinVerify/Rules/FrontendRuntimeObligations.lean b/merlin/lean/MerlinVerify/Rules/FrontendRuntimeObligations.lean
new file mode 100644
index 000000000..37c8e5216
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/FrontendRuntimeObligations.lean
@@ -0,0 +1,53 @@
+/- Explicit local obstructions to full-model definedness; no additional numeric law is assumed. -/
+import MerlinVerify.Rules.FrontendRuntimeChain
+
+namespace MerlinVerify.Rules.FrontendRuntimeObligations
+open MerlinVerify MerlinVerify.Check MerlinVerify.Sem.Ops
+
+/-- This is an allowed frozen FloatModel. Approving f32 UNE does not constrain toInt. -/
+def absentConversions (base : FloatModel) : FloatModel :=
+  {base with toInt := fun _ _ _ _ => none}
+
+def cast8 : Op := .mk "arith.fptosi" [{id := 0, ty := .int 8}] [1] [] [] [] []
+
+/-- An accepted actual i8 cast produces poison in an allowed interpretation, even from an
+initialized f32 operand. This is a local conversion obstruction, not a full-model counterexample. -/
+theorem cast8_poison {actual : Op} (h : opHeadEq cast8 actual = true)
+    (limit : Nat) (base : FloatModel) (ctx : Ctx) (call : CallSem) (x : FBits .f32) :
+    FrontendMaskRuntime.sem limit {ctx with M := FrontendF32Comparison.model (absentConversions base)}
+      call actual [.scalar (.some (.flt .f32 x))] [] = .ok [.scalar .poison] := by
+  rw [FrontendMaskRuntime.sem_blind (blind_of_opHeadEq h).symm]
+  simp [FrontendMaskRuntime.sem, cast8, opSem, dispatch, show dialectOf "arith.fptosi" = "arith" by cbv, Outcome.ofOption, Outcome.bind, unmodelledAttr?, interpretedAttrs,
+    Op.blind, Op.name, Op.results, Op.attrs, Op.props, Op.successors, Arith.sem, Arith.widthOf,
+    Arith.resultElt, Ty.bitWidth?, Arith.unOp, Arith.pureN, liftEager,
+    FrontendF32Comparison.model, absentConversions]
+
+/-- BF16 is merely the stored element type here. No BF16 arithmetic is interpreted or proved. -/
+def tokenExtract : Op :=
+  .mk "tensor.extract" [{id := 0, ty := .float .bf16}] [1,2,3] [] [] [] []
+
+/-- Initialization alone does not bound token indices. An index at the table's extent is UB
+under the existing tensor interpretation. The candidate retains that interpretation unchanged. -/
+theorem token_upper_ub {actual : Op} (h : opHeadEq tokenExtract actual = true)
+    (limit : Nat) (ctx : Ctx) (call : CallSem) (t : Tensor) (hs : t.shape = [49280,960]) :
+    FrontendMaskRuntime.sem limit ctx call actual
+      [.tensor t, FrontendMaskProgram.index 49280, FrontendMaskProgram.index 0] [] = .ub := by
+  rw [FrontendMaskRuntime.sem_blind (blind_of_opHeadEq h).symm]
+  simp [FrontendMaskRuntime.sem, tokenExtract, opSem, dispatch, show dialectOf "tensor.extract" = "tensor" by cbv, unmodelledAttr?, interpretedAttrs,
+    Op.blind, Op.name, Op.results, Op.attrs, Op.props, Op.successors, Tensor.sem,
+    FrontendMaskProgram.index, Tensor.indexVal?, hs]
+
+/-- A negative initialized token is the second independent missing domain restriction. -/
+theorem token_negative_ub {actual : Op} (h : opHeadEq tokenExtract actual = true)
+    (limit : Nat) (ctx : Ctx) (call : CallSem) (t : Tensor) (hs : t.shape = [49280,960]) :
+    FrontendMaskRuntime.sem limit ctx call actual
+      [.tensor t, .scalar (.some (.bits 64 (-1))), FrontendMaskProgram.index 0] [] = .ub := by
+  rw [FrontendMaskRuntime.sem_blind (blind_of_opHeadEq h).symm]
+  simp [FrontendMaskRuntime.sem, tokenExtract, opSem, dispatch, show dialectOf "tensor.extract" = "tensor" by cbv, unmodelledAttr?, interpretedAttrs,
+    Op.blind, Op.name, Op.results, Op.attrs, Op.props, Op.successors, Tensor.sem,
+    FrontendMaskProgram.index, Tensor.indexVal?, hs]
+
+#print axioms cast8_poison
+#print axioms token_upper_ub
+#print axioms token_negative_ub
+end MerlinVerify.Rules.FrontendRuntimeObligations
diff --git a/merlin/lean/MerlinVerify/Rules/FrontendRuntimeVerification.lean b/merlin/lean/MerlinVerify/Rules/FrontendRuntimeVerification.lean
new file mode 100644
index 000000000..34eed617c
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/FrontendRuntimeVerification.lean
@@ -0,0 +1,73 @@
+/- Actual-boundary repair policy and initialized checkpoint under one inactive interpretation. -/
+import MerlinVerify.Rules.FrontendRuntimeCheckpoint
+import MerlinVerify.Rules.FrontendBoolCandidateChain
+
+namespace MerlinVerify.Rules.FrontendRuntimeVerification
+open MerlinVerify MerlinVerify.Check FrontendRuntimeCheckpoint
+
+/-- Hints locate the checkpoint; every operation, root and type is recovered from both modules.
+The full repair check also accounts for all changes outside this checkpoint. -/
+def checkpoint (src tgt : Module) (name : String) (stop limit : Nat) : Bool :=
+  match FrontendBoolProgram.defsOps 64 src.ops, project? src name stop, project? tgt name stop with
+  | some defs, some s, some t =>
+    match t.p.cut.block.args.mapM (fun v => vtyOf 64 v.ty) with
+    | none => false
+    | some a => t.check limit a &&
+      FrontendBoolSimulation.region (FrontendBoolProgram.sourceTypes defs) [] s.body t.body
+  | _, _, _ => false
+
+def check (src tgt : Module) (name : String) (stop limit : Nat) : Bool :=
+  FrontendBoolSimulation.check src tgt && checkpoint src tgt name stop limit
+
+/-- Acceptance proves both complete-program equality to the declared repair policy and successful
+execution of the actual initial segment. It does not claim that the rest of the model is defined,
+or that repaired execution preserves the potentially poison-producing raw source semantics. -/
+theorem check_sound {src tgt : Module} {name : String} {stop limit : Nat}
+    (h : check src tgt name stop limit = true) :
+    FrontendBoolSimulation.check src tgt = true ∧
+    ∃ defs, ∃ (s : Scope src name stop) (t : Scope tgt name stop), ∃ a,
+      FrontendBoolProgram.defsOps 64 src.ops = some defs ∧
+      project? src name stop = some s ∧ project? tgt name stop = some t ∧
+      t.p.cut.block.args.mapM (fun v => vtyOf 64 v.ty) = some a ∧
+      ∀ (base : FloatModel) (ctx : Ctx) (call : CallSem) (args : List RVal),
+        ctx.indexBits = 64 → 1024 ≤ limit → HasTys 64 args a → ResultsDefined args →
+        ∃ results,
+          evalRegion (FrontendMaskRuntime.sem limit) {ctx with M := FrontendF32Comparison.model base}
+            call [] t.body args = .ok results ∧
+          evalRegion (FrontendBoolSimulationWith.policySem (FrontendMaskRuntime.sem limit)
+              (FrontendBoolProgram.sourceTypes defs)) {ctx with M := FrontendF32Comparison.model base}
+            call [] s.body args = .ok results ∧
+          HasTys 64 results FrontendMaskTyped.resultTypes ∧ ResultsDefined results := by
+  unfold check checkpoint at h
+  simp only [Bool.and_eq_true] at h
+  refine ⟨h.1, ?_⟩
+  rcases h with ⟨_, h⟩
+  split at h
+  · next defs s t hdefs hs ht =>
+    split at h
+    · cases h
+    · next a ha =>
+      simp only [Bool.and_eq_true] at h
+      refine ⟨defs, s, t, a, hdefs, hs, ht, ha, ?_⟩
+      intro base ctx call args hib hl hty hd
+      obtain ⟨results, hv, hr, hi⟩ := scope_sound h.1 base ctx call args hty hd hib hl
+      have he := FrontendBoolSimulationWith.region_sound _
+        (FrontendBoolSimulationWith.candidateLaws limit) _ call [] s.body t.body
+        {ctx with M := FrontendF32Comparison.model base} [] [] h.2
+        (FrontendF32Comparison.model_correct base) (by intro x y hxy; simp [Rho.find] at hxy)
+      exact ⟨results, hv, (congrFun he args).trans hv, hr, hi⟩
+  · cases h
+
+/-- Complete-program policy matching is unconditional on successful execution. Poison, UB and
+unsupported outcomes remain observable in the same candidate evaluator. -/
+theorem full_policy {src tgt : Module} {name : String} {stop limit : Nat}
+    (h : check src tgt name stop limit = true) (base : FloatModel) (ctx : Ctx)
+    (entry : String) (args : List RVal) :
+    FrontendBoolSimulationWith.policyDenote (FrontendMaskRuntime.sem limit) src
+        {ctx with M := FrontendF32Comparison.model base} entry args =
+      denote (FrontendMaskRuntime.sem limit) {ctx with M := FrontendF32Comparison.model base} tgt entry args :=
+  FrontendBoolSimulationWith.check_sound_candidate (check_sound h).1 limit base ctx entry args
+
+#print axioms check_sound
+#print axioms full_policy
+end MerlinVerify.Rules.FrontendRuntimeVerification
diff --git a/merlin/tests/ir/test_lean_frontend_runtime_checkpoint.py b/merlin/tests/ir/test_lean_frontend_runtime_checkpoint.py
