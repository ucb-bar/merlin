+++ b/merlin/tests/ir/test_lean_frontend_runtime_checkpoint.py
@@ -0,0 +1,284 @@
+"""Actual-program initialization, repair composition, and inactive receipt integrity."""
+
+from __future__ import annotations
+
+import copy
+import json
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from merlin.common.paths import merlin_dir
+from merlin.frontends.linalg_mlir import parse_mlir_text
+from merlin.llvmlower.passes_xdsl import fix_bool_fptosi
+from merlin.verify.lean import frontend_runtime as runtime
+from merlin.verify.lean.export import ExportError, export_file
+from merlin.xdsl_dialects._common import text as to_text
+
+
+def driver(request: dict, work: Path, tools) -> dict:
+    work.mkdir(parents=True, exist_ok=True)
+    path = work / "request.json"
+    path.write_text(json.dumps({"schema": runtime.REQUEST, "index_bits": 64, "limit": 1024, **request}))
+    proc = subprocess.run(
+        [str(tools.lake), "env", "lean", "--run", str(merlin_dir() / "lean/FrontendRuntimeCandidate.lean"), str(path)],
+        cwd=merlin_dir() / "lean",
+        capture_output=True,
+        text=True,
+        timeout=900,
+    )
+    assert proc.returncode == 0, proc.stdout + proc.stderr
+    result = json.loads(proc.stdout)
+    (work / "result.json").write_text(json.dumps(result, indent=2) + "\n")
+    return result
+
+
+def exported(source: str, work: Path, tools) -> Path:
+    work.mkdir(parents=True, exist_ok=True)
+    mlir, path = work / "subject.mlir", work / "subject.json"
+    mlir.write_text(source)
+    # The authoritative compiler parses AND verifies every positive and mutated program first.
+    export_file(mlir, path, backend="mlir", m2m_python=tools.compiler_python)
+    return path
+
+
+def checkpoint_sources() -> tuple[str, str]:
+    """Actual initial 116 operations, with their original block args, regions and SSA uses."""
+    from xdsl.dialects import func
+    from xdsl.dialects.builtin import ModuleOp
+    from xdsl.ir import Block, Region
+
+    module = parse_mlir_text(
+        (merlin_dir() / "contract/capsules/model/SY_model_smolvla/capsule.interface.mlir").read_text()
+    )
+    result = []
+    for repair in (False, True):
+        if repair:
+            assert fix_bool_fptosi(module) == 1
+        forward = next(o for o in module.body.block.ops if isinstance(o, func.FuncOp))
+        original = list(forward.body.block.ops)
+        block = Block(arg_types=forward.function_type.inputs)
+        mapping = dict(zip(forward.body.block.args, block.args, strict=True))
+        for op in original[:116]:
+            block.add_op(op.clone(value_mapper=mapping))
+        cloned = list(block.ops)
+        out, count = cloned[-1].results[0], cloned[-2].results[1]
+        block.add_op(func.ReturnOp(out, count))
+        projected = ModuleOp(
+            [
+                func.FuncOp.from_region(
+                    "subject", list(forward.function_type.inputs), [out.type, count.type], Region(block)
+                )
+            ]
+        )
+        projected.verify()
+        result.append(to_text(projected, generic=True))
+    return tuple(result)
+
+
+def test_actual_checkpoint_receipt_and_integrity(tmp_path, fidelity_tools):
+    before, after = checkpoint_sources()
+    paths = [tmp_path / name for name in ("before.mlir", "after.mlir")]
+    for path, text in zip(paths, (before, after), strict=True):
+        path.write_text(text)
+    receipt = runtime.verify_candidate(
+        *paths,
+        tmp_path / "evidence",
+        function="subject",
+        start=91,
+        compiler_python=Path(fidelity_tools.compiler_python),
+        suffix=(paths[1],),
+        lake=fidelity_tools.lake,
+    )
+    assert receipt["status"] == "verified_candidate", receipt.get("reason")
+    assert receipt["answer"]["repair"] and receipt["answer"]["checkpoint"] and receipt["answer"]["suffix"]
+    assert not receipt["whole_function_defined"] and not receipt["ordinary_source_equivalence"]
+    runtime.validate_receipt(receipt)
+    mutations = []
+    wrong = copy.deepcopy(receipt)
+    wrong["schema"] = "merlin.lean.receipt.v1"
+    mutations.append(wrong)
+    wrong = copy.deepcopy(receipt)
+    wrong["configuration"]["limit"] = 1023
+    mutations.append(wrong)
+    wrong = copy.deepcopy(receipt)
+    wrong["interpretation"]["sources"]["merlin/lean/MerlinVerify/Rules/FrontendMaskRuntime.lean"] = "0" * 64
+    mutations.append(wrong)
+    wrong = copy.deepcopy(receipt)
+    wrong["interpretation"]["sources"]["merlin/lean/MerlinVerify/Spec/FrontendIntent.lean"] = "0" * 64
+    mutations.append(wrong)
+    wrong = copy.deepcopy(receipt)
+    wrong["artifacts"][0], wrong["artifacts"][1] = wrong["artifacts"][1], wrong["artifacts"][0]
+    mutations.append(wrong)
+    wrong = copy.deepcopy(receipt)
+    wrong["answer"]["checkpoint"] = False
+    mutations.append(wrong)
+    wrong = copy.deepcopy(receipt)
+    wrong["whole_function_defined"] = True
+    mutations.append(wrong)
+    for wrong in mutations:
+        with pytest.raises(ValueError):
+            runtime.validate_receipt(wrong)
+    # Recomputing hashes of a forged execution result cannot create proof evidence.
+    wrong = copy.deepcopy(receipt)
+    wrong["answer"]["inventory"]["operations"] += 1
+    forged = tmp_path / "forged-result.json"
+    forged.write_text(json.dumps(wrong["answer"]))
+    wrong["result"] = runtime._ref(forged)
+    with pytest.raises(ValueError, match="actual Lean checker replay differs"):
+        runtime.validate_receipt(wrong)
+    artifact = Path(receipt["artifacts"][1]["export"]["path"])
+    artifact.write_text(artifact.read_text() + "\n")
+    with pytest.raises(ValueError, match="stale export"):
+        runtime.validate_receipt(receipt)
+
+
+@pytest.mark.parametrize(
+    "body,accepted",
+    [
+        ("%i = linalg.index 0 : index\n%v = arith.index_cast %i : index to i64\nlinalg.yield %v : i64", True),
+        ("linalg.yield %old : i64", False),
+    ],
+)
+def test_independent_index_initialization(tmp_path, fidelity_tools, body, accepted):
+    source = """builtin.module {func.func @subject() -> tensor<4xi64> {
+      %empty = tensor.empty() : tensor<4xi64>
+      %out = linalg.generic {indexing_maps = [affine_map<(d0)->(d0)>], iterator_types = ["parallel"]}
+        outs(%empty : tensor<4xi64>) { ^bb0(%old: i64): BODY } -> tensor<4xi64>
+      return %out : tensor<4xi64> }}""".replace("BODY", body)
+    path = exported(source, tmp_path, fidelity_tools)
+    result = driver({"mode": "defined", "function": "subject", "after_export": str(path)}, tmp_path, fidelity_tools)
+    assert result["accepted"] is accepted
+
+
+@pytest.mark.parametrize("slice_type,offset,accepted", [("tensor<2xi64>", 1, True), ("tensor<2xi64>", 2, True)])
+def test_static_slice_initialization_and_bounds(tmp_path, fidelity_tools, slice_type, offset, accepted):
+    source = f"""builtin.module {{func.func @subject(%x: tensor<4xi64>) -> {slice_type} {{
+      %r = tensor.extract_slice %x[{offset}] [2] [1] : tensor<4xi64> to {slice_type}
+      return %r : {slice_type} }} }}"""
+    path = exported(source, tmp_path, fidelity_tools)
+    result = driver({"mode": "defined", "function": "subject", "after_export": str(path)}, tmp_path, fidelity_tools)
+    assert result["accepted"] is accepted
+
+
+def test_dynamic_slice_is_explicitly_refused(tmp_path, fidelity_tools):
+    source = """builtin.module {func.func @subject(%x: tensor<4xi64>, %off: index) -> tensor<2xi64> {
+      %r = tensor.extract_slice %x[%off] [2] [1] : tensor<4xi64> to tensor<2xi64>
+      return %r : tensor<2xi64> }}"""
+    path = exported(source, tmp_path, fidelity_tools)
+    assert not driver({"mode": "defined", "function": "subject", "after_export": str(path)}, tmp_path, fidelity_tools)[
+        "accepted"
+    ]
+
+
+def test_static_out_of_bounds_slice_is_rejected_by_compiler(tmp_path, fidelity_tools):
+    source = """builtin.module {func.func @subject(%x: tensor<4xi64>) -> tensor<2xi64> {
+      %r = tensor.extract_slice %x[3] [2] [1] : tensor<4xi64> to tensor<2xi64>
+      return %r : tensor<2xi64> }}"""
+    # This is compiler qualification, never counted as a Lean mutation rejection.
+    with pytest.raises(ExportError, match="out-of-bounds"):
+        exported(source, tmp_path, fidelity_tools)
+
+
+def test_rank_reducing_slice_initialization(tmp_path, fidelity_tools):
+    source = """builtin.module {func.func @subject(%x: tensor<1x4xi64>) -> tensor<2xi64> {
+      %r = tensor.extract_slice %x[0,1] [1,2] [1,1] : tensor<1x4xi64> to tensor<2xi64>
+      return %r : tensor<2xi64> }}"""
+    path = exported(source, tmp_path, fidelity_tools)
+    assert driver({"mode": "defined", "function": "subject", "after_export": str(path)}, tmp_path, fidelity_tools)[
+        "accepted"
+    ]
+
+
+@pytest.mark.parametrize("flags,accepted", [("", True), (" fastmath<nnan>", False)])
+def test_comparison_initialization_metadata(tmp_path, fidelity_tools, flags, accepted):
+    source = f"""builtin.module {{func.func @subject(%x: f32, %y: f32) -> i1 {{
+      %r = arith.cmpf une, %x, %y{flags} : f32
+      return %r : i1 }} }}"""
+    path = exported(source, tmp_path, fidelity_tools)
+    assert (
+        driver({"mode": "defined", "function": "subject", "after_export": str(path)}, tmp_path, fidelity_tools)[
+            "accepted"
+        ]
+        is accepted
+    )
+
+
+def test_actual_boundary_mutations_rejected_by_lean(tmp_path, fidelity_tools):
+    from xdsl.dialects import arith, builtin
+
+    before, after = checkpoint_sources()
+    src = exported(before, tmp_path / "source", fidelity_tools)
+    original = parse_mlir_text(after)
+    predicate = next(op for op in original.walk() if isinstance(op, arith.CmpfOp))
+    cases = {}
+    wrong = original.clone()
+    cmp = next(op for op in wrong.walk() if isinstance(op, arith.CmpfOp))
+    cmp.properties["predicate"] = builtin.IntegerAttr(1, builtin.i64)
+    cases["wrong-predicate"] = wrong
+    # Positive zero and the exact absence of fast-math are part of acceptance.
+    wrong = parse_mlir_text(after.replace("#arith.fastmath<none>", "#arith.fastmath<nnan>", 1))
+    cases["fast-math"] = wrong
+    wrong = original.clone()
+    cmp = next(op for op in wrong.walk() if isinstance(op, arith.CmpfOp))
+    cmp.operands = [cmp.operands[1], cmp.operands[1]]
+    cases["wrong-source"] = wrong
+    wrong = original.clone()
+    generic = next(
+        op for op in wrong.walk() if op.name == "linalg.generic" and any(o.name == "linalg.index" for o in op.walk())
+    )
+    returned = generic.regions[0].block.last_op
+    # Returning the uninitialized output operand bypasses initialization, yet stays well typed.
+    returned.operands = [generic.regions[0].block.args[-1]]
+    cases["uninitialized-prefix-output"] = wrong
+    assert predicate is not None
+    for name, module in cases.items():
+        path = exported(to_text(module, generic=True), tmp_path / name, fidelity_tools)
+        answer = driver(
+            {
+                "mode": "boundary",
+                "function": "subject",
+                "start": 91,
+                "before_export": str(src),
+                "after_export": str(path),
+                "suffix_exports": [],
+            },
+            tmp_path / name,
+            fidelity_tools,
+        )
+        assert not answer["accepted"], name
+        if name == "uninitialized-prefix-output":
+            assert not answer["checkpoint"]
+
+    target = exported(after, tmp_path / "target", fidelity_tools)
+    suffix = tmp_path / "wrong-predicate/subject.json"
+    answer = driver(
+        {
+            "mode": "boundary",
+            "function": "subject",
+            "start": 91,
+            "before_export": str(src),
+            "after_export": str(target),
+            "suffix_exports": [str(suffix)],
+        },
+        tmp_path / "bad-suffix",
+        fidelity_tools,
+    )
+    assert answer["repair"] and answer["checkpoint"]
+    assert not answer["suffix"] and not answer["accepted"]
+
+
+def test_missing_runtime_tools_is_unmeasured(tmp_path):
+    receipt = runtime.verify_candidate(
+        tmp_path / "absent.mlir",
+        tmp_path / "absent2.mlir",
+        tmp_path / "evidence",
+        function="subject",
+        start=0,
+        compiler_python=Path("/missing/compiler"),
+        lake=Path("/missing/lake"),
+    )
+    assert receipt["status"] == "unmeasured"
+    with pytest.raises(ValueError, match="not verified"):
+        runtime.validate_receipt(receipt)
diff --git a/src/merlin/verify/lean/frontend_runtime.py b/src/merlin/verify/lean/frontend_runtime.py
new file mode 100644
index 000000000..827d82d68
--- /dev/null
+++ b/src/merlin/verify/lean/frontend_runtime.py
@@ -0,0 +1,289 @@
+"""Inactive runtime-candidate verification, with byte-bound evidence and one interpretation.
+
+This additive API does not issue frozen-model receipts or activate candidate semantics. Lean
+checks the complete f32 repair boundary, actual initialized prefix/selection execution, and
+every supplied suffix boundary. Suffixes currently require complete alpha correspondence.
+The census enumerates remaining full-model obligations; it is not a definedness proof.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import subprocess
+from pathlib import Path
+from typing import Any
+
+from merlin.common.paths import repo_root
+from merlin.verify.lean import check as infrastructure
+
+SCHEMA = "merlin.frontend.runtime.receipt.v1"
+REQUEST = "merlin.frontend.runtime.request.v1"
+MODULE = "MerlinVerify.Rules.FrontendRuntimeObligations"
+THEOREMS = (
+    "MerlinVerify.Rules.FrontendRuntimeVerification.check_sound",
+    "MerlinVerify.Rules.FrontendRuntimeVerification.full_policy",
+    "MerlinVerify.Rules.FrontendRuntimeChain.compose",
+)
+CONFIGURATION = {
+    "base": "MerlinVerify.Rules.FrontendMaskRuntime.sem",
+    "comparison": "MerlinVerify.Rules.FrontendF32Comparison.model(base)",
+    "source_policy": "MerlinVerify.Rules.FrontendBoolSimulationWith.policyDenote",
+    "poison_control": "stuck",
+    "index_bits": 64,
+    "limit": 1024,
+}
+_ALLOWED_AXIOMS = {"propext", "Classical.choice", "Quot.sound"}
+
+
+def _ref(path: Path) -> dict[str, Any]:
+    return infrastructure._file_ref(path)
+
+
+def _digest(value: Any) -> str:
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+
+
+def interpretation() -> dict[str, Any]:
+    """Bind source bodies AND their local compiled objects; names alone are insufficient.
+
+    Callers build first. Rechecking this identity after execution detects concurrent changes.
+    Upstream Lean/Mathlib remain explicit T1 dependencies, with pinned revisions and Lean binary.
+    """
+    root = repo_root()
+    lean = infrastructure.lean_root()
+    obj = root / "out/build/lean/build/lib/lean"
+    sources = sorted((lean / "MerlinVerify").rglob("*.lean"))
+    sources += [
+        lean / "FrontendRuntimeCandidate.lean",
+        lean / "FrontendRuntime.lakefile.toml",
+        lean / "SPEC_LOCK",
+        lean / "lean-toolchain",
+        lean / "lake-manifest.json",
+    ]
+    sources += [
+        root / "src/merlin/verify/lean" / name
+        for name in ("frontend_runtime.py", "check.py", "export.py", "mlir_export.py")
+    ]
+    files = {str(p.relative_to(root)): _ref(p)["sha256"] for p in sources}
+    objects = sorted((obj / "MerlinVerify").rglob("*.olean"))
+    if not objects or not (obj / "MerlinVerify/Rules/FrontendRuntimeObligations.olean").is_file():
+        raise ValueError("candidate Lean objects have not been built")
+    compiled = {str(p.relative_to(obj)): _ref(p)["sha256"] for p in objects}
+    review = infrastructure._frontend_review_evidence()
+    identity = {
+        "configuration": dict(CONFIGURATION),
+        "sources": files,
+        "compiled": compiled,
+        "lean": infrastructure._lean_block(),
+        "candidate_executable": _ref(root / "out/build/lean/build/bin/merlin-lean-frontend-runtime"),
+        "f32_policy_approval": review,
+        "runtime_review": "pending; inactive candidate",
+    }
+    return {**identity, "sha256": _digest(identity)}
+
+
+def _run(command: list[str], work: Path, name: str, *, timeout: int = 1200) -> subprocess.CompletedProcess[str]:
+    env = dict(os.environ)
+    env["PATH"] = f"{Path.home() / '.elan/bin'}:{env.get('PATH', '')}"
+    proc = subprocess.run(
+        command, cwd=infrastructure.lean_root(), env=env, capture_output=True, text=True, timeout=timeout
+    )
+    (work / f"{name}.stdout").write_text(proc.stdout)
+    (work / f"{name}.stderr").write_text(proc.stderr)
+    if proc.returncode:
+        raise RuntimeError(f"{name} failed ({proc.returncode}): {(proc.stdout + proc.stderr)[-1000:]}")
+    return proc
+
+
+def _proofs(work: Path, lake: Path) -> list[dict[str, Any]]:
+    result = []
+    for i, theorem in enumerate(THEOREMS):
+        proc = _run([str(lake), "exe", "merlin-lean-audit", "--axioms", theorem, MODULE], work, f"axioms-{i}")
+        axioms = json.loads(proc.stdout.strip().splitlines()[-1])["axioms"]
+        if not set(axioms) <= _ALLOWED_AXIOMS:
+            raise ValueError(f"unapproved axioms in {theorem}: {axioms}")
+        result.append({"theorem": theorem, "axioms": axioms})
+    return result
+
+
+def verify_candidate(
+    before: Path,
+    after: Path,
+    destination: Path,
+    *,
+    function: str,
+    start: int,
+    compiler_python: Path,
+    suffix: tuple[Path, ...] = (),
+    lake: Path | None = None,
+) -> dict[str, Any]:
+    """Verify actual MLIR snapshots and all ordered suffix stages using the inactive candidate.
+
+    Missing tools, rejected IR, round-trip failures and checker refusals are recorded explicitly.
+    No receipt from another interpretation is admitted as a suffix proof. Artifacts are immutable
+    snapshots in a fresh work directory, so existing evidence is never overwritten.
+    """
+    destination.mkdir(parents=True, exist_ok=True)
+    work = infrastructure._work(destination)
+    receipt: dict[str, Any] = {
+        "schema": SCHEMA,
+        "active": False,
+        "status": "unmeasured",
+        "claim_type": "frontend_policy_and_defined_checkpoint",
+        "ordinary_source_equivalence": False,
+        "whole_function_defined": False,
+        "function": function,
+        "start": start,
+        "configuration": dict(CONFIGURATION),
+        "work": str(work.resolve()),
+        "artifacts": [],
+    }
+    lake = lake or Path.home() / ".elan/bin/lake"
+    try:
+        if not isinstance(start, int) or isinstance(start, bool) or start < 0:
+            raise ValueError("checkpoint start must be a nonnegative integer")
+        _run(
+            [str(lake), "-f", "FrontendRuntime.lakefile.toml", "build", "merlin-lean-frontend-runtime"],
+            work,
+            "build",
+        )
+        identity = interpretation()
+        receipt["interpretation"] = identity
+        exported = []
+        for i, path in enumerate((before, after, *suffix)):
+            snapshot = work / f"stage-{i}.mlir"
+            original = infrastructure._snapshot(path, snapshot)
+            result, error = infrastructure._export_checked(
+                snapshot, work / f"round-trip-{i}", m2m_python=compiler_python
+            )
+            if error:
+                raise ValueError(error)
+            exported.append(result)
+            receipt["artifacts"].append({"original": original, "mlir": _ref(snapshot), "export": _ref(result)})
+        receipt["exporter"] = infrastructure._exporter_block(compiler_python) | {"round_trip": "identical"}
+        receipt["proofs"] = _proofs(work, lake)
+        request = {
+            "schema": REQUEST,
+            "mode": "boundary",
+            "function": function,
+            "start": start,
+            "limit": CONFIGURATION["limit"],
+            "index_bits": CONFIGURATION["index_bits"],
+            "before_export": str(exported[0]),
+            "after_export": str(exported[1]),
+            "suffix_exports": [str(p) for p in exported[2:]],
+        }
+        path = work / "request.json"
+        path.write_text(json.dumps(request, indent=2) + "\n")
+        executable = repo_root() / "out/build/lean/build/bin/merlin-lean-frontend-runtime"
+        proc = _run([str(executable), str(path)], work, "candidate")
+        answer = json.loads(proc.stdout)
+        if answer.get("schema") != "merlin.frontend.runtime.result.v1" or answer.get("theorems") != list(THEOREMS):
+            raise ValueError("unexpected candidate checker protocol")
+        if interpretation() != identity:
+            raise ValueError("interpretation changed during checking")
+        for entry in receipt["artifacts"]:
+            for key in ("mlir", "export"):
+                if _ref(Path(entry[key]["path"])) != entry[key]:
+                    raise ValueError("input snapshot changed during checking")
+        receipt["request"] = _ref(path)
+        receipt["result"] = _ref(work / "candidate.stdout")
+        receipt["answer"] = answer
+        receipt["status"] = "verified_candidate" if answer.get("accepted") is True else "abstracted"
+        receipt["reason"] = (
+            "proved under inactive interpretation; runtime admission awaits review"
+            if answer.get("accepted") is True
+            else "actual Lean checker refused repair, checkpoint, or supplied suffix"
+        )
+    except (OSError, ValueError, RuntimeError, subprocess.TimeoutExpired) as exc:
+        receipt["reason"] = str(exc)
+    receipt_path = work / "receipt.json"
+    receipt_path.write_text(json.dumps(receipt, indent=2, sort_keys=True) + "\n")
+    return receipt
+
+
+def validate_receipt(receipt: dict[str, Any], *, compiler_python: Path | None = None, lake: Path | None = None) -> None:
+    """Reject stale source/config/artifacts and frozen or mixed-model records.
+
+    This is evidence-integrity glue (T2), not a cryptographic signature or an additional theorem.
+    The authoritative round trips and actual Lean checks are replayed. A result JSON, even
+    with freshly recomputed hashes, never supplies an acceptance fact.
+    """
+    if receipt.get("schema") != SCHEMA or receipt.get("active") is not False:
+        raise ValueError("receipt is not an inactive runtime-candidate record")
+    if receipt.get("status") != "verified_candidate":
+        raise ValueError("candidate was not verified")
+    if receipt.get("configuration") != CONFIGURATION or receipt.get("interpretation") != interpretation():
+        raise ValueError("stale or mixed interpretation/configuration")
+    if (
+        receipt.get("claim_type") != "frontend_policy_and_defined_checkpoint"
+        or receipt.get("whole_function_defined") is not False
+    ):
+        raise ValueError("candidate claim was changed")
+    if receipt.get("ordinary_source_equivalence") is not False:
+        raise ValueError("candidate does not prove raw source equivalence")
+    proofs = receipt.get("proofs", [])
+    if [p.get("theorem") for p in proofs] != list(THEOREMS) or any(
+        not set(p.get("axioms", [])) <= _ALLOWED_AXIOMS for p in proofs
+    ):
+        raise ValueError("invalid theorem dependencies")
+    artifacts = receipt.get("artifacts", [])
+    if len(artifacts) < 2:
+        raise ValueError("before/after evidence missing")
+    for entry in artifacts:
+        for key in ("mlir", "export"):
+            if _ref(Path(entry[key]["path"])) != entry[key]:
+                raise ValueError(f"stale {key} artifact")
+    for key in ("request", "result"):
+        if _ref(Path(receipt[key]["path"])) != receipt[key]:
+            raise ValueError(f"stale {key} artifact")
+    request = json.loads(Path(receipt["request"]["path"]).read_text())
+    expected = {
+        "schema": REQUEST,
+        "mode": "boundary",
+        "function": receipt.get("function"),
+        "start": receipt.get("start"),
+        "limit": CONFIGURATION["limit"],
+        "index_bits": CONFIGURATION["index_bits"],
+        "before_export": artifacts[0]["export"]["path"],
+        "after_export": artifacts[1]["export"]["path"],
+        "suffix_exports": [entry["export"]["path"] for entry in artifacts[2:]],
+    }
+    if request != expected:
+        raise ValueError("receipt order or checkpoint differs from actual checker request")
+    answer = json.loads(Path(receipt["result"]["path"]).read_text())
+    if answer != receipt.get("answer") or answer.get("accepted") is not True:
+        raise ValueError("receipt differs from executed checker result")
+    compiler = compiler_python or Path(os.environ.get("MERLIN_COMPILER_PYTHON", "/missing/compiler"))
+    exporter = infrastructure._exporter_block(compiler) | {"round_trip": "identical"}
+    if receipt.get("exporter") != exporter:
+        raise ValueError("authoritative exporter changed")
+    replay = infrastructure._work(Path(receipt["work"]) / "replay")
+    for i, entry in enumerate(artifacts):
+        source, exported = (Path(entry[key]["path"]) for key in ("mlir", "export"))
+        if not infrastructure._exported_from(exported, source):
+            raise ValueError("export does not bind the actual MLIR snapshot")
+        trip = infrastructure.round_trip_exported(
+            source,
+            exported,
+            replay / f"round-trip-{i}",
+            lean_exe=infrastructure.lean_exe(),
+            backend="mlir",
+            m2m_python=compiler,
+        )
+        if trip.status != "identical":
+            raise ValueError(f"authoritative round-trip replay failed: {trip.status}: {trip.detail}")
+    if _proofs(replay, lake or Path.home() / ".elan/bin/lake") != proofs:
+        raise ValueError("theorem dependency replay differs")
+    executable = repo_root() / "out/build/lean/build/bin/merlin-lean-frontend-runtime"
+    proc = _run([str(executable), receipt["request"]["path"]], replay, "candidate-replay")
+    if json.loads(proc.stdout) != answer:
+        raise ValueError("actual Lean checker replay differs from receipt")
+    if interpretation() != receipt["interpretation"]:
+        raise ValueError("interpretation changed during replay")
+    for entry in artifacts:
+        for key in ("mlir", "export"):
+            if _ref(Path(entry[key]["path"])) != entry[key]:
+                raise ValueError("input snapshot changed during replay")
