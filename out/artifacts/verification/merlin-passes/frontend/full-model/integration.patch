diff --git a/merlin/lean/FrontendRuntime.lakefile.toml b/merlin/lean/FrontendRuntime.lakefile.toml
new file mode 100644
index 000000000..5b050012a
--- /dev/null
+++ b/merlin/lean/FrontendRuntime.lakefile.toml
@@ -0,0 +1,34 @@
+# Inactive candidate build only. The protected production lakefile.toml is unchanged.
+name = "MerlinVerify"
+version = "0.1.0"
+defaultTargets = ["merlin-lean-frontend-runtime"]
+# Generated output lives under the repo's out/ root (CLAUDE.md "Generated-output convention").
+packagesDir = "../../out/build/lean/packages"
+buildDir = "../../out/build/lean/build"
+
+[leanOptions]
+autoImplicit = false
+relaxedAutoImplicit = false
+
+[[require]]
+name = "mathlib"
+git = "https://github.com/leanprover-community/mathlib4.git"
+rev = "v4.35.0"
+
+[[lean_lib]]
+name = "MerlinVerify"
+globs = ["MerlinVerify.+"]
+
+# Checker driver: decode / round-trip / check subcommands (design §8.3).
+[[lean_exe]]
+name = "merlin-lean"
+root = "Main"
+
+# Guardrail audit: axioms, banned constructs, pinned statements (design §8.6).
+[[lean_exe]]
+name = "merlin-lean-audit"
+root = "Audit"
+
+[[lean_exe]]
+name = "merlin-lean-frontend-runtime"
+root = "FrontendRuntimeCandidate"
diff --git a/merlin/lean/FrontendRuntimeCandidate.lean b/merlin/lean/FrontendRuntimeCandidate.lean
new file mode 100644
index 000000000..3173d33a0
--- /dev/null
+++ b/merlin/lean/FrontendRuntimeCandidate.lean
@@ -0,0 +1,112 @@
+/- Inactive candidate driver. Acceptance decisions are executable Lean checkers.
+   The census is an inventory, not a whole-function execution claim. -/
+import MerlinVerify.Core.Json
+import MerlinVerify.Core.Print
+import MerlinVerify.Rules.FrontendRuntimeObligations
+import MerlinVerify.Check.TypedModule
+
+open MerlinVerify MerlinVerify.Check MerlinVerify.Rules Lean
+
+namespace FrontendCheckpointDriver
+mutual
+  def allOps : List Op → List Op
+    | [] => []
+    | op@(.mk _ _ _ _ _ rs _) :: rest => op :: (regionOps rs ++ allOps rest)
+  def regionOps : List Region → List Op
+    | [] => []
+    | .mk bs :: rest => blockOps bs ++ regionOps rest
+  def blockOps : List Block → List Op
+    | [] => []
+    | .mk _ ops :: rest => allOps ops ++ blockOps rest
+end
+
+def site (types : FrontendBoolSimulation.Types) (op : Op) : Json :=
+  Json.mkObj [("name", toJson op.name), ("results", toJson (op.results.map (·.id))),
+    ("operands", toJson op.operands),
+    ("operand_types", toJson (op.operands.map fun id => (types.lookup id).map MerlinVerify.Print.ty)),
+    ("result_types", toJson (op.results.map fun v => MerlinVerify.Print.ty v.ty)),
+    ("cast8_obstruction", toJson (opHeadEq FrontendRuntimeObligations.cast8 op)),
+    ("token_obstruction", toJson (opHeadEq FrontendRuntimeObligations.tokenExtract op))]
+
+def inventory (m : MerlinVerify.Module) : Json := Id.run do
+  let ops := allOps m.ops
+  let types := (FrontendBoolProgram.defsOps 64 m.ops).map FrontendBoolProgram.sourceTypes
+  let mut census : List (String × Nat) := []
+  for op in ops do
+    census := (op.name, (census.lookup op.name).getD 0 + 1) :: census.filter (fun p => p.1 != op.name)
+  let casts := ops.filter fun op => op.name == "arith.fptosi" || op.name == "arith.fptoui"
+  let extracts := ops.filter fun op => op.name == "tensor.extract"
+  let dynamic := ops.filter fun op => op.results.any fun v =>
+    match v.ty with | .tensor shape _ _ => shape.any Option.isNone | _ => false
+  return Json.mkObj [("kind", toJson "inventory; not whole-model execution proof"),
+    ("operations", toJson ops.length), ("census", toJson census),
+    ("float_integer_casts", toJson (casts.map (site (types.getD [])))),
+    ("tensor_reads", toJson (extracts.map (site (types.getD [])))),
+    ("dynamic_results", toJson (dynamic.map (site (types.getD []))))]
+
+def readModule (path : String) : IO MerlinVerify.Module := do
+  match Decode.module (← IO.FS.readFile path) with
+  | .ok m => return m
+  | .error why => throw (IO.userError why)
+
+def field (j : Json) (key : String) : IO Json :=
+  match Decode.field j key with
+  | .ok v => pure v
+  | .error why => throw (IO.userError why)
+
+def string (j : Json) (key : String) : IO String := do
+  match Decode.str (← field j key) with
+  | .ok v => return v
+  | .error why => throw (IO.userError why)
+
+def natural (j : Json) (key : String) : IO Nat := do
+  match Decode.nat (← field j key) with
+  | .ok v => return v
+  | .error why => throw (IO.userError why)
+
+def run (j : Json) : IO Json := do
+  unless (← string j "schema") == "merlin.frontend.runtime.request.v1" do
+    throw (IO.userError "wrong candidate request schema")
+  let mode ← string j "mode"
+  let limit ← natural j "limit"
+  let ib ← natural j "index_bits"
+  unless ib == 64 do throw (IO.userError "candidate requires index64")
+  let target ← readModule (← string j "after_export")
+  if mode == "defined" then
+    let name ← string j "function"
+    let accepted := match TypedModule.signature? 64 target name with
+      | none => false
+      | some (a,r) => Definedness.check (FrontendPrefixDefined.candidateBook limit 64) target name a r
+    return Json.mkObj [("accepted", toJson accepted),
+      ("theorem", toJson "MerlinVerify.Rules.FrontendPrefixDefined.check_sound")]
+  if mode == "inventory" then return inventory target
+  let source ← readModule (← string j "before_export")
+  let name ← string j "function"
+  let start ← natural j "start"
+  let .ok paths := Decode.arr (← field j "suffix_exports") | throw (IO.userError "invalid suffix list")
+  let tail ← paths.mapM fun p => do
+    let .ok path := Decode.str p | throw (IO.userError "invalid suffix path")
+    readModule path
+  let repair := FrontendBoolSimulation.check source target
+  let checkpoint := FrontendRuntimeCheckpoint.check target name start limit
+  let accepted := decide (1024 ≤ limit) && repair &&
+    FrontendRuntimeVerification.checkpoint source target name start limit
+  let suffix := FrontendRuntimeChain.suffix target tail
+  return Json.mkObj [("schema", toJson "merlin.frontend.runtime.result.v1"),
+    ("active", toJson false), ("accepted", toJson (accepted && suffix)),
+    ("repair", toJson repair), ("checkpoint", toJson checkpoint), ("suffix", toJson suffix),
+    ("whole_function_defined", toJson false),
+    ("claim", toJson "A2 f32 policy matching and defined actual initial segment"),
+    ("theorems", toJson ["MerlinVerify.Rules.FrontendRuntimeVerification.check_sound",
+      "MerlinVerify.Rules.FrontendRuntimeVerification.full_policy",
+      "MerlinVerify.Rules.FrontendRuntimeChain.compose"]),
+    ("inventory", inventory target)]
+end FrontendCheckpointDriver
+
+def main (args : List String) : IO UInt32 := do
+  let [path] := args | return 2
+  let .ok request := Json.parse (← IO.FS.readFile path) | return 2
+  try
+    IO.println (← FrontendCheckpointDriver.run request).compress
+    return 0
+  catch error => IO.eprintln error.toString; return 2
diff --git a/merlin/lean/MerlinVerify/Rules/FrontendDefinedCompare.lean b/merlin/lean/MerlinVerify/Rules/FrontendDefinedCompare.lean
new file mode 100644
index 000000000..3496b5a32
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/FrontendDefinedCompare.lean
@@ -0,0 +1,62 @@
+/- Additive f32 comparison totality for frontend execution qualification.
+This proves initialization for any comparison interpretation, without a numerical float law. -/
+import MerlinVerify.Check.DefinedLinalg
+import MerlinVerify.Rules.FrontendBoolSimulation
+
+namespace MerlinVerify.Rules.FrontendDefinedCompare
+open MerlinVerify MerlinVerify.Check MerlinVerify.Check.Definedness MerlinVerify.Sem.Ops
+
+/-- This proves initialization, not numerical identities. Only f32, known predicates and no
+fast-math are accepted; FloatModel remains parametric. -/
+def metadata (op : Op) : Prop :=
+  dialectOf op.name = "arith" ∧ op.name = "arith.cmpf" ∧ Arith.resultElt op.blind = some (.int 1) ∧
+  (match attrInt? op "predicate" with | some p => 0 ≤ p ∧ p < 16 | none => False) ∧
+  op.attr? "fastmath" = some (.enum "arith" "fastmath" "none")
+instance (op : Op) : Decidable (metadata op) := by
+  unfold metadata
+  cases attrInt? op "predicate" <;> infer_instance
+
+def compareRule : Definedness.Rule := fun op fs =>
+  if metadata op ∧ op.regions = [] ∧
+      fs = [⟨.scalar (.float .f32), true⟩, ⟨.scalar (.float .f32), true⟩] then
+    some [⟨.scalar (.int 1), true⟩]
+  else none
+
+theorem compareRule_sound (ib : Nat) : RuleSound ib compareRule := by
+  intro op fs rs hm h ctx call args _ ha
+  unfold compareRule at h
+  split at h
+  · next hc =>
+    obtain ⟨⟨hd, hn, hr, _⟩, _, rfl⟩ := hc
+    cases h
+    obtain _ | ⟨hx, hy⟩ := ha
+    obtain _ | ⟨hy, hnil⟩ := hy
+    cases hnil
+    obtain ⟨x, rfl⟩ := initialized_float hx
+    obtain ⟨y, rfl⟩ := initialized_float hy
+    rw [opSem_modelled hm]
+    simp only [dispatch, Op.blind_name, hd]
+    simp only [Arith.sem, Op.blind_name, hn, Arith.binOp, Arith.pureN, hr]
+    rw [show [.scalar (.some (.flt .f32 x)), .scalar (.some (.flt .f32 y))] =
+      ([.some (.flt .f32 x), .some (.flt .f32 y)] : List Val).map RVal.scalar from rfl,
+      liftEager_scalars]
+    exact ⟨_, rfl, .cons ⟨by simp [Arith.boolVal, RVal.HasTy, Val.HasTy, Scalar.conforms],
+      by simp [Arith.boolVal, RVal.Defined]⟩ .nil⟩
+  · cases h
+
+def comparisonBook (ib : Nat) : Book opSem ib where
+  rule _ op fs := if unmodelledAttr? op.blind = none then compareRule op fs else none
+  sound Γ op fs rs h ctx call env args hib _ ha := by
+    split at h
+    · next hm =>
+      have hregs : op.regions = [] := by
+        unfold compareRule at h
+        split at h
+        · next hc => exact hc.2.1
+        · cases h
+      simpa only [hregs, evalRegions] using compareRule_sound ib op fs rs hm h ctx call args hib ha
+    · cases h
+
+
+#print axioms compareRule_sound
+end MerlinVerify.Rules.FrontendDefinedCompare
diff --git a/merlin/lean/MerlinVerify/Rules/FrontendDefinedFrame.lean b/merlin/lean/MerlinVerify/Rules/FrontendDefinedFrame.lean
new file mode 100644
index 000000000..7d969ca49
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/FrontendDefinedFrame.lean
@@ -0,0 +1,122 @@
+/- Context-aware definedness for loop bodies, without changing the frozen facts or evaluator. -/
+import MerlinVerify.Rules.FrontendBoolDefined
+import MerlinVerify.Rules.FrontendRuntimeBridge
+
+namespace MerlinVerify.Rules.FrontendDefinedFrame
+open MerlinVerify MerlinVerify.Check MerlinVerify.Check.Definedness MerlinVerify.Sem.Ops
+variable {sem : OpSem} {ib depth : Nat}
+
+/-- The frame states only that linalg.index coordinates exist. It supplies no comparison law,
+value bound, initialization fact or certificate. -/
+structure BookAt (sem : OpSem) (ib depth : Nat) where
+  rule : FEnv → Op → List Fact → Option (List Fact)
+  sound : ∀ Γ op fs rs, rule Γ op fs = some rs → ∀ ctx call env args,
+    ctx.indexBits = ib → depth ≤ ctx.loopIndex.length → EnvHolds ib Γ env → FactsHold ib args fs →
+    ∃ vs, sem ctx call op args (evalRegions sem call env op.regions) = .ok vs ∧ FactsHold ib vs rs
+
+def lift (old : Book sem ib) (depth : Nat) : BookAt sem ib depth where
+  rule := old.rule
+  sound Γ op fs rs h ctx call env args hib _ hΓ ha := old.sound Γ op fs rs h ctx call env args hib hΓ ha
+
+def orElse (first next : BookAt sem ib depth) : BookAt sem ib depth where
+  rule Γ op fs := (first.rule Γ op fs).orElse fun _ => next.rule Γ op fs
+  sound Γ op fs rs h ctx call env args hib hd hΓ ha := by
+    cases hf : first.rule Γ op fs with
+    | some ys =>
+      simp only [hf, Option.orElse_some, Option.some.injEq] at h
+      subst h
+      exact first.sound Γ op fs ys hf ctx call env args hib hd hΓ ha
+    | none =>
+      simp only [hf, Option.orElse_none] at h
+      exact next.sound Γ op fs rs h ctx call env args hib hd hΓ ha
+
+def checkOps {sem : OpSem} {ib depth : Nat} (R : BookAt sem ib depth) (Γ : FEnv) : List Op → List VTy → Bool
+  | [], _ => false
+  | op :: rest, yields =>
+    match op.operands.mapM (fun x => Γ.lookup x) with
+    | none => false
+    | some fs =>
+      if op.isTerminator then
+        rest.isEmpty && fs.all (·.initialized) && fs.map (·.ty) == yields
+      else if op.successors.isEmpty then
+        match R.rule Γ op fs with
+        | none => false
+        | some rs => rs.length == op.results.length &&
+          checkOps R ((op.results.map (·.id)).zip rs ++ Γ) rest yields
+      else false
+
+theorem checkOps_sound {sem : OpSem} {ib depth : Nat} (R : BookAt sem ib depth) :
+    ∀ Γ ops yields ctx call env, checkOps R Γ ops yields = true → EnvHolds ib Γ env →
+      ctx.indexBits = ib → depth ≤ ctx.loopIndex.length → ∃ vs, evalOps sem ctx call env ops = .ok vs ∧
+        HasTys ib vs yields ∧ ResultsDefined vs
+  | _, [], _, _, _, _, h, _, _, _ => by cases h
+  | Γ, (.mk n results operands attrs props regions successors) :: rest, yields, ctx, call, env,
+      h, hΓ, hib, hdepth => by
+    simp only [checkOps] at h
+    split at h
+    · cases h
+    · next fs hfs =>
+      obtain ⟨args, hargs, hfacts⟩ := hΓ.getAll operands fs hfs
+      rw [evalOps.eq_2]
+      split
+      · next ht =>
+        rw [ite_eq_left ht] at h
+        simp only [Bool.and_eq_true, List.isEmpty_iff, beq_iff_eq] at h
+        obtain ⟨⟨rfl, hi⟩, hty⟩ := h
+        simp only [List.isEmpty_nil, ↓reduceIte, hargs]
+        exact ⟨args, rfl, hty ▸ hfacts.typed, hfacts.defined (List.all_eq_true.1 hi)⟩
+      · next ht =>
+        rw [ite_eq_right ht] at h
+        split at h
+        · next hempty =>
+          split at h
+          · cases h
+          · next rs hrule =>
+            simp only [Bool.and_eq_true, beq_iff_eq] at h
+            obtain ⟨hlen, hrest⟩ := h
+            obtain ⟨vs, hop, hv⟩ := R.sound Γ _ fs rs hrule ctx call env args hib hdepth hΓ hfacts
+            simp only [Op.regions] at hop
+            simp only [hargs, Outcome.bind_ok, hop, Op.results]
+            have hb : results.length = vs.length := hlen.symm.trans (List.Forall₂.length_eq hv).symm
+            rw [bindAll_ok hb, Outcome.bind_ok]
+            exact checkOps_sound R _ rest yields ctx call _ hrest (hΓ.extend _ vs rs hv) hib hdepth
+        · cases h
+
+
+def checkRegion (R : BookAt sem ib depth) (Γ : FEnv) (region : Region)
+    (args : List Fact) (yields : List VTy) : Bool :=
+  match region with
+  | .mk [.mk bargs ops] => bargs.mapM (fun a => vtyOf ib a.ty) == some (args.map (·.ty)) &&
+    checkOps R ((bargs.map (·.id)).zip args ++ Γ) ops yields
+  | _ => false
+
+theorem checkRegion_sound (R : BookAt sem ib depth) {Γ : FEnv} {region : Region}
+    {argFacts : List Fact} {yields : List VTy} (h : checkRegion R Γ region argFacts yields = true)
+    {ctx : Ctx} {call : CallSem} {env : Env} (hib : ctx.indexBits = ib)
+    (hd : depth ≤ ctx.loopIndex.length) (hΓ : EnvHolds ib Γ env) {args : List RVal}
+    (ha : FactsHold ib args argFacts) : ∃ vs, evalRegion sem ctx call env region args = .ok vs ∧
+      HasTys ib vs yields ∧ ResultsDefined vs := by
+  cases region with
+  | mk blocks =>
+    cases blocks with
+    | nil => simp [checkRegion] at h
+    | cons b rest =>
+      cases rest with
+      | cons _ _ => simp [checkRegion] at h
+      | nil =>
+        cases b with
+        | mk params body =>
+          simp only [checkRegion, Bool.and_eq_true, beq_iff_eq] at h
+          have hlen : params.length = args.length := by
+            rw [← optionMapM_length _ _ _ h.1]
+            simpa using (List.Forall₂.length_eq ha).symm
+          simp only [evalRegion, evalBlocks, evalBlock, bindAll_ok hlen, Outcome.bind_ok]
+          exact checkOps_sound R _ body yields ctx call _ h.2 (hΓ.extend _ args argFacts ha) hib hd
+
+/-- A depth-zero book plugs into the existing whole-function definedness checker unchanged. -/
+def root (book : BookAt sem ib 0) : Book sem ib where
+  rule := book.rule
+  sound Γ op fs rs h ctx call env args hib hΓ ha :=
+    book.sound Γ op fs rs h ctx call env args hib (Nat.zero_le _) hΓ ha
+
+end MerlinVerify.Rules.FrontendDefinedFrame
diff --git a/merlin/lean/MerlinVerify/Rules/FrontendDefinedGeneric.lean b/merlin/lean/MerlinVerify/Rules/FrontendDefinedGeneric.lean
new file mode 100644
index 000000000..5e844af84
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/FrontendDefinedGeneric.lean
@@ -0,0 +1,197 @@
+/- Context-aware generic initialization, using the existing frozen loop evaluator.
+The depth adaptation is a proof device; at every actual iteration it is the identity. -/
+import MerlinVerify.Rules.FrontendDefinedIndex
+
+namespace MerlinVerify.Rules.FrontendDefinedGeneric
+open MerlinVerify MerlinVerify.Check MerlinVerify.Check.Definedness MerlinVerify.Sem.Ops
+open Sem.Ops.Linalg FrontendDefinedFrame
+
+/-- Supply an arbitrary frame only outside the contexts actually used by the generic.
+No execution claim substitutes that outside-frame behavior for the original program. -/
+def framed (depth : Nat) (body : Ctx → RegionSem) : Ctx → RegionSem := fun ctx =>
+  body {ctx with loopIndex := if depth ≤ ctx.loopIndex.length then ctx.loopIndex else List.replicate depth 0}
+
+theorem framed_eq (depth : Nat) (body : Ctx → RegionSem) (ctx : Ctx)
+    (h : depth ≤ ctx.loopIndex.length) : framed depth body ctx = body ctx := by
+  simp only [framed, h, ↓reduceIte]
+
+theorem fold_congr {α β : Type} (f g : β → α → Outcome β) (xs : List α)
+    (h : ∀ x ∈ xs, ∀ state, f state x = g state x) (initial : β) :
+    xs.foldlM f initial = xs.foldlM g initial := by
+  induction xs generalizing initial with
+  | nil => rfl
+  | cons x xs ih =>
+    simp only [List.foldlM_cons]
+    rw [h x (List.mem_cons_self ..) initial]
+    apply congrArg (Outcome.bind (g initial x))
+    funext state
+    exact ih (fun y hy => h y (List.mem_cons_of_mem _ hy)) state
+
+/-- The loop evaluator supplies exactly one coordinate per iterator. Hence frame adaptation
+cannot change any body call that the actual checked generic makes. -/
+theorem generic_framed {ib : Nat} {maps : List AffineMap} {iters : List IterKind}
+    {inTys outTys : List VTy} {ranges : List Nat} {ins : List RVal} {outs : List Tensor}
+    (hs : StructuredOk maps iters.length (inTys ++ outTys) ranges)
+    (hi : HasTys ib ins inTys) (ho : HasTys ib (outs.map RVal.tensor) outTys)
+    (ctx : Ctx) (body : Ctx → RegionSem) :
+    genericSem ctx maps iters ins (outs.map RVal.tensor) (framed iters.length body) =
+      genericSem ctx maps iters ins (outs.map RVal.tensor) body := by
+  rw [genericSem_execute hs hi ho, genericSem_execute hs hi ho]
+  congr 1
+  apply fold_congr
+  intro pt hp cur
+  have hb := (mem_allPoints ranges pt).mp hp
+  have hlen : iters.length ≤ pt.length := by
+    have he : ranges.length = iters.length := by simpa only [List.length_range] using optionMapM_length _ _ _ hs.loops
+    have hp' : pt.length = ranges.length := hb.1
+    omega
+  simp only [loopStep, bodyAt]
+  rw [framed_eq iters.length body {ctx with loopIndex := pt} hlen]
+
+/-- A frame-checked body can use linalg.index, while ordinary leaves keep their old proofs. -/
+theorem framed_total {ib depth : Nat} (book : BookAt opSem ib depth) {Γ : FEnv} {body : Region}
+    {fs : List Fact} {ys : List VTy} (h : checkRegion book Γ body fs ys = true)
+    (call : CallSem) (env : Env) (hΓ : EnvHolds ib Γ env) :
+    BodyTotal ib (framed depth (fun ctx => evalRegion opSem ctx call env body)) fs ys := by
+  intro ctx hib args ha
+  unfold framed
+  apply checkRegion_sound book h (ctx := {ctx with loopIndex :=
+    if depth ≤ ctx.loopIndex.length then ctx.loopIndex else List.replicate depth 0}) hib ?_ hΓ ha
+  split <;> simp_all
+
+def overwriteRule (ib : Nat) (bodyBooks : (depth : Nat) → BookAt opSem ib depth)
+    (Γ : FEnv) (op : Op) (fs : List Fact) : Option (List Fact) :=
+  if unmodelledAttr? op.blind = none ∧ dialectOf op.name = "linalg" ∧ op.name = "linalg.generic" then
+    match splitInsOuts op fs, attrAffineMaps? op "indexing_maps", iterKinds? op, op.regions with
+    | some (ins, [⟨.tensor sh e, _⟩]), some maps, some iters, [body] =>
+      if op.results.length = 1 ∧ maps.drop ins.length = [identityMap sh.length] ∧
+          structuredRanges? maps iters.length (ins.map (·.ty) ++ [.tensor sh e]) = some sh ∧
+          FrontendDefinedFrame.checkRegion (bodyBooks iters.length) Γ body ((ins ++ [(⟨.tensor sh e, false⟩ : Fact)]).map elementFact) [.scalar e] then
+        some (clean [.tensor sh e])
+      else none
+    | _, _, _, _ => none
+  else none
+
+theorem overwriteRule_sound (ib : Nat) (bodyBooks : (depth : Nat) → BookAt opSem ib depth) : ∀ Γ op fs rs,
+    overwriteRule ib bodyBooks Γ op fs = some rs → ∀ ctx call env args,
+    ctx.indexBits = ib → EnvHolds ib Γ env → FactsHold ib args fs →
+    ∃ vs, opSem ctx call op args (evalRegions opSem call env op.regions) = .ok vs ∧
+      FactsHold ib vs rs := by
+  intro Γ op fs rs h ctx call env args hib hΓ ha
+  unfold overwriteRule at h
+  split at h
+  · next hc =>
+    obtain ⟨hm, hd, hn⟩ := hc
+    split at h
+    · next ins sh e init maps iters body hsplit hmaps hiters hregs =>
+      split at h
+      · next hc =>
+        obtain ⟨hres, hout, hranges, hbody⟩ := hc
+        cases h
+        obtain ⟨xs, ys, hio, hxs, hys⟩ := splitInsOuts_facts hsplit ha
+        obtain _ | ⟨ht, hnil⟩ := hys
+        cases hnil
+        rename_i t
+        cases t with
+        | scalar _ => cases ht.1
+        | tensor t =>
+          have hb := framed_total (bodyBooks iters.length) hbody call env hΓ
+          obtain ⟨rs, hsem, hrf⟩ := overwriteSem_total hib (structuredRanges?_spec hranges) hout hxs ht.1 hb
+          have hf := generic_framed (outs := [t]) (structuredRanges?_spec hranges) hxs.typed
+            (List.Forall₂.cons ht.1 .nil) ctx (fun inner => evalRegion opSem inner call env body)
+          simp only [List.map_cons, List.map_nil] at hf
+          rw [hf] at hsem
+          refine ⟨rs, ?_, hrf⟩
+          have hlen : rs.length = op.blind.results.length := by
+            rw [HasTys.length (clean_typed hrf), Op.blind_results, List.length_map, hres]
+            rfl
+          rw [linalg_sem_of hm hd (.inl hn)]
+          simp only [hregs, evalRegions, Linalg.sem, Op.blind_name, hn, splitInsOuts_blind, hio,
+            attrAffineMaps?_blind, hmaps, iterKinds?_blind, hiters, Outcome.bindOp_eq, hsem,
+            Outcome.bind_ok, hlen, ↓reduceIte, Outcome.pure_eq]
+      · cases h
+    · cases h
+  · cases h
+
+def initializedRule (ib : Nat) (bodyBooks : (depth : Nat) → BookAt opSem ib depth)
+    (Γ : FEnv) (op : Op) (fs : List Fact) : Option (List Fact) :=
+  if unmodelledAttr? op.blind = none ∧ dialectOf op.name = "linalg" ∧ op.name = "linalg.generic" then
+    match splitInsOuts op fs, attrAffineMaps? op "indexing_maps", iterKinds? op, op.regions with
+    | some (ins, outs), some maps, some iters, [body] =>
+      if (∀ f ∈ outs, f.initialized = true) ∧ (∀ f ∈ outs, f.ty.isTensor = true) ∧
+          op.results.length = outs.length ∧
+          (structuredRanges? maps iters.length ((ins ++ outs).map (·.ty))).isSome ∧
+          FrontendDefinedFrame.checkRegion (bodyBooks iters.length) Γ body ((ins ++ outs).map elementFact)
+            (outs.map fun f => f.ty.eltScalar) then
+        some (clean (outs.map (·.ty)))
+      else none
+    | _, _, _, _ => none
+  else none
+
+theorem initializedRule_sound (ib : Nat) (bodyBooks : (depth : Nat) → BookAt opSem ib depth) : ∀ Γ op fs rs,
+    initializedRule ib bodyBooks Γ op fs = some rs → ∀ ctx call env args,
+    ctx.indexBits = ib → EnvHolds ib Γ env → FactsHold ib args fs →
+    ∃ vs, opSem ctx call op args (evalRegions opSem call env op.regions) = .ok vs ∧
+      FactsHold ib vs rs := by
+  intro Γ op fs rs h ctx call env args hib hΓ ha
+  unfold initializedRule at h
+  split at h
+  · next hc =>
+    obtain ⟨hm, hd, hn⟩ := hc
+    split at h
+    · next ins outs maps iters body hsplit hmaps hiters hregs =>
+      split at h
+      · next hc =>
+        obtain ⟨hi, ht, hres, hranges, hbody⟩ := hc
+        obtain ⟨ranges, hranges⟩ := Option.isSome_iff_exists.1 hranges
+        cases h
+        obtain ⟨xs, ys, hio, hxs, hys⟩ := splitInsOuts_facts hsplit ha
+        have hclean := facts_eq_clean outs hi
+        have hys' : FactsHold ib ys (clean (outs.map (·.ty))) := hclean ▸ hys
+        have hb : BodyTotal ib (framed iters.length (fun inner => evalRegion opSem inner call env body))
+            ((ins ++ clean (outs.map (·.ty))).map elementFact)
+            ((outs.map (·.ty)).map VTy.eltScalar) := by
+          have hb := framed_total (bodyBooks iters.length) hbody call env hΓ
+          intro inner hwidth vals hfacts
+          rw [← hclean] at hfacts
+          simpa only [List.map_map, Function.comp_def] using hb inner hwidth vals hfacts
+        have hs : StructuredOk maps iters.length (ins.map (·.ty) ++ outs.map (·.ty)) ranges := by
+          simpa only [List.map_append] using structuredRanges?_spec hranges
+        have hout : ∀ t ∈ outs.map (·.ty), t.isTensor = true := by
+          intro t ht'
+          obtain ⟨f, hf, rfl⟩ := List.mem_map.1 ht'
+          exact ht f hf
+        obtain ⟨tensors, htensors⟩ := tensors_of_typed (clean_typed hys') hout
+        have hf := generic_framed hs hxs.typed (htensors ▸ clean_typed hys') ctx
+          (fun inner => evalRegion opSem inner call env body)
+        rw [← htensors] at hf
+        obtain ⟨rs, hsem, hrf⟩ := genericSem_total hib hs hout hxs hys' hb
+        rw [hf] at hsem
+        refine ⟨rs, ?_, hrf⟩
+        have hlen : rs.length = op.blind.results.length := by
+          rw [HasTys.length (clean_typed hrf), List.length_map, Op.blind_results,
+            List.length_map, hres]
+        rw [linalg_sem_of hm hd (.inl hn)]
+        simp only [hregs, evalRegions, Linalg.sem, Op.blind_name, hn, splitInsOuts_blind, hio,
+          attrAffineMaps?_blind, hmaps, iterKinds?_blind, hiters, Outcome.bindOp_eq, hsem,
+          Outcome.bind_ok, hlen, ↓reduceIte, Outcome.pure_eq]
+      · cases h
+    · cases h
+  · cases h
+
+
+def book (ib : Nat) (bodyBooks : (depth : Nat) → BookAt opSem ib depth) : Book opSem ib where
+  rule Γ op fs := (overwriteRule ib bodyBooks Γ op fs).orElse fun _ => initializedRule ib bodyBooks Γ op fs
+  sound Γ op fs rs h ctx call env args hib hΓ ha := by
+    cases ho : overwriteRule ib bodyBooks Γ op fs with
+    | some ys =>
+      simp only [ho, Option.orElse_some, Option.some.injEq] at h
+      subst h
+      exact overwriteRule_sound ib bodyBooks Γ op fs ys ho ctx call env args hib hΓ ha
+    | none =>
+      simp only [ho, Option.orElse_none] at h
+      exact initializedRule_sound ib bodyBooks Γ op fs rs h ctx call env args hib hΓ ha
+
+#print axioms book
+
+end MerlinVerify.Rules.FrontendDefinedGeneric
diff --git a/merlin/lean/MerlinVerify/Rules/FrontendDefinedIndex.lean b/merlin/lean/MerlinVerify/Rules/FrontendDefinedIndex.lean
new file mode 100644
index 000000000..0be8a9eaf
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/FrontendDefinedIndex.lean
@@ -0,0 +1,108 @@
+/- Initialized linalg.index values under a checked enclosing iteration frame. -/
+import MerlinVerify.Rules.FrontendDefinedFrame
+
+namespace MerlinVerify.Rules.FrontendDefinedIndex
+open MerlinVerify MerlinVerify.Check MerlinVerify.Check.Definedness MerlinVerify.Sem.Ops
+open FrontendDefinedFrame
+
+def rule (depth : Nat) : Definedness.Rule := fun op fs =>
+  if unmodelledAttr? op.blind = none ∧ dialectOf op.name = "linalg" ∧ op.name = "linalg.index" ∧
+      fs = [] ∧ op.results.map (·.ty) = [.index] ∧ op.regions = [] then
+    match attrInt? op "dim" with
+    | some d => if 0 ≤ d ∧ d.toNat < depth then some [⟨.scalar .index, true⟩] else none
+    | none => none
+  else none
+
+def book (ib depth : Nat) : BookAt opSem ib depth where
+  rule _ := rule depth
+  sound Γ op fs rs h ctx call env args hib hdepth _ ha := by
+    unfold rule at h
+    split at h
+    · next hc =>
+      obtain ⟨hm, hd, hn, rfl, _, _⟩ := hc
+      split at h
+      · next d hdim =>
+        split at h
+        · next hc =>
+          cases h
+          cases ha
+          have hlt : d.toNat < ctx.loopIndex.length := by omega
+          have hdim' : attrInt? op.blind "dim" = some d := by simpa [attrInt?] using hdim
+          have hi : ctx.loopIndex[d.toNat]? = some ctx.loopIndex[d.toNat] := List.getElem?_eq_getElem hlt
+          rw [opSem_modelled hm]
+          have hd' : dialectOf "linalg.index" = "linalg" := by cbv
+          simp only [dispatch, Op.blind_name, hd, hn, hd', beq_self_eq_true, Bool.or_true, ↓reduceIte]
+          simp only [Linalg.sem, Op.blind_name, hn]
+          simp only [hdim', hi, hc.1, ↓reduceIte]
+          refine ⟨_, rfl, .cons ?_ .nil⟩
+          constructor
+          · simp [RVal.HasTy, Val.HasTy, Scalar.conforms, hib]
+          · simp [RVal.Defined]
+        · cases h
+      · cases h
+    · cases h
+
+#print axioms book
+end MerlinVerify.Rules.FrontendDefinedIndex
+
+namespace MerlinVerify.Rules.FrontendDefinedIndex
+open MerlinVerify MerlinVerify.Check MerlinVerify.Check.Definedness MerlinVerify.Sem.Ops
+
+theorem index_int_fact (ib : Nat) (v : RVal) :
+    Fact.Holds ib v ⟨.scalar .index, true⟩ ↔ Fact.Holds ib v ⟨.scalar (.int ib), true⟩ := by
+  cases v with
+  | tensor _ => simp [Fact.Holds, RVal.HasTy]
+  | scalar v =>
+    cases v with
+    | poison => simp [Fact.Holds, RVal.HasTy, Val.HasTy, RVal.Defined]
+    | some s => cases s <;> simp [Fact.Holds, RVal.HasTy, Val.HasTy, Scalar.conforms]
+
+/-- Equal-width signed index casts preserve initialized bits in either direction. -/
+def castRule (ib : Nat) : Definedness.Rule := fun op fs =>
+  match fs, op.results with
+  | [⟨.scalar ty, true⟩], [r] =>
+    if dialectOf op.name = "arith" ∧ op.name = "arith.index_cast" ∧
+        ((ty = .index ∧ r.ty = .int ib) ∨ (ty = .int ib ∧ r.ty = .index)) then
+      some [⟨.scalar r.ty, true⟩]
+    else none
+  | _, _ => none
+
+theorem castRule_sound (ib : Nat) : Definedness.RuleSound ib (castRule ib) := by
+  intro op fs rs hm h ctx call args hib ha
+  unfold castRule at h
+  split at h
+  · next ty r hres =>
+    split at h
+    · next hc =>
+      obtain ⟨hd, hn, hdir⟩ := hc
+      cases h
+      obtain _ | ⟨hv, hnil⟩ := ha
+      cases hnil
+      rcases hdir with ⟨rfl, hr⟩ | ⟨rfl, hr⟩
+      all_goals
+        first | have hv' := (index_int_fact ib _).mp hv | have hv' := hv
+        obtain ⟨x, rfl⟩ := initialized_int hv'
+        have hresult : Arith.resultElt op.blind = some r.ty := by
+          simp [Arith.resultElt, Op.blind_results, hres, hr]
+        rw [opSem_modelled hm]
+        simp only [dispatch, Op.blind_name, hd]
+        simp only [Arith.sem, Op.blind_name, hn, Arith.widthOf, hresult, hr, Ty.bitWidth?, hib,
+          Outcome.ofOption, Outcome.bindOp_eq, Outcome.bind_ok, Arith.unOp, Arith.pureN]
+        rw [show [.scalar (.some (.bits ib x))] =
+          ([.some (.bits ib x)] : List Val).map RVal.scalar from rfl, liftEager_scalars]
+        simp only [Arith.intUn, Nat.le_refl, ↓reduceIte, Outcome.bind_ok, Arith.bv]
+        exact ⟨_, rfl, .cons ⟨by simp [hr, RVal.HasTy, Val.HasTy, Scalar.conforms],
+          by simp [RVal.Defined]⟩ .nil⟩
+    · cases h
+  · cases h
+
+def castBook (ib : Nat) : Definedness.Book opSem ib where
+  rule _ op fs := if unmodelledAttr? op.blind = none ∧ op.regions = [] then castRule ib op fs else none
+  sound Γ op fs rs h ctx call env args hib _ ha := by
+    split at h
+    · next hc =>
+      simpa only [hc.2, evalRegions] using castRule_sound ib op fs rs hc.1 h ctx call args hib ha
+    · cases h
+
+#print axioms castRule_sound
+end MerlinVerify.Rules.FrontendDefinedIndex
diff --git a/merlin/lean/MerlinVerify/Rules/FrontendDefinedSlice.lean b/merlin/lean/MerlinVerify/Rules/FrontendDefinedSlice.lean
new file mode 100644
index 000000000..41235fc7c
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/FrontendDefinedSlice.lean
@@ -0,0 +1,94 @@
+/- Initialized static slices, including rank reduction. All geometry is recomputed from IR. -/
+import MerlinVerify.Check.DefinedLinalg
+
+namespace MerlinVerify.Rules.FrontendDefinedSlice
+open MerlinVerify MerlinVerify.Check MerlinVerify.Check.Definedness MerlinVerify.Sem.Ops
+
+theorem place_total : ∀ (sizes cs : List Nat), cs.length = (sizes.filter (· ≠ 1)).length →
+    ∃ f, Sem.Ops.Tensor.placeNonUnit sizes cs = some f
+  | [], [], _ => ⟨[], rfl⟩
+  | [], _ :: _, h => by simp at h
+  | s :: ss, cs, h => by
+    by_cases hs : s = 1
+    · have hl : cs.length = (ss.filter (· ≠ 1)).length := by simpa [hs] using h
+      obtain ⟨f, hf⟩ := place_total ss cs hl
+      exact ⟨0 :: f, by simp [Sem.Ops.Tensor.placeNonUnit, hs, hf]⟩
+    · cases cs with
+      | nil => simp [hs] at h
+      | cons c cs =>
+        have hl : cs.length = (ss.filter (· ≠ 1)).length := by simpa [hs] using h
+        obtain ⟨f, hf⟩ := place_total ss cs hl
+        exact ⟨c :: f, by simp [Sem.Ops.Tensor.placeNonUnit, hs, hf]⟩
+
+theorem expand_total {sizes reduced : List Nat} {r : Idx}
+    (hc : Sem.Ops.Tensor.reducedCompatible sizes reduced = true) (hr : Idx.InBounds reduced r) :
+    ∃ f, Sem.Ops.Tensor.expandReduced sizes reduced r = some f := by
+  have hcoords := nonUnit_coords_lt (fun (x, s) => if s = 1 then none else some x) (by intro _ _; rfl) r reduced hr.1 hr.2
+  have hlength := List.Forall₂.length_eq hcoords
+  simp only [Sem.Ops.Tensor.reducedCompatible, Bool.and_eq_true, beq_iff_eq] at hc
+  unfold Sem.Ops.Tensor.expandReduced
+  exact place_total sizes _ (by rwa [hc.1])
+
+def rule : Definedness.Rule := fun op fs =>
+  if dialectOf op.name = "tensor" ∧ op.name = "tensor.extract_slice" then
+    match fs, Sem.Ops.Tensor.resultTensorTy op, Sem.Ops.Tensor.staticArray? op "static_offsets",
+        Sem.Ops.Tensor.staticArray? op "static_sizes", Sem.Ops.Tensor.staticArray? op "static_strides" with
+    | [⟨.tensor sh e, true⟩], some (rshape, elt), some offs, some sizes, some strides =>
+      if e = elt ∧
+          ¬(offs.length ≠ sh.length ∨ sizes.length ≠ sh.length ∨ strides.length ≠ sh.length) ∧
+          Sem.Ops.Tensor.reducedCompatible sizes rshape = true ∧
+          ((List.range sh.length).any fun d => sizes.getD d 0 ≠ 0 &&
+            offs.getD d 0 + (sizes.getD d 0 - 1) * strides.getD d 0 ≥ sh.getD d 0) = false then
+        some [⟨.tensor rshape elt, true⟩]
+      else none
+    | _, _, _, _, _ => none
+  else none
+
+theorem rule_sound (ib : Nat) : Definedness.RuleSound ib rule := by
+  intro op fs rs hm h ctx call args _ ha
+  unfold rule at h
+  split at h
+  · next hc =>
+    obtain ⟨hd, hn⟩ := hc
+    split at h
+    · next sh e rshape elt offs sizes strides hr hoffs hsizes hstrides =>
+      split at h
+      · next hc =>
+        obtain ⟨rfl, hlen, hcomp, hfit⟩ := hc
+        cases h
+        obtain _ | ⟨ht, hnil⟩ := ha
+        cases hnil
+        rename_i value
+        cases value with
+        | scalar _ => cases ht.1
+        | tensor t =>
+          obtain ⟨⟨hts, hte, htg⟩, hinit⟩ := ht
+          subst hts hte
+          rw [tensor_sem_of hm hd]
+          simp only [Sem.Ops.Tensor.sem, Op.blind_name, hn, resultTensorTy_blind, hr,
+            staticArray?_blind, hoffs, hsizes, hstrides, hlen, ↓reduceIte, hcomp, Bool.not_true,
+            Bool.false_eq_true, hfit]
+          refine ⟨_, rfl, .cons ⟨⟨rfl, rfl, ?_⟩, ?_⟩ .nil⟩
+          · intro r hbound
+            obtain ⟨f, hf⟩ := expand_total hcomp hbound
+            simp only [Tensor.canon, hbound, ↓reduceIte, hf]
+            exact htg _ (slice_index_inBounds (by omega) (expandReduced_inBounds hcomp hbound hf) hfit)
+          · intro _ r hbound
+            change Idx.InBounds rshape r at hbound
+            obtain ⟨f, hf⟩ := expand_total hcomp hbound
+            simp only [Tensor.canon, hbound, ↓reduceIte, hf]
+            exact hinit rfl _ (slice_index_inBounds (by omega) (expandReduced_inBounds hcomp hbound hf) hfit)
+      · cases h
+    · cases h
+  · cases h
+
+def book (ib : Nat) : Book opSem ib where
+  rule _ op fs := if unmodelledAttr? op.blind = none ∧ op.regions = [] then rule op fs else none
+  sound Γ op fs rs h ctx call env args hib _ ha := by
+    split at h
+    · next hc =>
+      simpa only [hc.2, evalRegions] using rule_sound ib op fs rs hc.1 h ctx call args hib ha
+    · cases h
+
+#print axioms rule_sound
+end MerlinVerify.Rules.FrontendDefinedSlice
diff --git a/merlin/lean/MerlinVerify/Rules/FrontendMaskTyped.lean b/merlin/lean/MerlinVerify/Rules/FrontendMaskTyped.lean
new file mode 100644
index 000000000..e717652e7
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/FrontendMaskTyped.lean
@@ -0,0 +1,122 @@
+/- The selection theorem accepts ordinary typed initialized tensors, without canonicality hints. -/
+import MerlinVerify.Rules.FrontendMaskWhole
+import MerlinVerify.Check.DefinedLinalg
+
+namespace MerlinVerify.Rules.FrontendMaskTyped
+open MerlinVerify MerlinVerify.Check MerlinVerify.Check.Definedness
+open FrontendMaskWhole FrontendMaskProgram
+
+def word (value : Val) : BitVec 64 :=
+  match value with
+  | .some (.bits 64 x) => x
+  | _ => 0
+
+def boolean (value : Val) : Bool :=
+  match value with
+  | .some (.bits 1 x) => x == 1
+  | _ => false
+
+theorem initialized_bits {shape : List Nat} {t : Tensor} {width : Nat}
+    (ht : RVal.HasTy 64 (.tensor t) (.tensor shape (.int width)))
+    (hd : RVal.Defined (.tensor t)) {p : Idx} (hp : Idx.InBounds shape p) :
+    ∃ x : BitVec width, t.get p = .some (.bits width x) := by
+  obtain ⟨x, hx⟩ := initialized_int (show Fact.Holds 64 (.scalar (t.get p)) ⟨.scalar (.int width), true⟩ from
+    ⟨ht.2.2 p hp, fun _ => hd p (ht.1.symm ▸ hp)⟩)
+  exact ⟨x, RVal.scalar.inj hx⟩
+
+theorem one_bit (x : BitVec 1) : x = 0 ∨ x = 1 := by
+  have hbound := x.isLt
+  by_cases h : x.toNat = 0
+  · left; apply BitVec.eq_of_toNat_eq; change x.toNat = 0; exact h
+  · right; apply BitVec.eq_of_toNat_eq; change x.toNat = 1; omega
+
+def words (t : Tensor) (i : Nat) : BitVec 64 :=
+  word (t.get (Sem.Ops.Tensor.delinearize t.shape i))
+
+def bits (t : Tensor) (i : Nat) : Bool :=
+  boolean (t.get (Sem.Ops.Tensor.delinearize t.shape i))
+
+theorem word_represents {shape : List Nat} {t : Tensor}
+    (ht : RVal.HasTy 64 (.tensor t) (.tensor shape (.int 64))) (hd : RVal.Defined (.tensor t)) :
+    Represents t shape (.int 64) (fun i => .some (.bits 64 (words t i))) := by
+  refine ⟨ht.1, ht.2.1, ?_⟩
+  intro p hp
+  obtain ⟨x, hx⟩ := initialized_bits ht hd hp
+  simp only [words, ht.1, ReshapeIndex.delinearize_linear shape p hp, hx, word]
+
+theorem mask_represents {t : Tensor}
+    (ht : RVal.HasTy 64 (.tensor t) (.tensor [1,32,32] (.int 1))) (hd : RVal.Defined (.tensor t)) :
+    Represents t [1,32,32] (.int 1) (fun i => Sem.Ops.Arith.boolVal (bits t i)) := by
+  refine ⟨ht.1, ht.2.1, ?_⟩
+  intro p hp
+  obtain ⟨x, hx⟩ := initialized_bits ht hd hp
+  simp only [bits, ht.1, ReshapeIndex.delinearize_linear [1,32,32] p hp, hx, boolean]
+  rcases one_bit x with rfl | rfl <;> rfl
+
+def inputTypes : List VTy :=
+  [.tensor [1,32,32] (.int 1), .tensor [1,1024] (.int 64), .tensor [1,1024] (.int 64)]
+
+def resultTypes : List VTy := [.tensor [1,1024] (.int 64), .scalar .index]
+
+/-- This is a typed region theorem over arbitrary initialized tensor representations and arbitrary
+call semantics. No input values or safety bits come from Python. -/
+theorem body_exec (limit : Nat) (ctx : Ctx) (call : CallSem) (args : List RVal)
+    (ha : HasTys 64 args inputTypes) (hd : ResultsDefined args) (hib : ctx.indexBits = 64)
+    (hu : FrontendBoolFptosi.UneCorrect ctx.M) (hl : 1024 ≤ limit) :
+    ∃ results, evalRegion (FrontendMaskRuntime.sem limit) ctx call [] FrontendMaskTemplate.body args = .ok results ∧
+      HasTys 64 results resultTypes ∧ ResultsDefined results := by
+  obtain _ | ⟨hm, rest⟩ := ha
+  obtain _ | ⟨hv, rest⟩ := rest
+  obtain _ | ⟨hs, rest⟩ := rest
+  cases rest
+  rename_i mask values seed
+  have hdm := hd mask (by simp)
+  have hdv := hd values (by simp)
+  have hds := hd seed (by simp)
+  cases mask with
+  | scalar _ => cases hm
+  | tensor mask =>
+    cases values with
+    | scalar _ => cases hv
+    | tensor values =>
+      cases seed with
+      | scalar _ => cases hs
+      | tensor seed =>
+        obtain ⟨out, he, hshape, hdefined, htyped⟩ := body_inputs_exec limit ctx call
+          (bits mask) (words values) (words seed) mask values seed
+          (mask_represents hm hdm) (word_represents hv hdv) (word_represents hs hds) hib hu hl
+        refine ⟨_, he, .cons htyped (.cons ?_ .nil), ?_⟩
+        · simp [index, RVal.HasTy, Val.HasTy, Scalar.conforms]
+        · intro value hvalue
+          simp only [List.mem_cons, List.not_mem_nil, or_false] at hvalue
+          rcases hvalue with rfl | rfl
+          · exact hdefined
+          · simp [index, RVal.Defined]
+
+/-- Full actual-cut acceptance transports typed execution. The approved direct f32 model
+supplies the generic comparison premise; the input domain no longer requires canonical tensors. -/
+theorem check_sound {actual : Module} (h : FrontendMaskWhole.check actual = true)
+    (limit : Nat) (base : FloatModel) (ctx : Ctx) (args : List RVal)
+    (ha : HasTys 64 args inputTypes) (hd : ResultsDefined args) (hib : ctx.indexBits = 64)
+    (hl : 1024 ≤ limit) :
+    ∃ results, denote (FrontendMaskRuntime.sem limit) {ctx with M := FrontendF32Comparison.model base}
+      actual "subject" args = .ok results ∧ HasTys 64 results resultTypes ∧ ResultsDefined results := by
+  simp only [FrontendMaskWhole.check, Bool.and_eq_true] at h
+  have he := FrontendBoolSimulationWith.evalFunc_sound (FrontendMaskRuntime.sem limit)
+    (FrontendBoolSimulationWith.candidateLaws limit) h.2
+    {ctx with M := FrontendF32Comparison.model base} (FrontendF32Comparison.model_correct base)
+  rw [FrontendBoolSimulationWith.policy_nil] at he
+  have hlen := FrontendBoolSimulation.functions_length FrontendMaskTemplate.subject.funcs actual.funcs h.2
+  obtain ⟨results, hr, ht, hd⟩ := body_exec limit {ctx with M := FrontendF32Comparison.model base}
+    (evalFunc (FrontendMaskRuntime.sem limit) {ctx with M := FrontendF32Comparison.model base}
