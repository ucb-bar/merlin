diff --git a/merlin/lean/MerlinVerify/Rules/FrontendFunctionRanges.lean b/merlin/lean/MerlinVerify/Rules/FrontendFunctionRanges.lean
new file mode 100644
index 000000000..986404e31
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/FrontendFunctionRanges.lean
@@ -0,0 +1,55 @@
+/- Integer postconditions inferred from an actual function, with no numeric input facts. -/
+import MerlinVerify.Rules.FrontendRangeDefined
+import MerlinVerify.Rules.FrontendRangeFacts
+import MerlinVerify.Rules.FrontendProgramFrames
+import MerlinVerify.Check.TypedModule
+
+namespace MerlinVerify.Rules.FrontendFunctionRanges
+open MerlinVerify MerlinVerify.Check
+open FrontendTensorRanges
+
+def expected (types : List VTy) (upper : Nat) : List Fact :=
+  types.map fun ty => ⟨⟨ty,true⟩, some ⟨0,upper⟩⟩
+
+def check (m : Module) (name : String) (upper : Nat) : Bool :=
+  match m.func? name, TypedModule.signature? 64 m name with
+  | some f, some (a,r) => !f.isDecl && FrontendRuntimeBridge.regions [f.body] &&
+      match FrontendRangeFrame.inferRegion (FrontendRangeDefined.frameBook 64 []) [] f.body
+        (a.map fun ty => Definedness.Refined.emptyFact model ⟨ty,true⟩) with
+      | some facts => FrontendRangeFacts.fits facts (expected r upper)
+      | none => false
+  | _, _ => false
+
+/-- Requested output bounds must follow from the actual checked producers.
+The formal statement quantifies every FloatModel, including every comparison result. -/
+theorem check_sound {m : Module} {name : String} {upper : Nat} (h : check m name upper = true) :
+    ∃ a r, TypedModule.signature? 64 m name = some (a,r) ∧
+      ∀ (limit : Nat) (ctx : Ctx) (args : List RVal), ctx.indexBits = 64 →
+        HasTys 64 args a → ResultsDefined args →
+        ∃ values, denote (FrontendMaskRuntime.sem limit) ctx m name args = .ok values ∧
+          Definedness.Refined.FactsHold model 64 values (expected r upper) := by
+  unfold check at h
+  split at h
+  · next f a r hf hsig =>
+    simp only [Bool.and_eq_true, Bool.not_eq_eq_eq_not, Bool.not_true] at h
+    obtain ⟨⟨hdecl, hbridge⟩, h⟩ := h
+    split at h
+    · next facts hinfer =>
+      refine ⟨a,r,hsig,?_⟩
+      intro limit ctx args hib ht hd
+      obtain ⟨values, hv, hvalues⟩ := FrontendRangeFrame.inferRegion_sound
+        (ctx := ctx) (call := evalFunc (FrontendMaskRuntime.sem limit) ctx m m.funcs.length) (env := [])
+        (FrontendRangeDefined.frameBook 64 []) hinfer hib (.inl rfl)
+        (by intro _ _ h; cases h) (Definedness.Refined.inputFacts model ht hd)
+      have hb : FrontendRuntimeBridge.blocksCheck f.body.blocks = true := by
+        cases hbody : f.body with
+        | mk blocks => simpa only [hbody, FrontendRuntimeBridge.regions, Region.blocks, Bool.and_true] using hbridge
+      have he := FrontendProgramFrames.region_eq limit ctx
+        (evalFunc (FrontendMaskRuntime.sem limit) ctx m m.funcs.length) [] f.body args hb
+      refine ⟨values, ?_, FrontendRangeFacts.fits_sound h hvalues⟩
+      simpa only [denote, evalFunc, hf, hdecl, Bool.false_eq_true, ↓reduceIte] using he.trans hv
+    · cases h
+  · cases h
+
+#print axioms check_sound
+end MerlinVerify.Rules.FrontendFunctionRanges
diff --git a/merlin/lean/MerlinVerify/Rules/FrontendPositionExecution.lean b/merlin/lean/MerlinVerify/Rules/FrontendPositionExecution.lean
new file mode 100644
index 000000000..644c1f4d2
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/FrontendPositionExecution.lean
@@ -0,0 +1,167 @@
+/- Program composition of actual position-producing prefix, selection and continuation. -/
+import MerlinVerify.Rules.FrontendPositionScope
+import MerlinVerify.Rules.FrontendMaskRange
+
+namespace MerlinVerify.Rules.FrontendPositionExecution
+open MerlinVerify MerlinVerify.Check
+open FrontendTensorRanges FrontendPositionScope FrontendProgramSegments
+
+def maskFact : Fact := ⟨⟨.tensor [1,32,32] (.int 1), true⟩, none⟩
+def positionFact : Fact := ⟨⟨.tensor [1,1024] (.int 64), true⟩, some ⟨0,1024⟩⟩
+
+/-- Expose the three proved tensor roots while retaining every additional observation. -/
+theorem roots {vs : List RVal} {extraFacts : List Fact}
+    (h : Definedness.Refined.FactsHold model 64 vs (FrontendPrefixRanges.expected 1024 ++ extraFacts)) :
+    ∃ mask values seed extras,
+      vs = [.tensor mask,.tensor values,.tensor seed] ++ extras ∧
+      Definedness.Refined.Fact.Holds model 64 (.tensor mask) maskFact ∧
+      Definedness.Refined.Fact.Holds model 64 (.tensor values) positionFact ∧
+      Definedness.Refined.Fact.Holds model 64 (.tensor seed) positionFact ∧
+      Definedness.Refined.FactsHold model 64 extras extraFacts := by
+  cases vs with
+  | nil => cases h
+  | cons mask rest =>
+    obtain _ | ⟨hm, hrest⟩ := h
+    cases rest with
+    | nil => cases hrest
+    | cons values rest =>
+      obtain _ | ⟨hv, hrest⟩ := hrest
+      cases rest with
+      | nil => cases hrest
+      | cons seed extras =>
+        obtain _ | ⟨hs, he⟩ := hrest
+        cases mask with
+        | scalar _ => cases hm.1.1
+        | tensor mask =>
+          cases values with
+          | scalar _ => cases hv.1.1
+          | tensor values =>
+            cases seed with
+            | scalar _ => cases hs.1.1
+            | tensor seed => exact ⟨mask,values,seed,extras,rfl,hm,hv,hs,he⟩
+
+/-- Strong selection execution for arbitrary initialized tensor representations. -/
+theorem selection {m : Module} {name : String} {stop count : Nat}
+    (s : Scope m name stop count) {limit : Nat} {base : FloatModel} {ctx : Ctx} {call : CallSem}
+    {env : Env} {mask values seed : Tensor}
+    (hm : Definedness.Refined.Fact.Holds model 64 (.tensor mask) maskFact)
+    (hv : Definedness.Refined.Fact.Holds model 64 (.tensor values) positionFact)
+    (hs : Definedness.Refined.Fact.Holds model 64 (.tensor seed) positionFact)
+    (hib : ctx.indexBits = 64) (hl : 1024 ≤ limit)
+    (hread : env.getAll [s.selection.mask.id,s.selection.values.id,s.selection.seed.id] =
+      .ok [.tensor mask,.tensor values,.tensor seed])
+    (hcut : FrontendBoolSimulation.region []
+      [(50,s.selection.mask.id),(51,s.selection.values.id),(52,s.selection.seed.id)]
+      FrontendRuntimeCheckpoint.bareSource s.selection.bare = true) :
+    ∃ results, evalRegion (FrontendMaskRuntime.sem limit) {ctx with M := FrontendF32Comparison.model base}
+      call env s.selection.bare [] = .ok results ∧
+      Definedness.Refined.FactsHold model 64 results selectedFacts := by
+  let modelCtx := {ctx with M := FrontendF32Comparison.model base}
+  obtain ⟨out, hbody, ht, hd, hp⟩ := FrontendMaskRange.body_exec limit modelCtx call mask values seed
+    hm.1.1 hv.1.1 hs.1.1 (hm.1.2 rfl) (hv.1.2 rfl) (hs.1.2 rfl) hv.2 hs.2 hib
+    (FrontendF32Comparison.model_correct base) hl
+  have hc := roots_corr env s.selection.mask.id s.selection.values.id s.selection.seed.id
+    (.tensor mask) (.tensor values) (.tensor seed) hread
+  have he := FrontendBoolSimulationWith.region_sound (FrontendMaskRuntime.sem limit)
+    (FrontendBoolSimulationWith.candidateLaws limit) [] call _ FrontendRuntimeCheckpoint.bareSource
+    s.selection.bare modelCtx [(50,.tensor mask),(51,.tensor values),(52,.tensor seed)] env hcut
+    (FrontendF32Comparison.model_correct base) hc
+  rw [FrontendBoolSimulationWith.policy_nil] at he
+  have hsource : evalRegion (FrontendMaskRuntime.sem limit) modelCtx call
+      [(50,.tensor mask),(51,.tensor values),(52,.tensor seed)] FrontendRuntimeCheckpoint.bareSource [] =
+      .ok [.tensor out, FrontendMaskProgram.index (FrontendMaskBounds.countFrom (FrontendMaskTyped.bits mask) 1024 0)] := by
+    simpa only [FrontendRuntimeCheckpoint.bareSource, FrontendMaskTemplate.body, evalRegion,
+      evalBlocks, evalBlock, Env.bindAll, List.length_cons, List.length_nil, ↓reduceIte,
+      List.map_cons, List.map_nil, List.zip_cons_cons, List.zip_nil_left, List.cons_append,
+      List.nil_append, Outcome.bind_ok] using hbody
+  refine ⟨_, (congrFun he []).symm.trans hsource, .cons ⟨⟨ht, fun _ => hd⟩, hp⟩ (.cons ?_ .nil)⟩
+  exact ⟨⟨by simp [FrontendMaskProgram.index, RVal.HasTy, Val.HasTy, Scalar.conforms],
+    by simp [FrontendMaskProgram.index, RVal.Defined]⟩, trivial⟩
+
+/-- Successful execution of the actual prefix, selection and entire continuation,
+composed through the evaluator's real SSA environments and checked capture frames. -/
+theorem scope_sound {m : Module} {name : String} {stop count : Nat}
+    (s : Scope m name stop count) (h : s.check = true) : s.Executes := by
+  unfold Scope.check at h
+  simp only [Bool.and_eq_true] at h
+  obtain ⟨⟨⟨⟨⟨⟨_, hcut⟩, hpreNon⟩, hselNon⟩, _⟩, hbridge⟩, h⟩ := h
+  split at h
+  · next a fs rs ha hfs hrs =>
+    split at h
+    · next prefixFacts resultFacts hpre htail =>
+      simp only [Bool.and_eq_true] at h
+      obtain ⟨⟨hpreFits, hpreserve⟩, htailFits⟩ := h
+      unfold Scope.preFacts? at hfs
+      cases hext : s.extras.mapM (fun v => vtyOf 64 v.ty) with
+      | none => simp [hext] at hfs
+      | some extraTypes =>
+        simp only [hext, Option.map_some, Option.some.injEq] at hfs
+        subst fs
+        refine ⟨a, rs, ha, hrs, ?_⟩
+        intro limit base ctx call args hib hl ht hd
+        let modelCtx := {ctx with M := FrontendF32Comparison.model base}
+        let sem := FrontendMaskRuntime.sem limit
+        have hb : FrontendRuntimeBridge.blocksCheck s.preBody.blocks = true ∧
+            FrontendRuntimeBridge.blocksCheck s.tailBody.blocks = true := by
+          simpa only [Scope.preBody, Scope.tailBody, FrontendRuntimeBridge.regions,
+            Region.blocks, Bool.and_true, Bool.and_eq_true] using hbridge
+        obtain ⟨observations, hpreEval, hpreFacts⟩ := FrontendRangeFrame.inferRegion_sound
+          (ctx := modelCtx) (call := call) (env := []) (FrontendRangeDefined.frameBook 64 []) hpre hib
+          (.inl rfl) (by intro _ _ h; cases h) (Definedness.Refined.inputFacts model ht hd)
+        have hf := FrontendRangeFacts.fits_sound hpreFits hpreFacts
+        have he := (FrontendProgramFrames.region_eq limit modelCtx call [] s.preBody args hb.1).trans hpreEval
+        cases hbind : Env.bindAll [] s.selection.p.cut.block.args args with
+        | ub => simp [Scope.preBody, evalRegion, evalBlocks, evalBlock, hbind] at he
+        | stuck why => simp [Scope.preBody, evalRegion, evalBlocks, evalBlock, hbind] at he
+        | ok initial =>
+          simp only [Scope.preBody, evalRegion, evalBlocks, evalBlock, hbind, Outcome.bind_ok] at he
+          obtain ⟨middle, hprefix, hread⟩ := prefix_state
+            (fun op hop => by simpa using List.all_eq_true.mp hpreNon op hop) he
+          have hΓ := FrontendProgramFrames.of_getAll middle _ observations _ hread hf
+          obtain ⟨mask, values, seed, extraValues, rfl, hm, hv, hs, _⟩ := roots hf
+          have hroots : middle.getAll [s.selection.mask.id,s.selection.values.id,s.selection.seed.id] =
+              .ok [.tensor mask,.tensor values,.tensor seed] := by
+            have h := FrontendProgramFrames.getAll_take middle _ _ hread 3
+            simpa only [Scope.observed, s.selection.roots, List.map_append, List.map_cons, List.map_nil,
+              List.cons_append, List.nil_append, List.take_succ_cons, List.take_zero] using h
+          obtain ⟨selectedValues, hselected, hselectedFacts⟩ := selection s
+            (base := base) (ctx := ctx) (call := call) hm hv hs hib hl hroots hcut
+          simp only [FrontendRuntimeCheckpoint.Scope.bare, evalRegion, evalBlocks, evalBlock,
+            Env.bindAll, List.length_nil, ↓reduceIte, List.map_nil, List.zip_nil_left,
+            List.nil_append, Outcome.bind_ok] at hselected
+          obtain ⟨afterSelection, hexec, hselectedRead⟩ := prefix_state
+            (fun op hop => by simpa using List.all_eq_true.mp hselNon op hop) hselected
+          have hkept := FrontendProgramFrames.exec_preserves s.selection.p.cut.selected middle afterSelection hΓ
+            (fun op hop => by simpa using List.all_eq_true.mp hselNon op hop) hpreserve hexec
+          have hnew := FrontendProgramFrames.of_getAll afterSelection _ selectedValues _ hselectedRead hselectedFacts
+          have hpost := FrontendProgramFrames.append hnew hkept
+          obtain ⟨results, hresult, hresultFacts⟩ := FrontendRangeFrame.inferRegion_sound
+            (ctx := modelCtx) (call := call) (env := afterSelection)
+            (FrontendRangeDefined.frameBook 64 []) htail hib (.inl rfl) hpost List.Forall₂.nil
+          have htailEval := (FrontendProgramFrames.region_eq limit modelCtx call afterSelection s.tailBody [] hb.2).trans hresult
+          simp only [Scope.tailBody, evalRegion, evalBlocks, evalBlock, Env.bindAll,
+            List.length_nil, ↓reduceIte, List.map_nil, List.zip_nil_left, List.nil_append, Outcome.bind_ok] at htailEval
+          refine ⟨results, ?_, FrontendRangeFacts.fits_sound htailFits hresultFacts⟩
+          rw [s.body_segments]
+          simp only [evalRegion, evalBlocks, evalBlock, hbind, Outcome.bind_ok, List.append_assoc]
+          rw [evalOps_append sem modelCtx call initial _ _
+            (fun op hop => by simpa using List.all_eq_true.mp hpreNon op hop), hprefix, Outcome.bind_ok]
+          rw [evalOps_append sem modelCtx call middle _ _
+            (fun op hop => by simpa using List.all_eq_true.mp hselNon op hop), hexec, Outcome.bind_ok]
+          exact htailEval
+    · cases h
+  · cases h
+
+theorem check_sound {m : Module} {name : String} {stop count : Nat}
+    (h : FrontendPositionScope.check m name stop count = true) :
+    ∃ s : Scope m name stop count, FrontendPositionScope.project? m name stop count = some s ∧ s.Executes := by
+  unfold FrontendPositionScope.check at h
+  split at h
+  · next s hs => exact ⟨s, hs, scope_sound s h⟩
+  · cases h
+
+#print axioms scope_sound
+#print axioms check_sound
+
+#print axioms selection
+end MerlinVerify.Rules.FrontendPositionExecution
diff --git a/merlin/lean/MerlinVerify/Rules/FrontendPositionScope.lean b/merlin/lean/MerlinVerify/Rules/FrontendPositionScope.lean
new file mode 100644
index 000000000..7717b586f
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/FrontendPositionScope.lean
@@ -0,0 +1,111 @@
+/- A checked continuation after actual mask selection. Every slice, observation,
+extra capture and type is recomputed from the original exported function. -/
+import MerlinVerify.Rules.FrontendRuntimeCheckpoint
+import MerlinVerify.Rules.FrontendPrefixRanges
+import MerlinVerify.Rules.FrontendProgramFrames
+import MerlinVerify.Rules.FrontendRangeProjection
+
+namespace MerlinVerify.Rules.FrontendPositionScope
+open MerlinVerify MerlinVerify.Check
+open FrontendTensorRanges FrontendProgramSegments
+
+structure Scope (m : Module) (name : String) (stop count : Nat) where
+  selection : FrontendRuntimeCheckpoint.Scope m name stop
+  extras : List Value
+
+def Scope.tail {m : Module} {name : String} {stop count : Nat} (s : Scope m name stop count) : List Op :=
+  (s.selection.p.cut.block.ops.drop (stop + 25)).take count
+
+def Scope.outputs {m : Module} {name : String} {stop count : Nat} (s : Scope m name stop count) : List Value :=
+  s.selection.p.cut.outputs ++ ((s.tail.getLast?).map (·.results)).getD []
+
+def Scope.observed {m : Module} {name : String} {stop count : Nat} (s : Scope m name stop count) : List Value :=
+  s.selection.p.cut.args ++ s.extras
+
+def Scope.preBody {m : Module} {name : String} {stop count : Nat} (s : Scope m name stop count) : Region :=
+  .mk [.mk s.selection.p.cut.block.args ((s.selection.p.cut.block.ops.take stop) ++
+    [returned (s.observed.map (·.id))])]
+
+def Scope.tailBody {m : Module} {name : String} {stop count : Nat} (s : Scope m name stop count) : Region :=
+  .mk [.mk [] (s.tail ++ [returned (s.outputs.map (·.id))])]
+
+def Scope.body {m : Module} {name : String} {stop count : Nat} (s : Scope m name stop count) : Region :=
+  .mk [.mk s.selection.p.cut.block.args ((s.selection.p.cut.block.ops.take (stop + 25 + count)) ++
+    [returned (s.outputs.map (·.id))])]
+
+/-- The execution proof composes exactly these source operations; no embedding operation is skipped. -/
+theorem Scope.body_segments {m : Module} {name : String} {stop count : Nat} (s : Scope m name stop count) :
+    s.body = .mk [.mk s.selection.p.cut.block.args ((s.selection.p.cut.block.ops.take stop) ++
+      s.selection.p.cut.selected ++ s.tail ++ [returned (s.outputs.map (·.id))])] := by
+  simp only [Scope.body, Scope.tail, s.selection.p.cut.slice, ← List.take_add]
+
+
+def selectedFacts : List Fact :=
+  [⟨⟨.tensor [1,1024] (.int 64), true⟩, some ⟨0,1024⟩⟩, ⟨⟨.scalar .index, true⟩, none⟩]
+
+def Scope.preFacts? {m : Module} {name : String} {stop count : Nat} (s : Scope m name stop count) :
+    Option (List Fact) :=
+  (s.extras.mapM fun v => vtyOf 64 v.ty).map fun ts =>
+    FrontendPrefixRanges.expected 1024 ++ ts.map (fun ty => Definedness.Refined.emptyFact model ⟨ty,true⟩)
+
+def Scope.resultFacts? {m : Module} {name : String} {stop count : Nat} (s : Scope m name stop count) :
+    Option (List Fact) :=
+  (((s.tail.getLast?).map (·.results)).getD []).mapM (fun v => vtyOf 64 v.ty) |>.map fun ts =>
+    selectedFacts ++ ts.map (fun ty => Definedness.Refined.emptyFact model ⟨ty,true⟩)
+
+def Scope.preEnv {m : Module} {name : String} {stop count : Nat} (s : Scope m name stop count) (fs : List Fact) : FEnv :=
+  (s.observed.map (·.id)).zip fs
+
+def Scope.postEnv {m : Module} {name : String} {stop count : Nat} (s : Scope m name stop count) (fs : List Fact) : FEnv :=
+  (s.selection.p.cut.outputs.map (·.id)).zip selectedFacts ++ s.preEnv fs
+
+
+def project? (m : Module) (name : String) (stop count : Nat) : Option (Scope m name stop count) := do
+  let selection ← FrontendRuntimeCheckpoint.project? m name stop
+  let tail := (selection.p.cut.block.ops.drop (stop + 25)).take count
+  if count = 0 ∨ tail.length ≠ count then none else do
+    let localDefs ← FrontendBoolProgram.defsOps 64 tail
+    let allDefs ← FrontendBoolProgram.defsOps 64 m.ops
+    let types := FrontendBoolProgram.sourceTypes allDefs
+    let outputs := selection.p.cut.outputs ++ ((tail.getLast?).map (·.results)).getD []
+    let uses := FrontendRangeProjection.operands (tail ++ [returned (outputs.map (·.id))])
+    let free := (uses.filter fun id => !(localDefs.any (fun v => v.id == id))).eraseDups
+    let old := (selection.p.cut.args ++ selection.p.cut.outputs).map (·.id)
+    let extras ← (free.filter fun id => !old.contains id).mapM fun id => do
+      let ty ← types.lookup id
+      pure ({id := id, ty := ty} : Value)
+    pure ⟨selection, extras⟩
+
+def Scope.Executes {m : Module} {name : String} {stop count : Nat} (s : Scope m name stop count) : Prop :=
+  ∃ a rs, s.selection.p.cut.block.args.mapM (fun v => vtyOf 64 v.ty) = some a ∧
+    s.resultFacts? = some rs ∧
+    ∀ (limit : Nat) (base : FloatModel) (ctx : Ctx) (call : CallSem) (args : List RVal),
+      ctx.indexBits = 64 → 1024 ≤ limit → HasTys 64 args a → ResultsDefined args →
+      ∃ results, evalRegion (FrontendMaskRuntime.sem limit) {ctx with M := FrontendF32Comparison.model base}
+        call [] s.body args = .ok results ∧ Definedness.Refined.FactsHold model 64 results rs
+
+/-- The prefix establishes every fact used by the continuation; selected operations
+must preserve those exact captured SSA bindings. No range is assumed at a cut input. -/
+def Scope.check {m : Module} {name : String} {stop count : Nat} (s : Scope m name stop count) : Bool :=
+  FrontendMaskWhole.check s.selection.p.cut.program &&
+  FrontendBoolSimulation.region [] [(50,s.selection.mask.id),(51,s.selection.values.id),(52,s.selection.seed.id)]
+    FrontendRuntimeCheckpoint.bareSource s.selection.bare &&
+  (s.selection.p.cut.block.ops.take stop).all (fun op => !op.isTerminator) &&
+  s.selection.p.cut.selected.all (fun op => !op.isTerminator) &&
+  s.tail.all (fun op => !op.isTerminator) &&
+  FrontendRuntimeBridge.regions [s.preBody, s.tailBody] &&
+  match s.selection.p.cut.block.args.mapM (fun v => vtyOf 64 v.ty), s.preFacts?, s.resultFacts? with
+  | some a, some fs, some rs =>
+    match FrontendRangeFrame.inferRegion (FrontendRangeDefined.frameBook 64 []) [] s.preBody
+        (a.map fun ty => Definedness.Refined.emptyFact model ⟨ty,true⟩),
+      FrontendRangeFrame.inferRegion (FrontendRangeDefined.frameBook 64 []) (s.postEnv fs) s.tailBody [] with
+    | some prefixFacts, some resultFacts =>
+      FrontendRangeFacts.fits prefixFacts fs &&
+      s.selection.p.cut.selected.all (FrontendProgramFrames.preserves (s.preEnv fs)) &&
+      FrontendRangeFacts.fits resultFacts rs
+    | _, _ => false
+  | _, _, _ => false
+
+def check (m : Module) (name : String) (stop count : Nat) : Bool :=
+  match project? m name stop count with | some s => s.check | none => false
+end MerlinVerify.Rules.FrontendPositionScope
diff --git a/merlin/lean/MerlinVerify/Rules/FrontendPositionVerification.lean b/merlin/lean/MerlinVerify/Rules/FrontendPositionVerification.lean
new file mode 100644
index 000000000..ebee89568
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/FrontendPositionVerification.lean
@@ -0,0 +1,57 @@
+/- Before/after program execution against A2's source-only repair policy,
+including the actual position embedding and attention-mask continuation. -/
+import MerlinVerify.Rules.FrontendPositionExecution
+
+namespace MerlinVerify.Rules.FrontendPositionVerification
+open MerlinVerify MerlinVerify.Check FrontendPositionScope
+open FrontendTensorRanges
+
+/-- The source policy is applied to the actual original region. The target's
+initialized execution is proved independently from its actual SSA producers. -/
+def checkpoint (src tgt : Module) (name : String) (stop count : Nat) : Bool :=
+  match FrontendBoolProgram.defsOps 64 src.ops, project? src name stop count, project? tgt name stop count with
+  | some defs, some s, some t => t.check &&
+      FrontendBoolSimulation.region (FrontendBoolProgram.sourceTypes defs) [] s.body t.body
+  | _, _, _ => false
+
+def check (src tgt : Module) (name : String) (stop count : Nat) : Bool :=
+  FrontendBoolSimulation.check src tgt && checkpoint src tgt name stop count
+
+/-- Acceptance connects execution of both actual initial segments to the approved
+frontend repair policy. It does not assert ordinary equivalence to the raw fptosi source. -/
+theorem check_sound {src tgt : Module} {name : String} {stop count : Nat}
+    (h : check src tgt name stop count = true) :
+    FrontendBoolSimulation.check src tgt = true ∧
+    ∃ defs, ∃ (s : Scope src name stop count) (t : Scope tgt name stop count), ∃ a rs,
+      FrontendBoolProgram.defsOps 64 src.ops = some defs ∧
+      project? src name stop count = some s ∧ project? tgt name stop count = some t ∧
+      t.selection.p.cut.block.args.mapM (fun v => vtyOf 64 v.ty) = some a ∧ t.resultFacts? = some rs ∧
+      ∀ (limit : Nat) (base : FloatModel) (ctx : Ctx) (call : CallSem) (args : List RVal),
+        ctx.indexBits = 64 → 1024 ≤ limit → HasTys 64 args a → ResultsDefined args →
+        ∃ results,
+          evalRegion (FrontendMaskRuntime.sem limit) {ctx with M := FrontendF32Comparison.model base}
+            call [] t.body args = .ok results ∧
+          evalRegion (FrontendBoolSimulationWith.policySem (FrontendMaskRuntime.sem limit)
+              (FrontendBoolProgram.sourceTypes defs)) {ctx with M := FrontendF32Comparison.model base}
+            call [] s.body args = .ok results ∧
+          Definedness.Refined.FactsHold model 64 results rs := by
+  unfold check checkpoint at h
+  simp only [Bool.and_eq_true] at h
+  refine ⟨h.1, ?_⟩
+  rcases h with ⟨_, h⟩
+  split at h
+  · next defs s t hdefs hs ht =>
+    simp only [Bool.and_eq_true] at h
+    obtain ⟨a, rs, ha, hr, hexec⟩ := FrontendPositionExecution.scope_sound t h.1
+    refine ⟨defs, s, t, a, rs, hdefs, hs, ht, ha, hr, ?_⟩
+    intro limit base ctx call args hib hl hty hd
+    obtain ⟨results, hv, hf⟩ := hexec limit base ctx call args hib hl hty hd
+    have he := FrontendBoolSimulationWith.region_sound (FrontendMaskRuntime.sem limit)
+      (FrontendBoolSimulationWith.candidateLaws limit) _ call [] s.body t.body
+      {ctx with M := FrontendF32Comparison.model base} [] [] h.2
+      (FrontendF32Comparison.model_correct base) (by intro x y hxy; simp [Rho.find] at hxy)
+    exact ⟨results, hv, (congrFun he args).trans hv, hf⟩
+  · cases h
+
+#print axioms check_sound
+end MerlinVerify.Rules.FrontendPositionVerification
diff --git a/merlin/lean/MerlinVerify/Rules/FrontendPrefixRanges.lean b/merlin/lean/MerlinVerify/Rules/FrontendPrefixRanges.lean
new file mode 100644
index 000000000..10685f5f8
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/FrontendPrefixRanges.lean
@@ -0,0 +1,66 @@
+/- Actual-prefix position bounds under the existing candidate interpretation.
+Inputs receive only their declared types and initialization, never range annotations. -/
+import MerlinVerify.Rules.FrontendRangeDefined
+import MerlinVerify.Rules.FrontendRangeFacts
+import MerlinVerify.Rules.FrontendPrefixProjection
+
+namespace MerlinVerify.Rules.FrontendPrefixRanges
+open MerlinVerify MerlinVerify.Check
+open FrontendTensorRanges
+
+def expected (upper : Nat) : List Fact :=
+  [⟨⟨.tensor [1,32,32] (.int 1), true⟩, none⟩,
+   ⟨⟨.tensor [1,1024] (.int 64), true⟩, some ⟨0,upper⟩⟩,
+   ⟨⟨.tensor [1,1024] (.int 64), true⟩, some ⟨0,upper⟩⟩]
+
+def check (m : Module) (name : String) (stop upper : Nat) : Bool :=
+  match FrontendPrefixProjection.project? m name stop with
+  | none => false
+  | some p =>
+    match p.cut.block.args.mapM (fun v => vtyOf 64 v.ty) with
+    | none => false
+    | some a => FrontendRuntimeBridge.regions [p.body] &&
+      (p.cut.block.ops.take stop).all (fun op => !op.isTerminator) &&
+      match FrontendRangeFrame.inferRegion (FrontendRangeDefined.frameBook 64 []) [] p.body
+        (a.map fun ty => Definedness.Refined.emptyFact model ⟨ty,true⟩) with
+      | some inferred => FrontendRangeFacts.fits inferred (expected upper)
+      | none => false
+
+/-- Acceptance proves actual prefix execution and the requested bounds from
+ordinary initialized function inputs, without assuming any intermediate value bound. -/
+theorem check_sound {m : Module} {name : String} {stop upper : Nat}
+    (h : check m name stop upper = true) :
+    ∃ p : FrontendPrefixProjection.Prefix m name stop,
+      FrontendPrefixProjection.project? m name stop = some p ∧
+      ∃ a, p.cut.block.args.mapM (fun v => vtyOf 64 v.ty) = some a ∧
+      ∀ (limit : Nat) (ctx : Ctx) (call : CallSem) (args : List RVal), ctx.indexBits = 64 →
+        HasTys 64 args a → ResultsDefined args →
+        ∃ values, evalRegion (FrontendMaskRuntime.sem limit) ctx call [] p.body args = .ok values ∧
+          Definedness.Refined.FactsHold model 64 values (expected upper) := by
+  unfold check at h
+  split at h
+  · cases h
+  · next p hp =>
+    split at h
+    · cases h
+    · next a ha =>
+      simp only [Bool.and_eq_true] at h
+      obtain ⟨⟨hbridge, _⟩, h⟩ := h
+      split at h
+      · next inferred hinfer =>
+        refine ⟨p, hp, a, ha, ?_⟩
+        intro limit ctx call args hib ht hd
+        obtain ⟨values, hv, hf⟩ := FrontendRangeFrame.inferRegion_sound
+          (ctx := ctx) (call := call) (env := []) (FrontendRangeDefined.frameBook 64 []) hinfer hib
+          (.inl rfl) (by intro _ _ h; cases h) (Definedness.Refined.inputFacts model ht hd)
+        have hb : FrontendRuntimeBridge.blocksCheck p.body.blocks = true := by
+          simpa only [FrontendPrefixProjection.Prefix.body, FrontendRuntimeBridge.regions,
+            Region.blocks, Bool.and_true] using hbridge
+        have he := FrontendRuntimeBridge.blocks_sound limit ctx call [] p.body.blocks args hb
+        change evalRegion (FrontendMaskRuntime.sem limit) ctx call [] p.body args =
+          evalRegion Sem.Ops.opSem ctx call [] p.body args at he
+        exact ⟨values, he.trans hv, FrontendRangeFacts.fits_sound h hf⟩
+      · cases h
+
+#print axioms check_sound
+end MerlinVerify.Rules.FrontendPrefixRanges
diff --git a/merlin/lean/MerlinVerify/Rules/FrontendProgramFrames.lean b/merlin/lean/MerlinVerify/Rules/FrontendProgramFrames.lean
new file mode 100644
index 000000000..ccabb1c5d
--- /dev/null
+++ b/merlin/lean/MerlinVerify/Rules/FrontendProgramFrames.lean
@@ -0,0 +1,116 @@
+/- Intermediate SSA facts and unchanged captures across an actual operation segment. -/
+import MerlinVerify.Rules.FrontendRangeFacts
+import MerlinVerify.Rules.Dce
+
+namespace MerlinVerify.Rules.FrontendProgramFrames
+open MerlinVerify MerlinVerify.Check
+open FrontendTensorRanges
+
+theorem getAll_cons (env : Env) (x : ValueId) (xs : List ValueId) :
+    env.getAll (x :: xs) = (Outcome.ofOption "unbound SSA value" (env.get? x)).bind fun v =>
+      (env.getAll xs).bind fun vs => .ok (v :: vs) := rfl
+
+/-- Facts learned from actual returned SSA values hold in that same intermediate environment. -/
+theorem of_getAll {ib : Nat} (env : Env) : ∀ ids vs fs,
+    env.getAll ids = .ok vs → Definedness.Refined.FactsHold model ib vs fs →
+    Definedness.Refined.EnvHolds model ib (ids.zip fs) env
+  | [], vs, fs, h, hf => by
+    cases h
+    cases hf
+    intro _ _ h; cases h
+  | x :: xs, vs, fs, h, hf => by
+    rw [getAll_cons] at h
+    cases hx : env.get? x with
+    | none => simp [hx, Outcome.ofOption, Outcome.bind] at h
+    | some v =>
+      simp only [hx, Outcome.ofOption, Outcome.bind_ok] at h
+      cases hxs : env.getAll xs with
+      | ub => rw [hxs] at h; cases h
+      | stuck why => rw [hxs] at h; cases h
+      | ok vals =>
+        rw [hxs] at h
+        cases h
+        obtain _ | ⟨hv, hrest⟩ := hf
+        have ih := of_getAll env xs vals _ hxs hrest
+        intro y f hy
+        simp only [List.zip_cons_cons, List.lookup] at hy
+        split at hy
+        · next heq =>
+          have heq' : y = x := beq_iff_eq.mp heq
+          subst y
+          cases hy
+          exact ⟨v, hx, hv⟩
+        · exact ih y f hy
+
+def preserves (Γ : FEnv) (op : Op) : Bool := op.results.all fun v => (Γ.lookup v.id).isNone
+
+theorem step_preserves {ib : Nat} {Γ : FEnv} {sem : OpSem} {ctx : Ctx} {call : CallSem}
+    {env next : Env} {op : Op} (hΓ : Definedness.Refined.EnvHolds model ib Γ env)
+    (hp : preserves Γ op = true) (he : stepOp sem ctx call env op = .ok next) :
+    Definedness.Refined.EnvHolds model ib Γ next := by
+  obtain ⟨vs, rfl⟩ := Dce.stepOp_ok_form he
+  intro x f hx
+  obtain ⟨v, hv, hf⟩ := hΓ x f hx
+  refine ⟨v, ?_, hf⟩
+  have hn : x ∉ op.results.map (·.id) := by
+    intro hmem
+    obtain ⟨r, hr, heq⟩ := List.mem_map.mp hmem
+    have hnone := List.all_eq_true.mp hp r hr
+    rw [heq, hx] at hnone
+    cases hnone
+  simpa only [Env.get?, Dce.lookup_zip_append_not_mem x _ vs env hn] using hv
+
+theorem exec_preserves {ib : Nat} {Γ : FEnv} {sem : OpSem} {ctx : Ctx} {call : CallSem} :
+    ∀ ops env next, Definedness.Refined.EnvHolds model ib Γ env →
+      (∀ op ∈ ops, op.isTerminator = false) → ops.all (preserves Γ) = true →
+      execOps sem ctx call env ops = .ok next → Definedness.Refined.EnvHolds model ib Γ next
+  | [], env, next, hΓ, _, _, he => by cases he; exact hΓ
+  | op :: ops, env, next, hΓ, hn, hp, he => by
+    rw [execOps_cons_step sem ctx call env op ops (hn op (List.mem_cons_self ..))] at he
+    cases hs : stepOp sem ctx call env op with
+    | ub => simp [hs, Outcome.bind] at he
+    | stuck why => simp [hs, Outcome.bind] at he
+    | ok mid =>
+      simp only [List.all_cons, Bool.and_eq_true] at hp
+      simp only [hs, Outcome.bind_ok] at he
+      exact exec_preserves ops mid next (step_preserves hΓ hp.1 hs)
+        (fun op hmem => hn op (List.mem_cons_of_mem _ hmem)) hp.2 he
+
+/-- Taking a prefix of an actual multi-value observation preserves the read proof. -/
+theorem getAll_take (env : Env) : ∀ ids vs, env.getAll ids = .ok vs → ∀ n,
+    env.getAll (ids.take n) = .ok (vs.take n)
+  | ids, vs, h, 0 => rfl
+  | [], vs, h, _ + 1 => by cases h; rfl
+  | x :: xs, vs, h, n + 1 => by
+    rw [getAll_cons] at h
+    cases hx : env.get? x with
+    | none => simp [hx, Outcome.ofOption, Outcome.bind] at h
+    | some v =>
+      simp only [hx, Outcome.ofOption, Outcome.bind_ok] at h
+      cases hxs : env.getAll xs with
+      | ub => rw [hxs] at h; cases h
+      | stuck why => rw [hxs] at h; cases h
+      | ok vals =>
+        rw [hxs] at h
+        cases h
+        have ih := getAll_take env xs vals hxs n
+        simp only [List.take_succ_cons, getAll_cons, hx, Outcome.ofOption, Outcome.bind_ok, ih]
+
+theorem append {ib : Nat} {Γ Δ : FEnv} {env : Env}
+    (hΓ : Definedness.Refined.EnvHolds model ib Γ env) (hΔ : Definedness.Refined.EnvHolds model ib Δ env) :
+    Definedness.Refined.EnvHolds model ib (Γ ++ Δ) env := by
+  intro x f hx
+  rw [List.lookup_append] at hx
+  cases hh : Γ.lookup x with
+  | some g => simp only [hh, Option.or, Option.some.injEq] at hx; subst f; exact hΓ x g hh
+  | none => simp only [hh, Option.or] at hx; exact hΔ x f hx
+
+theorem region_eq (limit : Nat) (ctx : Ctx) (call : CallSem) (env : Env) (r : Region)
+    (args : List RVal) (h : FrontendRuntimeBridge.blocksCheck r.blocks = true) :
+    evalRegion (FrontendMaskRuntime.sem limit) ctx call env r args =
+      evalRegion Sem.Ops.opSem ctx call env r args := by
+  cases r with
+  | mk blocks => exact FrontendRuntimeBridge.blocks_sound limit ctx call env blocks args h
+
+#print axioms exec_preserves
+end MerlinVerify.Rules.FrontendProgramFrames
diff --git a/merlin/lean/MerlinVerify/Rules/FrontendRangeDefined.lean b/merlin/lean/MerlinVerify/Rules/FrontendRangeDefined.lean
