+    if change == "wrong-use":
+        before = before.replace("return %a, %b", "%c = arith.constant 8 : i64\nreturn %a, %c")
+    elif change == "non-adjacent":
+        before = before.replace("%b =", "%c = arith.constant 8 : i64\n%b =")
