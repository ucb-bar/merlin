--- /dev/null
+++ b/src/merlin/verify/lean/Merlin/GraphStateIntegerCountermodels.lean
@@ -0,0 +1,77 @@
+/- Preserved countermodels for omitting entry/value-result/pure-primitive
+contracts. These are limitations of the theorem domain, not a pass refutation
+on initialized canonical words with the disclosed exact local interpretation. -/
+import Merlin.GraphStateIntegerOperations
+
+namespace Merlin.GraphState.Integer.Countermodels
+set_option autoImplicit false
+open Scalar
+
+def base : Model Int Nat Int [] where
+  default := 0
+  primitive := Integer.primitive
+  index := id
+  iterations := fun _ _ _ => []
+  effect := fun _ _ world => .ok ([],world)
+  arity := by intro identity arguments world values final success; cases success; simp [signature]
+
+def addZero : Program := .pure (.constant 8 0) [] (.pure (.add 8) [1,0] (.ret [0]))
+def unchanged : Program := .ret [0]
+
+theorem noncanonical_entry_refutes_neutral_deletion :
+    evalProgram base addZero [256] 7 ≠ evalProgram base unchanged [256] 7 := by
+  intro same
+  have outputs : (([0],7) : List Int × Nat) = ([256],7) := Except.ok.inj same
+  have impossible : (0 : Int) = 256 := congrArg (fun result => result.1.headD 0) outputs
+  omega
+
+theorem entry_really_noncanonical : ¬ Canonical (.bits 8) 256 := by
+  change (0 : Int) ≠ 256
+  decide
+
+def wrongPrimitive : Model Int Nat Int [] := {base with primitive := fun _ _ => 7}
+
+theorem missing_primitive_contract_refutes_deletion :
+    evalProgram wrongPrimitive addZero [5] 7 ≠ evalProgram wrongPrimitive unchanged [5] 7 := by
+  intro same
+  have outputs : (([7],7) : List Int × Nat) = ([5],7) := Except.ok.inj same
+  have impossible : (7 : Int) = 5 := congrArg (fun result => result.1.headD 0) outputs
+  omega
+
+def registry : List Signature := [{inputs := [],outputs := [.bits 8]}]
+def noncanonicalProvider : Model Int Nat Int registry where
+  default := 0
+  primitive := Integer.primitive
+  index := id
+  iterations := fun _ _ _ => []
+  effect := fun identity _ world => .ok ((signature registry identity).outputs.map (fun _ => 256),world+1)
+  arity := by intro identity arguments world values final success; cases success; simp only [List.length_map]
+
+def withProvider : Program := .opaque 0 [] [.bits 8] addZero
+def liftedProvider : Program := .opaque 0 [] [.bits 8] unchanged
+
+theorem provider_programs_statically_typed :
+    checkTypes registry [] [.bits 8] withProvider = true ∧
+    checkTypes registry [] [.bits 8] liftedProvider = true := by decide
+
+theorem missing_local_result_contract_refutes_deletion :
+    evalProgram noncanonicalProvider withProvider [] 7 ≠ evalProgram noncanonicalProvider liftedProvider [] 7 := by
+  intro same
+  have outputs : (([0],8) : List Int × Nat) = ([256],8) := Except.ok.inj same
+  have impossible : (0 : Int) = 256 := congrArg (fun result => result.1.headD 0) outputs
+  omega
+
+/-- A physical arithmetic instruction with a hidden world update cannot be
+represented by the total STATE-FREE Scalar primitive field. Removing it would
+change the observed world even when its word result is correct. -/
+theorem hidden_effect_countermodel :
+    (Except.ok ([5],8) : Outcome Int Nat Int) ≠ .ok ([5],7) := by
+  intro same
+  have impossible : (8 : Nat) = 7 := congrArg Prod.snd (Except.ok.inj same)
+  omega
+
+#print axioms noncanonical_entry_refutes_neutral_deletion
+#print axioms missing_local_result_contract_refutes_deletion
+#print axioms missing_primitive_contract_refutes_deletion
+#print axioms hidden_effect_countermodel
+end Merlin.GraphState.Integer.Countermodels
diff --git a/src/merlin/verify/lean/Merlin/GraphStateIntegerExpressions.lean b/src/merlin/verify/lean/Merlin/GraphStateIntegerExpressions.lean
new file mode 100644
--- /dev/null
+++ b/src/merlin/verify/lean/Merlin/GraphStateIntegerExpressions.lean
@@ -0,0 +1,158 @@
+/- Kernel-checked local integer rewrite sequences over the existing Scalar.Expr.
+Every neutral deletion requires the actual retained expression's runtime word
+type. Python may propose a sequence; only the following proved rules accept it. -/
+import Merlin.GraphStateIntegerOperations
+
+namespace Merlin.GraphState.Integer
+set_option autoImplicit false
+open Scalar
+
+inductive ExprTyped (environment : List Ty) : Expr → Ty → Prop where
+  | var {index : Nat} {type : Ty} (found : environment[index]? = some type) :
+      ExprTyped environment (.var index) type
+  | zero {op : Prim} (valid : op.valid = true) (arity : op.inputs = []) :
+      ExprTyped environment (.zero op) op.output
+  | one {op : Prim} {argument : Expr} {type : Ty}
+      (valid : op.valid = true) (arity : op.inputs = [type])
+      (operand : ExprTyped environment argument type) :
+      ExprTyped environment (.one op argument) op.output
+  | two {op : Prim} {left right : Expr} {first second : Ty}
+      (valid : op.valid = true) (arity : op.inputs = [first,second])
+      (lhs : ExprTyped environment left first) (rhs : ExprTyped environment right second) :
+      ExprTyped environment (.two op left right) op.output
+
+theorem ExprTyped.canonical {environment : List Ty} {expression : Expr} {type : Ty}
+    (typed : ExprTyped environment expression type) (values : List Int)
+    (entry : Values Canonical environment values) :
+    Canonical type (evalExpr 0 primitive values expression) := by
+  cases typed with
+  | var found => exact entry.lookup found 0
+  | zero valid arity => exact primitive_canonical _ _
+  | one valid arity operand => exact primitive_canonical _ _
+  | two valid arity lhs rhs => exact primitive_canonical _ _
+
+inductive ExprsTyped (environment : List Ty) : List Expr → List Ty → Prop where
+  | nil : ExprsTyped environment [] []
+  | cons {head : Expr} {tail : List Expr} {type : Ty} {types : List Ty}
+      (first : ExprTyped environment head type) (rest : ExprsTyped environment tail types) :
+      ExprsTyped environment (head::tail) (type::types)
+
+theorem ExprsTyped.canonical {environment types : List Ty} {expressions : List Expr}
+    (typed : ExprsTyped environment expressions types) (values : List Int)
+    (entry : Values Canonical environment values) :
+    Values Canonical types (expressions.map (evalExpr 0 primitive values)) := by
+  induction typed with
+  | nil => exact .nil
+  | cons first rest ih => exact .cons (first.canonical values entry) ih
+
+def Same (environment : List Ty) (first second : Expr) : Prop :=
+  ∀ values, Values Canonical environment values →
+    evalExpr 0 primitive values first = evalExpr 0 primitive values second
+
+theorem Same.refl (environment : List Ty) (expression : Expr) : Same environment expression expression :=
+  fun _ _ => rfl
+
+theorem Same.symm {environment : List Ty} {first second : Expr} (same : Same environment first second) :
+    Same environment second first := fun values entry => (same values entry).symm
+
+theorem Same.trans {environment : List Ty} {first middle last : Expr}
+    (left : Same environment first middle) (right : Same environment middle last) :
+    Same environment first last := fun values entry => (left values entry).trans (right values entry)
+
+theorem Same.one {environment : List Ty} {first second : Expr} (op : Prim)
+    (same : Same environment first second) : Same environment (.one op first) (.one op second) := by
+  intro values entry
+  simp only [evalExpr,same values entry]
+
+theorem Same.two {environment : List Ty} {first second left right : Expr} (op : Prim)
+    (lhs : Same environment first second) (rhs : Same environment left right) :
+    Same environment (.two op first left) (.two op second right) := by
+  intro values entry
+  simp only [evalExpr,lhs values entry,rhs values entry]
+
+theorem Same.constant (environment : List Ty) (width : Nat) (first second : Int)
+    (bits : word width first = word width second) :
+    Same environment (.zero (.constant width first)) (.zero (.constant width second)) := by
+  intro values entry
+  exact bits
+
+theorem Same.fold_add (environment : List Ty) (width : Nat) (first second result : Int)
+    (bits : word width (first+second) = word width result) :
+    Same environment (.two (.add width) (.zero (.constant width first)) (.zero (.constant width second)))
+      (.zero (.constant width result)) := by
+  intro values entry
+  exact (word_add width first second).trans bits
+
+theorem Same.fold_sub (environment : List Ty) (width : Nat) (first second result : Int)
+    (bits : word width (first-second) = word width result) :
+    Same environment (.two (.sub width) (.zero (.constant width first)) (.zero (.constant width second)))
+      (.zero (.constant width result)) := by
+  intro values entry
+  exact (word_sub width first second).trans bits
+
+theorem Same.fold_mul (environment : List Ty) (width : Nat) (first second result : Int)
+    (bits : word width (first*second) = word width result) :
+    Same environment (.two (.mul width) (.zero (.constant width first)) (.zero (.constant width second)))
+      (.zero (.constant width result)) := by
+  intro values entry
+  exact (word_mul width first second).trans bits
+
+theorem Same.add_zero {environment : List Ty} {value : Expr} (width : Nat)
+    (typed : ExprTyped environment value (.bits width)) :
+    Same environment (.two (.add width) value (.zero (.constant width 0))) value := by
+  intro values entry
+  exact Integer.add_zero width _ (typed.canonical values entry)
+
+theorem Same.zero_add {environment : List Ty} {value : Expr} (width : Nat)
+    (typed : ExprTyped environment value (.bits width)) :
+    Same environment (.two (.add width) (.zero (.constant width 0)) value) value := by
+  intro values entry
+  exact Integer.zero_add width _ (typed.canonical values entry)
+
+theorem Same.sub_zero {environment : List Ty} {value : Expr} (width : Nat)
+    (typed : ExprTyped environment value (.bits width)) :
+    Same environment (.two (.sub width) value (.zero (.constant width 0))) value := by
+  intro values entry
+  exact Integer.sub_zero width _ (typed.canonical values entry)
+
+theorem Same.mul_one {environment : List Ty} {value : Expr} (width : Nat)
+    (typed : ExprTyped environment value (.bits width)) :
+    Same environment (.two (.mul width) value (.zero (.constant width 1))) value := by
+  intro values entry
+  exact Integer.mul_one width _ (typed.canonical values entry)
+
+theorem Same.one_mul {environment : List Ty} {value : Expr} (width : Nat)
+    (typed : ExprTyped environment value (.bits width)) :
+    Same environment (.two (.mul width) (.zero (.constant width 1)) value) value := by
+  intro values entry
+  exact Integer.one_mul width _ (typed.canonical values entry)
+
+def Sames (environment : List Ty) (first second : List Expr) : Prop :=
+  ∀ values, Values Canonical environment values →
+    first.map (evalExpr 0 primitive values) = second.map (evalExpr 0 primitive values)
+
+theorem Sames.nil (environment : List Ty) : Sames environment [] [] := fun _ _ => rfl
+
+theorem Sames.cons {environment : List Ty} {first second : Expr} {left right : List Expr}
+    (head : Same environment first second) (tail : Sames environment left right) :
+    Sames environment (first::left) (second::right) := by
+  intro values entry
+  simp only [List.map_cons,head values entry,tail values entry]
+
+def ExactModel {World Error : Type} {registry : List Signature} (model : Model Int World Error registry) : Prop :=
+  model.default = 0 ∧ model.primitive = primitive
+
+theorem Same.model {World Error : Type} {registry : List Signature}
+    {environment : List Ty} {first second : Expr} (same : Same environment first second)
+    (model : Model Int World Error registry) (exact : ExactModel model)
+    (values : List Int) (entry : Values Canonical environment values) :
+    evalExpr model.default model.primitive values first = evalExpr model.default model.primitive values second := by
+  rw [exact.1,exact.2]
+  exact same values entry
+
+#print axioms Same.fold_add
+#print axioms Same.fold_sub
+#print axioms Same.fold_mul
+#print axioms Same.add_zero
+#print axioms ExprTyped.canonical
+end Merlin.GraphState.Integer
diff --git a/src/merlin/verify/lean/Merlin/GraphStateIntegerModels.lean b/src/merlin/verify/lean/Merlin/GraphStateIntegerModels.lean
new file mode 100644
--- /dev/null
+++ b/src/merlin/verify/lean/Merlin/GraphStateIntegerModels.lean
@@ -0,0 +1,118 @@
+/- Inhabited initialized mathematical models. Success is DERIVED from typed
+syntax and local total-on-typed call behavior, not supplied as a source premise.
+An optional faulty provider remains explicitly partial with a terminal world. -/
+import Merlin.GraphStateIntegerProgram
+import Merlin.GraphStateIntegerTrace
+
+namespace Merlin.GraphState.Integer
+set_option autoImplicit false
+open Scalar Pipeline
+
+def TotalOnTyped {World Error : Type} {registry : List Signature}
+    (model : Model Int World Error registry) (rep : Ty → Int → Prop) : Prop :=
+  ∀ identity arguments world, Values rep (signature registry identity).inputs arguments →
+    ∃ values final, model.effect identity arguments world = .ok (values,final)
+
+theorem loop_success {World Error : Type} {rep : Ty → Int → Prop} (types : List Ty)
+    (body : Int → List Int → World → Outcome Int World Error)
+    (total : ∀ index values world, Values rep types values →
+      ∃ outputs final, body index values world = .ok (outputs,final) ∧ Values rep types outputs)
+    (iterations : List Int) (values : List Int) (world : World) (typed : Values rep types values) :
+    ∃ outputs final, loopEval types.length body iterations values world = .ok (outputs,final) ∧
+      Values rep types outputs := by
+  induction iterations generalizing values world with
+  | nil => exact ⟨values,world,by simp only [loopEval,typed.length,↓reduceIte],typed⟩
+  | cons index later ih =>
+    obtain ⟨next,current,step,nextTyped⟩ := total index values world typed
+    obtain ⟨outputs,final,rest,outputTyped⟩ := ih next current nextTyped
+    exact ⟨outputs,final,by simp only [loopEval,typed.length,↓reduceIte,step,Except.bind,rest],outputTyped⟩
+
+theorem typed_success {World Error : Type} {registry : List Signature} {rep : Ty → Int → Prop}
+    (model : Model Int World Error registry) (laws : LocalTyping model rep) (total : TotalOnTyped model rep)
+    {types results : List Ty} {program : Program} (typed : Typed registry types results program)
+    (values : List Int) (world : World) (entry : Values rep types values) :
+    ∃ outputs final, evalProgram model program values world = .ok (outputs,final) ∧ Values rep results outputs := by
+  induction typed generalizing values world with
+  | ret operands => exact ⟨_,world,rfl,entry.reads operands model.default⟩
+  | pure eligible operands later ih =>
+    exact ih _ world (.cons (laws.primitive _ _ eligible (entry.reads operands model.default)) entry)
+  | @effect types results outputs identity arguments selected next known equal operands later ih =>
+    have inputs : Values rep (signature registry identity).inputs (reads model.default values arguments) := by
+      simpa only [signature,known,Option.getD_some] using entry.reads operands model.default
+    obtain ⟨returned,current,step⟩ := total identity _ world inputs
+    have typedOutputs := laws.effect _ _ _ _ _ inputs step
+    have same : (signature registry identity).outputs = outputs := by simp [signature,known,equal]
+    rw [same] at typedOutputs
+    obtain ⟨result,final,success,resultTyped⟩ := ih _ current (typedOutputs.append entry)
+    exact ⟨result,final,by simp only [evalProgram,opaqueStep,step,Except.bind,success],resultTyped⟩
+  | @loop types results carries lower upper stride initial body next bounds operands inside later ihBody ihNext =>
+    obtain ⟨returned,current,step,typedOutputs⟩ := loop_success carries
+      (fun index carry current => evalProgram model body (model.index index::carry++values) current)
+      (fun index carry current carryTyped => ihBody _ current
+        (.cons (laws.index index) (carryTyped.append entry)))
+      (model.iterations (values[lower]?.getD model.default) (values[upper]?.getD model.default)
+        (values[stride]?.getD model.default)) (reads model.default values initial) world
+      (entry.reads operands model.default)
+    obtain ⟨result,final,success,resultTyped⟩ := ihNext _ current (typedOutputs.append entry)
+    exact ⟨result,final,by simp only [evalProgram,step,Except.bind,success],resultTyped⟩
+
+def inhabit : Ty → Int
+  | .bits width => word width 17
+  | .index | .opaque _ => 17
+
+theorem inhabit_typed (type : Ty) : Canonical type (inhabit type) := by
+  cases type <;> simp only [inhabit,Canonical,word_word] <;> trivial
+
+theorem inhabitants (types : List Ty) : Values Canonical types (types.map inhabit) := by
+  induction types with
+  | nil => exact .nil
+  | cons type later ih => exact .cons (inhabit_typed type) ih
+
+def provider (registry : List Signature) (failure : Option Nat) : External Nat Int registry where
+  run := fun identity _ world =>
+    if failure = some identity then .error (17,world+1)
+    else .ok ((signature registry identity).outputs.map inhabit,world+1)
+  arity := by
+    intro identity arguments world values final success
+    split at success
+    · cases success
+    · cases success; simp only [List.length_map]
+
+theorem provider_typed (registry : List Signature) (failure : Option Nat)
+    (identity : Nat) (arguments : List Int) (world : Nat) (values : List Int) (final : Nat)
+    (_inputs : Values Canonical (signature registry identity).inputs arguments)
+    (success : (provider registry failure).run identity arguments world = .ok (values,final)) :
+    Values Canonical (signature registry identity).outputs values := by
+  simp only [provider] at success
+  split at success
+  · cases success
+  · cases success; exact inhabitants _
+
+theorem provider_total {registry : List Signature} {controls : Controls} (valid : ControlValid registry controls) :
+    TotalOnTyped (indexModel valid primitive (provider registry none)) Canonical := by
+  intro identity arguments world inputs
+  cases found : controlAt controls identity with
+  | none => exact ⟨(signature registry identity).outputs.map inhabit,world+1,
+      by simp [indexModel,indexEffect,found,provider]⟩
+  | some op => exact ⟨[op.eval arguments],world,by simp only [indexModel,indexEffect,found]⟩
+
+/-- Constant-result/effect-count loop witnesses do not expand a dynamic trace. -/
+theorem loop_constant (value : Int) (increment : Nat)
+    (body : Int → List Int → Nat → Outcome Int Nat Int)
+    (bodyExact : ∀ index carry world, carry.length = 1 → body index carry world = .ok ([value],world+increment))
+    (first : Int) (later : List Int) (carry : List Int) (world : Nat) (arity : carry.length = 1) :
+    loopEval 1 body (first::later) carry world = .ok ([value],world+increment*(later.length+1)) := by
+  induction later generalizing first carry world with
+  | nil => simp [loopEval,arity,bodyExact first carry world arity,Except.bind]
+  | cons index rest ih =>
+    rw [loopEval,ite_eq_left arity,bodyExact first carry world arity]
+    change loopEval 1 body (index::rest) [value] (world+increment) = _
+    rw [ih index [value] (world+increment) rfl]
+    congr 2
+    simp only [List.length_cons,Nat.mul_add,Nat.mul_one]
+    omega
+
+#print axioms typed_success
+#print axioms provider_typed
+#print axioms loop_constant
+end Merlin.GraphState.Integer
diff --git a/src/merlin/verify/lean/Merlin/GraphStateIntegerOperations.lean b/src/merlin/verify/lean/Merlin/GraphStateIntegerOperations.lean
new file mode 100644
--- /dev/null
+++ b/src/merlin/verify/lean/Merlin/GraphStateIntegerOperations.lean
@@ -0,0 +1,111 @@
+/- Exact word representation, using existing core BitVec facts. No new axiom
+or native numerical agreement is asserted. This explicitly chooses unsigned
+canonical Int representatives for signless finite words. -/
+import Merlin.GraphStateIntegerRepresentation
+
+namespace Merlin.GraphState.Integer
+set_option autoImplicit false
+open Scalar
+
+@[simp] theorem ofInt_word (width : Nat) (value : Int) :
+    BitVec.ofInt width (word width value) = BitVec.ofInt width value := by
+  change BitVec.ofNat width (BitVec.ofInt width value).toNat = BitVec.ofInt width value
+  simpa only [BitVec.setWidth_eq] using BitVec.ofNat_toNat width (BitVec.ofInt width value)
+
+@[simp] theorem word_word (width : Nat) (value : Int) :
+    word width (word width value) = word width value := by
+  change ((BitVec.ofInt width (word width value)).toNat : Int) = _
+  rw [ofInt_word]
+  rfl
+
+theorem word_bounds (width : Nat) (value : Int) :
+    0 ≤ word width value ∧ word width value < (2^width : Nat) := by
+  have bound := (BitVec.ofInt width value).isLt
+  constructor
+  · exact Int.natCast_nonneg _
+  · exact Int.ofNat_lt.mpr bound
+
+theorem canonical_iff (width : Nat) (value : Int) :
+    Canonical (.bits width) value ↔ 0 ≤ value ∧ value < (2^width : Nat) := by
+  constructor
+  · intro canonical
+    have bounds := word_bounds width value
+    change word width value = value at canonical
+    rw [canonical] at bounds
+    exact bounds
+  · intro bounds
+    simp only [Canonical,word,BitVec.toNat_ofInt]
+    rw [Int.emod_eq_of_lt bounds.1 bounds.2,Int.toNat_of_nonneg bounds.1]
+
+theorem word_add (width : Nat) (left right : Int) :
+    word width (word width left + word width right) = word width (left+right) := by
+  change ((BitVec.ofInt width (word width left + word width right)).toNat : Int) = _
+  simp only [BitVec.ofInt_add,ofInt_word]
+  rw [← BitVec.ofInt_add]
+  rfl
+
+theorem word_sub (width : Nat) (left right : Int) :
+    word width (word width left - word width right) = word width (left-right) := by
+  change ((BitVec.ofInt width (word width left - word width right)).toNat : Int) = _
+  simp only [Int.sub_eq_add_neg,BitVec.ofInt_add,BitVec.ofInt_neg,ofInt_word]
+  rw [← BitVec.ofInt_neg,← BitVec.ofInt_add]
+  rfl
+
+theorem word_mul (width : Nat) (left right : Int) :
+    word width (word width left * word width right) = word width (left*right) := by
+  change ((BitVec.ofInt width (word width left * word width right)).toNat : Int) = _
+  simp only [BitVec.ofInt_mul,ofInt_word]
+  rw [← BitVec.ofInt_mul]
+  rfl
+
+def primitive (op : Prim) (arguments : List Int) : Int :=
+  let first := arguments[0]?.getD 0
+  let second := arguments[1]?.getD 0
+  match op with
+  | .constant width value => word width value
+  | .add width => word width (first+second)
+  | .sub width => word width (first-second)
+  | .mul width => word width (first*second)
+  | .zext _ target | .trunc _ target => word target first
+  | .sext source target =>
+    let unsigned := word source first
+    word target (if unsigned < (2^(source-1) : Int) then unsigned else unsigned-(2^source : Int))
+
+theorem primitive_canonical (op : Prim) (arguments : List Int) :
+    Canonical op.output (primitive op arguments) := by
+  cases op <;> simp only [Prim.output,Canonical,primitive,word_word]
+
+theorem add_zero (width : Nat) (value : Int) (canonical : Canonical (.bits width) value) :
+    primitive (.add width) [value,word width 0] = value := by
+  simpa [primitive,word,Canonical] using canonical
+
+theorem zero_add (width : Nat) (value : Int) (canonical : Canonical (.bits width) value) :
+    primitive (.add width) [word width 0,value] = value := by
+  simpa [primitive,word,Canonical] using canonical
+
+theorem sub_zero (width : Nat) (value : Int) (canonical : Canonical (.bits width) value) :
+    primitive (.sub width) [value,word width 0] = value := by
+  simpa [primitive,word,Canonical] using canonical
+
+theorem mul_one (width : Nat) (value : Int) (canonical : Canonical (.bits width) value) :
+    primitive (.mul width) [value,word width 1] = value := by
+  simp only [primitive,List.getElem?_cons_zero,List.getElem?_cons_succ,Option.getD_some]
+  change ((BitVec.ofInt width (value * word width 1)).toNat : Int) = value
+  rw [BitVec.ofInt_mul,ofInt_word]
+  simp only [BitVec.ofInt_ofNat,BitVec.mul_one]
+  exact canonical
+
+theorem one_mul (width : Nat) (value : Int) (canonical : Canonical (.bits width) value) :
+    primitive (.mul width) [word width 1,value] = value := by
+  simp only [primitive,List.getElem?_cons_zero,List.getElem?_cons_succ,Option.getD_some]
+  change ((BitVec.ofInt width (word width 1 * value)).toNat : Int) = value
+  rw [BitVec.ofInt_mul,ofInt_word]
+  simp only [BitVec.ofInt_ofNat,BitVec.one_mul]
+  exact canonical
+
+#print axioms canonical_iff
+#print axioms word_add
+#print axioms word_sub
+#print axioms word_mul
+#print axioms mul_one
+end Merlin.GraphState.Integer
diff --git a/src/merlin/verify/lean/Merlin/GraphStateIntegerProgram.lean b/src/merlin/verify/lean/Merlin/GraphStateIntegerProgram.lean
new file mode 100644
--- /dev/null
+++ b/src/merlin/verify/lean/Merlin/GraphStateIntegerProgram.lean
@@ -0,0 +1,79 @@
+/- Complete entry-roster correspondence on a canonical entry domain, using the
+UNCHANGED pipeline dispatcher. Wrong arity and missing entries remain visible.
+The suffix may be the sealed four-pass theorem in the SAME actual registry. -/
+import Merlin.GraphStateIntegerCode
+import Merlin.GraphStatePipelineProgram
+
+namespace Merlin.GraphState.Integer
+set_option autoImplicit false
+open Scalar Pipeline
+
+def EntryDomain (entries : List Entry) (identity : Nat) (arguments : List Int) : Prop :=
+  match entries[identity]? with
+  | none => True
+  | some entry => arguments.length ≠ entry.inputs.length ∨ Values Canonical entry.inputs arguments
+
+def PreservesEntriesCanonical {World Error : Type} {registry : List Signature}
+    (model : Model Int World Error registry) (before after : List Entry) : Prop :=
+  ∀ identity arguments world, EntryDomain before identity arguments →
+    evalEntry model before identity arguments world = evalEntry model after identity arguments world
+
+theorem entries_nil {World Error : Type} {registry : List Signature}
+    (model : Model Int World Error registry) : PreservesEntriesCanonical model [] [] := by
+  intro identity arguments world entry
+  rfl
+
+theorem entries_cons {World Error : Type} {registry : List Signature}
+    (model : Model Int World Error registry) {first second : Entry} {before after : List Entry}
+    (inputs : first.inputs = second.inputs) (_outputs : first.outputs = second.outputs)
+    (body : ∀ arguments world, Values Canonical first.inputs arguments →
+      evalProgram model first.body arguments world = evalProgram model second.body arguments world)
+    (rest : PreservesEntriesCanonical model before after) :
+    PreservesEntriesCanonical model (first::before) (second::after) := by
+  intro identity arguments world entry
+  cases identity with
+  | zero =>
+    simp only [evalEntry,List.getElem?_cons_zero]
+    rw [← inputs]
+    by_cases arity : arguments.length = first.inputs.length
+    · have canonical : Values Canonical first.inputs arguments := by
+        change arguments.length ≠ first.inputs.length ∨ Values Canonical first.inputs arguments at entry
+        exact entry.resolve_left (fun wrong => wrong arity)
+      simp only [arity,↓reduceIte,body arguments world canonical]
+    · simp only [arity,↓reduceIte]
+  | succ identity =>
+    exact rest identity arguments world (by simpa only [EntryDomain,List.getElem?_cons_succ] using entry)
+
+theorem compose_suffix {World Error : Type} {registry : List Signature}
+    (model : Model Int World Error registry) {before middle after : List Entry}
+    (earlier : PreservesEntriesCanonical model before middle)
+    (suffix : PreservesEntries model middle after) : PreservesEntriesCanonical model before after := by
+  intro identity arguments world entry
+  exact (earlier identity arguments world entry).trans (suffix identity arguments world)
+
+/-- Opaque successful results require their LOCAL representation contract.
+Index operations return the concrete index carrier and impose no word premise. -/
+theorem index_model_typing {World Error : Type} {registry : List Signature} {controls : Controls}
+    (valid : ControlValid registry controls) (external : External World Error registry)
+    (typed : ∀ identity arguments world values final,
+      Values Canonical (signature registry identity).inputs arguments →
+      external.run identity arguments world = .ok (values,final) →
+      Values Canonical (signature registry identity).outputs values) :
+    LocalTyping (indexModel valid primitive external) Canonical where
+  primitive := fun op arguments _ _ => primitive_canonical op arguments
+  index := fun _ => True.intro
+  effect := by
+    intro identity arguments world values final inputs success
+    cases found : controlAt controls identity with
+    | none => exact typed _ _ _ _ _ inputs (by simpa only [indexModel,indexEffect,found] using success)
+    | some op =>
+      have same : ([op.eval arguments],world) = (values,final) := by
+        simpa only [indexModel,indexEffect,found,Except.ok.injEq] using success
+      cases same
+      rw [(valid.2 identity op found).2.2]
+      exact .cons True.intro .nil
+
+#print axioms compose_suffix
+#print axioms entries_cons
+#print axioms index_model_typing
+end Merlin.GraphState.Integer
diff --git a/src/merlin/verify/lean/Merlin/GraphStateIntegerRepresentation.lean b/src/merlin/verify/lean/Merlin/GraphStateIntegerRepresentation.lean
new file mode 100644
--- /dev/null
+++ b/src/merlin/verify/lean/Merlin/GraphStateIntegerRepresentation.lean
@@ -0,0 +1,139 @@
+/- Runtime value typing for the EXISTING Scalar operational evaluator.
+Local result contracts plus typed canonical entries derive every successful
+result/carry representation. They do not assume source success or no poison
+for a physical execution; the admitted carrier contains initialized Ints. -/
+import Merlin.GraphStateScalar
+
+namespace Merlin.GraphState.Integer
+set_option autoImplicit false
+open Scalar
+
+def word (width : Nat) (value : Int) : Int := (BitVec.ofInt width value).toNat
+
+def Canonical : Ty → Int → Prop
+  | .bits width,value => word width value = value
+  | .index,_ | .opaque _,_ => True
+
+inductive Values (rep : Ty → Int → Prop) : List Ty → List Int → Prop where
+  | nil : Values rep [] []
+  | cons {type : Ty} {types : List Ty} {value : Int} {values : List Int}
+      (head : rep type value) (tail : Values rep types values) :
+      Values rep (type::types) (value::values)
+
+theorem Values.length {rep : Ty → Int → Prop} {types : List Ty} {values : List Int}
+    (typed : Values rep types values) : values.length = types.length := by
+  induction typed with
+  | nil => rfl
+  | cons _ _ ih => simpa using congrArg Nat.succ ih
+
+theorem Values.append {rep : Ty → Int → Prop} {first second : List Ty} {xs ys : List Int}
+    (left : Values rep first xs) (right : Values rep second ys) :
+    Values rep (first++second) (xs++ys) := by
+  induction left with
+  | nil => exact right
+  | cons head tail ih => exact .cons head ih
+
+theorem Values.lookup {rep : Ty → Int → Prop} {types : List Ty} {values : List Int}
+    (typed : Values rep types values) {index : Nat} {type : Ty}
+    (found : types[index]? = some type) (default : Int) :
+    rep type (values[index]?.getD default) := by
+  induction typed generalizing index with
+  | nil => cases found
+  | cons head tail ih =>
+    cases index with
+    | zero => cases found; exact head
+    | succ index => exact ih found
+
+theorem Values.reads {rep : Ty → Int → Prop} {types selected : List Ty} {values : List Int}
+    {indices : List Nat} (typed : Values rep types values)
+    (operands : HasReads types indices selected) (default : Int) :
+    Values rep selected (reads default values indices) := by
+  induction operands with
+  | nil => exact .nil
+  | cons found rest ih => exact .cons (typed.lookup found default) ih
+
+/-- These laws are LOCAL to individual admitted operations. An opaque failure
+has no result-representation obligation and retains its entire error/world. -/
+structure LocalTyping {World Error : Type} {registry : List Signature}
+    (model : Model Int World Error registry) (rep : Ty → Int → Prop) : Prop where
+  primitive : ∀ op arguments, op.valid = true → Values rep op.inputs arguments →
+    rep op.output (model.primitive op arguments)
+  index : ∀ index, rep .index (model.index index)
+  effect : ∀ identity arguments world values final,
+    Values rep (signature registry identity).inputs arguments →
+    model.effect identity arguments world = .ok (values,final) →
+    Values rep (signature registry identity).outputs values
+
+def ResultTyped {World Error : Type} (rep : Ty → Int → Prop) (types : List Ty) :
+    Outcome Int World Error → Prop
+  | .ok (values,_) => Values rep types values
+  | .error (.external _,_) => True
+  | .error (.arity,_) => False
+
+theorem loop_result_typed {World Error : Type} {rep : Ty → Int → Prop} (types : List Ty)
+    (body : Int → List Int → World → Outcome Int World Error)
+    (bodyTyped : ∀ index values world, Values rep types values → ResultTyped rep types (body index values world))
+    (iterations : List Int) (values : List Int) (world : World) (typed : Values rep types values) :
+    ResultTyped rep types (loopEval types.length body iterations values world) := by
+  induction iterations generalizing values world with
+  | nil => simpa only [loopEval,typed.length,↓reduceIte,ResultTyped] using typed
+  | cons index rest ih =>
+    simp only [loopEval,typed.length,↓reduceIte]
+    have current := bodyTyped index values world typed
+    cases step : body index values world with
+    | error failure =>
+      rcases failure with ⟨error,final⟩
+      cases error with
+      | external error => trivial
+      | arity => simp only [step,ResultTyped] at current
+    | ok next =>
+      exact ih next.1 next.2 (by simpa only [step,ResultTyped] using current)
+
+/-- Runtime result representations, including recursively carried values, are
+derived from static syntax and LOCAL contracts. This is conditional on canonical
+entries, not a global intermediate-typing or successful-execution hypothesis. -/
+theorem typed_result {World Error : Type} {registry : List Signature}
+    {rep : Ty → Int → Prop} (model : Model Int World Error registry) (laws : LocalTyping model rep)
+    {types results : List Ty} {program : Program} (typed : Typed registry types results program)
+    (values : List Int) (world : World) (entry : Values rep types values) :
+    ResultTyped rep results (evalProgram model program values world) := by
+  induction typed generalizing values world with
+  | ret operands => exact entry.reads operands model.default
+  | pure eligible operands later ih =>
+    exact ih _ world (.cons (laws.primitive _ _ eligible (entry.reads operands model.default)) entry)
+  | @effect types results outputs identity arguments selected next known equal operands later ih =>
+    simp only [evalProgram,opaqueStep]
+    cases step : model.effect identity (reads model.default values arguments) world with
+    | error failure => trivial
+    | ok result =>
+      apply ih
+      apply Values.append _ entry
+      have inputs : (signature registry identity).inputs = selected.inputs := by simp [signature,known]
+      have outputs : (signature registry identity).outputs = outputs := by simp [signature,known, equal]
+      rw [← outputs]
+      exact laws.effect _ _ _ _ _ (by rw [inputs]; exact entry.reads operands model.default) step
+  | @loop types results carries lower upper stride initial body next bounds operands inside later ihBody ihNext =>
+    simp only [evalProgram]
+    have shape := loop_result_typed carries
+      (fun index carry current => evalProgram model body (model.index index::carry++values) current)
+      (fun index carry current carryTyped => ihBody _ current
+        (.cons (laws.index index) (carryTyped.append entry)))
+      (model.iterations (values[lower]?.getD model.default) (values[upper]?.getD model.default)
+        (values[stride]?.getD model.default)) (reads model.default values initial) world
+      (entry.reads operands model.default)
+    cases outcome : loopEval carries.length
+        (fun index carry current => evalProgram model body (model.index index::carry++values) current)
+        (model.iterations (values[lower]?.getD model.default) (values[upper]?.getD model.default)
+          (values[stride]?.getD model.default)) (reads model.default values initial) world with
+    | error failure =>
+      rcases failure with ⟨error,final⟩
+      cases error with
+      | external error => trivial
+      | arity => simp only [outcome,ResultTyped] at shape
+    | ok result =>
+      apply ihNext
+      exact (show Values rep carries result.1 from by simpa only [outcome,ResultTyped] using shape).append entry
+
+#print axioms typed_result
+#print axioms loop_result_typed
+end Merlin.GraphState.Integer
diff --git a/src/merlin/verify/lean/Merlin/GraphStateIntegerTrace.lean b/src/merlin/verify/lean/Merlin/GraphStateIntegerTrace.lean
