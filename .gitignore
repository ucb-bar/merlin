# --- Generated build outputs (structured, gitignored) ---
# Keep the tracked skeleton files (AGENT.md / README.md / .gitkeep), ignore the rest.
/build/**
!/build/
!/build/**/
!/build/**/AGENT.md
!/build/**/README.md
!/build/**/.gitkeep

# --- Produced artifacts (structured, gitignored) ---
/output/**
!/output/
!/output/**/
!/output/**/AGENT.md
!/output/**/README.md
!/output/**/.gitkeep

# --- Per-target generated scaffolds ---
/merlin/targets/*/generated/**
!/merlin/targets/*/generated/
!/merlin/targets/*/generated/AGENT.md
!/merlin/targets/*/generated/.gitkeep

# --- Local scratch (fully ignored; cross-session notes live here) ---
/tmp/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/lib/
dist/
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- CMake / C++ ---
CMakeCache.txt
CMakeFiles/
*.o
*.a
*.so
compile_commands.json

# --- Vendored LLVM/MLIR toolchain build + install (Phase 0; never committed) ---
/third_party/llvm-build/
/third_party/llvm-install/
/third_party/llvm-build.log
# Out-of-tree package build trees (gemmini-opt etc.)
/generated_targets/**/mlir_oot/build/
/generated_targets/*
results
runs
build

# --- Editor / OS ---
.DS_Store
*.swp
.idea/
.vscode/

# P18 capture-level ablation: raw multi-level recaptures are regenerable (m2m flags); only the
# small committed summary case_study/capture_level_ablation.csv is tracked.
merlin/benchmarks/dse_guidance/recaptures_levels/*/*.mlir

# P19 forensic audit: re-exported FX graph dumps are regenerable via dump_exported_fx.py
merlin/benchmarks/dse_guidance/case_study/manual_validation/exported_fx/*.txt
merlin/benchmarks/dse_guidance/case_study/manual_validation/exported_fx/*.FAILED.txt

# P20-S3 caveat-resolving variant recaptures (regenerable via variant_capture.py)
merlin/benchmarks/dse_guidance/recaptures_decode/*/*.mlir
merlin/benchmarks/dse_guidance/recaptures_decode/*/FAILED.txt
