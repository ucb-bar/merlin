# --- Stray/cruft guards (repo root stays clean; generated logs/keys never tracked) ---
/*.log
tmp
*.key
*.err
/.compat_lib/
selfcheck_out/
.qa_channel/
.oracle_timing.json
.oracle_timing.*.json

# --- Claude Code local config / working memory (never ship; settings.local.json holds a
#     per-machine permission allow-list; .claude/projects/ is agent scratch that embeds the
#     local checkout path in its dir name). ---
/.claude/settings.local.json
/.claude/projects/

# --- Generated output (CLAUDE.md "Generated-output convention") ---
# Everything under out/ is generated and ignored. Only the four root READMEs are tracked.
/out/**
!/out/
!/out/README.md
!/out/runs/
!/out/runs/README.md
!/out/artifacts/
!/out/artifacts/README.md
!/out/build/
!/out/build/README.md

# --- RTL facts are a GENERATED artifact, never hand-tracked. Our CIRCT/mlc tooling EXTRACTS them
#     from the target's RTL on demand (merlin.targetgen.rtl.facts.ensure_facts ->
#     out/artifacts/cache/rtl_introspect/<target>/facts.json, purgeable). A target's only tracked
#     definition is its reviewed input yaml (contracts/target_contract.yaml + the human-owned
#     contracts/dialect_plan.yaml). The former per-target rtl_facts/ pin (facts.json + the arc/replay
#     extras) is retired (untracked + ignored). The generated/ dir keeps its tracked AGENT.md/.gitkeep
#     skeleton per the convention above. ---
/experiments/reference-data/target-inputs/*/contracts/rtl_facts/

# --- output/ is DELETED/retired: recaptures now live in out/artifacts/recaptures/. Keep this
#     ignore as a backstop so a stray re-created output/ is never committed. ---
/output/

# --- Same backstop for the other retired top-level generated roots. CLAUDE.md retires runs/,
#     artifacts/ and build/ in favour of out/{runs,artifacts,build}/, but only output/ and results/
#     had a guard — so a re-created /artifacts/ (66 files incl. weight blobs) was surfacing as
#     untracked. /build/ stayed quiet only by accident, via venv-generated .gitignore files. ---
/artifacts/
/runs/
/build/
# figures/ was a fourth: paper-figure generators saved their renders beside themselves at the repo
# root (33 files). Generators now live in build_tools/plots/paper_figures/ and render to
# out/artifacts/paper-figures/<set>/.
/figures/

# --- Per-target generated scaffolds ---
/experiments/reference-data/target-inputs/*/generated/**
!/experiments/reference-data/target-inputs/*/generated/
!/experiments/reference-data/target-inputs/*/generated/AGENT.md
!/experiments/reference-data/target-inputs/*/generated/.gitkeep

# --- Local scratch (fully ignored; cross-session notes live here) ---
/tmp/

# --- Python ---
__pycache__/
*.py[cod]
# Build-time bundled data: setup.py's build_py hook copies merlin/{schemas,prompts} here so the
# wheel can ship them; the canonical top-level copies stay tracked. Regenerated on every build.
/merlin/python/merlin/_data/
/src/merlin/_data/
*.egg-info/
.eggs/
build/lib/
dist/
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- CMake / C++ ---
CMakeCache.txt
CMakeFiles/
*.o
*.a
*.so
compile_commands.json

# --- Vendored LLVM/MLIR toolchain build + install (Phase 0; never committed) ---
/third_party/llvm-build/
/third_party/llvm-install/
/third_party/llvm-build.log
# legacy retired dse-analysis root (dse now writes under artifacts/dse/)
/results/

# --- Editor / OS ---
.DS_Store
*.swp
.idea/
.vscode/

# P18 capture-level ablation: raw multi-level recaptures are regenerable (m2m flags); only the
# small committed summary case_study/capture_level_ablation.csv is tracked.
experiments/benchmarks/dse_guidance/recaptures_levels/*/*.mlir

# P19 forensic audit: re-exported FX graph dumps are regenerable via dump_exported_fx.py
experiments/benchmarks/dse_guidance/case_study/manual_validation/exported_fx/*.txt
experiments/benchmarks/dse_guidance/case_study/manual_validation/exported_fx/*.FAILED.txt

# P20-S3 caveat-resolving variant recaptures (regenerable via variant_capture.py)
experiments/benchmarks/dse_guidance/recaptures_decode/*/*.mlir
experiments/benchmarks/dse_guidance/recaptures_decode/*/FAILED.txt

# Experiment run outputs are generated: new runs route to runs/<target>/<suite>/ (see CLAUDE.md).
# Any legacy per-experiment runs/ dir is regenerable and never tracked.
experiments/studies/**/runs/
# Transient agentic-experiment workspaces: per-run bwrap workspaces full of absolute symlinks +
# live-written state (never want these tracked; durable artifacts live in runs/ and reports/).
**/_qa_ws/
# cross-arm verilator slot semaphore (runtime only)
/tmp/oscar_merlin_veril_slots/

# Firecrawl tool-state (web-scrape cache; not repo content)
/.firecrawl/


# External machine-specific dep config — NEVER commit the active files (real paths).
# Only .env.example (the template) is tracked. See merlin.common.paths.ext_path().
/.env
/config.json
/config.local.json
!/.env.example

# Per-experiment tooling-path env (real machine paths, all arms) — only the .example is tracked.
**/experiment.env
!**/experiment.env.example

# General ignore
tmp
.compat_lib/

# ── Benchmark ANSWER KEYS — never tracked anywhere (public repo: github.com/ucb-bar/merlin) ──
# Graded answers (golden outputs + required instruction coverage) and the held-out HIDDEN sets. These
# are the answers an agent is graded against; committing them defeats the benchmark AND enables
# cheating. Regenerable from the tracked generators + oracle; the public CONTRACT (capsule.interface.mlir
# + capsule.yaml + MANIFEST.yaml, outside hidden/) stays tracked. Global — covers capsule_bench,
# gemmini_perf_bench, agent_bench, and any future benchmark dir.
**/golden.yaml
**/golden_*.yaml
**/expected_instruction_coverage.yaml
**/hidden/
# Externalized capsule weights are large regenerable binaries AND, for a whole-model capsule, the
# thing the golden was computed from. The rule existed only in experiments/corpora/.gitignore,
# so it protected nothing under artifacts/, out/, or harness/full_public_capsules/ — where 11 weight
# blobs were surfacing as untracked. Make it global, like every other rule in this section.
**/*.safetensors
**/*.safetensors.manifest.json

# targetgen_evals grading rubrics + the declared holdout. A `golden/` DIRECTORY is an answer surface
# (check_no_answer_keys.py matches it as a path component, as it already did for `hidden/`); the two
# files the method's own prompt hands it are re-included below as declared stimulus.
/experiments/studies/targetgen_evals/datasets/*/golden/**
!/experiments/studies/targetgen_evals/datasets/*/golden/expected_contract.yaml
!/experiments/studies/targetgen_evals/datasets/*/golden/expected_dialect_features.yaml

# llvm-lit writes a per-suite timing cache next to the tests on every run. It is scheduling state, not
# a test input, and it reappears the moment anyone runs the suite -- so without this it shows up as an
# untracked file in every session and eventually gets swept into someone's commit.
tests/data/lit/.lit_test_times.txt

