# --- Stray/cruft guards (repo root stays clean; generated logs/keys never tracked) ---
/*.log
tmp
*.key
*.err
/.compat_lib/
selfcheck_out/
.qa_channel/
.oracle_timing.json

# --- Claude Code local config / working memory (never ship; settings.local.json holds a
#     per-machine permission allow-list; .claude/projects/ is agent scratch that embeds the
#     local checkout path in its dir name). ---
/.claude/settings.local.json
/.claude/projects/

# --- Single-root generated-output convention (see CLAUDE.md "Generated-output convention") ---
# All generated output lives under a single top-level out/ with subdirs out/{runs,artifacts,build}:
#   out/runs/      = aet experiment runs
#   out/artifacts/ = all other generated products (measurements, caches, recaptures, plots, ...)
#   out/build/     = compiled trees, baseline toolchains, OOT codegen
# Ignore ALL contents, but KEEP the tracked skeletons (AGENT.md / README.md / .gitkeep) and the
# curated, non-regenerable files re-included by the explicit negations below. Regenerable output
# (build products, run outputs, caches, recaptures, traces) stays ignored — never pushed.
/out/**
!/out/
!/out/**/
!/out/**/AGENT.md
!/out/**/README.md
!/out/**/.gitkeep

# GUARD: those three negations are depth-UNBOUNDED, so a vendored AGENT.md/README.md sitting deep
# inside a generated build tree (a cmake-out/third-party/ vendor dir, a baseline toolchain clone)
# would be un-ignored too and could be swept into a commit by a plain `git add -A`. Re-ignore the
# bulk trees wholesale — the curated skeleton never lives inside one.
/out/build/baselines/**
/out/**/cmake-out/**
/out/**/third-party/**
/out/**/third_party/**
/out/**/node_modules/**
/out/**/.venv/**

# The generated OOT target packages under out/build/generated/ (minted by merlin.targetgen; the
# hand-authored source of truth is merlin/targets/<target>/) are fully regenerable. Don't track their
# empty doc-only skeletons — on a fresh clone they'd be a directory tree of AGENT.md/README.md
# placeholders describing content that isn't there. out/build/generated/{AGENT,README}.md already
# document the dir's purpose. Re-ignore the whole per-target subtree.
/out/build/generated/merlin-target-*/**

# GUARD (regenerable concern subtrees): recaptures/ (per-model captures), measurements/ (per-run
# substrate dumps), selfcheck/ and cache/ each grow one fully-regenerable/purgeable subtree per
# model/run. Re-ignore everything BELOW each concern root so a generator that drops a nested
# README.md/AGENT.md can't be un-ignored by the depth-unbounded !/out/**/{AGENT,README}.md negations
# above and swept into a commit by `git add -A`. The `*/` skips the concern root, so the concern's
# own top-level AGENT.md/.gitkeep stay tracked. Adding a new model/measurement needs no .gitignore edit.
/out/artifacts/recaptures/*/**
/out/artifacts/measurements/*/**
/out/artifacts/selfcheck/*/**
/out/artifacts/cache/*/**

# --- Relocated hand-written reports (were docs/*, moved to their concern in the Phase-3 docs
#     restructure). These are NOT tool-regenerable, so they stay tracked. Explicit per-file
#     negations (never a broad *.md) so generated results in the same dirs remain ignored. ---
!/out/artifacts/kernel-mining/rvv/rvv_mining_report.md
!/out/artifacts/kernel-mining/rvv/rvv_kernel_mining_results.md
!/out/artifacts/kernel-mining/rvv/beam_rvv_v2_report.md
!/out/artifacts/compare/results.md
!/out/artifacts/compare/baselines_cross_framework_k1.md
!/out/artifacts/presentation/implementation_milestones.md
!/out/artifacts/presentation/validation_plan.md
!/out/artifacts/presentation/gemmini_requant_reconciliation.md
!/out/artifacts/presentation/gemmini_rtl_oracle_status.md
!/out/artifacts/presentation/gemmini_target_prototype.md
!/out/artifacts/presentation/saturn_vec_findings.md

# --- dse-guidance case_study GOLDEN: the committed reference the tests + --consume/--meta read.
#     It's generated analysis (regenerable via `merlin-dse-guidance --case-study`) but tracked as
#     the byte-stable golden. Track the data/source files; keep regenerable binaries untracked. ---
!/out/artifacts/dse-guidance/case_study/**
/out/artifacts/dse-guidance/case_study/**/*.png
/out/artifacts/dse-guidance/case_study/**/*.svg
/out/artifacts/dse-guidance/case_study/**/*.pdf
/out/artifacts/dse-guidance/case_study/**/*.jpg
/out/artifacts/dse-guidance/case_study/**/*.jpeg
/out/artifacts/dse-guidance/case_study/**/*.html
/out/artifacts/dse-guidance/case_study/**/*.log
# regenerable FX-graph dumps (produced by merlin/benchmarks/dse_guidance/dump_exported_fx.py)
/out/artifacts/dse-guidance/case_study/**/exported_fx/*.txt

# --- out/artifacts/targets/ : generated target packages (codegen products). Forks/OOT builds are
#     regenerable and stay ignored; the hand-authored reference baselines + promoted champions
#     are the only tracked packages (re-included via the negations below). ---
# Override the skeleton idiom's global README/AGENT un-ignore inside targets/ so fork docs are NOT
# picked up (they are regenerable); tracking is re-granted only by the explicit negations after.
/out/artifacts/targets/**/README.md
/out/artifacts/targets/**/AGENT.md
!/out/artifacts/targets/AGENT.md
!/out/artifacts/targets/rvv/hand_v0/**
!/out/artifacts/targets/rvv/hand_v0_int8/**
!/out/artifacts/targets/rvv/impr_tuned_*/**
# hand-authored reference baselines for other targets that tests load (keep suite reproducible)
!/out/artifacts/targets/gemmini/hand_v0/**
!/out/artifacts/targets/saturn_vec/hand_v0/**
!/out/artifacts/targets/muon/reference_v0/**
# never track compiled OOT build trees or bytecode even under a negated baseline (these win: last match)
/out/artifacts/targets/**/mlir_oot/build/
/out/artifacts/targets/**/__pycache__/

# --- output/ is DELETED/retired: recaptures now live in out/artifacts/recaptures/. Keep this
#     ignore as a backstop so a stray re-created output/ is never committed. ---
/output/

# --- Per-target generated scaffolds ---
/merlin/targets/*/generated/**
!/merlin/targets/*/generated/
!/merlin/targets/*/generated/AGENT.md
!/merlin/targets/*/generated/.gitkeep

# --- Local scratch (fully ignored; cross-session notes live here) ---
/tmp/

# --- Python ---
__pycache__/
*.py[cod]
# Build-time bundled data: setup.py's build_py hook copies merlin/{schemas,prompts} here so the
# wheel can ship them; the canonical top-level copies stay tracked. Regenerated on every build.
/merlin/python/merlin/_data/
*.egg-info/
.eggs/
build/lib/
dist/
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- CMake / C++ ---
CMakeCache.txt
CMakeFiles/
*.o
*.a
*.so
compile_commands.json

# --- Vendored LLVM/MLIR toolchain build + install (Phase 0; never committed) ---
/third_party/llvm-build/
/third_party/llvm-install/
/third_party/llvm-build.log
# legacy retired dse-analysis root (dse now writes under artifacts/dse/)
/results/

# --- Editor / OS ---
.DS_Store
*.swp
.idea/
.vscode/

# P18 capture-level ablation: raw multi-level recaptures are regenerable (m2m flags); only the
# small committed summary case_study/capture_level_ablation.csv is tracked.
merlin/benchmarks/dse_guidance/recaptures_levels/*/*.mlir

# P19 forensic audit: re-exported FX graph dumps are regenerable via dump_exported_fx.py
merlin/benchmarks/dse_guidance/case_study/manual_validation/exported_fx/*.txt
merlin/benchmarks/dse_guidance/case_study/manual_validation/exported_fx/*.FAILED.txt

# P20-S3 caveat-resolving variant recaptures (regenerable via variant_capture.py)
merlin/benchmarks/dse_guidance/recaptures_decode/*/*.mlir
merlin/benchmarks/dse_guidance/recaptures_decode/*/FAILED.txt

# Experiment run outputs are generated: new runs route to runs/<target>/<suite>/ (see CLAUDE.md).
# Any legacy per-experiment runs/ dir is regenerable and never tracked.
merlin/experiments/**/runs/
# Transient agentic-experiment workspaces: per-run bwrap workspaces full of absolute symlinks +
# live-written state (never want these tracked; durable artifacts live in runs/ and reports/).
**/_qa_ws/
# cross-arm verilator slot semaphore (runtime only)
/tmp/oscar_merlin_veril_slots/

# Firecrawl tool-state (web-scrape cache; not repo content)
/.firecrawl/


# External machine-specific dep config — NEVER commit the active files (real paths).
# Only .env.example (the template) is tracked. See merlin.common.paths.ext_path().
/.env
/config.json
/config.local.json
!/.env.example

# General ignore
tmp
