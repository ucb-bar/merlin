#!/usr/bin/env bash
# Repo-managed pre-commit hook (docs + artifact-layout anti-drift).
# Enable per clone with:  python build_tools/scripts/install_git_hooks.py
# (git hooks are not tracked/auto-installed; this file is, and the installer points
#  core.hooksPath here.)
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

PY=.venv/bin/python
[ -x "$PY" ] || PY=python

echo "[pre-commit] artifact layout (staged)…"
"$PY" build_tools/scripts/check_artifact_layout.py --staged

echo "[pre-commit] no-regex (staged)…"
"$PY" build_tools/scripts/check_no_regex.py --staged

echo "[pre-commit] no-target-name (staged)…"
"$PY" build_tools/scripts/check_no_target_name.py --staged

echo "[pre-commit] no-assumed-constants (staged)…"
"$PY" build_tools/scripts/check_no_assumed_constants.py --staged
# Whole-tree, not --staged: the register's claim is about the tree as a whole, and a commit that couples a
# module to a target without declaring it must fail even when the coupling arrives from another file.
echo "[pre-commit] overfit register (tree)…"
"$PY" build_tools/scripts/check_overfit_register.py

echo "[pre-commit] no-answer-keys (tracked)…"
"$PY" build_tools/scripts/check_no_answer_keys.py

echo "[pre-commit] hardware provenance (staged)…"
"$PY" build_tools/scripts/check_provenance.py --staged

echo "[pre-commit] docs freshness…"
"$PY" build_tools/scripts/check_docs.py

echo "[pre-commit] OK"
