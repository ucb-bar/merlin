# External, machine-specific dependency locations (NOT inside the repo — the repo finds itself
# via merlin.common.paths.repo_root()). Copy this file to `.env` and edit for your machine:
#     cp .env.example .env
# Code resolves these with merlin.common.paths.ext_path('chipyard') -> reads MERLIN_EXT_CHIPYARD.
# A real process env var of the same name overrides the .env value. `.env` is gitignored.
#
# The values below are the reference (this dev machine); change them to your local install paths.
MERLIN_EXT_PROJECTS_ROOT=/scratch/agustin/projects
MERLIN_EXT_SCRATCH_TMP=/scratch/agustin/tmp
MERLIN_EXT_AGENT_BENCH_EXT=/scratch/agustin/agent_bench
MERLIN_EXT_CHIPYARD=/scratch2/agustin/chipyard
MERLIN_EXT_CHIPYARD_AUTOCOMP=/scratch2/agustin/chipyard-autocomp
MERLIN_EXT_MERLIN_IREE=/scratch2/agustin/merlin
MERLIN_EXT_FIRESIM_QUEUE=/scratch2/agustin/firesim_queue
MERLIN_EXT_FIRESIM_RUNS=/scratch2/agustin/FIRESIM_RUNS_DIR
MERLIN_EXT_ZEPHYR_CHIPYARD_SW=/scratch2/agustin/zephyr-chipyard-sw
MERLIN_EXT_RADIANCE_KERNELS=/scratch2/agustin/radiance-kernels
MERLIN_EXT_MODELBLASTER=/scratch2/agustin/ModelBlaster
MERLIN_EXT_LHWIR=/scratch2/agustin/LHWIR
MERLIN_EXT_MINIFORGE=/scratch2/agustin/miniforge3
MERLIN_EXT_DIMA_SLICE_KEY=/scratch2/agustin/DIMA_SLICE
