# External, machine-specific dependency locations (NOT inside the repo — the repo finds itself via
# merlin.common.paths.repo_root()). Copy to `.env` and set these to your local install paths:
#     cp .env.example .env
# Code reads them via merlin.common.paths.ext_path('chipyard') -> $MERLIN_EXT_CHIPYARD (a real
# process env var wins over .env). `.env` is gitignored and never committed. Add a new line here
# only when code actually needs another external dependency.
# chipyard checkout (RTL/FireSim/spike sims)
MERLIN_EXT_CHIPYARD=/path/to/chipyard
# the IREE-based Merlin baseline (third_party/baselines/merlin-iree submodule, or a sibling checkout)
MERLIN_EXT_MERLIN_IREE=/path/to/merlin-iree
# FireSim job-queue dir
MERLIN_EXT_FIRESIM_QUEUE=/path/to/firesim_queue
# atlas-npu RTL checkout (the NPU/MXU target — src/ Scala + docs spec + embedded npu-model). The mlc
# arc model + capsule oracle read from it. Run `python build_tools/scripts/setup_atlas.py --write-env`
# to resolve + pin this. Default: the mlc sibling checkout's submodule.
MERLIN_EXT_ATLAS_NPU=/path/to/atlas-npu
# npu_model — atlas's execution-driven functional simulator (the capsule L2 functional oracle, the
# spike analog). A self-contained uv project (bundles ee194_softfloat). Defaults to $MERLIN_EXT_ATLAS_NPU/npu-model.
MERLIN_EXT_NPU_MODEL=/path/to/atlas-npu/npu-model
# chipyard-atlas — the chipyard checkout with atlas wired as generators/atlas + a PREBUILT whole-program
# Verilator sim (sims/verilator/simulator-chipyard.harness-AtlasRocketConfig), the L4 cycle-accurate RTL
# tier. Its toolchain (Verilator + riscv-gcc) is sourced via $MERLIN_EXT_CHIPYARD_ATLAS/env.sh. Runs a
# host RISC-V ELF (atlas program embedded via baremetal --out-c). Example: /path/to/chipyard-atlas.
# atlas L4 Verilator RTL oracle — a program-driven bare-AtlasCore Verilator sim directory shipping
# verilator_run.py (run_program) + the built vobj_dir/VAtlasCore. Resolved as MERLIN_EXT_<TARGET>_VSIM,
# so any external_backend target that registers one gets an additive L4 cycle-accurate RTL tier.
MERLIN_EXT_ATLAS_VSIM=/path/to/atlas/vsim_oracle
MERLIN_EXT_CHIPYARD_ATLAS=/path/to/chipyard-atlas

# --- Other external deps read directly from the environment (NOT via ext_path). A fresh clone needs
#     these for the documented workflows; unset => the feature degrades / its tests skip. ---
# model2MLIR checkout (add-a-model workflow: loaders + the torch-mlir LLVM-23 lowering venv).
# MERLIN_M2M_DIR points at the checkout; the compile path runs inside MERLIN_M2M_DIR/.venv.
MERLIN_M2M_DIR=/path/to/model2MLIR
MERLIN_MODEL2MLIR=/path/to/model2MLIR
# mlc — the model-ladder compiler (CIRCT+xDSL RTL frontend, targetgen.rtl.mlc_bridge). Its Python is
# pip-installed editable into merlin's venv from this checkout (`uv pip install -e $MERLIN_MLC_DIR`,
# see docs/guides/getting_started.md), so `import mlc` needs no env var. This path still locates mlc's
# NON-python assets: the prebuilt circt-opt binary, the cached runs/circt-arc/<target> arc outputs,
# and schemas. Example: /path/to/mvp-lhwir/modeling. Unset => mlc-derived RTL facts skip.
MERLIN_MLC_DIR=/path/to/mlc
# specir — the spec->testbench/golden generator (targetgen.capsule_source spec path). Defaults to
# a `spec/` checkout beside this repo; set this when it lives elsewhere. Unset + absent => the
# spec-derived capsules are unavailable.
SPECIR_ROOT=/path/to/specir
# clang-23 (else PATH `clang-23`); or point MERLIN_IREE_BIN at the IREE-Merlin build that ships it.
MERLIN_CLANG=/path/to/clang-23
# SpacemiT K1 board (baseline measurements). IP is a DHCP lease; key is your private key path.
MERLIN_K1_HOST=root@<board-ip>
MERLIN_K1_SSH_KEY=/path/to/board_key

# =====================================================================================================
# OPTIONAL baseline / board / simulator extras. Every var below has a built-in default and its feature
# DEGRADES GRACEFULLY (skips, or fails at use-time with an actionable message) when unset — a fresh
# clone's core SDK + test suite work without any of these. Set only the ones for the flow you run.
# (The many MERLIN_* runtime/ABI knobs read internally — MERLIN_OUT_ELEMS, MERLIN_WEIGHTS, MERLIN_ARGS,
# MERLIN_E2E, … — are process-internal parameters, NOT user config, and are intentionally omitted.)
# -----------------------------------------------------------------------------------------------------

# --- RTL / simulator / cross toolchain (ceiling measurement, Gemmini/Saturn/Muon cert, board build) ---
# chipyard checkout: NOTE two independent conventions. Most tools (cost_model, kernels/bench_ceiling,
# ceiling_drivers, runtime/backends/gemmini — ~25 sites) read MERLIN_CHIPYARD directly; the ext_path()
# consumers read MERLIN_EXT_CHIPYARD (top of file). They do NOT fall back to each other — set BOTH to
# the same checkout to satisfy every consumer.
MERLIN_CHIPYARD=/path/to/chipyard
MERLIN_RISCV_GCC=/path/to/riscv64-unknown-elf-gcc     # else PATH
MERLIN_SPIKE=/path/to/spike                            # RISC-V ISA sim (else PATH)
MERLIN_MLIR_TRANSLATE=/path/to/llvm-install/bin/mlir-translate   # else third_party/llvm-install
MERLIN_MLIR_INSTALL=/path/to/llvm-install              # standalone LLVM/MLIR-23 install root
MERLIN_M2M_VENV=/path/to/model2MLIR/.venv              # else MERLIN_M2M_DIR/.venv
# Gemmini sim binaries / harness (RTL cert + perf-bench)
MERLIN_GEMMINI_SPIKE=/path/to/gemmini-spike
MERLIN_GEMMINI_VERILATOR=/path/to/gemmini-verilator
MERLIN_GEMMINI_SIMV=/path/to/gemmini-simv
MERLIN_GEMMINI_HARNESS_DIR=/path/to/gemmini-rocc-tests
# Saturn (RVV) + Muon (SIMT) sims
MERLIN_SATURN_REPO=/path/to/saturn
MERLIN_SATURN_SIMV=/path/to/saturn-simv
MERLIN_MUON_VCS=/path/to/muon-vcs
MERLIN_MUON_CYCLOTRON=/path/to/cyclotron
MERLIN_MUON_CLANG=/path/to/muon-clang
MERLIN_RADIANCE_KERNELS=/path/to/radiance-kernels
MERLIN_ZEPHYR_SW=/path/to/zephyr-chipyard-sw               # the Zephyr SW workspace root
ZEPHYR_BASE=/path/to/zephyr-chipyard-sw/zephyr_ws/zephyr   # the zephyr tree (whole-model build_app)
ZEPHYR_SDK_INSTALL_DIR=/path/to/zephyr-sdk-0.17.0          # Zephyr SDK 0.17.0

# --- External baseline framework arms (cross-framework K1 comparison; each arm's tests skip if unset) ---
MERLIN_XNNPACK_REPO=/path/to/XNNPACK
MERLIN_XNNPACK_HOST=/path/to/xnnpack-host-build
MERLIN_OPENBLAS_REPO=/path/to/OpenBLAS
MERLIN_TRITON_REPO=/path/to/triton
MERLIN_BUDDY_BUILD=/path/to/buddy-mlir/build
MERLIN_BUDDY_LLVM_BUILD=/path/to/buddy-mlir/llvm/build
MERLIN_BUDDY_TORCH_PYTHON=/path/to/buddy-torch-venv/bin/python
MERLIN_GGML_BUILD=/path/to/llama.cpp/build
MERLIN_GGUF_PYTHON=/path/to/gguf-venv/bin/python
MERLIN_ET_VENV=/path/to/executorch/.venv        # ExecuTorch capture venv
MERLIN_MODELBLASTER=/path/to/modelblaster
# TVM baseline reads a family of MERLIN_TVM_* vars (checkout, RPC tracker, tune trials, target, …);
# see merlin/python/merlin/baselines/tvm.py. Representative locations:
MERLIN_TVM_LIBRARY_PATH=/path/to/tvm/build
MERLIN_TVM_CROSS_CC=/path/to/riscv64-unknown-linux-gnu-gcc

# --- Agentic loops (real LLM proposer/QA-loop runs; deterministic mock fallback when unset) ---
# The kernel-mining beam proposer + gemmini QA-loop arms call the Anthropic API through
# merlin.common.llm.complete. Unset ANTHROPIC_API_KEY => complete() returns None and the caller uses
# its deterministic fallback (tests still pass; no real agentic run). MERLIN_LLM_MODEL overrides the
# default model id.
ANTHROPIC_API_KEY=sk-ant-...
MERLIN_LLM_MODEL=claude-opus-4-8

# --- Target publishing (merlin-target-publish -> the per-target external repos) ---
# Remote for each publishable target. A process env var wins; --remote overrides both. Absent =>
# read from the tracked merlin/targets/publish.yaml. NEVER hardcode a remote in code.
MERLIN_PUBLISH_REMOTE_RVV=git@github.com:ucb-bar/rvv-mlir.git
MERLIN_PUBLISH_REMOTE_GEMMINI=git@github.com:ucb-bar/gemmini-mlir.git

# --- Bundled-data / output dir overrides (default to the in-repo layout; useful for an installed wheel) ---
# MERLIN_REPO_ROOT     — point at a checkout so repo-tree data/output resolves when running outside it
# MERLIN_OUT_ROOT      — relocate the out/ generated-output root (durable products / runs / build)
# MERLIN_WORK_DIR      — writable root for ephemeral scratch (tmp/ build scratch, calibration
#                        intermediates, external baseline checkouts); set it for an installed wheel so
#                        runs don't write under site-packages (default: the repo root in-repo)
# MERLIN_RUNTIME_DIR   — override the C runtime substrate dir (default: bundled / repo merlin/runtime)
# MERLIN_TARGETS_DIR / MERLIN_PROMPTS_DIR — override the reference-targets / prompts dirs
# MERLIN_SCHEMAS_DIR   — schemas/    (default: bundled / repo merlin/schemas)
# MERLIN_CONTRACT_DIR  — contract/   (default: bundled / repo merlin/contract)
# MERLIN_BENCH_DIR     — benchmarks/ (default: repo merlin/benchmarks)
# MERLIN_DSE_CORPUS / MERLIN_RTL_FACTS / MERLIN_TARGET_CONTRACT — per-concern data overrides
