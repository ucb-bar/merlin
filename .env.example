# External, machine-specific dependency locations (NOT inside the repo — the repo finds itself via
# merlin.common.paths.repo_root()). Copy to `.env` and set these to your local install paths:
#     cp .env.example .env
# Code reads them via merlin.common.paths.ext_path('chipyard') -> $MERLIN_EXT_CHIPYARD (a real
# process env var wins over .env). `.env` is gitignored and never committed. Add a new line here
# only when code actually needs another external dependency.
MERLIN_EXT_CHIPYARD=/scratch2/agustin/chipyard
MERLIN_EXT_MERLIN_IREE=/scratch2/agustin/merlin
MERLIN_EXT_FIRESIM_QUEUE=/scratch2/agustin/firesim_queue
